TYPE BITMAPINFO
    DEF biSize:INT
    DEF biWidth:INT
    DEF biHeight:INT
    DEF biPlanes:WORD
    DEF biBitCount:WORD
    DEF biCompression:INT
    DEF biSizeImage:INT
    DEF biXPelsPerMeter:INT
    DEF biYPelsPerMeter:INT
    DEF biClrUsed:INT
    DEF biClrImportant:INT
ENDTYPE

' ---- game states ----
CONST GS_TITLE = 0
CONST GS_READY = 1
CONST GS_PLAY  = 2
CONST GS_PDEAD = 3
CONST GS_CLEAR = 4
CONST GS_OVER  = 5
CONST GS_NAME  = 6      ' typing your initials after a top-8 score
CONST GS_STORY = 7      ' campaign: story pages
CONST GS_MAP   = 8      ' campaign: galaxy map
CONST LIFE_W   = 22      ' the remaining-lives icon: size of the bitmap (see proto/life_big.py, NUM / DEN = scale) ...
CONST LIFE_H   = 23
CONST LIFE_STEP = 21     ' ... and the distance between two icons
CONST GS_END   = 9      ' campaign: victory pages
CONST GS_OPT   = 10     ' options screen (from the title)

' ---- enemy states ----
CONST ES_DEAD  = 0
CONST ES_WAIT  = 1      ' not launched yet
CONST ES_ENTER = 2      ' flying its entry path
CONST ES_HOME  = 3      ' flying straight to its formation slot
CONST ES_FORM  = 4      ' sitting in the formation
CONST ES_DIVE  = 5      ' attack run
CONST ES_TRACT = 6      ' boss flying its tractor-beam attack

CONST ID_RAD_X2   = 101
CONST ID_RAD_X3   = 102
CONST ID_RAD_FULL = 103
CONST ID_BTN_OK   = 105

PROJECTGLOBAL "on"
    WINDOW main_win
    DIALOG dlgRes
    BITMAPINFO bmpInfo
    INT hWindowDC, hMemDC, hMemBmp, hOldBmp
    POINTER pPixelBuffer
    INT g_winW, g_winH, g_isFullScreen
    INT g_dstX, g_dstY, g_dstW, g_dstH, g_needScale
    INT hOutDC, hOutBmp, hOutOld               ' off-screen copy of the scaled frame (used for the scanlines)
    POINTER pOutBuf
    INT g_scanLevel                            ' 0 off, 1 light, 2 strong
    INT g_asmPix, g_asmCount, g_asmDecay, g_asmPixelColor
    POINTER g_pMq                                       ' trail buffer of the title marquee (224 x 288)
    POINTER g_pFx                                       ' trail buffer of the explosion sparks (224 x 288)
    INT g_fxLive
    POINTER g_pTrail                                    ' the ship's trail buffer (224 x 288)
    POINTER g_pSav                             ' 64 byte block used for the settings file
    INT g_paused, g_quitAsk, g_quitWasPaused, g_quitT                 ' ESC: the "really quit?" prompt (it pauses the game while it is open)
    INT g_hsScore[8], g_hsName[8], g_hsStage[8]    ' top 8: score, 3 letters packed as c0 | c1<<8 | c2<<16, and the stage reached (0 = unknown; arcade: the stage number; campaign: 1000 + world * 100 + step)
    INT g_nameRank, g_nameLen, g_nameCh[3], g_nameTimer, g_fireEdge
    INT g_atTick                               ' attract-mode clock on the title screen
    INT g_kRep[4]                              ' key repeat counters: left, right, up, down
    INT g_inL, g_inR, g_inU, g_inD, g_inFire   ' keyboard + gamepad (+ mouse button) state this tick
    INT g_mouseL, g_mouseR, g_mouseOn, g_mouseLastX, g_mouseLastY, g_mouseU, g_mouseD, g_free
    INT g_joyOk
    POINTER g_pJoy                             ' JOYINFOEX block

    ' scratch globals for the asm helpers
    POINTER g_pAsmDst
    POINTER g_pPlanA, g_pPlanB, g_pPlanC, g_pPlanD                  ' the four planets cut out of the orbital pictures (16 = transparent)
    POINTER g_pCloudR, g_pCloudM, g_pCloudV                          ' the plasma cloud in red, magenta and violet
    INT g_skyInit, g_skyFx, g_skyFy, g_skyPx, g_skyPy, g_skyCy, g_skyCfx, g_skyCfy
    POINTER g_pBeacon, g_pHulk, g_pRocket, g_pAstro, g_pFleet, g_pVig, g_pCaps, g_pRouteCard, g_pStrip, g_pOrb, g_pLoadDst, g_pStripF, g_pOrbF, g_pStripH, g_pOrbH, g_pStripE, g_pOrbE, g_pManta, g_pCoreS, g_pRockS, g_pQueenS, g_pRockBg, g_pOmegaBg, g_pOmegaMini, g_pCloud, g_pShotO, g_pShotS, g_pEShotS, g_pLifeS, g_pHullS, g_pTurS, g_pStnS          ' backdrop bitmaps (32 bit colours): scrolling planet strip 224x384, orbital view 224x288
    INT g_bgPos, g_bgLimit, g_bgPlanet, g_bgPal[16], g_animTab[2048], g_sprBase
    INT g_asmNumBytes

    ' art
    INT g_pal[48]                      ' 0-15 base colours, 16-39 enemy skin colours
    INT g_palN, g_skin, g_skinMap[64]
    FLOAT g_bank                       ' ship tilt while moving sideways
    INT g_pauseT, g_marq
    FLOAT g_xgSX[48], g_xgSY[48]                ' XGalaga compass paths: start point (400 x 500 field), token count,
    INT g_xgN[48], g_xgDir[2304], g_xgDur[2304]  '   heading 0-15 (0 = north, 8 = south) and frames of every step
    INT g_lvPath[900], g_lvDelay[900]           ' 15 levels x 6 rows x 10 columns: path id (-1 = none) and launch delay
    INT g_useLevel, g_lvl
    INT g_diff                                  ' 0 easy, 1 normal, 2 hard
    INT g_idle, g_demo, g_demoQuit, g_demoT, g_demoMode, g_demoHi, g_demoDiff, g_dmL, g_dmR, g_dmU, g_dmD, g_demoSeg, g_demoLast   ' demo mode: idle ticks on the title, demo running, quit request, demo clock, saved settings, AI steering
    INT g_grab, g_grabE, g_grabCool, g_grabS            ' octopus grip: ticks left, which enemy, cool-down before it can grab again
    FLOAT g_grabX, g_grabY, g_grabP            ' the octopus is frozen on its dive path while it holds the ship
    INT g_stMus                                 ' 1 = the stage tune still has to start (after the stage fanfare)
    INT g_pcX0, g_pcY0, g_pcX1, g_pcY1          ' clip box of the ending postcards
    INT g_volMus, g_volSfx, g_speed, g_optSel   ' options: music / sfx volume 0-10, game speed 0 fast 1 normal 2 slow, selected row
    INT g_curState, g_curPass                  ' mouse cursor: hidden while playing, normal arrow on menus
    INT g_spr[12288]                   ' 48 sprites x 16 x 16: 0-9 game art (9 = captured red fighter), 10-33 enemy skins 1-3, 34-37 hornet / moth, 38-39 spider, 40-41 splitter, 42-43 orbiter, 44-45 fragment, 46-47 octopus
    INT g_fnt[420]                     ' 60 glyph slots x 7 rows (5-bit masks, bit 4 = leftmost pixel)
    INT g_fontIdx[128]

    ' starfield
    FLOAT g_stX[64], g_stY[64], g_stSp[64]
    INT g_stCol[64]

    ' game
    ' audio
    POINTER g_pAud
    POINTER g_pAudBuf
    INT g_hWave, g_audioOk, g_mute, g_audNext
    INT g_audThreadOn, g_audStop, g_reqCmd, g_reqSong, g_reqLoop      ' audio thread: 0 off, 1 running, 2 has stopped; music requests posted by the game
    INT g_sfxData[160000]
    INT g_sfxStart[16], g_sfxLen[16]
    INT g_vSfx[8], g_vPos[8]
    INT g_gsId, g_gsBase, g_gsPos, g_gsMax, g_gsNext
    FLOAT g_gtPh, g_gtNoise
    ' music
    POINTER g_pHvM, g_pHvS, g_pHvC                             ' the Hive guard sprites
    INT g_hgOn[3], g_hgHp[3], g_hgSt[3], g_hgT[3], g_hgCd[3], g_hgFl[3]     ' the Queen's three bodyguards: alive, hp, state, timer, re-hatch countdown, hit flash
    FLOAT g_hgX[3], g_hgY[3], g_hgTx[3], g_hgVX[3], g_hgVY[3]
    INT g_tnTick, g_tnSong                                     ' the "next track" notice: frames left, tune shown
    INT g_musSong, g_musLoop, g_lastTune                     ' g_musLoop: 0 once, 1 loop, 2 shuffle the stage tunes
    INT g_patCell[131072], g_patRows[256], g_patN             ' pattern pool: 256 patterns x 64 rows x 8 channel slots (g_nVoice of them are played)
    INT g_nVoice                                              ' number of music voices (4..8)
    INT g_songOrd[3072], g_songOrdLen[24], g_songRowSamp[24], g_songSpeed[24], g_songRestart[24]
    INT g_tBag[24], g_tBagN, g_tBagPos, g_rngS                 ' shuffled bag of stage tunes + its own random generator
    INT g_stageList[24], g_nStage                             ' songs shuffled during the levels
    INT g_mOrd, g_mRow, g_mTick, g_mSamp, g_mTickLen          ' play position
    INT g_vOn[8], g_vInst[8], g_vSel[8], g_vVol[8], g_vAge[8], g_vRel[8], g_vFx[8], g_vPar[8], g_vArp[8], g_vVibPos[8], g_vVibSp[8], g_vVibDp[8], g_vNc[8], g_vSlSp[8]
    FLOAT g_vPitch[8], g_vTarget[8], g_vVib[8], g_vPh[8], g_vNz[8], g_vFreq[8], g_noteHz[128]
    INT g_inWave[32], g_inDec[32], g_inVibDly[32]             ' instruments 1-16
    FLOAT g_inAmp[32], g_inDuty[32], g_inSus[32], g_inVibD[32], g_inVibR[32]
    INT g_tmpMus[2560], g_tmpCnt[4]                           ' old text songs while they are being built
    INT g_curSong, g_curPat, g_curBase

    FLOAT g_warp                               ' star speed multiplier (1 = normal, up to 14 during the warp)
    INT g_flash                                ' respawn invulnerability ticks left
    INT g_stShots, g_stHits, g_totShots, g_totHits
    POINTER g_pTkH, g_pTkL, g_pTkR, g_pTkC, g_pTkF, g_pTkD   ' the Emperor's tank: hull, treads (left / right), cannons, faces, glass dome
    INT g_emAt, g_emAtT, g_emIdle, g_emSeq, g_emShk, g_mtOn[3], g_mtT[3]   ' attack in progress / its clock / pause before the next / sequence / shake / mortar shells
    INT g_emH, g_emN
    FLOAT g_emTrk, g_emY0, g_mtX[3], g_mtY[3], g_ebA1, g_ebA2                       ' where the flagship fell from, mortar targets, the two eye beams
    INT g_emRv, g_emCa, g_emCl, g_emMus, g_emCd, g_emBurst, g_emBt, g_emSl, g_emSlC, g_emHd   ' reveal timer, arm hp, music delay, cannon, claw, head
    INT g_bsAcc                                        ' damage accumulator (see BossGate)
    INT g_bossCheat                                    ' 1 = this run was started with the boss shortcut: it never touches the campaign checkpoint
    INT g_stScore0, g_accPct, g_accBonus, g_accPts     ' score at stage start / accuracy at clear / bonus percent / bonus points
    INT g_spread, g_rapid, g_pspeed, g_shield, g_lemon   ' power-ups: spread / rapid level 0-2, speed level 0-3, shield layers 0-3, lemon ticks left
    INT g_invert                                          ' octopus ink: ticks left of flipped controls
    INT g_theme                                          ' arcade backdrop (and obstacle type): 0 asteroid field, 1 Omega station, 2 icy asteroids, 3 derelict fleet
    POINTER g_pIceBg, g_pWreckBg, g_dsP                              ' icy asteroids, derelict fleet wrecks, the picture chosen by DriftSpec
    INT g_dsW, g_dsH
    FLOAT g_hkX, g_hkY                                               ' the giant derelict carrier (left, top corner of its 152 x 48 picture)
    INT g_warpPod, g_cJump, g_podDrop, g_warpMsg                ' campaign warp pods: one waiting, jumps made in this world, pod already dropped this stage, banner timer
    INT g_mode, g_cBranch, g_cStep, g_cDone, g_cForce, g_mapSel, g_sPage, g_cTimer, g_sBr, g_cSaveDone, g_cSaveScore, g_cSaveLives   ' campaign: mode 0 arcade / 1 campaign, branch 0 ice 1 fire 2 hive 3 empire, step 1-6 (6 = boss), cleared bits
    INT g_bsOn, g_bsKind, g_bsHp, g_bsMax, g_bsT, g_bsFlash, g_bsDying, g_bsAtk, g_bsPh, g_bsDmg, g_bsSw   ' big boss: state, kind, hp, timers, phase, swoop state
    INT g_rkHp[4], g_bsFlip, g_bsSp
    FLOAT g_bgY                                ' scroll position of the planet backdrops (speeds up with the warp)
    INT g_tuHp[4], g_tuCd[4], g_fsOpen, g_fsBeam, g_fsBP     ' flagship: turret hp / cooldowns, hatch opening 0-40, beam cycle counter, beam phase (-1 none, 0-59 warning, 60-99 firing)
    FLOAT g_fsBX
    FLOAT g_rkA, g_bsSpA
    INT g_bbOn[32]                             ' boss bullets
    FLOAT g_bsX, g_bsY, g_bsTX, g_bsSwA, g_bbX[32], g_bbY[32], g_bbVX[32], g_bbVY[32]
    INT g_swarm                                ' 0 normal stage, 1 spider / 2 splitter / 3 orbiter swarm
    INT g_shHit, g_bagPos, g_prWait, g_bag[20], g_rSplit[5]   ' shield grace ticks, prize bag position / kills to the next drop / the bag, split waves
    INT g_prOn[4], g_prType[4], g_prAge[4]               ' falling prize capsules
    FLOAT g_prX[4], g_prY[4]
    INT g_crOn, g_crPh, g_crT, g_crHp, g_crFl, g_crDrop, g_crDone, g_crFire, g_stT          ' the carrier (arcade: fleet wiped in under 45 s with stacked capsules)
    FLOAT g_crX, g_crY
    POINTER g_pCarrier
    INT g_obOn[8], g_obType[8], g_obHp[8], g_obFl[8], g_obCol[8]       ' shield obstacles (arcade stages 11, 13, 16, 18 ...; 4 at most): asteroid / metal beacon / ice shard
    FLOAT g_obX[8], g_obY[8]
    FLOAT g_rkX[6], g_rkY[6], g_rkV[6], g_rkDX[6]          ' background asteroid field (arcade)
    INT g_rkF[6]
    FLOAT g_cn[640], g_clX                           ' plasma cloud lattice noise and its horizontal scroll
    INT g_bmOn[4], g_bmAge[4], g_bmCd                      ' boss bombs (arcade, stage 11 and up): slow, they can be shot, and they blow up everything around them
    FLOAT g_bmX[4], g_bmY[4]
    INT g_dual, g_resc, g_heldShip, g_capBoss, g_capPhase, g_capTimer, g_capCool, g_capMsg
    FLOAT g_rx, g_ry, g_rang, g_cpx, g_cpy, g_cang
    INT g_stream                               ' 1 during a planetary defence stage: waves stream past (no formation)
    INT g_challenge, g_chHits                  ' 1 during a bonus stage / hits scored in it
    INT g_gstate, g_gtimer, g_stage, g_score, g_hiscore, g_lives, g_nextLife
    INT g_tick, g_ftick, g_attackHold, g_diveTimer
    INT g_palive, g_firePrev, g_fireCool
    FLOAT g_px, g_py
    FLOAT g_slotX, g_slotY

    ' bullets / explosions
    INT g_pbOn[16]
    FLOAT g_pbX[16], g_pbY[16], g_pbVX[16]
    INT g_cosmo, g_medals, g_cosT                      ' cosmonauts rescued this game, medals earned (arcade: one per 3), timer to the next cosmonaut drifting out of the wreckage
    POINTER g_pMedal, g_pLove                                   ' the love story portrait (bonus ending)
    INT g_nextStraight                          ' 1: the next enemy shot flies straight down (the planetary jets)
    INT g_ebOn[10], g_ebKind[10], g_nextKind          ' enemy shots: kind 0 plasma, 1 rocket (the carrier's); the kind of the next shot
    FLOAT g_ebX[10], g_ebY[10], g_ebVX[10], g_ebVY[10]
    INT g_exOn[16], g_exAge[16]
    FLOAT g_spX[8], g_spY[8]                      ' sparkle stars: position, ...
    INT g_spPh[8], g_spCol[8]                      ' ... twinkle phase and colour
    FLOAT g_exX[16], g_exY[16]
    FLOAT g_xpX[384], g_xpY[384], g_xpVX[384], g_xpVY[384]       ' firework sparks of the explosions: 24 per explosion (Euler ballistics)

    ' enemies (40) and their private path buffers (420 points, 2 px apart)
    INT g_eEsc[40]                             ' boss index this enemy escorts, or -1
    INT g_popOn[8], g_popAge[8], g_popVal[8]   ' floating score popups
    FLOAT g_popX[8], g_popY[8]
    INT g_eState[40], g_eType[40], g_eHp[40], g_eRow[40], g_eCol[40], g_eDelay[40], g_eLen[40], g_eShots[40]
    FLOAT g_eX[40], g_eY[40], g_eAng[40], g_ePos[40], g_eSpeed[40]
    FLOAT g_pathX[40, 420]
    FLOAT g_pathY[40, 420]

    ' wave tables
    INT g_wRow[40], g_wCol[40], g_wTempl[5], g_wMirror[5]
    INT g_rTempl[5], g_rMirror[5]               ' entry pattern of each wave in the current stage

    ' dense scratch polyline used while building a path
    FLOAT g_tmpX[2400], g_tmpY[2400]
    INT g_tmpN
PROJECTGLOBAL "off"

