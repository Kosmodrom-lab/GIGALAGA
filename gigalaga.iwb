    ' damaged boss (after the first hit): same art, purple instead of green
    FOR i = 0 TO 255
        v = g_spr[(5 * 256) + i]
        IF v = 6 THEN v = 11
        g_spr[(7 * 256) + i] = v
        v = g_spr[(6 * 256) + i]
        IF v = 6 THEN v = 11
        g_spr[(8 * 256) + i] = v
