SUB DrawBackdrop()
    INT sc
    g_bgPlanet = 0
    IF g_mode <> 1 OR g_cBranch < 0 THEN RETURN
    IF g_gstate < GS_READY OR g_gstate > GS_CLEAR THEN RETURN
    sc = INT(g_bgY)
    IF g_skyInit = 0 THEN SkyInit()
    IF g_cBranch = 0 THEN
        IF g_pStrip = 0 OR g_pOrb = 0 THEN
            DrawBgIce(sc)
        ELSEIF g_cStep >= 6 THEN
            g_bgPlanet = 1
            DrawStrip(g_pStrip, 0, INT(g_bgY * 1.6))
        ELSE
            DrawOrbSky(g_pOrb, 0, g_pPlanA)
        ENDIF
    ENDIF
    IF g_cBranch = 1 THEN
        IF g_pStripF = 0 OR g_pOrbF = 0 THEN
            DrawBgFire(sc)
        ELSEIF g_cStep >= 6 THEN
            g_bgPlanet = 1
            DrawStrip(g_pStripF, 1, INT(g_bgY * 1.6))
        ELSE
            DrawOrbSky(g_pOrbF, 1, g_pPlanB)
        ENDIF
    ENDIF
    IF g_cBranch = 2 THEN
        IF g_pStripH = 0 OR g_pOrbH = 0 THEN
            DrawBgHive(sc)
        ELSEIF g_cStep >= 6 THEN
            g_bgPlanet = 1
            DrawStrip(g_pStripH, 2, INT(g_bgY * 1.6))
        ELSE
            DrawOrbSky(g_pOrbH, 2, g_pPlanC)
        ENDIF
    ENDIF
    IF g_cBranch = 3 THEN
        IF g_pStripE = 0 OR g_pOrbE = 0 THEN
            DrawBgEmpire(sc)
        ELSEIF g_cStep >= 6 THEN
            g_bgPlanet = 1
            DrawStrip(g_pStripE, 3, INT(g_bgY * 1.6))
        ELSE
            DrawOrbSky(g_pOrbE, 3, g_pPlanD)
        ENDIF
    ENDIF
ENDSUB

SUB DrawGame()
    POINTER pSave
    INT i, e, k, j, eSt, frame, sprIdx, col, x, y, age, pct, ecx, ecy, hf, sq, starN
    FLOAT r, a

    FastClearBuffer(pPixelBuffer, 224 * 288 * 4)
    DrawBackdrop()
    DrawCloudBg()

    ' stars (the nearest layer twinkles); none over a planet surface
    starN = 63
    IF g_bgPlanet = 1 THEN starN = -1
    FOR i = 0 TO starN
        col = g_stCol[i]
        IF g_warp > 1.4 THEN
            DrawStreak(INT(g_stX[i]), INT(g_stY[i]), INT(g_stSp[i] * g_warp * 1.6), col)
        ELSE
            IF ((g_tick + (i * 7)) % 40) < 5 THEN col = 0xFF303048
            PutPix(INT(g_stX[i]), INT(g_stY[i]), col)
        ENDIF
    NEXT i

    IF g_bgPlanet = 0 THEN DrawSparks()
    DrawOmegaBg()
    DrawRockBg()
    DrawObstacles()

    ' enemies
    frame = (g_tick / 12) % 2
    FOR e = 0 TO 39
        eSt = g_eState[e]
        IF eSt = ES_ENTER OR eSt = ES_HOME OR eSt = ES_FORM OR eSt = ES_DIVE OR eSt = ES_TRACT THEN
            IF g_eType[e] >= 11 THEN
                sprIdx = 0
                DrawHiveG(g_eType[e] - 11, INT(g_eX[e]), INT(g_eY[e]), (g_tick / 10) % 2, 0)
            ELSEIF g_eType[e] >= 8 THEN
                sprIdx = 0
                DrawJet(g_eType[e] - 8, INT(g_eX[e]), INT(g_eY[e]))
            ELSEIF g_eType[e] = 0 THEN
                sprIdx = 1 + frame
            ELSEIF g_eType[e] = 1 THEN
                sprIdx = 3 + frame
            ELSEIF g_eType[e] = 3 THEN
                sprIdx = 38 + ((g_tick / 6) % 2)             ' spiders scuttle faster than the others flap
            ELSEIF g_eType[e] = 4 THEN
                sprIdx = 40 + ((g_tick / 10) % 2)
            ELSEIF g_eType[e] = 5 THEN
                sprIdx = 42 + ((g_tick / 12) % 2)
            ELSEIF g_eType[e] = 6 THEN
                sprIdx = 44 + ((g_tick / 4) % 2)
            ELSEIF g_eType[e] = 7 THEN
                sprIdx = 46 + ((g_tick / 14) % 2)
            ELSE
                IF g_eHp[e] = 2 THEN sprIdx = 5 + frame ELSE sprIdx = 7 + frame
            ENDIF
            IF g_skin > 0 AND g_eType[e] < 3 THEN sprIdx = 10 + ((g_skin - 1) * 8) + (sprIdx - 1)
            IF sprIdx > 0 THEN LDrawSprite(sprIdx, INT(g_eX[e]), INT(g_eY[e]), g_eAng[e])
            IF g_eType[e] = 5 AND g_eHp[e] >= 2 THEN DrawOrb(INT(g_eX[e]), INT(g_eY[e]), e)
        ENDIF
    NEXT e

    DrawCarrier()

    ' the red captured fighter rides above (behind) its boss; the tractor beam
    IF g_heldShip = 1 THEN
        LDrawSprite(9, INT(g_eX[g_capBoss] - (16.0 * SIN(g_eAng[g_capBoss]))), INT(g_eY[g_capBoss] - (16.0 * COS(g_eAng[g_capBoss]))), g_eAng[g_capBoss])
    ENDIF
    IF g_capPhase = 2 THEN DrawBeam()

    ' falling prize capsules, then the bullets
    DrawPrizes()
    DrawBombs()
    FOR i = 0 TO 15
        IF g_pbOn[i] = 1 THEN
            IF g_pShotO <> 0 AND g_bgPlanet = 1 THEN
                DrawSpr(g_pShotO + (((g_tick / 3) % 2) * 70 * 4), 7, 10, INT(g_pbX[i]) - 2, INT(g_pbY[i]) - 2, 0)      ' dark outline: readable over the ice
            ELSEIF g_pShotS <> 0 THEN
                DrawSpr(g_pShotS + (((g_tick / 3) % 2) * 40 * 4), 5, 8, INT(g_pbX[i]) - 1, INT(g_pbY[i]) - 1, 0)
            ELSE
                FillRectSolid(INT(g_pbX[i]), INT(g_pbY[i]), 2, 6, 0xFFFF5050)
            ENDIF
        ENDIF
    NEXT i
    FOR i = 0 TO 9
        IF g_ebOn[i] = 1 THEN
            IF g_ebKind[i] = 1 AND g_pRocket <> 0 THEN
                DrawSpr(g_pRocket + (((g_tick / 3) % 2) * 128 * 4), 8, 16, INT(g_ebX[i]) - 4, INT(g_ebY[i]) - 8, 0)
            ELSEIF g_pEShotS <> 0 THEN
                DrawSpr(g_pEShotS + (((g_tick / 4) % 2) * 77 * 4), 7, 11, INT(g_ebX[i]) - 2, INT(g_ebY[i]) - 4, 0)
            ELSE
                FillRectSolid(INT(g_ebX[i]), INT(g_ebY[i]), 2, 4, 0xFFFFFF78)
            ENDIF
        ENDIF
    NEXT i

    DrawShipTrail()

    ' player
    IF g_palive = 1 AND g_gstate <> GS_TITLE AND g_gstate <> GS_OPT AND g_gstate <> GS_OVER AND (g_flash = 0 OR ((g_flash / 3) % 2) = 0) THEN
        IF g_capPhase = 3 THEN
            LDrawSprite(0, INT(g_cpx), INT(g_cpy), g_cang)       ' spiralling up the beam
        ELSEIF g_dual = 1 THEN
            DrawFlame(INT(g_px) - 8, INT(g_py))
            DrawFlame(INT(g_px) + 8, INT(g_py))
            LDrawSprite(0, INT(g_px) - 8, INT(g_py), 0.0 - g_bank)
            LDrawSprite(0, INT(g_px) + 8, INT(g_py), 0.0 - g_bank)
        ELSE
            DrawFlame(INT(g_px), INT(g_py))
            LDrawSprite(0, INT(g_px), INT(g_py), 0.0 - g_bank)
        ENDIF
    ENDIF
    IF g_resc = 1 THEN LDrawSprite(0, INT(g_rx), INT(g_ry), g_rang)
    DrawShield()
    DrawGrabFx()

    ' explosions: a white flash core, an expanding shock ring and 16 sparks (white -> yellow -> red)
    FOR i = 0 TO 15
        IF g_exOn[i] = 1 THEN
            age = g_exAge[i]
            ecx = INT(g_exX[i])
            ecy = INT(g_exY[i])
            IF age < 8 THEN
                sq = 7 - age
                IF age < 3 THEN col = 0xFFFFFFFF ELSE col = 0xFFFFDC3C
                FOR y = -sq TO sq
                    hf = INT(SQRT(FLOAT((sq * sq) - (y * y))))
                    FillRectSolid(ecx - hf, ecy + y, (hf * 2) + 1, 1, col)
                NEXT y
            ENDIF
            IF age < 23 THEN
                r = (FLOAT(age) * 1.25) + 2.0
                IF age < 10 THEN
                    col = 0xFFAAE6FF
                ELSEIF age < 18 THEN
                    col = 0xFF4678DC
                ELSE
                    col = 0xFF283C78
                ENDIF
                FOR k = 0 TO 27
                    a = FLOAT(k) * 0.2243995
                    PutPix(ecx + INT(COS(a) * r), ecy + INT(SIN(a) * r), col)
                NEXT k
            ENDIF
            pSave = pPixelBuffer
            FOR k = 0 TO 15
                j = (i * 24) + k
                IF age < 8 THEN
                    col = 0xFFFFFFFF
                ELSEIF age < 18 THEN
                    col = 0xFFFFDC3C
                ELSEIF age < 28 THEN
                    col = 0xFFFF8C28
                ELSEIF age < 38 THEN
                    col = 0xFFF03C28
                ELSE
                    col = 0xFF8C1C28
                ENDIF
                x = INT(g_xpX[j])
                y = INT(g_xpY[j])
                IF g_pFx <> 0 THEN
                    pPixelBuffer = g_pFx                     ' the head of every spark also goes into the trail buffer
                    PutPix(x, y, col)
                    PutPix(x + 1, y, col)
                    pPixelBuffer = pSave
                ENDIF
                PutPix(x, y, col)
                IF age < 30 THEN
                    PutPix(x + 1, y, col)
                    PutPix(x, y + 1, col)
                    PutPix(x + 1, y + 1, col)
                ENDIF
            NEXT k
            g_fxLive = 34
        ENDIF
    NEXT i
    DrawFxTrail()

    ' score popups (800 / 1600 for bosses with escorts, 1000 for a rescue) and the names of caught prizes
    FOR i = 0 TO 7
        IF g_popOn[i] = 1 THEN
            IF ((g_popAge[i] / 3) % 2) = 0 THEN col = 0xFFFFDC3C ELSE col = 0xFFFFFFFF
            y = INT(g_popY[i]) - 4 - (g_popAge[i] / 5)
            IF g_popVal[i] < 0 THEN
                DrawPopupText(INT(g_popX[i]), y, g_popVal[i], col)
            ELSE
                k = 18
                IF g_popVal[i] >= 1000 THEN k = 24
                x = INT(g_popX[i]) + (k / 2)
                IF x < k + 2 THEN x = k + 2
                IF x > 222 THEN x = 222
                DrawNumber(x, y, g_popVal[i], col)
            ENDIF
        ENDIF
    NEXT i

    DrawBoss()

    ' HUD
    IF g_gstate = GS_TITLE OR ((g_tick / 16) % 2) = 0 THEN DrawGlyphText(8, 4, "1UP", 0xFFFF3C3C, 1)
    DrawNumber(56, 13, g_score, 0xFFFFFFFF)
    DrawGlyphText(82, 4, "HIGH SCORE", 0xFFFF3C3C, 1)
    DrawNumber(142, 13, g_hiscore, 0xFFFFFFFF)
    DrawPowerHud()
    IF g_invert > 0 AND ((g_tick / 6) % 2) = 0 THEN DrawCentered(18, "INK  CONTROLS FLIPPED", 0xFFCD46E1)

    IF g_gstate <> GS_TITLE AND g_gstate < GS_STORY THEN
        k = g_lives - 1
        IF k > 7 THEN k = 7
        FOR i = 0 TO k - 1
            IF g_pLifeS <> 0 THEN
                DrawSpr(g_pLifeS, LIFE_W, LIFE_H, 4 + (i * LIFE_STEP), 287 - LIFE_H, 0)
            ELSE
                LDrawSprite(0, 14 + (i * LIFE_STEP), 276, 0.0)
            ENDIF
        NEXT i
        IF g_mode = 1 AND g_warpPod = 1 AND ((g_tick / 10) % 2) = 0 THEN CapIcon(150, 278, 7, 0xFF9B5CFF)
        DrawGlyphText(176, 276, "STAGE", 0xFFFFDC3C, 1)
        DrawNumber(220, 276, g_stage, 0xFFFFDC3C)
    ENDIF

    ' banners
    IF g_gstate = GS_READY THEN
        IF g_challenge = 1 THEN
            DrawGlyphText(61, 60, "CHALLENGING STAGE", 0xFFFFDC3C, 1)
        ELSE
            DrawStageBanner(60)
            IF g_swarm = 1 THEN DrawCentered(76, "SPIDER SWARM", 0xFFFF5AFF)
            IF g_swarm = 2 THEN DrawCentered(76, "SPLITTER SWARM", 0xFF3CE1FF)
            IF g_swarm = 3 THEN DrawCentered(76, "ORBITER SWARM", 0xFFFFE132)
            IF g_mode = 1 THEN CampBanner()
        ENDIF
    ELSEIF g_gstate = GS_CLEAR AND g_challenge = 0 THEN
        IF g_stShots > 0 THEN pct = (g_stHits * 100) / g_stShots ELSE pct = 0
        DrawGlyphText(73, 112, "STAGE CLEARED", 0xFFFFDC3C, 1)
        DrawGlyphText(46, 130, "SHOTS FIRED", 0xFF3CE1FF, 1)
        DrawNumber(178, 130, g_stShots, 0xFFFFFFFF)
        DrawGlyphText(46, 142, "NUMBER OF HITS", 0xFF3CE1FF, 1)
        DrawNumber(178, 142, g_stHits, 0xFFFFFFFF)
        DrawGlyphText(46, 154, "HIT RATIO", 0xFF3CE1FF, 1)
        DrawNumber(172, 154, pct, 0xFFFFFFFF)
        DrawGlyphText(174, 154, "%", 0xFFFFFFFF, 1)
        IF g_accBonus > 0 THEN
            DrawGlyphText(46, 170, "ACCURACY BONUS", 0xFFFFDC3C, 1)
            DrawGlyphText(166, 170, "+", 0xFFFFDC3C, 1)
            DrawNumber(184, 170, g_accBonus, 0xFFFFDC3C)
            DrawGlyphText(186, 170, "%", 0xFFFFDC3C, 1)
            DrawNumber(178, 182, g_accPts, 0xFFFFFFFF)
            DrawGlyphText(46, 182, "BONUS POINTS", 0xFF3CE1FF, 1)
        ELSEIF g_stShots >= 10 THEN
            DrawGlyphText(46, 170, "ACCURACY BONUS FROM 50%", 0xFF888899, 1)
        ENDIF
    ELSEIF g_gstate = GS_CLEAR AND g_challenge = 1 THEN
        DrawGlyphText(46, 130, "NUMBER OF HITS", 0xFF3CE1FF, 1)
        DrawNumber(178, 130, g_chHits, 0xFFFFFFFF)
        IF g_chHits = 40 AND g_gtimer < 200 THEN
            IF ((g_tick / 6) % 2) = 0 THEN DrawGlyphText(82, 150, "PERFECT !", 0xFFFFDC3C, 1)
            DrawGlyphText(50, 166, "SPECIAL BONUS 10000", 0xFFFF3C3C, 1)
        ENDIF
    ELSEIF g_gstate = GS_PDEAD AND g_capMsg = 1 THEN
        DrawGlyphText(64, 150, "FIGHTER CAPTURED", 0xFFFF3C3C, 1)
    ELSEIF g_gstate = GS_OVER THEN
        IF g_mode = 1 AND (g_cDone & 15) = 15 THEN
            DrawCentered(150, "MISSION COMPLETE", 0xFFFFDC3C)
        ELSE
            DrawGlyphText(85, 150, "GAME OVER", 0xFFFF3C3C, 1)
        ENDIF
        IF g_totShots > 0 THEN pct = (g_totHits * 100) / g_totShots ELSE pct = 0
        DrawGlyphText(46, 176, "SHOTS FIRED", 0xFF3CE1FF, 1)
        DrawNumber(178, 176, g_totShots, 0xFFFFFFFF)
        DrawGlyphText(46, 188, "NUMBER OF HITS", 0xFF3CE1FF, 1)
        DrawNumber(178, 188, g_totHits, 0xFFFFFFFF)
        DrawGlyphText(46, 200, "HIT RATIO", 0xFF3CE1FF, 1)
        DrawNumber(172, 200, pct, 0xFFFFFFFF)
        DrawGlyphText(174, 200, "%", 0xFFFFFFFF, 1)
    ELSEIF g_gstate = GS_NAME THEN
        DrawNameEntry()
    ELSEIF g_gstate = GS_STORY OR g_gstate = GS_MAP OR g_gstate = GS_END THEN
        DrawCampaign()
    ELSEIF g_gstate = GS_TITLE THEN
        DrawAttract(frame)
    ELSEIF g_gstate = GS_OPT THEN
        DrawOptions()
    ENDIF

    IF g_demo = 1 THEN
        DrawCentered(30, "GAME DEMO", CycleColor(g_tick * 3))
        IF ((g_tick / 24) % 2) = 0 THEN DrawCentered(40, "PRESS ANY KEY", 0xFFFFFFFF)
    ENDIF
    DrawTuneNotice()
    IF g_paused = 1 AND g_quitAsk = 0 THEN DrawPauseBanner()
    IF g_quitAsk = 1 THEN DrawQuitPrompt()
ENDSUB
