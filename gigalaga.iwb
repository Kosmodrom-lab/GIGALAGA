' ===============================================================================
' MAIN
' ===============================================================================
g_winW = 448
g_winH = 576
g_isFullScreen = 0
g_paused = 0
g_quitAsk = 0
g_quitWasPaused = 0
g_quitT = 0
g_hiscore = 20000
g_nameRank = -1
g_diff = 1
g_stMus = 0
g_idle = 0
g_demo = 0
g_demoQuit = 0
g_volMus = 8
g_volSfx = 10
g_speed = 0
g_optSel = 0
g_warp = 1.0

$MAIN

InitPalette()
InitSprites()
InitSprArt()
InitFont()
InitWaves()
InitLevelData()
InitStars()
InitRocks()
InitCloud()
InitDrift()
InitSparks()
InitBackdrops()
InitManta()
InitBossArt()
InitEmperorArt()
InitHiveGuards()
InitStationArt()
LoadSave()

IF ShowResolutionDialog() = 1 THEN

    INT winFlags

    IF g_isFullScreen = 1 THEN
        winFlags = @NOCAPTION | @NOAUTODRAW | @TOPMOST
    ELSE
        winFlags = @CAPTION | @SYSMENU | @MINBOX | @NOAUTODRAW
    ENDIF

    IF OPENWINDOW(main_win, 0, 0, g_winW, g_winH, winFlags, 0, "Gigalaga", &Handler) THEN

        IF g_isFullScreen = 0 THEN CENTERWINDOW main_win

        ONEXIT(&FreeEngineBuffers, NULL)
        API_timeBeginPeriod(1)

        InitGraphics()
        InitAudio()
        g_curState = -1

        g_gstate = GS_TITLE
        PlayMusic(10, 1)                                ' the title tune
        g_gtimer = 0

        INT lastTick, nowTick, accum, ticked
        lastTick = timeGetTime()
        accum = 0

        WHILE main_win <> 0
            WAIT 1
            IF g_audThreadOn = 0 THEN PumpAudio()          ' (the audio thread does it when it runs)
            UpdateCursor()

            nowTick = timeGetTime()
            accum = accum + (((nowTick - lastTick) * 60 * (100 - (g_speed * 10))) / 100)        ' FAST 100 %, NORMAL 90 %, SLOW 80 %
            lastTick = nowTick
            IF accum > 6000 THEN accum = 6000          ' never run more than 6 logic ticks in one go

            ticked = 0
            IF g_paused = 0 THEN
                WHILE accum >= 1000
                    GameTick()
                    accum = accum - 1000
                    ticked = 1
                ENDWHILE
            ELSE
                accum = 0
            ENDIF

            IF ticked = 1 OR g_paused = 1 THEN
                RenderFrame()
                IF g_paused = 1 THEN
                    g_pauseT = g_pauseT + 1
                    Sleep(16)
                ENDIF
            ELSE
                Sleep(1)
            ENDIF
        ENDWHILE

    ENDIF

ENDIF

END

' ===============================================================================
' WINDOW / GRAPHICS
' ===============================================================================
SUB Handler(), INT
    SELECT @MESSAGE
        CASE @IDCLOSEWINDOW
            CLOSEWINDOW main_win

        CASE @IDCHAR
            g_idle = 0
            IF g_quitAsk = 1 THEN
                IF @WPARAM = 89 OR @WPARAM = 121 THEN
                    CLOSEWINDOW main_win                                  ' Y: yes, quit
                ELSEIF @WPARAM = 78 OR @WPARAM = 110 OR @WPARAM = 27 OR @WPARAM = 13 THEN
                    g_quitAsk = 0                                         ' N / ESC / ENTER: back to the game
                    g_paused = g_quitWasPaused
                ENDIF
            ELSEIF g_demo = 1 THEN
                g_demoQuit = 1                                            ' any key ends the demo
            ELSEIF @WPARAM = 27 THEN
                IF g_gstate = GS_OPT THEN
                    g_gstate = GS_TITLE
                    g_atTick = 0
                    SaveSettings()
                ELSE
                    g_quitAsk = 1                                         ' ESC: ask first
                    g_quitWasPaused = g_paused
                    g_quitT = 0
                    g_paused = 1
                    g_pauseT = 0
                ENDIF
            ELSEIF @WPARAM = 79 OR @WPARAM = 111 THEN                    ' O: options (title screen only)
                IF g_gstate = GS_TITLE THEN
                    g_gstate = GS_OPT
                    g_optSel = 0
                    PlaySfx(12)
                ENDIF
            ELSEIF @WPARAM = 80 OR @WPARAM = 112 THEN
                g_paused = 1 - g_paused
                g_pauseT = 0
            ELSEIF @WPARAM = 81 OR @WPARAM = 113 THEN
                EndGameNow()
            ELSEIF @WPARAM = 43 OR @WPARAM = 45 THEN                    ' + harder, - easier (title screen only)
                IF g_gstate = GS_TITLE THEN
                    IF @WPARAM = 43 AND g_diff < 2 THEN g_diff = g_diff + 1
                    IF @WPARAM = 45 AND g_diff > 0 THEN g_diff = g_diff - 1
                    PlaySfx(12)
                    SaveSettings()
                ENDIF
            ELSEIF @WPARAM = 9 THEN                                      ' TAB: arcade / campaign (title screen only)
                IF g_gstate = GS_TITLE THEN
                    g_mode = 1 - g_mode
                    PlaySfx(12)
                    SaveSettings()
                ENDIF
            ELSEIF @WPARAM = 78 OR @WPARAM = 110 THEN                    ' N: throw the saved campaign away (title screen); in a stage: next track
                IF g_gstate = GS_TITLE AND g_mode = 1 AND g_cSaveDone > 0 THEN
                    g_cSaveDone = 0
                    PlaySfx(12)
                    SaveSettings()
                ENDIF
                IF g_gstate = GS_READY OR g_gstate = GS_PLAY OR g_gstate = GS_PDEAD OR g_gstate = GS_CLEAR THEN SkipTune()
            ELSEIF @WPARAM = 77 OR @WPARAM = 109 THEN
                g_mute = 1 - g_mute
                SaveSettings()
            ELSEIF @WPARAM = 67 OR @WPARAM = 99 THEN
                g_scanLevel = g_scanLevel + 1
                IF g_scanLevel > 2 THEN g_scanLevel = 0
                SaveSettings()
            ENDIF
    ENDSELECT
    RETURN 0
ENDSUB

SUB FreeEngineBuffers(pParam AS POINTER), INT
    SaveSettings()
    CloseAudio()
    FreeOutBuffer()
    API_timeEndPeriod(1)

    IF hMemDC <> 0 THEN
        SelectObject(hMemDC, hOldBmp)
        DeleteObject(hMemBmp)
        DeleteDC(hMemDC)
        hMemDC = 0
    ENDIF

    IF hWindowDC <> 0 THEN
        ReleaseDC(main_win.hwnd, hWindowDC)
        hWindowDC = 0
    ENDIF
    RETURN 0
ENDSUB

SUB ShowResolutionDialog(), INT
    CREATEDIALOG dlgRes, 0, 0, 260, 170, @CAPTION | @SYSMENU, 0, "Gigalaga", &ResDialogHandler

    CONTROL dlgRes, @RADIOBUTTON, "Window x2  (448 x 576)",   20, 12, 220, 20, @GROUP | @TABSTOP, ID_RAD_X2
    CONTROL dlgRes, @RADIOBUTTON, "Window x3  (672 x 864)",   20, 34, 220, 20, 0, ID_RAD_X3
    CONTROL dlgRes, @RADIOBUTTON, "Full screen (integer scale, black bars)", 20, 56, 230, 20, 0, ID_RAD_FULL

    CONTROL dlgRes, @BUTTON, "Start Game", 70, 90, 120, 26, @TABSTOP | 0x0001, ID_BTN_OK

    CONTROL dlgRes, @STATIC, "", 15, 126, 230, 2, 0x1000, 9990
    CONTROL dlgRes, @STATIC, "Arrows | SPACE fire | P pause | M mute | C CRT | ESC", 10, 134, 240, 24, @CTEDITCENTER, 9991

    RETURN DOMODAL(dlgRes, 0)
ENDSUB

SUB ResDialogHandler(), INT
    SELECT @MESSAGE
        CASE @IDINITDIALOG
            g_winW = 448 : g_winH = 576
            CENTERWINDOW dlgRes
            SETSTATE dlgRes, ID_RAD_X2, 1
            SETFOCUS dlgRes, ID_BTN_OK
        CASE @IDCONTROL
            SELECT @CONTROLID
                CASE ID_BTN_OK
                    IF GETSTATE(dlgRes, ID_RAD_X2) = 1 THEN
                        g_winW = 448 : g_winH = 576 : g_isFullScreen = 0
                    ELSEIF GETSTATE(dlgRes, ID_RAD_X3) = 1 THEN
                        g_winW = 672 : g_winH = 864 : g_isFullScreen = 0
                    ELSEIF GETSTATE(dlgRes, ID_RAD_FULL) = 1 THEN
                        g_winW = GetSystemMetrics(0) : g_winH = GetSystemMetrics(1)
                        g_isFullScreen = 1
                    ENDIF
                    CLOSEDIALOG dlgRes, 1
            ENDSELECT
        CASE @IDCLOSEWINDOW
            CLOSEDIALOG dlgRes, 0
    ENDSELECT
    RETURN 0
ENDSUB

' integer scale that fits the window, centred; the rest stays black
SUB ComputeBlitRect()
    INT sc, sc2
    sc  = g_winW / 224
    sc2 = g_winH / 288
    IF sc2 < sc THEN sc = sc2
    IF sc < 1 THEN sc = 1
    g_dstW = 224 * sc
    g_dstH = 288 * sc
    g_dstX = (g_winW - g_dstW) / 2
    g_dstY = (g_winH - g_dstH) / 2
    IF g_dstW = 224 AND g_dstH = 288 AND g_dstX = 0 AND g_dstY = 0 THEN
        g_needScale = 0
    ELSE
        g_needScale = 1
    ENDIF
ENDSUB

SUB InitGraphics()
    IF hMemDC <> 0 THEN
        SelectObject(hMemDC, hOldBmp)
        DeleteObject(hMemBmp)
        DeleteDC(hMemDC)
    ENDIF

    IF hWindowDC <> 0 THEN ReleaseDC(main_win.hwnd, hWindowDC)
    hWindowDC = GetDC(main_win.hwnd)
    SetStretchBltMode(hWindowDC, 3)                 ' COLORONCOLOR: crisp, no blending
    ComputeBlitRect()
    IF g_needScale = 1 THEN PatBlt(hWindowDC, 0, 0, g_winW, g_winH, 0x00000042)     ' BLACKNESS: the bars

    hMemDC = CreateCompatibleDC(hWindowDC)

    bmpInfo.biSize = 40
    bmpInfo.biWidth = 224
    bmpInfo.biHeight = -288
    bmpInfo.biPlanes = 1
    bmpInfo.biBitCount = 32
    bmpInfo.biCompression = 0

    hMemBmp = CreateDIBSection(hMemDC, &bmpInfo, 0, &pPixelBuffer, 0, 0)
    hOldBmp = SelectObject(hMemDC, hMemBmp)

    ' off-screen buffer at the scaled size, for the scanlines
    FreeOutBuffer()
    IF g_needScale = 1 THEN
        hOutDC = CreateCompatibleDC(hWindowDC)
        SetStretchBltMode(hOutDC, 3)
        bmpInfo.biWidth = g_dstW
        bmpInfo.biHeight = 0 - g_dstH
        hOutBmp = CreateDIBSection(hOutDC, &bmpInfo, 0, &pOutBuf, 0, 0)
        hOutOld = SelectObject(hOutDC, hOutBmp)
        bmpInfo.biWidth = 224                         ' back to the game buffer's size (SetDIBitsToDevice uses it)
        bmpInfo.biHeight = -288
    ENDIF
ENDSUB

' ship trail: every pixel of the buffer is multiplied by decayFactor / 256 (alpha forced back to 255), four pixels at a time (SSE2)
SUB ApplyTrailDecaySSE2(pBuffer:POINTER, numPix:INT, decayFactor:INT)
    IF decayFactor < 0 THEN decayFactor = 0
    IF decayFactor > 255 THEN decayFactor = 255
    g_pAsmDst = pBuffer
    g_asmCount = numPix >> 2
    g_asmDecay = decayFactor
    g_asmPixelColor = 0xFF000000

    _asm
        push edi
        mov edi, [g_pAsmDst]
        mov ecx, [g_asmCount]

        test edi, edi
        jz decay_exit
        test ecx, ecx
        jz decay_exit

        mov eax, [g_asmDecay]
        movd xmm3, eax
        pshuflw xmm3, xmm3, 0
        punpcklqdq xmm3, xmm3         ; factor in all 8 words
        movd xmm5, [g_asmPixelColor]
        pshufd xmm5, xmm5, 0          ; alpha byte forced to 0xFF
        pxor xmm4, xmm4

    decay_loop:
        movdqu xmm0, [edi]
        movdqa xmm1, xmm0
        punpcklbw xmm0, xmm4          ; bytes -> words (low 2 pixels)
        punpckhbw xmm1, xmm4          ; (high 2 pixels)
        pmullw xmm0, xmm3
        pmullw xmm1, xmm3
        psrlw xmm0, 8
        psrlw xmm1, 8
        packuswb xmm0, xmm1
        por xmm0, xmm5
        movdqu [edi], xmm0
        add edi, 16
        dec ecx
        jnz decay_loop

    decay_exit:
        pop edi
    _endasm
ENDSUB

' the sparks of the explosions leave comet tails: the buffer decays every frame (SSE2) and is added over the picture while any spark is alive
SUB DrawFxTrail()
    INT i, c, d, r, g, b
    IF g_pFx = 0 THEN RETURN
    IF g_fxLive <= 0 THEN RETURN
    g_fxLive = g_fxLive - 1
    ApplyTrailDecaySSE2(g_pFx, 224 * 288, 226)
    FOR i = 0 TO (224 * 288) - 1
        c = *<INT>(g_pFx + (i * 4))
        IF (c & 0xFFFFFF) <> 0 THEN
            d = *<INT>(pPixelBuffer + (i * 4))
            r = ((d >> 16) & 255) + ((c >> 16) & 255)
            g = ((d >> 8) & 255) + ((c >> 8) & 255)
            b = (d & 255) + (c & 255)
            IF r > 255 THEN r = 255
            IF g > 255 THEN g = 255
            IF b > 255 THEN b = 255
            *<INT>(pPixelBuffer + (i * 4)) = 0xFF000000 | (r << 16) | (g << 8) | b
        ENDIF
    NEXT i
ENDSUB

' the ship leaves a fading ghost of itself: the ship is drawn into its own buffer, the buffer decays every frame, and what is left
' is added (half strength) over the picture. Only the bottom rows (176..287) are handled, where the ship lives.
SUB DrawShipTrail()
    INT i, c, d, r, g, b, base, nPix
    POINTER pSave
    IF g_pTrail = 0 THEN RETURN
    base = 176 * 224
    nPix = 112 * 224
    ApplyTrailDecaySSE2(g_pTrail + (base * 4), nPix, 236)
    IF g_palive = 1 AND g_gstate >= GS_READY AND g_gstate <= GS_CLEAR AND g_capPhase <> 3 THEN
        pSave = pPixelBuffer
        pPixelBuffer = g_pTrail
        IF g_dual = 1 THEN
            LDrawSprite(0, INT(g_px) - 8, INT(g_py), 0.0 - g_bank)
            LDrawSprite(0, INT(g_px) + 8, INT(g_py), 0.0 - g_bank)
        ELSE
            LDrawSprite(0, INT(g_px), INT(g_py), 0.0 - g_bank)
        ENDIF
        pPixelBuffer = pSave
    ENDIF
    FOR i = 0 TO nPix - 1
        c = *<INT>(g_pTrail + ((base + i) * 4))
        IF (c & 0xFFFFFF) <> 0 THEN
            d = *<INT>(pPixelBuffer + ((base + i) * 4))
            r = ((d >> 16) & 255) + (((c >> 16) & 255) >> 1)
            g = ((d >> 8) & 255) + (((c >> 8) & 255) >> 1)
            b = (d & 255) + ((c & 255) >> 1)
            IF r > 255 THEN r = 255
            IF g > 255 THEN g = 255
            IF b > 255 THEN b = 255
            *<INT>(pPixelBuffer + ((base + i) * 4)) = 0xFF000000 | (r << 16) | (g << 8) | b
        ENDIF
    NEXT i
ENDSUB

' darken one row of pixels: light = 75 %, strong = 62 %  (x>>1 & 7F7F7F7F  +  x>>2 & 3F3F3F3F  or  x>>3 & 1F1F1F1F)
SUB DarkenRow(pRow:POINTER, nPix:INT)
    g_pAsmDst = pRow
    g_asmPix = nPix

    _asm
        push edi
        push esi
        push ebx
        mov edi, [g_pAsmDst]
        mov ecx, [g_asmPix]
        test edi, edi
        jz scan_exit
        test ecx, ecx
        jz scan_exit
        mov esi, 0x7F7F7F7F
        mov eax, [g_scanLevel]
        cmp eax, 2
        jz scan_strong
        mov ebx, 0x3F3F3F3F

    scan_light:
        mov eax, [edi]
        mov edx, eax
        shr eax, 1
        shr edx, 2
        and eax, esi
        and edx, ebx
        add eax, edx
        mov [edi], eax
        add edi, 4
        dec ecx
        jnz scan_light
        jmp scan_exit

    scan_strong:
        mov ebx, 0x1F1F1F1F

    scan_strong_loop:
        mov eax, [edi]
        mov edx, eax
        shr eax, 1
        shr edx, 3
        and eax, esi
        and edx, ebx
        add eax, edx
        mov [edi], eax
        add edi, 4
        dec ecx
        jnz scan_strong_loop

    scan_exit:
        pop ebx
        pop esi
        pop edi
    _endasm
ENDSUB

' the lower half of every scaled pixel row (x2: every 2nd screen row, x3: the 3rd, x4: the 3rd and 4th) gets darker
SUB ApplyScanlines()
    INT y, sc, lim
    POINTER pr

    sc = g_dstW / 224
    lim = (sc + 1) / 2
    FOR y = 0 TO g_dstH - 1
        IF (y % sc) >= lim THEN
            pr = pOutBuf + (y * g_dstW * 4)
            DarkenRow(pr, g_dstW)
        ENDIF
    NEXT y
ENDSUB

SUB FreeOutBuffer()
    IF hOutDC <> 0 THEN
        SelectObject(hOutDC, hOutOld)
        DeleteObject(hOutBmp)
        DeleteDC(hOutDC)
        hOutDC = 0
    ENDIF
    pOutBuf = NULL
ENDSUB

' ---- settings file: 76 bytes = magic, flags (bits 0-1 scanlines, bit 2 mute), 8 scores, 8 names, check value ----
SUB NameOf(n0:INT, n1:INT, n2:INT), INT
    RETURN n0 | (n1 << 8) | (n2 << 16)
ENDSUB

SUB InitScores()
    g_hsScore[0] = 20000
    g_hsScore[1] = 15000
    g_hsScore[2] = 10000
    g_hsScore[3] = 7000
    g_hsScore[4] = 5000
    g_hsScore[5] = 3000
    g_hsScore[6] = 2000
    g_hsScore[7] = 1000
    g_hsName[0] = NameOf(65, 67, 69)
    g_hsName[1] = NameOf(66, 79, 66)
    g_hsName[2] = NameOf(67, 65, 84)
    g_hsName[3] = NameOf(68, 65, 78)
    g_hsName[4] = NameOf(69, 86, 69)
    g_hsName[5] = NameOf(70, 79, 88)
    g_hsName[6] = NameOf(71, 85, 83)
    g_hsName[7] = NameOf(72, 65, 76)
    g_hsStage[0] = 5
    g_hsStage[1] = 4
    g_hsStage[2] = 3
    g_hsStage[3] = 3
    g_hsStage[4] = 2
    g_hsStage[5] = 2
    g_hsStage[6] = 1
    g_hsStage[7] = 1
    g_hiscore = g_hsScore[0]
ENDSUB

SUB ScoreCheck(fl:INT), INT
    INT i, sum
    sum = (fl * 7) + 12345
    FOR i = 0 TO 7
        sum = sum + (g_hsScore[i] * 31) + (g_hsName[i] * 17) + i
    NEXT i
    RETURN sum
ENDSUB

' rank (0 = best) a score would take in the table, or -1
SUB FindRank(sc:INT), INT
    INT r
    FOR r = 0 TO 7
        IF sc > g_hsScore[r] THEN RETURN r
    NEXT r
    RETURN -1
ENDSUB

' where the game ends, for the table: the stage number (arcade) or 1000 + world * 100 + step (campaign)
SUB StageCode(), INT
    IF g_mode = 1 AND g_cBranch >= 0 AND g_cBranch <= 3 AND g_cStep >= 1 AND g_cStep <= 9 THEN RETURN 1000 + (g_cBranch * 100) + g_cStep
    IF g_stage > 999 THEN RETURN 999
    RETURN g_stage
ENDSUB

SUB InsertScore(sc:INT, nm:INT), INT
    INT r, i
    r = FindRank(sc)
    IF r < 0 THEN RETURN -1
    i = 7
    WHILE i > r
        g_hsScore[i] = g_hsScore[i - 1]
        g_hsName[i] = g_hsName[i - 1]
        g_hsStage[i] = g_hsStage[i - 1]
        i = i - 1
    ENDWHILE
    g_hsScore[r] = sc
    g_hsName[r] = nm
    g_hsStage[r] = StageCode() + (10000 * (g_diff + 1)) + (100000 * g_medals)                      ' where the game ended (0 when an old file is converted)
    RETURN r
ENDSUB

SUB LoadSave()
    INT i, h, nRead, magic, hi, fl, ck, good, v, tv
    POINTER pRd, pBuf

    InitScores()
    g_pJoy = API_GlobalAlloc(0x40, 64)
    g_pSav = API_GlobalAlloc(0x40, 512)
    i = g_pSav
    IF i = 0 THEN RETURN

    pBuf = g_pSav
    pRd = g_pSav + 256
    h = API_CreateFileA("gigalaga.sav", 0x80000000, 1, 0, 3, 0x80, 0)      ' GENERIC_READ, SHARE_READ, OPEN_EXISTING
    IF h = -1 THEN RETURN
    IF h = 0 THEN RETURN
    API_ReadFile(h, pBuf, 128, pRd, 0)
    API_CloseHandle(h)

    nRead = *<INT>(g_pSav + 256)
    magic = *<INT>(g_pSav + 0)

    IF (magic = 0x47474C32 AND nRead = 76) OR (magic = 0x47474C33 AND nRead = 92) OR (magic = 0x47474C34 AND nRead = 128) THEN
        fl = *<INT>(g_pSav + 4)
        ck = *<INT>(g_pSav + 72)
        good = 1
        FOR i = 0 TO 7
            v = *<INT>(g_pSav + 8 + (i * 4))
            IF v < 0 OR v > 99999999 THEN good = 0
            g_hsScore[i] = v
            g_hsName[i] = *<INT>(g_pSav + 40 + (i * 4))
            g_hsStage[i] = 0
        NEXT i
        IF good = 0 OR ScoreCheck(fl) <> ck THEN
            InitScores()
            RETURN
        ENDIF
        g_hiscore = g_hsScore[0]
        g_scanLevel = fl & 3
        IF g_scanLevel > 2 THEN g_scanLevel = 0
        g_mute = (fl >> 2) & 1
        g_mode = (fl >> 5) & 1
        g_diff = ((fl >> 3) & 3) - 1
        IF g_diff < 0 OR g_diff > 2 THEN g_diff = 1
        tv = (fl >> 6) & 15
        IF tv >= 1 AND tv <= 11 THEN g_volMus = tv - 1
        tv = (fl >> 10) & 15
        IF tv >= 1 AND tv <= 11 THEN g_volSfx = tv - 1
        tv = (fl >> 14) & 3
        IF tv >= 1 AND tv <= 3 THEN g_speed = tv - 1
        IF magic = 0x47474C34 THEN                            ' newest file: the stage of every score, with its own check value
            v = 0
            good = 1
            FOR i = 0 TO 7
                hi = *<INT>(g_pSav + 92 + (i * 4))
                IF hi < 0 OR hi > 9999999 THEN good = 0
                v = v + (hi * 37) + i
            NEXT i
            IF *<INT>(g_pSav + 124) <> v + 777 THEN good = 0
            IF good = 1 THEN
                FOR i = 0 TO 7
                    g_hsStage[i] = *<INT>(g_pSav + 92 + (i * 4))
                NEXT i
            ENDIF
        ENDIF
        IF magic = 0x47474C33 OR magic = 0x47474C34 THEN
            v = *<INT>(g_pSav + 76)
            hi = *<INT>(g_pSav + 80)
            fl = *<INT>(g_pSav + 84)
            ck = *<INT>(g_pSav + 88)
            good = 1
            IF ck <> ((v * 131) + (hi * 31) + (fl * 7) + 4321) THEN good = 0
            IF v < 1 OR v > 4095 THEN good = 0
            IF hi < 0 OR hi > 99999999 THEN good = 0
            IF fl < 1 OR fl > 9 THEN good = 0
            IF good = 1 THEN
                g_cSaveDone = v
                g_cSaveScore = hi
                g_cSaveLives = fl
            ENDIF
        ENDIF
    ELSEIF magic = 0x47474C31 AND nRead = 16 THEN         ' old file: one high score and the flags
        hi = *<INT>(g_pSav + 4)
        fl = *<INT>(g_pSav + 8)
        ck = *<INT>(g_pSav + 12)
        IF ck <> ((hi * 31) + (fl * 7) + 12345) THEN RETURN
        IF hi < 0 OR hi > 99999999 THEN RETURN
        InsertScore(hi, NameOf(89, 79, 85))
        g_hiscore = g_hsScore[0]
        g_scanLevel = fl & 3
        IF g_scanLevel > 2 THEN g_scanLevel = 0
        g_mute = (fl >> 2) & 1
    ENDIF
ENDSUB

SUB SaveSettings()
    INT i, h, fl, md, df
    POINTER pBuf, pWr

    i = g_pSav
    IF i = 0 THEN RETURN

    md = g_mode
    df = g_diff
    IF g_demo = 1 THEN
        md = g_demoMode                                                         ' the demo borrows the mode / difficulty: save the real ones
        df = g_demoDiff
    ENDIF
    fl = g_scanLevel + (g_mute * 4) + ((df + 1) * 8) + (md * 32)       ' bits 3-4: difficulty + 1 (0 = old file = normal)
    fl = fl + ((g_volMus + 1) << 6) + ((g_volSfx + 1) << 10) + ((g_speed + 1) << 14)      ' bits 6-9 music, 10-13 sfx, 14-15 speed (all stored + 1: 0 = old file = default)
    *<INT>(g_pSav + 0) = 0x47474C34
    *<INT>(g_pSav + 4) = fl
    FOR i = 0 TO 7
        *<INT>(g_pSav + 8 + (i * 4)) = g_hsScore[i]
        *<INT>(g_pSav + 40 + (i * 4)) = g_hsName[i]
    NEXT i
    *<INT>(g_pSav + 72) = ScoreCheck(fl)
    *<INT>(g_pSav + 76) = g_cSaveDone
    *<INT>(g_pSav + 80) = g_cSaveScore
    *<INT>(g_pSav + 84) = g_cSaveLives
    *<INT>(g_pSav + 88) = (g_cSaveDone * 131) + (g_cSaveScore * 31) + (g_cSaveLives * 7) + 4321
    fl = 0
    FOR i = 0 TO 7
        *<INT>(g_pSav + 92 + (i * 4)) = g_hsStage[i]
        fl = fl + (g_hsStage[i] * 37) + i
    NEXT i
    *<INT>(g_pSav + 124) = fl + 777

    pBuf = g_pSav
    pWr = g_pSav + 256
    h = API_CreateFileA("gigalaga.sav", 0x40000000, 0, 0, 2, 0x80, 0)     ' GENERIC_WRITE, CREATE_ALWAYS
    IF h = -1 THEN RETURN
    IF h = 0 THEN RETURN
    API_WriteFile(h, pBuf, 128, pWr, 0)
    API_CloseHandle(h)
ENDSUB

SUB FastClearBuffer(pBuf:POINTER, nBytes:INT)
    g_pAsmDst = pBuf
    g_asmNumBytes = nBytes

    _asm
        push edi
        mov edi, [g_pAsmDst]
        mov ecx, [g_asmNumBytes]
        shr ecx, 2
        xor eax, eax
        rep stosd
        pop edi
    _endasm
ENDSUB

SUB RenderFrame()
    IF pPixelBuffer = 0 THEN RETURN
    DrawGame()
    IF g_needScale = 0 THEN
        SetDIBitsToDevice(hWindowDC, 0, 0, 224, 288, 0, 0, 0, 288, pPixelBuffer, &bmpInfo, 0)
    ELSE
        IF g_scanLevel > 0 AND hOutDC <> 0 THEN
            StretchBlt(hOutDC, 0, 0, g_dstW, g_dstH, hMemDC, 0, 0, 224, 288, 0x00CC0020)
            ApplyScanlines()
            BitBlt(hWindowDC, g_dstX, g_dstY, g_dstW, g_dstH, hOutDC, 0, 0, 0x00CC0020)
        ELSE
            StretchBlt(hWindowDC, g_dstX, g_dstY, g_dstW, g_dstH, hMemDC, 0, 0, 224, 288, 0x00CC0020)
        ENDIF
    ENDIF
ENDSUB

' ===============================================================================
' ART DATA (generated)
' ===============================================================================
SUB InitPalette()
    g_pal[0] = 0
    g_pal[1] = 0xFFFFFFFF
    g_pal[2] = 0xFFF03232
    g_pal[3] = 0xFF325AFF
    g_pal[4] = 0xFFFFE132
    g_pal[5] = 0xFF3CE1FF
    g_pal[6] = 0xFF46E146
    g_pal[7] = 0xFF192DAA
    g_pal[8] = 0xFFC3C6D7
    g_pal[9] = 0xFFA01919
    g_pal[10] = 0xFFFF8C1E
    g_pal[11] = 0xFFCD46E1
    g_pal[12] = 0xFF646982
    g_pal[13] = 0xFFFFA0B4
    g_pal[14] = 0xFF197D2D
    g_pal[15] = 0xFF0C0E28
    g_palN = 15
ENDSUB

SUB SetSprRow(sprIdx:INT, row:INT, s:STRING)
    INT i, cc, v
    POINTER p
    p = &s
    FOR i = 0 TO 15
        cc = *<CHAR>(p + i)
        IF cc >= 65 THEN v = cc - 55 ELSE v = cc - 48
        g_spr[(sprIdx * 256) + (row * 16) + i] = v
    NEXT i
ENDSUB

