' ---- enemy skins ----------------------------------------------------------------------------------------------
' skin 0 = the classic colours. Skins 1-3 are copies of sprites 1-8 with the palette indices swapped for new colours;
' skin 2 and 3 also use a hornet instead of the bee, skin 3 a moth instead of the butterfly.
SUB SkinCol(skinId:INT, fromIdx:INT, col:INT)
    g_palN = g_palN + 1
    g_pal[g_palN] = col
    g_skinMap[(skinId * 16) + fromIdx] = g_palN
ENDSUB

SUB BuildSkins()
    INT s, k, i, srcSpr, v

    SetSprRow(34, 0, "0000000000000000")
    SetSprRow(34, 1, "0000A000000A0000")
    SetSprRow(34, 2, "00000A0000A00000")
    SetSprRow(34, 3, "0000007777000000")
