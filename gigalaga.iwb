SUB InitBackdrops()
    BgPalIce()
    BuildAnim(0)
    g_pStrip = API_GlobalAlloc(0x40, 224 * 384)
    g_pOrb = API_GlobalAlloc(0x40, 224 * 288)
    IF g_pStrip = 0 OR g_pOrb = 0 THEN
        g_pStrip = 0
        g_pOrb = 0
        RETURN
    ENDIF
    ' ---- ICE planet surface (tiles vertically)
    BgBegin(g_pStrip, 224 * 384)
    BgRunB("7A6A7A6A7A6A7A6A7C6A7A6A7A6A7A6A7A6A7A6A7A6A7C6A7A6A7A6A7A6A7A6B1A8A1A8B9C8C9DAA9A7A6A7A6A7A6A7A6A7C6A7A6A7A6A7A6A7C6A7A")
    BgRunB("6A7A6A7C6A7A6C7A6A7A6D1A8F9A8A9BAA9A7A9A7A9A7C6A7A6A8B7A9A7A6A7A8B1A8C1A5A4A5M4A5C4A5A4A5A4A5E4A5A3ABA4ABA4ABA4ABA4A6A5D")
    BgRunB("1QCA4ACA4ABA3A6A5A6A5A6A5A6A5A6A5AAA9AAC9AAA9A7A9A7C6B7A6A7A6A7A6A7A6A7A6G7A6A7A6E7A6C7A6C7A6B5A1B8B9C8C9F7A9A7A6A7A6C7A")
    BgRunB("6A7A6A7A6A7A6A7A6A7A6A7A6G7A6G7A6D5A8H9BAA9B8A7A8A7A6A7A6D8C7A9A7A8B1A8A1A8A1A8A4A5A4A5G4A5C4A5C4A5A4A5A4A5E4A5A4A3A4ABA")
    BgRunB("4ABA4ABA4B5B4A5B1PCA4CCA4A3A5I6A9AAC9E7A9A7A6A7B6A7A6A7A6A7C6A7A6C7A6C7A6C7A6A7A6A7A6A7A6A7A6A7A6D1A8B9E8A9FAA9A7C6A7A6A")
    BgRunB("7A6A7A6A7A6A7A6A7A6A7A6A7A6E7E6C7A6A7A6G8B9A8A9A8A9BAA9AAA9B8A7C6A7A6C7A6A7A9A7A6A8A1A8C1A8B5A4A5O4A5A4A5A4A5D6A5B4A5A3B")
    BgRunB("4ABA4ABA5C4A5D1QCA4ACA4A3A5A6A5E6A5A6A5AAC9AAA9AAA9A7E6D7A6A7A6A7A6L5A6B7A6G7A6D5A8B9A8A9A8A9A8A9FAA9A7C6A7A6A7A6A7A6A7A")
    BgRunB("6G7A6E7C6A7A6E7A6H1A8B9A8A9BAA9B8A9A8A9B7A6A7A6E7A8A7A9A6A1A8A1A8A1A8D5C4A5C4A5G4A5A4C5A4A5E4A5A4A5A4A3A4ABA5D4A5A4A5A4A")
    BgRunB("1Q4ACA4ABA3A5A4A5A4A5A4A5D6AAB9AAA9AAA9A7C6D7A6A7A6A7C6A7A6C7A6G7A6A7A6A7A6A7A6A7A6A7A6A7A6E9A8A7A9CAA9EAB7E6A7A6A7A6A7A")
    BgRunB("6A7A6A7A6A7A6A7A6E7E6C7A6A7A6A7A6C7A6D8C9D7A9B8A9B7A6A7A6A7A6A7A6A7A6A7C6A7A8A9A8A9A8A9A8A9B5B6A5C6A5H4A5A4A5D6A5A6A5A6A")
    BgRunB("5E3A6A4C5E1P2A1ABA4ABA3A6A5I6AAD9AAB7E6A7A6A8A6B7A6A7A6O7A6A7A6E7A6A7A6B5A6C8A7A9A7A9IAB7A6A7A6A7A6C7A6J5A6B7E6Q8A1A8B9A")
