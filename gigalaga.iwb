    ENDIF
ENDSUB

SUB DrawHazard(y:INT, h:INT, off:INT)
    INT x, yy, col
    FOR yy = 0 TO h - 1
        FOR x = 0 TO 223
            IF (((x + yy + off) / 6) % 2) = 0 THEN col = 0xFFFFDC3C ELSE col = 0xFF181818
            PutPix(x, y + yy, col)
        NEXT x
    NEXT yy
ENDSUB

' a white flash over the whole picture, a = 0..255
SUB FlashScreen(a:INT)
    INT n, c, r, g, b
    IF a <= 0 THEN RETURN
    IF a > 255 THEN a = 255
    FOR n = 0 TO 64511
        c = *<INT>(pPixelBuffer + (n * 4))
        r = (c >> 16) & 255
        g = (c >> 8) & 255
        b = c & 255
        r = r + (((255 - r) * a) / 256)
        g = g + (((255 - g) * a) / 256)
        b = b + (((255 - b) * a) / 256)
        *<INT>(pPixelBuffer + (n * 4)) = 0xFF000000 | (r << 16) | (g << 8) | b
    NEXT n
ENDSUB

' the end of a big boss: shock rings and a flash on the last frames
SUB DrawBossDeath(cx:INT, cy:INT)
    INT r, d6
    r = (110 - g_bsDying) * 2
    IF g_bsDying > 8 THEN
        DrawOval(cx, cy, r, r, 0xFFFFDC3C)
        IF r > 16 THEN DrawOval(cx, cy, r - 16, r - 16, 0xFFFFFFFF)
        IF r > 40 THEN DrawOval(cx, cy, r - 40, r - 40, 0xFFFF6E28)
    ENDIF
    IF g_bsDying <= 12 THEN
        d6 = g_bsDying - 6
        IF d6 < 0 THEN d6 = 0 - d6
        FlashScreen(230 - (d6 * 38))
    ENDIF
ENDSUB

SUB DrawBoss()
    INT i, w, col, x, y, my, sx, sy
    IF g_bsOn = 0 THEN RETURN
    IF g_gstate = GS_TITLE OR g_gstate >= GS_OVER THEN RETURN

    x = INT(g_bsX)
    y = INT(g_bsY)
    IF g_bsDying > 0 THEN x = x + ((g_bsDying % 3) - 1)
    IF g_emShk > 0 THEN
        sx = ((g_tick * 7) % 5) - 2
        sy = ((g_tick * 3) % 5) - 2
        IF g_emShk > 12 THEN
            sx = sx * 2
            sy = sy * 2
        ENDIF
        x = x + sx
        y = y + sy
    ENDIF
    IF g_bsDying = 0 OR ((g_bsDying / 3) % 2) = 0 THEN
        IF g_bsKind = 0 THEN
            DrawManta(x, y, FLOAT(g_tick) * (0.07 + (0.03 * FLOAT(g_bsPh))), g_bsFlash)
        ELSEIF g_bsKind = 1 THEN
            DrawCore(x, y, g_bsFlash)
            IF g_bsDying = 0 THEN
                FOR i = 0 TO 3
                    IF g_rkHp[i] > 0 THEN DrawRock(INT(RockX(i)), INT(RockY(i)), g_rkHp[i])
                NEXT i
            ENDIF
        ELSEIF g_bsKind = 2 THEN
            DrawQueen(x, y, g_bsFlash)
            DrawHiveGuards()
        ELSEIF g_bsKind = 4 THEN
            DrawTank(x, y, g_bsFlash, 9999, EmpFaceFrame(), EmpDome())
        ELSE
            DrawFlagship(x, y, g_bsFlash)
            IF g_emRv > 70 THEN
                IF g_emRv <= 230 THEN
                    DrawTank(x, (y + 10) - (((g_emRv - 70) * 158) / 160), 0, y + 9, 0, 0)       ' the tank climbs out of the wreck
                ELSE
                    DrawTank(x - (INT(g_bsX) - 112), 2, 0, 9999, 0, 0)
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    IF g_bsDying > 0 THEN
        IF g_bsKind = 4 THEN DrawBossDeath(x, y + 40) ELSE DrawBossDeath(x, y)
    ENDIF

    FOR i = 0 TO 31
        IF g_bbOn[i] = 1 THEN
            x = INT(g_bbX[i])
            y = INT(g_bbY[i])
            IF g_bsKind = 0 THEN
                FillRectSolid(x, y - 3, 1, 7, 0xFF3CE1FF)
                FillRectSolid(x - 1, y - 1, 3, 3, 0xFFD8F8FF)
            ELSEIF g_bsKind = 1 THEN
                FillRectSolid(x - 1, y - 2, 3, 5, 0xFFFF6E1E)
                FillRectSolid(x - 2, y - 1, 5, 3, 0xFFFF6E1E)
                FillRectSolid(x, y - 1, 1, 3, 0xFFFFF0A0)
            ELSEIF g_bsKind = 2 THEN
                FillRectSolid(x - 1, y - 2, 3, 4, 0xFF78E650)
                FillRectSolid(x - 2, y - 1, 5, 2, 0xFF78E650)
                FillRectSolid(x, y - 1, 1, 2, 0xFFE6FFB4)
            ELSEIF g_bsKind = 4 THEN
                FillRectSolid(x - 1, y - 2, 3, 5, 0xFFE03040)
                FillRectSolid(x - 2, y - 1, 5, 3, 0xFFFF5060)
                FillRectSolid(x, y - 1, 1, 3, 0xFFFFE8C8)
            ELSE
                FillRectSolid(x - 1, y - 2, 3, 5, 0xFFD23CFF)
                FillRectSolid(x - 2, y - 1, 5, 3, 0xFFD23CFF)
                FillRectSolid(x, y - 1, 1, 3, 0xFFFFFFFF)
            ENDIF
        ENDIF
    NEXT i

    IF g_bsKind = 3 AND g_bsDying = 0 THEN DrawFsBeam()
    IF g_bsKind = 4 AND g_bsDying = 0 THEN DrawEmpFx()

    ' health meter
    IF g_bsDying = 0 AND g_bsT > 20 AND g_emRv = 0 AND g_emSeq = 0 THEN
        my = 25
        IF g_bsKind = 4 THEN my = 100
        col = 0xFF3CE1FF
        IF g_bsPh = 1 THEN col = 0xFFFFDC3C
        IF g_bsPh = 2 THEN col = 0xFFFF3C3C
        w = (156 * g_bsHp) / g_bsMax
        FillRectSolid(31, my, 162, 7, 0xFFC8C8E6)
        FillRectSolid(32, my + 1, 160, 5, 0xFF101028)
        IF w > 0 THEN FillRectSolid(34, my + 2, w, 3, col)
        IF g_bsKind = 0 THEN DrawCentered(my + 10, "FROST MANTA", 0xFF9090C8)
        IF g_bsKind = 1 THEN DrawCentered(my + 10, "MAGMA CORE", 0xFF9090C8)
        IF g_bsKind = 2 THEN DrawCentered(my + 10, "HIVE QUEEN", 0xFF9090C8)
        IF g_bsKind = 3 THEN DrawCentered(my + 10, "EMPIRE FLAGSHIP", 0xFF9090C8)
        IF g_bsKind = 4 THEN DrawCentered(my + 10, "THE EMPEROR", 0xFFFF5060)
    ENDIF
ENDSUB

' ---- magma core (kind 1): a glowing core, four orbiting lava rocks that soak up shots ----------------------------
SUB RockX(k:INT), FLOAT
    RETURN g_bsX + (38.0 * COS(g_rkA + (1.5708 * FLOAT(k))))
ENDSUB

SUB RockY(k:INT), FLOAT
    RETURN g_bsY + (28.0 * SIN(g_rkA + (1.5708 * FLOAT(k))))
ENDSUB

' the toughness of a boss follows the firepower of the ship: with stronger guns (spread, rapid fire, a second ship) several hits
' are needed for one point of damage. A plain single shot always does full damage (100 %).
SUB BossPower(), INT
    INT sp, pwr
    sp = 100
    IF g_spread = 1 THEN sp = 150
    IF g_spread >= 2 THEN sp = 180
    pwr = (1 + g_rapid) * (1 + g_dual) * sp
    RETURN 100 + ((60 * (pwr - 100)) / 100)
ENDSUB

' 2 = this hit counts as one point of damage, 3 = the boss shrugs it off (the shot is still used up)
SUB BossGate(), INT
    INT pw
    pw = BossPower()
    g_bsAcc = g_bsAcc + 100
    IF g_bsAcc >= pw THEN
        g_bsAcc = g_bsAcc - pw
        RETURN 2
    ENDIF
    RETURN 3
ENDSUB

' 0 = miss, 1 = the bullet was soaked up, 2 = the boss itself was hit, 3 = hit but no damage (see BossGate)
' ---- the Hive guards: three kinds of living weapons. In the planet stages they stream past instead of the jets; in the Queen fight
' they are her bodyguards (0 blade mantis, 1 acid spitter, 2 carapace guard). Dead guards are re-hatched, slowly.
SUB DrawHiveG(k:INT, cx:INT, cy:INT, fr:INT, flash:INT)
    IF k = 0 AND g_pHvM <> 0 THEN DrawSpr(g_pHvM + (fr * 24 * 26 * 4), 24, 26, cx - 12, cy - 13, flash)
    IF k = 1 AND g_pHvS <> 0 THEN DrawSpr(g_pHvS + (fr * 24 * 26 * 4), 24, 26, cx - 12, cy - 13, flash)
    IF k = 2 AND g_pHvC <> 0 THEN DrawSpr(g_pHvC + (fr * 40 * 28 * 4), 40, 28, cx - 20, cy - 14, flash)
ENDSUB

SUB GuardHp(k:INT), INT
    INT h
    h = 2
    IF k = 1 THEN h = 3
    IF k = 2 THEN h = 6
    IF g_diff = 0 THEN h = (h * 2) / 3
    IF g_diff = 2 THEN h = h + 1
    IF h < 1 THEN h = 1
    RETURN h
ENDSUB

SUB HiveGuardsInit(kind:INT)
    INT k
    FOR k = 0 TO 2
        g_hgOn[k] = 0
        g_hgFl[k] = 0
        g_hgCd[k] = 99999
        IF kind = 2 THEN g_hgCd[k] = 40 + (k * 100)
    NEXT k
    g_hgCd[2] = 40
    g_hgCd[1] = 140
    g_hgCd[0] = 240
    IF kind <> 2 THEN
        FOR k = 0 TO 2
            g_hgCd[k] = 99999
        NEXT k
    ENDIF
ENDSUB

SUB HiveGuardsKill(boom:INT)
    INT k
    FOR k = 0 TO 2
        IF g_hgOn[k] = 1 AND boom = 1 THEN SpawnExplosion(g_hgX[k], g_hgY[k])
        g_hgOn[k] = 0
        g_hgCd[k] = 99999
    NEXT k
ENDSUB

SUB UpdateHiveGuards(ph:INT)
    INT k, pace
    FLOAT tx, ty, dx, dy, d
    pace = BossPace()
    FOR k = 0 TO 2
        IF g_hgOn[k] = 0 THEN
            g_hgCd[k] = g_hgCd[k] - 1
            IF g_hgCd[k] <= 0 THEN
                g_hgOn[k] = 1                          ' re-hatched from the queen's belly
                g_hgHp[k] = GuardHp(k)
                g_hgX[k] = g_bsX
                g_hgY[k] = g_bsY + 8.0
                g_hgSt[k] = 0
                g_hgT[k] = 70 + INT(RND(60.0))
                g_hgFl[k] = 0
            ENDIF
        ELSE
            IF g_hgFl[k] > 0 THEN g_hgFl[k] = g_hgFl[k] - 1
            IF k = 2 THEN
                ' the carapace guard hangs in front of her head and sways, a living shield
                tx = g_bsX + (30.0 * SIN(FLOAT(g_bsT) * 0.035))
                ty = g_bsY + 54.0
                g_hgX[k] = g_hgX[k] + ((tx - g_hgX[k]) * 0.09)
                g_hgY[k] = g_hgY[k] + ((ty - g_hgY[k]) * 0.09)
            ELSEIF k = 1 THEN
                ' the spitter drifts along her flank and lobs slow acid at the ship
                tx = g_bsX + (58.0 * SIN((FLOAT(g_bsT) * 0.022) + 2.0))
                ty = g_bsY + 6.0 + (8.0 * SIN(FLOAT(g_bsT) * 0.05))
                g_hgX[k] = g_hgX[k] + ((tx - g_hgX[k]) * 0.07)
                g_hgY[k] = g_hgY[k] + ((ty - g_hgY[k]) * 0.07)
                g_hgT[k] = g_hgT[k] - 1
                IF g_hgT[k] <= 0 AND g_palive = 1 THEN
                    BossAim(g_hgX[k], g_hgY[k] + 10.0, 1.5 + (0.2 * FLOAT(ph)))
                    g_hgT[k] = ((150 - (15 * ph)) * pace) / 100
                ENDIF
            ELSE
                ' the blade mantis circles the queen, marks the ship (a shudder), then dives at it and flies home
                IF g_hgSt[k] = 0 THEN
                    tx = g_bsX + (50.0 * COS(FLOAT(g_bsT) * 0.045))
                    ty = g_bsY - 4.0 + (18.0 * SIN(FLOAT(g_bsT) * 0.045))
                    g_hgX[k] = g_hgX[k] + ((tx - g_hgX[k]) * 0.08)
                    g_hgY[k] = g_hgY[k] + ((ty - g_hgY[k]) * 0.08)
                    g_hgT[k] = g_hgT[k] - 1
                    IF g_hgT[k] <= 0 AND g_palive = 1 THEN
                        g_hgSt[k] = 1
                        g_hgT[k] = 30
                        g_hgTx[k] = g_px
                    ENDIF
                ELSEIF g_hgSt[k] = 1 THEN
                    g_hgX[k] = g_hgX[k] + (1.5 * SIN(FLOAT(g_hgT[k]) * 1.7))
                    g_hgT[k] = g_hgT[k] - 1
                    IF g_hgT[k] <= 0 THEN
                        dx = g_hgTx[k] - g_hgX[k]
                        dy = (g_py - 4.0) - g_hgY[k]
                        d = SQRT((dx * dx) + (dy * dy))
                        IF d < 1.0 THEN d = 1.0
                        g_hgVX[k] = (dx / d) * 4.6
                        g_hgVY[k] = (dy / d) * 4.6
                        g_hgSt[k] = 2
                    ENDIF
                ELSEIF g_hgSt[k] = 2 THEN
                    g_hgX[k] = g_hgX[k] + g_hgVX[k]
                    g_hgY[k] = g_hgY[k] + g_hgVY[k]
                    IF g_hgY[k] > 262.0 OR g_hgX[k] < 6.0 OR g_hgX[k] > 218.0 THEN g_hgSt[k] = 3
                ELSE
                    dx = g_bsX - g_hgX[k]
                    dy = (g_bsY - 4.0) - g_hgY[k]
                    d = SQRT((dx * dx) + (dy * dy))
                    IF d < 9.0 THEN
                        g_hgSt[k] = 0
                        g_hgT[k] = ((120 + INT(RND(80.0))) * pace) / 100
                    ELSE
                        g_hgX[k] = g_hgX[k] + ((dx / d) * 3.2)
                        g_hgY[k] = g_hgY[k] + ((dy / d) * 3.2)
                    ENDIF
                ENDIF
            ENDIF
            ' they kill by touch
            IF g_palive = 1 THEN
                IF k = 2 THEN
                    IF ABS(g_hgX[k] - g_px) < (18.0 + (8.0 * FLOAT(g_dual))) AND ABS(g_hgY[k] - g_py) < 14.0 THEN KillPlayer()
                ELSE
                    IF ABS(g_hgX[k] - g_px) < (10.0 + (8.0 * FLOAT(g_dual))) AND ABS(g_hgY[k] - g_py) < 11.0 THEN KillPlayer()
                ENDIF
            ENDIF
        ENDIF
    NEXT k
ENDSUB

' a player shot against the guards: 0 = missed, 1 = the shot is used up (the guard may die). The carapace guard is tested first: it screens the queen's head.
SUB HiveGuardHit(px:FLOAT, py:FLOAT), INT
    INT j, k, pts
    FLOAT hw, hh
    FOR j = 0 TO 2
        k = 2 - j
        IF g_hgOn[k] = 1 THEN
            hw = 12.0
            hh = 13.0
            IF k = 2 THEN
                hw = 20.0
                hh = 13.0
            ENDIF
            IF ABS(px - g_hgX[k]) < hw AND ABS(py - g_hgY[k]) < hh THEN
                IF BossGate() = 3 THEN RETURN 1
                g_hgHp[k] = g_hgHp[k] - 1
                g_hgFl[k] = 3
                IF g_hgHp[k] <= 0 THEN
                    g_hgOn[k] = 0
                    g_hgCd[k] = 420
                    pts = 300
                    IF k = 1 THEN pts = 400
                    IF k = 2 THEN pts = 600
                    AddScore(pts)
                    SpawnPopup(g_hgX[k], g_hgY[k], pts)
                    SpawnExplosion(g_hgX[k], g_hgY[k])
                    PlaySfx(3)
                ELSE
                    PlaySfx(2)
                ENDIF
                RETURN 1
            ENDIF
        ENDIF
    NEXT j
    RETURN 0
ENDSUB

SUB DrawHiveGuards()
    INT k, fl, fr
    fr = (g_tick / 10) % 2
    FOR k = 0 TO 2
        IF g_hgOn[k] = 1 THEN
            fl = 0
            IF g_hgFl[k] > 0 THEN fl = 1
            IF k = 0 AND g_hgSt[k] = 1 AND ((g_tick / 3) % 2) = 0 THEN fl = 1
            DrawHiveG(k, INT(g_hgX[k]), INT(g_hgY[k]), fr, fl)
        ENDIF
    NEXT k
ENDSUB

' which frame the boss sprites show (the drawing and the hit tests share these)
SUB MantaFrame(fp:FLOAT), INT
    INT fi
    fi = INT((SIN(fp) + 1.0) * 4.49)
    IF fi < 0 THEN fi = 0
    IF fi > 8 THEN fi = 8
    RETURN fi
ENDSUB

SUB CoreFrame(), INT
    INT fi
    fi = INT((SIN(FLOAT(g_tick) * 0.1) + 1.0) * 1.99)
    IF fi < 0 THEN fi = 0
    IF fi > 3 THEN fi = 3
    RETURN fi
ENDSUB

SUB QueenFrame(), INT
    INT egg
    egg = 0
    IF g_bsSp < 30 AND g_bsDying = 0 AND ((g_tick / 4) % 2) = 0 THEN egg = 1
    RETURN ((g_tick / 14) % 2) * 2 + egg
ENDSUB

' pixel-accurate hit test: is there sprite under (px, py), give or take a pixel, for a sprite drawn with its corner at (sx, sy)?
SUB SprHit(pSrc:POINTER, w:INT, h:INT, sx:INT, sy:INT, px:INT, py:INT), INT
    INT x, y, xx, yy
    FOR yy = -1 TO 1
        FOR xx = -1 TO 1
            x = px - sx + xx
            y = py - sy + yy
            IF x >= 0 AND x < w AND y >= 0 AND y < h THEN
                IF *<INT>(pSrc + (((y * w) + x) * 4)) <> 0 THEN RETURN 1
            ENDIF
        NEXT xx
    NEXT yy
    RETURN 0
ENDSUB

SUB BossBulletHit(i:INT), INT
    INT k
    FLOAT dx, dy
    IF g_bsKind = 0 THEN
        IF g_pManta = 0 THEN RETURN 0
        IF SprHit(g_pManta + (MantaFrame(FLOAT(g_tick) * (0.07 + (0.03 * FLOAT(g_bsPh)))) * 116 * 84 * 4), 116, 84, INT(g_bsX) - 58, INT(g_bsY) - 48, INT(g_pbX[i]), INT(g_pbY[i])) = 1 THEN RETURN BossGate()
        RETURN 0
    ENDIF
    IF g_bsKind = 2 THEN
        IF HiveGuardHit(g_pbX[i], g_pbY[i]) = 1 THEN RETURN 1
        IF g_pQueenS = 0 THEN RETURN 0
        IF SprHit(g_pQueenS + (QueenFrame() * 84 * 64 * 4), 64, 84, INT(g_bsX) - 32, INT(g_bsY) - 44, INT(g_pbX[i]), INT(g_pbY[i])) = 1 THEN RETURN BossGate()
        RETURN 0
    ENDIF
    IF g_bsKind = 3 THEN
        FOR k = 0 TO 3
            IF g_tuHp[k] > 0 THEN
                IF ABS(g_pbX[i] - (g_bsX + TuX(k))) < 8.0 AND ABS(g_pbY[i] - (g_bsY + TuY(k))) < 8.0 THEN
                    IF BossGate() = 3 THEN RETURN 3
                    g_tuHp[k] = g_tuHp[k] - 1
                    IF g_tuHp[k] <= 0 THEN
                        SpawnExplosion(g_bsX + TuX(k), g_bsY + TuY(k))
                        PlaySfx(3)
                    ENDIF
                    RETURN 2
                ENDIF
            ENDIF
        NEXT k
        IF g_fsOpen >= 30 THEN
            dx = ABS(g_pbX[i] - g_bsX)
            dy = g_pbY[i] - (g_bsY + 4.0)
            IF dx < 12.0 AND dy > -13.0 AND dy < 19.0 THEN RETURN BossGate()          ' the open hatch lets shots through to the core
        ENDIF
        IF ABS(g_pbX[i] - g_bsX) < 56.0 AND ABS(g_pbY[i] - (g_bsY + 2.0)) < 20.0 THEN RETURN 1
        RETURN 0
    ENDIF
    IF g_bsKind = 4 THEN
        ' the tank: the two cannons first; once both are gone, shots up the front reach the face behind the glass
        IF g_emSeq > 0 THEN
            IF ABS(g_pbX[i] - g_bsX) < 43.0 AND g_pbY[i] > g_bsY AND g_pbY[i] < (g_bsY + 84.0) THEN RETURN 1
            RETURN 0
        ENDIF
        IF g_emCa > 0 THEN
            IF ABS(g_pbX[i] - (g_bsX - 17.0)) < 10.0 AND g_pbY[i] > (g_bsY + 46.0) AND g_pbY[i] < (g_bsY + 82.0) THEN
                IF BossGate() = 3 THEN RETURN 3
                g_emCa = g_emCa - 1
                IF g_emCa <= 0 THEN
                    SpawnExplosion(g_bsX - 17.0, g_bsY + 60.0)
                    SpawnExplosion(g_bsX - 17.0, g_bsY + 74.0)
                    PlaySfx(3)
                    AddScore(2000)
                    SpawnPopup(g_bsX - 17.0, g_bsY + 60.0, 2000)
                    SpawnPrize(g_bsX - 17.0, g_bsY + 70.0)
                ENDIF
                RETURN 2
            ENDIF
        ENDIF
        IF g_emCl > 0 THEN
            IF ABS(g_pbX[i] - (g_bsX + 17.0)) < 10.0 AND g_pbY[i] > (g_bsY + 46.0) AND g_pbY[i] < (g_bsY + 82.0) THEN
                IF BossGate() = 3 THEN RETURN 3
                g_emCl = g_emCl - 1
                IF g_emCl <= 0 THEN
                    SpawnExplosion(g_bsX + 17.0, g_bsY + 60.0)
                    SpawnExplosion(g_bsX + 17.0, g_bsY + 74.0)
                    PlaySfx(3)
                    AddScore(2000)
                    SpawnPopup(g_bsX + 17.0, g_bsY + 60.0, 2000)
                    SpawnPrize(g_bsX + 17.0, g_bsY + 70.0)
                ENDIF
                RETURN 2
            ENDIF
        ENDIF
        IF g_emCa <= 0 AND g_emCl <= 0 THEN
            IF ABS(g_pbX[i] - g_bsX) < 17.0 AND g_pbY[i] > (g_bsY + 8.0) AND g_pbY[i] < (g_bsY + 84.0) THEN RETURN BossGate()          ' as deep as the hull soak below, or the hull would eat the shot first
        ENDIF
        IF ABS(g_pbX[i] - g_bsX) < 43.0 AND g_pbY[i] > g_bsY AND g_pbY[i] < (g_bsY + 82.0) THEN RETURN 1           ' hull, treads and wrecked cannons
        RETURN 0
    ENDIF
    FOR k = 0 TO 3
        IF g_rkHp[k] > 0 THEN
            IF ABS(g_pbX[i] - RockX(k)) < 9.0 AND ABS(g_pbY[i] - RockY(k)) < 9.0 THEN
                IF BossGate() = 3 THEN RETURN 3
                g_rkHp[k] = g_rkHp[k] - 1
                IF g_rkHp[k] <= 0 THEN
                    SpawnExplosion(RockX(k), RockY(k))
                    PlaySfx(3)
                ENDIF
                RETURN 1
            ENDIF
        ENDIF
    NEXT k
    IF g_pCoreS = 0 THEN RETURN 0
    IF SprHit(g_pCoreS + (CoreFrame() * 56 * 56 * 4), 56, 56, INT(g_bsX) - 28, INT(g_bsY) - 28, INT(g_pbX[i]), INT(g_pbY[i])) = 1 THEN RETURN BossGate()
    RETURN 0
ENDSUB

' an arc of shots over the lower half; fflip = 1 shifts it half a step so two arcs interlock
SUB BossArc(n:INT, spd:FLOAT, fflip:INT)
    INT k
    FLOAT a
    FOR k = 0 TO n - 1
        a = 3.14159 * (FLOAT(k) + 0.5 + (0.5 * FLOAT(fflip))) / FLOAT(n)
        BossShot(g_bsX, g_bsY + 8.0, COS(a) * spd, (SIN(a) * spd) + 0.2)
    NEXT k
    PlaySfx(5)
ENDSUB

SUB UpdateCoreAI(ph:INT)
    INT pace
    FLOAT tgx, tgy

    g_rkA = g_rkA + 0.022 + (0.008 * FLOAT(ph))
    g_bsSwA = g_bsSwA + 0.007 + (0.0025 * FLOAT(ph))
    tgx = 112.0 + (58.0 * SIN(g_bsSwA))
    tgy = 84.0 + (5.0 * SIN(FLOAT(g_bsT) * 0.04))
    g_bsX = g_bsX + ((tgx - g_bsX) * 0.05)
    g_bsY = g_bsY + ((tgy - g_bsY) * 0.05)
    IF g_palive = 0 THEN RETURN

    pace = BossPace()
    ' lava drops from the top
    IF ph >= 1 AND (g_bsT % ((34 * pace) / 100)) = 0 THEN BossShot(8.0 + RND(208.0), 34.0, 0.0, 2.0)
    ' spiral stream (two arms in the last phase)
    IF ph >= 1 AND (g_bsT % ((8 * pace) / 100)) = 0 THEN
        g_bsSpA = g_bsSpA + 0.55
        BossShot(g_bsX, g_bsY + 8.0, COS(g_bsSpA) * 1.5, (ABS(SIN(g_bsSpA)) * 1.5) + 0.5)
        IF ph = 2 THEN BossShot(g_bsX, g_bsY + 8.0, COS(g_bsSpA + 3.14159) * 1.5, (ABS(SIN(g_bsSpA + 3.14159)) * 1.5) + 0.5)
    ENDIF
    IF ph = 2 AND g_diff > 0 AND (g_bsT % 60) = 0 THEN BossAim(g_bsX, g_bsY + 10.0, 2.2)

    g_bsAtk = g_bsAtk - 1
    IF g_bsAtk <= 0 THEN
        g_bsFlip = 1 - g_bsFlip
        BossArc(9, 1.4, g_bsFlip)
        IF ph = 0 THEN g_bsAtk = (90 * pace) / 100
        IF ph = 1 THEN g_bsAtk = (110 * pace) / 100
        IF ph = 2 THEN g_bsAtk = (85 * pace) / 100
    ENDIF
ENDSUB

SUB DrawSpr(pSrc:POINTER, w:INT, h:INT, dx:INT, dy:INT, flash:INT)
    INT x, y, col
    FOR y = 0 TO h - 1
        FOR x = 0 TO w - 1
            col = *<INT>(pSrc + (((y * w) + x) * 4))
            IF col <> 0 THEN
                IF flash > 0 THEN col = (((col & 0x00FEFEFE) >> 1) + 0x00808080) | 0xFF000000
                PutPix(dx + x, dy + y, col)
            ENDIF
        NEXT x
    NEXT y
ENDSUB

' a gold medal on a red and blue ribbon, 10 x 14 pixels, centred on the disc (cx, cy) - drawn in code, flat facets and a dither
SUB DrawMedal(cx:INT, cy:INT)
    INT r, dx, dy, d2, c
    IF g_pMedal <> 0 THEN
        DrawSpr(g_pMedal, 24, 24, cx - 12, cy - 12, 0)
        RETURN
    ENDIF
    FOR r = 0 TO 4
        PutPix(cx - 4 + (r / 2), cy - 9 + r, 0xFFD83030)
        PutPix(cx - 3 + (r / 2), cy - 9 + r, 0xFFE85848)
        PutPix(cx + 4 - (r / 2), cy - 9 + r, 0xFF3050D8)
        PutPix(cx + 3 - (r / 2), cy - 9 + r, 0xFF5878F0)
    NEXT r
    FOR dy = -4 TO 4
        FOR dx = -4 TO 4
            d2 = (dx * dx) + (dy * dy)
            IF d2 <= 19 THEN
                IF d2 > 12 THEN
                    c = 0xFF8A5A10                                    ' rim
                ELSEIF (dx + dy) < -1 THEN
                    c = 0xFFFFE878                                    ' lit side
                ELSEIF (dx + dy) > 2 THEN
                    c = 0xFFC88A20                                    ' shaded side
                ELSEIF ((dx + dy) & 1) = 0 THEN
                    c = 0xFFFFD84A
                ELSE
                    c = 0xFFE0A830
                ENDIF
                PutPix(cx + dx, cy + dy, c)
            ENDIF
        NEXT dx
    NEXT dy
    PutPix(cx, cy - 2, 0xFFFFF8C8)                                    ' a little star in the middle
    PutPix(cx - 1, cy - 1, 0xFFFFF8C8)
    PutPix(cx, cy - 1, 0xFFFFF8C8)
    PutPix(cx + 1, cy - 1, 0xFFFFF8C8)
    PutPix(cx - 1, cy, 0xFFFFF8C8)
    PutPix(cx + 1, cy, 0xFFFFF8C8)
    PutPix(cx - 1, cy + 1, 0xFFFFF8C8)
    PutPix(cx + 1, cy + 1, 0xFFFFF8C8)
ENDSUB

' the bonus ending: hearts float up over the portrait (clipped to the painting)
SUB PcLove(ox:INT, oy:INT)
    INT i, t, hx, hy, r, c
    FOR i = 0 TO 4
        t = ((g_tick / 2) + (i * 37)) % 110
        hx = ox + 30 + (i * 33) + INT(4.0 * SIN(FLOAT(t) * 0.12))
        hy = oy + 104 - t
        FOR r = 0 TO 5
            FOR c = 0 TO 6
                IF r = 0 THEN
                    IF c = 1 OR c = 2 OR c = 4 OR c = 5 THEN PcPix(hx + c, hy + r, 0xFFFF5878)
                ELSEIF r = 1 OR r = 2 THEN
                    PcPix(hx + c, hy + r, 0xFFE03050)
                ELSEIF r = 3 THEN
                    IF c >= 1 AND c <= 5 THEN PcPix(hx + c, hy + r, 0xFFE03050)
                ELSEIF r = 4 THEN
                    IF c >= 2 AND c <= 4 THEN PcPix(hx + c, hy + r, 0xFFC02040)
                ELSE
                    IF c = 3 THEN PcPix(hx + c, hy + r, 0xFFC02040)
                ENDIF
            NEXT c
        NEXT r
    NEXT i
ENDSUB

' an enemy jet of the planetary defence: the fighter sprite (nose up in the sheet) drawn upside down, nose pointing at the player
SUB DrawJet(k:INT, cx:INT, cy:INT)
    INT x, y, col
    POINTER p
    IF g_pFleet = 0 THEN RETURN
    p = g_pFleet + (k * 624 * 4)
    FOR y = 0 TO 25
        FOR x = 0 TO 23
            col = *<INT>(p + (((25 - y) * 24) + x) * 4)
            IF col <> 0 THEN PutPix(cx - 12 + x, cy - 13 + y, col)
        NEXT x
    NEXT y
ENDSUB

SUB DrawCore(cx:INT, cy:INT, flash:INT)
    INT fi
    POINTER pf
    IF g_pCoreS = 0 THEN
        DrawCoreVec(cx, cy, flash)
        RETURN
    ENDIF
    fi = CoreFrame()
    pf = g_pCoreS + (fi * 56 * 56 * 4)
    DrawSpr(pf, 56, 56, cx - 28, cy - 28, flash)
ENDSUB

SUB DrawRock(cx:INT, cy:INT, hp:INT)
    POINTER pf
    IF g_pRockS = 0 THEN
        DrawRockVec(cx, cy, hp)
        RETURN
    ENDIF
    pf = g_pRockS
    IF hp <= 2 THEN pf = g_pRockS + (16 * 16 * 4)
    DrawSpr(pf, 16, 16, cx - 8, cy - 8, 0)
ENDSUB

SUB DrawCoreVec(cx:INT, cy:INT, flash:INT)
    INT dx, dy, col, a
    FLOAT d, rad, pulse

    pulse = 2.0 * SIN(FLOAT(g_tick) * 0.1)
    rad = 19.0 + pulse
    FOR dy = -27 TO 27
        FOR dx = -27 TO 27
            d = SQRT(FLOAT((dx * dx) + (dy * dy)))
            IF d <= rad THEN
                col = 0xFFB42814
                IF d < 16.0 THEN col = 0xFFFF6E1E
                IF d < 11.0 THEN col = 0xFFFFB428
                IF d < 6.0 THEN col = 0xFFFFF0A0
                IF d > 7.0 AND (((dx * 3) + (dy * 5)) % 11) = 0 THEN col = 0xFF501408        ' cracks
                IF d > rad - 1.5 THEN col = 0xFF501408
                IF ABS(FLOAT(dx)) < 2.0 AND ABS(FLOAT(dy)) < 5.0 THEN col = 0xFF200808        ' the slit of an eye
                IF flash > 0 AND d < 16.0 THEN col = 0xFFFFFFFF
                PutPix(cx + dx, cy + dy, col)
            ELSEIF d < rad + 7.0 THEN
                a = INT((rad + 7.0 - d) * 12.0)
                BlendPix(cx + dx, cy + dy, 0xFFFF6E1E, a)
            ENDIF
        NEXT dx
    NEXT dy
ENDSUB

SUB DrawRockVec(cx:INT, cy:INT, hp:INT)
    INT dx, dy, col, d2, lump
    FOR dy = -6 TO 6
        FOR dx = -6 TO 6
            d2 = (dx * dx) + (dy * dy)
            lump = 0
            IF d2 > 16 AND (((dx * 5) + (dy * 3)) % 7) = 0 THEN lump = 1
            IF d2 <= 36 AND lump = 0 THEN
                col = 0xFF503C32
                IF (dx + dy) < -2 THEN col = 0xFF785A46
                IF (dx + dy) > 3 THEN col = 0xFF281E1E
                IF hp <= 2 AND (dx = 0 OR dy = 0) AND d2 < 12 THEN col = 0xFFFF6E1E          ' about to break: glowing cracks
                PutPix(cx + dx, cy + dy, col)
            ENDIF
        NEXT dx
    NEXT dy
ENDSUB

' ---- hive queen (kind 2): hatches spiders from her abdomen and spits acid --------------------------------------------
' a spider that dives out of the queen (the same kind of flight as the fragments of a splitter)
SUB BossSpider()
    INT f, dirF
    FLOAT tx
    FOR f = 0 TO 39
        IF g_eState[f] = ES_DEAD THEN
            dirF = 1
            IF RND(2.0) < 1.0 THEN dirF = -1
            tx = g_px + (RND(80.0) - 40.0)
            g_eType[f] = 3
            g_eHp[f] = 1
            g_eRow[f] = 0
            g_eCol[f] = 0
            g_eEsc[f] = -1
            g_eShots[f] = 9
            g_eX[f] = g_bsX
            g_eY[f] = g_bsY - 6.0
            g_eAng[f] = 0.0
            BuildDiveT(f, 3, g_bsX, g_bsY - 6.0, tx, dirF)
            g_ePos[f] = 0.0
            g_eSpeed[f] = (1.7 + (0.04 * FLOAT(g_stage))) * DiffDiveSpeed()
            g_eState[f] = ES_DIVE
            RETURN
        ENDIF
    NEXT f
ENDSUB

SUB UpdateQueenAI(ph:INT)
    INT n, capM, pace
    FLOAT tgx, tgy

    g_bsSwA = g_bsSwA + 0.009 + (0.003 * FLOAT(ph))
    tgx = 112.0 + (60.0 * SIN(g_bsSwA))
    tgy = 74.0 + (6.0 * SIN(FLOAT(g_bsT) * 0.05))
    g_bsX = g_bsX + ((tgx - g_bsX) * 0.05)
    g_bsY = g_bsY + ((tgy - g_bsY) * 0.05)
    UpdateHiveGuards(ph)
    IF g_palive = 0 THEN RETURN

    pace = BossPace()
    ' eggs: a spider every so often, never too many at once
    g_bsSp = g_bsSp - 1
    IF g_bsSp <= 0 THEN
        n = CountState(ES_DIVE)
        capM = 2 + ph
        IF g_diff = 0 THEN capM = capM - 1
        IF n < capM THEN BossSpider()
        g_bsSp = ((140 - (20 * ph)) * pace) / 100
    ENDIF
    ' acid rain
    IF ph >= 1 AND (g_bsT % ((40 * pace) / 100)) = 0 THEN BossShot(8.0 + RND(208.0), 34.0, 0.0, 1.9)
    ' spit
    g_bsAtk = g_bsAtk - 1
    IF g_bsAtk <= 0 THEN
        IF ph = 0 THEN BossFan(3, 0.5, 1.5)
        IF ph = 1 THEN BossFan(5, 0.45, 1.7)
        IF ph = 2 THEN BossFan(7, 0.4, 1.9)
        IF ph >= 1 AND g_diff > 0 THEN BossAim(g_bsX, g_bsY + 26.0, 2.0)
        g_bsAtk = ((100 - (15 * ph)) * pace) / 100
    ENDIF
ENDSUB

SUB DrawSeg(x0:INT, y0:INT, x1:INT, y1:INT, col:INT)
    INT k, n, adx, ady
    adx = x1 - x0
    IF adx < 0 THEN adx = 0 - adx
    ady = y1 - y0
    IF ady < 0 THEN ady = 0 - ady
    n = adx
    IF ady > n THEN n = ady
    IF n < 1 THEN n = 1
    FOR k = 0 TO n
        PutPix(x0 + (((x1 - x0) * k) / n), y0 + (((y1 - y0) * k) / n), col)
    NEXT k
ENDSUB

SUB DrawQueen(cx:INT, cy:INT, flash:INT)
    POINTER pf
    IF g_pQueenS = 0 THEN
        DrawQueenVec(cx, cy, flash)
        RETURN
    ENDIF
    pf = g_pQueenS + (QueenFrame() * 84 * 64 * 4)
    DrawSpr(pf, 64, 84, cx - 32, cy - 44, flash)
ENDSUB

SUB DrawQueenVec(cx:INT, cy:INT, flash:INT)
    INT dx, dy, adx, col, ins, j, wx, wy, egg
    FLOAT ry, wig

    egg = 0
    IF g_bsSp < 30 AND g_bsDying = 0 THEN egg = 1
    ' wings: pale and translucent, fluttering
    ry = 7.0 + (3.0 * SIN(FLOAT(g_tick) * 0.3))
    FOR wy = -12 TO 12
        FOR wx = -17 TO 17
            IF ((FLOAT(wx * wx) / 289.0) + ((FLOAT(wy * wy)) / (ry * ry * 1.5))) <= 1.0 THEN
                BlendPix(cx - 22 + wx, cy - 10 + wy, 0xFFC8FFC8, 80)
                BlendPix(cx + 22 + wx, cy - 10 + wy, 0xFFC8FFC8, 80)
            ENDIF
        NEXT wx
    NEXT wy
    ' legs
    FOR j = 0 TO 2
        wig = 3.0 * SIN((FLOAT(g_tick) * 0.12) + FLOAT(j * 2))
        DrawSeg(cx - 8, cy + 2 + (4 * j), cx - 22, cy - 4 + (10 * j) + INT(wig), 0xFF2D6E1E)
        DrawSeg(cx - 22, cy - 4 + (10 * j) + INT(wig), cx - 30, cy + 4 + (13 * j), 0xFF2D6E1E)
        DrawSeg(cx + 8, cy + 2 + (4 * j), cx + 22, cy - 4 + (10 * j) - INT(wig), 0xFF2D6E1E)
        DrawSeg(cx + 22, cy - 4 + (10 * j) - INT(wig), cx + 30, cy + 4 + (13 * j), 0xFF2D6E1E)
    NEXT j
    ' body
    FOR dy = -36 TO 32
        FOR dx = -16 TO 16
            adx = dx
            IF adx < 0 THEN adx = 0 - adx
            ins = 0
            col = 0xFF4BAA32
            IF ((FLOAT(dx * dx) / 225.0) + (FLOAT((dy + 14) * (dy + 14)) / 400.0)) <= 1.0 THEN
                ins = 1                                                     ' abdomen
                IF ((dy + 40) % 7) = 0 THEN col = 0xFF2D6E1E
                IF ((dx * 5) + (dy * 7)) % 17 = 0 THEN
                    col = 0xFFB4E650
                    IF egg = 1 AND ((g_tick / 4) % 2) = 0 THEN col = 0xFFFFE132
                ENDIF
            ENDIF
            IF ((FLOAT(dx * dx) / 100.0) + (FLOAT((dy - 8) * (dy - 8)) / 81.0)) <= 1.0 THEN
                ins = 1                                                     ' thorax
                col = 0xFF2D7D23
            ENDIF
            IF ((FLOAT(dx * dx) / 81.0) + (FLOAT((dy - 20) * (dy - 20)) / 49.0)) <= 1.0 THEN
                ins = 1                                                     ' head
                col = 0xFF3C8C2D
                IF dy >= 19 AND dy <= 21 AND adx >= 4 AND adx <= 6 THEN col = 0xFFFF3C3C
            ENDIF
            IF dy >= 25 AND dy <= 29 AND adx = (3 + (dy - 25)) THEN          ' mandibles
                ins = 1
                col = 0xFFFFDC3C
            ENDIF
            IF ins = 1 THEN
                IF flash > 0 THEN col = 0xFFE8FFD0
                PutPix(cx + dx, cy + dy, col)
            ENDIF
        NEXT dx
    NEXT dy
ENDSUB

' ---- empire flagship (kind 3): four turrets, then the hatch opens on the core; the beam sweeps in the last phase ---------
SUB TuX(k:INT), FLOAT
    IF k = 0 THEN RETURN 0.0 - 42.0
    IF k = 1 THEN RETURN 0.0 - 18.0
    IF k = 2 THEN RETURN 18.0
    RETURN 42.0
ENDSUB

SUB TuY(k:INT), FLOAT
    IF k = 0 OR k = 3 THEN RETURN 12.0
    RETURN 18.0
ENDSUB

SUB UpdateFlagAI(ph:INT)
    INT k, alive, pace, cyc, cycLen
    FLOAT tgx, tgy

    alive = 0
    FOR k = 0 TO 3
        IF g_tuHp[k] > 0 THEN alive = alive + 1
    NEXT k
    IF alive = 0 AND g_fsOpen < 40 THEN
        g_fsOpen = g_fsOpen + 1
        IF g_fsOpen = 1 THEN PlaySfx(6)
    ENDIF

    g_bsSwA = g_bsSwA + 0.008 + (0.002 * FLOAT(ph))
    tgx = 112.0 + (46.0 * SIN(g_bsSwA))
    tgy = 70.0 + (4.0 * SIN(FLOAT(g_bsT) * 0.04))
    g_bsX = g_bsX + ((tgx - g_bsX) * 0.05)
    g_bsY = g_bsY + ((tgy - g_bsY) * 0.05)
    g_fsBP = -1
    IF g_palive = 0 THEN RETURN

    pace = BossPace()
    ' turrets: aimed shots, a little faster as their number drops
    FOR k = 0 TO 3
        IF g_tuHp[k] > 0 THEN
            g_tuCd[k] = g_tuCd[k] - 1
            IF g_tuCd[k] <= 0 THEN
                BossAim(g_bsX + TuX(k), g_bsY + TuY(k) + 6.0, 2.0)
                g_tuCd[k] = (((130 - (12 * (4 - alive))) * pace) / 100) + (k * 7)
            ENDIF
        ENDIF
    NEXT k

    ' the core: fans, and in the last phase a beam that locks on to where the ship was
    IF g_fsOpen >= 30 THEN
        g_bsAtk = g_bsAtk - 1
        IF g_bsAtk <= 0 THEN
            IF ph < 2 THEN
                BossFan(5, 0.5, 1.7)
            ELSE
                BossFan(7, 0.4, 1.9)
                IF g_diff > 0 THEN BossAim(g_bsX, g_bsY + 14.0, 2.3)
            ENDIF
            g_bsAtk = ((85 - (10 * ph)) * pace) / 100
        ENDIF
        IF ph = 2 THEN
            g_fsBeam = g_fsBeam + 1
            cycLen = (260 * pace) / 100
            cyc = g_fsBeam % cycLen
            IF cyc = 0 THEN g_fsBX = g_px
            IF cyc < 100 THEN g_fsBP = cyc
            IF g_fsBP >= 60 AND g_palive = 1 THEN
                IF ABS(g_px - g_fsBX) < (7.0 + (8.0 * FLOAT(g_dual))) AND g_py > (g_bsY + 14.0) THEN KillPlayer()
            ENDIF
        ENDIF
    ENDIF
ENDSUB

SUB DrawTurret(x:INT, y:INT, hp:INT, flash:INT)
    INT dx, dy, d2, col
    FLOAT ax, ay, d
    POINTER pt
    IF g_pTurS = 0 THEN
    FOR dy = -6 TO 6
        FOR dx = -6 TO 6
            d2 = (dx * dx) + (dy * dy)
            IF d2 <= 36 THEN
                IF hp > 0 THEN
                    col = 0xFF303050
                    IF d2 > 25 THEN col = 0xFF9090C8
                    IF d2 < 5 AND hp <= 2 THEN col = 0xFFFF3C3C
                    IF flash > 0 AND d2 > 25 THEN col = 0xFFFFFFFF
                ELSE
                    col = 0xFF1C1C2C                                    ' a smoking crater
                    IF ((dx * 3) + (dy * 5) + (g_tick / 5)) % 9 = 0 THEN col = 0xFFFF6E1E
                ENDIF
                PutPix(x + dx, y + dy, col)
            ENDIF
        NEXT dx
    NEXT dy
    ELSE
        IF hp > 0 THEN
            DrawSpr(g_pTurS, 16, 16, x - 8, y - 8, flash)
            IF hp <= 2 THEN FillRectSolid(x - 1, y - 1, 3, 3, 0xFFFF3C3C)
        ELSE
            pt = g_pTurS + (16 * 16 * 4)
            DrawSpr(pt, 16, 16, x - 8, y - 8, 0)
            IF ((g_tick / 5) % 3) = 0 THEN PutPix(x - 2 + ((g_tick / 7) % 5), y + ((g_tick / 3) % 3) - 1, 0xFFFF9628)
        ENDIF
    ENDIF
    IF hp > 0 THEN
        ax = g_px - FLOAT(x)
        ay = g_py - FLOAT(y)
        d = SQRT((ax * ax) + (ay * ay))
        IF d < 1.0 THEN d = 1.0
        DrawSeg(x, y, x + INT((ax / d) * 10.0), y + INT((ay / d) * 10.0), 0xFFD23CFF)
        DrawSeg(x + 1, y, x + 1 + INT((ax / d) * 10.0), y + INT((ay / d) * 10.0), 0xFFD23CFF)
    ENDIF
ENDSUB

SUB DrawFlagship(cx:INT, cy:INT, flash:INT)
    INT dy, dx, hw, col, k, half, d2, ex
    IF g_pHullS <> 0 THEN
        DrawSpr(g_pHullS, 120, 56, cx - 60, cy - 26, 0)
    ELSE
    FOR dy = -22 TO 22
        IF dy < 0 THEN
            hw = 30 + (((dy + 22) * 26) / 22)
        ELSEIF dy <= 10 THEN
            hw = 56 - (dy / 2)
        ELSE
            hw = 51 - (((dy - 10) * 17) / 12)
        ENDIF
        col = 0xFF4A4A6E
        IF ((dy + 30) % 6) = 0 THEN col = 0xFF34344E
        FillRectSolid(cx - hw, cy + dy, (2 * hw) + 1, 1, col)
        FillRectSolid(cx - hw, cy + dy, 2, 1, 0xFF8C8CB4)
        FillRectSolid(cx + hw - 1, cy + dy, 2, 1, 0xFF8C8CB4)
    NEXT dy
    FillRectSolid(cx - 34, cy + 22, 69, 2, 0xFFD23CFF)
    FOR k = -5 TO 5
        FillRectSolid(cx + (k * 8) - 1, cy - 8, 3, 2, 0xFFFFE132)
    NEXT k
    ENDIF
    FOR k = 0 TO 3
        ex = cx - 36
        IF k = 1 THEN ex = cx - 18
        IF k = 2 THEN ex = cx + 18
        IF k = 3 THEN ex = cx + 36
        FillRectSolid(ex - 2, cy - 24, 5, 2 + ((g_tick / 3) % 2), 0xFFFF9628)
    NEXT k
    ' the core under its hatch
    IF g_fsOpen > 0 AND g_emRv = 0 THEN
        FOR dy = -9 TO 9
            FOR dx = -9 TO 9
                d2 = (dx * dx) + (dy * dy)
                IF d2 <= 81 THEN
                    col = 0xFFD23CFF
                    IF d2 < 40 THEN col = 0xFFEC8CFF
                    IF d2 < 14 THEN col = 0xFFFFFFFF
                    IF flash > 0 THEN col = 0xFFFFFFFF
                    PutPix(cx + dx, cy + 4 + dy, col)
                ENDIF
            NEXT dx
        NEXT dy
    ENDIF
    half = 11 - ((g_fsOpen * 11) / 40)
    IF half > 0 THEN
        FillRectSolid(cx - 11, cy - 2, half, 13, 0xFF405074)
        FillRectSolid(cx + 11 - half, cy - 2, half, 13, 0xFF405074)
    ENDIF
    FOR k = 0 TO 3
        DrawTurret(cx + INT(TuX(k)), cy + INT(TuY(k)), g_tuHp[k], g_bsFlash)
    NEXT k
ENDSUB

' ---- the Emperor (kind 4): released by the beaten flagship; cannon arm, claw arm, then the reactor --------------------
SUB SetupEmperor()
    INT k
    IF g_diff = 0 THEN
        g_emCa = 6
        g_emCl = 6
        g_emH = 12
    ELSEIF g_diff = 2 THEN
        g_emCa = 12
        g_emCl = 12
        g_emH = 26
    ELSE
        g_emCa = 9
        g_emCl = 9
        g_emH = 18
    ENDIF
    g_bsHp = g_emH + g_emCa + g_emCl                   ' one health meter for the two cannons and the man behind the glass
    g_emCd = 0
    g_emBurst = 0
    g_emAt = 0
    g_emAtT = 0
    g_emIdle = 90
    g_emSeq = 0
    g_emShk = 0
    g_emN = 0
    g_emTrk = 0.0
    g_emMus = 0
    FOR k = 0 TO 2
        g_mtOn[k] = 0
    NEXT k
ENDSUB

' hit points left in the head (the meter also counts the cannons)
SUB EmpHead(), INT
    INT h
    h = g_bsHp
    IF g_emCa > 0 THEN h = h - g_emCa
    IF g_emCl > 0 THEN h = h - g_emCl
    IF h < 0 THEN h = 0
    RETURN h
ENDSUB

' 0 armoured (a cannon still stands), 1 the glass is exposed, 2 rage: the glass has shattered
SUB EmpPhase(), INT
    IF g_emCa > 0 OR g_emCl > 0 THEN RETURN 0
    IF EmpHead() * 3 > g_emH THEN RETURN 1
    RETURN 2
ENDSUB

' the face behind the glass: asleep, lids opening, glaring, screaming
SUB EmpDome(), INT
    INT h
    IF g_emCa > 0 OR g_emCl > 0 THEN RETURN 0
    h = EmpHead() * 3
    IF h <= g_emH THEN RETURN 2
    IF h <= (g_emH * 2) THEN RETURN 1
    RETURN 0
ENDSUB

SUB EmpFaceFrame(), INT
    IF g_emSeq > 0 THEN
        IF g_emSeq < 90 THEN RETURN 0
        IF g_emSeq < 110 THEN RETURN 1
        IF g_emSeq < 135 THEN RETURN 2
        RETURN 3 + ((g_tick / 3) % 2)
    ENDIF
    IF g_bsDying > 0 THEN RETURN 4
    IF g_emAt = 4 THEN
        IF g_emAtT > 4 THEN RETURN 3 + ((g_tick / 3) % 2)
    ENDIF
    IF g_bsFlash > 0 THEN RETURN 3
    RETURN 2
ENDSUB

SUB StartEmpReveal()
    INT k
    g_emRv = 1
    AddScore(5000)
    SpawnPopup(g_bsX, g_bsY, 5000)
    StopMusic()
    PlaySfx(4)
    g_fsBP = -1
    FOR k = 0 TO 31
        g_bbOn[k] = 0
    NEXT k
    FOR k = 0 TO 3
        g_tuHp[k] = 0
    NEXT k
    g_fsOpen = 40
    g_emShk = 14
    SpawnExplosion(g_bsX, g_bsY + 4.0)               ' the core goes up
    SpawnExplosion(g_bsX - 20.0, g_bsY)
    SpawnExplosion(g_bsX + 20.0, g_bsY + 8.0)
ENDSUB

' the flagship crashes, the tank climbs out of the wreck with a sleeping man behind its glass
SUB UpdateEmpReveal()
    INT t, k
    g_emRv = g_emRv + 1
    t = g_emRv
    g_fsBP = -1
    IF g_emShk > 0 THEN g_emShk = g_emShk - 1
    IF t <= 70 THEN
        g_bsX = g_bsX + ((112.0 - g_bsX) * 0.1)               ' the hull comes down on the ground
        g_bsY = g_bsY + ((150.0 - g_bsY) * 0.07)
        IF (t % 7) = 1 THEN SpawnExplosion(g_bsX + RND(100.0) - 50.0, g_bsY + RND(44.0) - 22.0)
        IF (t % 20) = 5 THEN PlaySfx(3)
        IF t = 70 THEN
            g_bsX = 112.0
            g_bsY = 150.0
            g_emShk = 30                                        ' the impact
            PlaySfx(4)
            FOR k = 0 TO 5
                SpawnExplosion(112.0 + RND(120.0) - 60.0, 150.0 + RND(40.0) - 20.0)
            NEXT k
        ENDIF
    ELSEIF t <= 230 THEN
        g_bsX = 112.0
        g_bsY = 150.0
        IF (t % 10) = 0 THEN SpawnExplosion(g_bsX + RND(60.0) - 30.0, g_bsY + 4.0 + RND(12.0))
        IF (t % 40) = 0 THEN
            PlaySfx(3)
            g_emShk = 8                                         ' the tank grinds out of the wreck
        ENDIF
        g_emTrk = g_emTrk + 1.1
    ELSE
        g_bsY = g_bsY + 2.2                                 ' the hull sinks away behind him
        IF (t % 6) = 0 THEN SpawnExplosion(g_bsX + RND(110.0) - 55.0, g_bsY + RND(40.0) - 20.0)
        IF t >= 300 THEN
            g_emRv = 0
            g_bsKind = 4
            SetupEmperor()
            g_bsMax = g_bsHp
            g_bsX = 112.0
            g_bsY = 2.0
            g_bsT = 200
            g_bsPh = 0
            g_bsAtk = 90
            g_bsFlash = 0
            g_bsSwA = 0.0
            g_fsBeam = 0
            g_fsBP = -1
            g_bsSw = 0
            g_emSeq = 1                                     ' the pause: only the sleeping face
            FOR k = 0 TO 31
                g_bbOn[k] = 0
            NEXT k
        ENDIF
    ENDIF
ENDSUB

' the tank arrives on its own (boss shortcut): silence, then the awakening
SUB EmpBeginWake(y0:FLOAT)
    StopMusic()
    g_bsY = y0
    g_bsX = 112.0
    g_bsT = 200
    g_emSeq = 1
ENDSUB

SUB BossAimJ(x:FLOAT, y:FLOAT, spd:FLOAT, jit:FLOAT)
    FLOAT dx, dy, d
    dx = (g_px - x) + ((RND(2.0) - 1.0) * jit)
    dy = g_py - y
    d = SQRT((dx * dx) + (dy * dy))
    IF d < 1.0 THEN d = 1.0
    BossShot(x, y, (dx / d) * spd, (dy / d) * spd)
ENDSUB

SUB EmpRest()
    g_emAt = 0
    g_emAtT = 0
    g_emIdle = (((60 - (12 * EmpPhase())) * BossPace()) / 100) + INT(RND(20.0))
ENDSUB

SUB EmpNext(ph:INT, n:INT), INT
    INT m
    IF ph = 0 THEN
        m = n % 5
        IF m = 0 THEN RETURN 1
        IF m = 1 THEN RETURN 2
        IF m = 2 THEN RETURN 1
        IF m = 3 THEN RETURN 3
        RETURN 2
    ENDIF
    IF ph = 1 THEN
        m = n % 6
        IF m = 0 THEN RETURN 4
        IF m = 1 THEN RETURN 2
        IF m = 2 THEN RETURN 5
        IF m = 3 THEN RETURN 4
        IF m = 4 THEN RETURN 3
        RETURN 5
    ENDIF
    m = n % 7
    IF m = 0 THEN RETURN 4
    IF m = 1 THEN RETURN 6
    IF m = 2 THEN RETURN 5
    IF m = 3 THEN RETURN 3
    IF m = 4 THEN RETURN 4
    IF m = 5 THEN RETURN 6
    RETURN 5
ENDSUB

' the awakening: he sleeps, the lids lift, the eyes burn red and he screams
SUB EmpWake()
    INT t, k
    IF g_bsY < 1.9 THEN
        g_bsY = g_bsY + 2.4                              ' still rolling in
        g_emTrk = g_emTrk + 2.4
        IF g_bsY > 2.0 THEN g_bsY = 2.0
        g_emSeq = 1
        RETURN
    ENDIF
    g_emSeq = g_emSeq + 1
    t = g_emSeq
    IF t < 90 THEN
        g_bsY = 2.6 + (0.6 * SIN(FLOAT(t) * 0.3))        ' a low engine idle (never above the rest line, or it would look like still rolling in)
        IF (t % 30) = 0 THEN g_emShk = 2
    ENDIF
    IF t = 90 THEN PlaySfx(6)
    IF t = 110 THEN
        g_bsFlash = 3
        PlaySfx(5)
    ENDIF
    IF t = 135 THEN
        g_bsFlash = 4
        g_emShk = 40
        PlaySfx(4)
        FOR k = 0 TO 31
            g_bbOn[k] = 0
        NEXT k
        PlayMusic(15, 0)                                  ' the warning again, then the boss theme
        g_emMus = 130
    ENDIF
    IF t > 135 AND t < 185 THEN
        IF (t % 8) = 0 THEN g_emShk = 6
    ENDIF
    IF t >= 190 THEN
        g_emSeq = 0
        g_emIdle = 50
        g_emAt = 0
    ENDIF
ENDSUB

' twin autocannons sweep two crossing fans
SUB EmpSweep()
    INT t
    FLOAT a
    t = g_emAtT
    IF (t % 7) = 0 AND t < 98 THEN
        a = 0.95 + (1.24 * FLOAT(t) / 98.0)
        IF g_emCa > 0 THEN BossShot(g_bsX - 17.0, g_bsY + 78.0, COS(a) * 2.1, SIN(a) * 2.1)
        IF g_emCl > 0 THEN BossShot(g_bsX + 17.0, g_bsY + 78.0, COS(3.14159 - a) * 2.1, SIN(3.14159 - a) * 2.1)
        g_emBurst = 4
        IF (t % 14) = 0 THEN PlaySfx(5)
    ENDIF
    IF t >= 110 THEN EmpRest()
ENDSUB

' shoulder mortars: a marked circle on the ground, the shell falls, it bursts
SUB EmpMortarAtk(ph:INT)
    INT t, k, f
    t = g_emAtT
    IF t = 1 OR t = 16 OR t = 31 THEN
        f = -1
        FOR k = 0 TO 2
            IF g_mtOn[k] = 0 THEN f = k
        NEXT k
        IF f >= 0 THEN
            g_mtOn[f] = 1
            g_mtT[f] = 0
            g_mtX[f] = g_px + RND(40.0) - 20.0
            g_mtY[f] = g_py + RND(24.0) - 22.0
            IF g_mtX[f] < 12.0 THEN g_mtX[f] = 12.0
            IF g_mtX[f] > 212.0 THEN g_mtX[f] = 212.0
            IF g_mtY[f] < 150.0 THEN g_mtY[f] = 150.0
            IF g_mtY[f] > 270.0 THEN g_mtY[f] = 270.0
            PlaySfx(5)
        ENDIF
    ENDIF
    IF t >= 70 THEN EmpRest()
ENDSUB

' the charge: it locks onto where you stand, then rolls down the screen
SUB EmpRam()
    INT t
    FLOAT v
    t = g_emAtT
    IF t < 30 THEN
        g_bsX = g_bsX + ((g_px - g_bsX) * 0.07)
        IF g_bsX < 52.0 THEN g_bsX = 52.0
        IF g_bsX > 172.0 THEN g_bsX = 172.0
        g_emTrk = g_emTrk + 0.8
        g_fsBX = g_bsX
    ELSEIF t < 55 THEN
        g_bsX = g_fsBX
        g_emTrk = g_emTrk + 1.5
        IF (t % 4) = 0 THEN g_emShk = 2
    ELSE
        g_bsX = g_fsBX
        IF g_bsSw = 0 THEN
            g_bsSw = 1
            PlaySfx(6)
        ENDIF
        IF g_bsSw = 1 THEN
            v = 0.3 * FLOAT(t - 54)
            IF v > 7.0 THEN v = 7.0
            g_bsY = g_bsY + v
            g_emTrk = g_emTrk + v
            IF g_bsY >= 190.0 THEN
                g_bsY = 190.0
                g_bsSw = 2
                g_emShk = 24
                PlaySfx(4)
                SpawnExplosion(g_bsX - 24.0, g_bsY + 78.0)
                SpawnExplosion(g_bsX + 24.0, g_bsY + 78.0)
                SpawnExplosion(g_bsX, g_bsY + 82.0)
            ENDIF
        ELSE
            g_bsY = g_bsY - 3.2
            g_emTrk = g_emTrk + 3.2
            IF g_bsY <= 4.0 THEN
                g_bsY = 4.0
                g_bsSw = 0
                EmpRest()
            ENDIF
        ENDIF
        IF g_palive = 1 THEN
            IF ABS(g_px - g_bsX) < (46.0 + (8.0 * FLOAT(g_dual))) AND g_py > (g_bsY + 6.0) AND g_py < (g_bsY + 84.0) THEN KillPlayer()
        ENDIF
    ENDIF
ENDSUB

' his scream: expanding rings of red shots, each with a gap
SUB EmpScream(ph:INT)
    INT t, sp, nr, r, k
    FLOAT gap, a, ofs, my
    t = g_emAtT
    sp = 24
    nr = 3
    IF ph = 2 THEN
        sp = 17
        nr = 4
    ENDIF
    my = g_bsY + 33.0
    IF t >= 10 THEN
        IF ((t - 10) % sp) = 0 THEN
            r = (t - 10) / sp
            IF r < nr THEN
                gap = GlAtan2(g_py - my, g_px - g_bsX) + RND(0.6) - 0.3
                ofs = 0.26 * FLOAT(r % 2)
                FOR k = 0 TO 11
                    a = (0.5236 * FLOAT(k)) + ofs
                    IF COS(a - gap) < 0.955 THEN BossShot(g_bsX, my, COS(a) * 2.0, SIN(a) * 2.0)
                NEXT k
                g_emShk = 6
                PlaySfx(4)
            ENDIF
        ENDIF
    ENDIF
    IF t >= 10 + (sp * nr) + 30 THEN EmpRest()
ENDSUB

' the eyes burn: two red beams sweep across the field
SUB EmpEyes(ph:INT)
    INT t
    FLOAT s, ey, d, pr
    t = g_emAtT
    ey = g_bsY + 25.0
    IF t <= 40 THEN
        g_emY0 = GlAtan2(g_py - ey, g_px - g_bsX)         ' aiming: the angle is locked at t = 40
        g_ebA1 = g_emY0
        g_ebA2 = g_emY0
        IF t = 1 THEN PlaySfx(6)
    ELSEIF t <= 150 THEN
        s = FLOAT(t - 40) / 110.0
        g_ebA1 = g_emY0 - 0.5 + (1.0 * s)
        g_ebA2 = g_ebA1
        IF ph = 2 THEN g_ebA2 = g_emY0 + 0.5 - (1.0 * s)
        IF (t % 20) = 0 THEN PlaySfx(5)
        IF t >= 48 AND g_palive = 1 THEN
            d = ABS(((g_px - (g_bsX - 6.0)) * SIN(g_ebA1)) - ((g_py - ey) * COS(g_ebA1)))
            pr = ((g_px - (g_bsX - 6.0)) * COS(g_ebA1)) + ((g_py - ey) * SIN(g_ebA1))
            IF d < (4.0 + (4.0 * FLOAT(g_dual))) AND pr > 0.0 THEN KillPlayer()
            d = ABS(((g_px - (g_bsX + 6.0)) * SIN(g_ebA2)) - ((g_py - ey) * COS(g_ebA2)))
            pr = ((g_px - (g_bsX + 6.0)) * COS(g_ebA2)) + ((g_py - ey) * SIN(g_ebA2))
            IF d < (4.0 + (4.0 * FLOAT(g_dual))) AND pr > 0.0 THEN KillPlayer()
        ENDIF
    ELSE
        EmpRest()
    ENDIF
ENDSUB

' rage: the tank sprays burning shots out of its front corners
SUB EmpFlames()
    INT t
    FLOAT a
    t = g_emAtT
    IF (t % 5) = 0 AND t < 110 THEN
        a = 1.5708 + (0.85 * SIN(FLOAT(t) * 0.07))
        BossShot(g_bsX - 27.0, g_bsY + 68.0, COS(a + RND(0.2) - 0.1) * 2.6, SIN(a + RND(0.2) - 0.1) * 2.6)
        a = 1.5708 - (0.85 * SIN(FLOAT(t) * 0.07 + 1.3))
        BossShot(g_bsX + 27.0, g_bsY + 68.0, COS(a + RND(0.2) - 0.1) * 2.6, SIN(a + RND(0.2) - 0.1) * 2.6)
        IF (t % 20) = 0 THEN PlaySfx(5)
    ENDIF
    IF t >= 125 THEN EmpRest()
ENDSUB

SUB UpdateMortars()
    INT k, t
    FOR k = 0 TO 2
        IF g_mtOn[k] = 1 THEN
            g_mtT[k] = g_mtT[k] + 1
            t = g_mtT[k]
            IF g_gstate = GS_PDEAD OR g_bsDying > 0 THEN
                g_mtOn[k] = 0
            ELSE
                IF t = 56 THEN
                    PlaySfx(3)
                    SpawnExplosion(g_mtX[k], g_mtY[k])
                ENDIF
                IF t >= 56 AND t <= 66 AND g_palive = 1 THEN
                    IF ABS(g_px - g_mtX[k]) < (17.0 + (6.0 * FLOAT(g_dual))) AND ABS(g_py - g_mtY[k]) < 17.0 THEN KillPlayer()
                ENDIF
                IF t > 66 THEN g_mtOn[k] = 0
            ENDIF
        ENDIF
    NEXT k
ENDSUB

SUB UpdateEmpAI()
    INT ph, pace
    FLOAT tgx, dx

    IF g_emMus > 0 THEN
        g_emMus = g_emMus - 1
        IF g_emMus = 0 THEN PlayMusic(9, 1)
    ENDIF
    IF g_emShk > 0 THEN g_emShk = g_emShk - 1
    IF g_emBurst > 0 THEN g_emBurst = g_emBurst - 1
    g_fsBP = -1
    UpdateMortars()
    IF g_emSeq > 0 THEN
        EmpWake()
        RETURN
    ENDIF
    IF g_palive = 0 THEN
        IF g_emAt = 3 THEN
            g_bsY = g_bsY - 2.4                              ' the ship is down: the tank backs off
            IF g_bsY <= 4.0 THEN
                g_bsY = 4.0
                g_bsSw = 0
                EmpRest()
            ENDIF
        ENDIF
        RETURN
    ENDIF
    pace = BossPace()
    ph = EmpPhase()
    g_emTrk = g_emTrk + 0.35

    ' the tank sways from side to side (it does not while it charges)
    IF g_emAt <> 3 THEN
        g_bsSwA = g_bsSwA + 0.006 + (0.003 * FLOAT(ph))
        tgx = 112.0 + (38.0 * SIN(g_bsSwA))
        dx = (tgx - g_bsX) * 0.08
        g_bsX = g_bsX + dx
        g_emTrk = g_emTrk + (ABS(dx) * 1.5)
        g_bsY = 2.0 + (2.0 * SIN(FLOAT(g_bsT) * 0.06))
    ENDIF

    IF g_emAt = 0 THEN
        g_emIdle = g_emIdle - 1
        IF g_emIdle <= 0 THEN
            g_emAt = EmpNext(ph, g_emN)
            g_emN = g_emN + 1
            g_emAtT = 0
        ENDIF
        RETURN
    ENDIF
    g_emAtT = g_emAtT + 1
    IF g_emAt = 1 THEN
        EmpSweep()
    ELSEIF g_emAt = 2 THEN
        EmpMortarAtk(ph)
    ELSEIF g_emAt = 3 THEN
        EmpRam()
    ELSEIF g_emAt = 4 THEN
        EmpScream(ph)
    ELSEIF g_emAt = 5 THEN
        EmpEyes(ph)
    ELSE
        EmpFlames()
    ENDIF
ENDSUB

' a sprite whose rows below maxY (screen line) are left out: it grows out of a hatch
SUB DrawSprClip(pSrc:POINTER, w:INT, h:INT, dx:INT, dy:INT, flash:INT, maxY:INT)
    INT x, y, col
    FOR y = 0 TO h - 1
        IF dy + y <= maxY THEN
            FOR x = 0 TO w - 1
                col = *<INT>(pSrc + (((y * w) + x) * 4))
                IF col <> 0 THEN
                    IF flash > 0 THEN col = (((col & 0x00FEFEFE) >> 1) + 0x00808080) | 0xFF000000
                    PutPix(dx + x, dy + y, col)
                ENDIF
            NEXT x
        ENDIF
    NEXT y
ENDSUB

' the tank, seen from above and facing down: x is its centre, top the top of the hull
SUB DrawTank(x:INT, top:INT, flash:INT, maxY:INT, face:INT, dome:INT)
    INT tr, ay
    IF g_pTkH = 0 THEN RETURN
    tr = (INT(g_emTrk) / 3) % 4
    DrawSprClip(g_pTkL + (tr * 14 * 80 * 4), 14, 80, x - 42, top + 2, flash, maxY)
    DrawSprClip(g_pTkR + (tr * 14 * 80 * 4), 14, 80, x + 28, top + 2, flash, maxY)
    DrawSprClip(g_pTkH, 56, 72, x - 28, top, flash, maxY)
    ay = top + 48
    IF g_emBurst > 0 THEN ay = ay + 2
    IF g_emCa > 0 THEN
        DrawSprClip(g_pTkC, 16, 30, x - 25, ay, flash, maxY)
    ELSE
        DrawSprClip(g_pTkC + (16 * 30 * 4), 16, 30, x - 25, top + 48, flash, maxY)
    ENDIF
    IF g_emCl > 0 THEN
        DrawSprClip(g_pTkC, 16, 30, x + 9, ay, flash, maxY)
    ELSE
        DrawSprClip(g_pTkC + (16 * 30 * 4), 16, 30, x + 9, top + 48, flash, maxY)
    ENDIF
    DrawSprClip(g_pTkF + (face * 28 * 30 * 4), 28, 30, x - 14, top + 10, 0, maxY)
    DrawSprClip(g_pTkD + (dome * 36 * 36 * 4), 36, 36, x - 18, top + 7, flash, maxY)
ENDSUB

SUB DrawBeamLine(ex:INT, ey:INT, ang:FLOAT, active:INT)
    INT x1, y1
    x1 = ex + INT(COS(ang) * 330.0)
    y1 = ey + INT(SIN(ang) * 330.0)
    IF active = 0 THEN
        IF ((g_tick / 2) % 2) = 0 THEN DrawSeg(ex, ey, x1, y1, 0xFF9C1C28)
    ELSE
        DrawSeg(ex - 1, ey, x1 - 1, y1, 0xFFFF3C3C)
        DrawSeg(ex + 1, ey, x1 + 1, y1, 0xFFFF3C3C)
        DrawSeg(ex, ey, x1, y1, 0xFFFFE8E8)
    ENDIF
ENDSUB

' effects around the tank: the awakening shockwave, eye beams, charge lanes, flame glow, mortar shells
SUB DrawEmpFx()
    INT k, t, cx, top, r, mx, my, sy, col
    cx = INT(g_bsX)
    top = INT(g_bsY)
    ' shockwave of the first scream
    IF g_emSeq > 135 THEN
        r = (g_emSeq - 135) * 5
        IF r < 260 THEN
            DrawOval(cx, top + 33, r, r, 0xFFFF6070)
            IF r > 8 THEN DrawOval(cx, top + 33, r - 6, r - 6, 0xFFFFE0E0)
        ENDIF
    ENDIF
    IF g_emSeq = 0 THEN
        t = g_emAtT
        IF g_emAt = 5 THEN
            IF t <= 40 THEN
                IF ((t / 3) % 2) = 0 THEN
                    FillRectSolid(cx - 8, top + 24, 5, 2, 0xFFFF6070)
                    FillRectSolid(cx + 3, top + 24, 5, 2, 0xFFFF6070)
                ENDIF
                DrawBeamLine(cx - 6, top + 25, g_ebA1, 0)
                DrawBeamLine(cx + 6, top + 25, g_ebA2, 0)
            ELSEIF t > 40 THEN
                FillRectSolid(cx - 8, top + 24, 5, 2, 0xFFFFE0E0)
                FillRectSolid(cx + 3, top + 24, 5, 2, 0xFFFFE0E0)
                IF t < 48 THEN
                    DrawBeamLine(cx - 6, top + 25, g_ebA1, 0)
                    DrawBeamLine(cx + 6, top + 25, g_ebA2, 0)
                ELSE
                    DrawBeamLine(cx - 6, top + 25, g_ebA1, 1)
                    DrawBeamLine(cx + 6, top + 25, g_ebA2, 1)
                ENDIF
            ENDIF
        ENDIF
        IF g_emAt = 3 AND t >= 30 AND t < 55 THEN
            IF ((t / 2) % 2) = 0 THEN
                FOR k = 0 TO 7
                    FillRectSolid(cx - 46, top + 90 + (k * 24), 2, 10, 0xFFFF3C3C)
                    FillRectSolid(cx + 45, top + 90 + (k * 24), 2, 10, 0xFFFF3C3C)
                NEXT k
            ENDIF
        ENDIF
        IF g_emAt = 6 THEN
            FillRectSolid(cx - 30, top + 68, 6, 4 + ((g_tick / 2) % 3), 0xFFFFA030)
            FillRectSolid(cx + 24, top + 68, 6, 4 + ((g_tick / 2) % 3), 0xFFFFA030)
            FillRectSolid(cx - 28, top + 68, 2, 3, 0xFFFFF0A0)
            FillRectSolid(cx + 26, top + 68, 2, 3, 0xFFFFF0A0)
        ENDIF
    ENDIF
    ' mortar shells
    FOR k = 0 TO 2
        IF g_mtOn[k] = 1 THEN
            t = g_mtT[k]
            mx = INT(g_mtX[k])
            my = INT(g_mtY[k])
            IF t < 56 THEN
                r = 22 - ((t * 12) / 56)
                col = 0xFFE03040
                IF ((t / 4) % 2) = 0 THEN col = 0xFF8A1020
                DrawOval(mx, my, r, r, col)
                FillRectSolid(mx - 1, my - 1, 3, 3, col)
                sy = my - ((56 - t) * 3)
                IF sy >= -4 THEN
                    FillRectSolid(mx - 1, sy - 3, 3, 6, 0xFFFFE070)
                    FillRectSolid(mx, sy - 4, 1, 2, 0xFFFFFFFF)
                ENDIF
            ELSE
                r = (t - 56) * 2
                DrawOval(mx, my, r, r, 0xFFFFE070)
                IF r > 6 THEN DrawOval(mx, my, r - 6, r - 6, 0xFFFF8030)
                IF r < 16 THEN FillRectSolid(mx - (r / 2), my - (r / 2), r + 1, r + 1, 0xFFFFF0A0)
            ENDIF
        ENDIF
    NEXT k
ENDSUB

SUB DrawFsBeam()
    INT x0, y0, k, n
    IF g_fsBP < 0 THEN RETURN
    x0 = INT(g_fsBX)
    IF g_bsKind = 4 THEN
        y0 = INT(g_bsY) - 3                           ' from the chest of the Emperor
    ELSE
        y0 = INT(g_bsY) + 27                          ' the beam leaves the muzzle of the main cannon
    ENDIF
    IF g_fsBP < 60 THEN
        n = (270 - y0) / 3
        FOR k = 0 TO n
            IF ((k + (g_tick / 3)) % 2) = 0 THEN PutPix(x0, y0 + (k * 3), 0xFFFF3C3C)
        NEXT k
    ELSE
        FillRectSolid(x0 - 6, y0, 13, 288 - y0, 0xFFFF3C3C)
        IF ((g_tick / 2) % 2) = 0 THEN
            FillRectSolid(x0 - 3, y0, 7, 288 - y0, 0xFFFFFFFF)
        ELSE
            FillRectSolid(x0 - 2, y0, 5, 288 - y0, 0xFFFFDCDC)
        ENDIF
    ENDIF
ENDSUB

' ===============================================================================
' PLANET BACKDROPS (campaign): a gradient, scenery on the sides and drifting particles; the stars stay on top
' ===============================================================================
' a repeatable pseudo random number 0-996
SUB BgH(i:INT, sd:INT), INT
    RETURN ((i * 7919) + (sd * 104729) + (i * i * 31)) % 997
ENDSUB

SUB DrawBgGrad(c0:INT, c1:INT)
    INT y, x, r, g, b, col
    POINTER pRow
    FOR y = 0 TO 287
        r = ((c0 >> 16) & 255) + (((((c1 >> 16) & 255) - ((c0 >> 16) & 255)) * y) / 287)
        g = ((c0 >> 8) & 255) + (((((c1 >> 8) & 255) - ((c0 >> 8) & 255)) * y) / 287)
        b = (c0 & 255) + ((((c1 & 255) - (c0 & 255)) * y) / 287)
        col = 0xFF000000 | (r << 16) | (g << 8) | b
        pRow = pPixelBuffer + (y * 224 * 4)
        FOR x = 0 TO 223
            *<INT>(pRow + (x * 4)) = col
        NEXT x
    NEXT y
ENDSUB

SUB DrawBgIce(sc:INT)
    INT i, k, r, x, y, y0, h, w, ww, side, n, yb, j
    DrawBgGrad(0xFF061428, 0xFF0E3050)
    ' ice crystals growing out of the side walls
    FOR side = 0 TO 1
        FOR k = 0 TO 4
            n = k + (side * 5)
            y0 = (((BgH(n, 3) * 340) / 997) + ((sc * 4) / 10)) % 340 - 50
            h = 44 + (BgH(n, 4) % 30)
            w = 12 + (BgH(n, 5) % 14)
            FOR r = 0 TO h - 1
                y = y0 + r
                IF y >= 0 AND y < 288 THEN
                    ww = 2 + ((r * w) / h)
                    IF side = 0 THEN
                        FillRectSolid(0, y, ww, 1, 0xFF2A6490)
                        FillRectSolid(ww - 2, y, 2, 1, 0xFF7CC8F0)
                    ELSE
                        FillRectSolid(224 - ww, y, ww, 1, 0xFF2A6490)
                        FillRectSolid(224 - ww, y, 2, 1, 0xFF7CC8F0)
                    ENDIF
                ENDIF
            NEXT r
        NEXT k
    NEXT side
    ' aurora
    FOR k = 0 TO 111
        x = k * 2
        yb = 46 + INT(12.0 * SIN((FLOAT(x) * 0.04) + (FLOAT(g_tick) * 0.012))) + INT(6.0 * SIN((FLOAT(x) * 0.11) - (FLOAT(g_tick) * 0.02)))
        FOR j = 0 TO 11
            BlendPix(x, yb + j, 0xFF50FFB4, 46 - (j * 4))
            BlendPix(x + 1, yb + j, 0xFF50FFB4, 46 - (j * 4))
        NEXT j
    NEXT k
    ' snow
    FOR i = 0 TO 47
        x = (BgH(i, 1) * 224) / 997
        y = ((((BgH(i, 2) * 288) / 997) + ((sc * (6 + ((i % 3) * 3))) / 10))) % 288
        x = x + INT(5.0 * SIN((FLOAT(y) * 0.05) + FLOAT(i)))
        PutPix(x, y, 0xFFC8E6FF)
        IF (i % 6) = 0 THEN
            PutPix(x - 1, y, 0xFFC8E6FF)
            PutPix(x + 1, y, 0xFFC8E6FF)
            PutPix(x, y - 1, 0xFFC8E6FF)
            PutPix(x, y + 1, 0xFFC8E6FF)
        ENDIF
    NEXT i
ENDSUB

SUB DrawBgFire(sc:INT)
    INT i, k, r, x, y, y0, h, w, ww, side, n, col
    DrawBgGrad(0xFF1C0606, 0xFF5A1808)
    ' basalt columns with glowing cracks on both sides
    FOR side = 0 TO 1
        FOR k = 0 TO 4
            n = k + (side * 5)
            y0 = (((BgH(n, 3) * 340) / 997) + ((sc * 5) / 10)) % 340 - 50
            h = 40 + (BgH(n, 4) % 40)
            w = 8 + (BgH(n, 5) % 10)
            FOR r = 0 TO h - 1
                y = y0 + r
                IF y >= 0 AND y < 288 THEN
                    ww = w + (((r / 5) % 2) * 3)
                    IF side = 0 THEN x = 0 ELSE x = 224 - ww
                    FillRectSolid(x, y, ww, 1, 0xFF2A1010)
                    IF side = 0 THEN FillRectSolid(ww - 2, y, 2, 1, 0xFF5A2418) ELSE FillRectSolid(x, y, 2, 1, 0xFF5A2418)
                    IF (r % 9) = 4 THEN FillRectSolid(x + 2, y, ww - 5, 1, 0xFFFF6E1E)
                ENDIF
            NEXT r
        NEXT k
    NEXT side
    ' embers rising
    FOR i = 0 TO 43
        x = (BgH(i, 1) * 224) / 997
        y = (288000 + ((BgH(i, 2) * 288) / 997) - ((sc * (8 + ((i % 4) * 4))) / 10)) % 288
        x = x + INT(3.0 * SIN((FLOAT(y) * 0.07) + FLOAT(i)))
        col = 0xFFFF9628
        IF (i % 3) = 1 THEN col = 0xFFFFDC3C
        IF (i % 3) = 2 THEN col = 0xFFFF4818
        IF (i % 5) = 0 THEN
            FillRectSolid(x, y, 2, 2, col)
        ELSE
            PutPix(x, y, col)
        ENDIF
    NEXT i
ENDSUB

SUB DrawBgHive(sc:INT)
    INT i, y, ww, x, y0, dx, dy, d2
    DrawBgGrad(0xFF08160A, 0xFF123018)
    ' pulsing membrane walls
    FOR y = 0 TO 287
        ww = 7 + INT(5.0 * SIN((FLOAT(y) * 0.05) + (FLOAT(sc) * 0.012))) + INT(3.0 * SIN((FLOAT(y) * 0.13) - (FLOAT(sc) * 0.02)))
        FillRectSolid(0, y, ww, 1, 0xFF1E5028)
        FillRectSolid(ww - 2, y, 2, 1, 0xFF5AB43C)
        ww = 7 + INT(5.0 * SIN((FLOAT(y) * 0.05) + (FLOAT(sc) * 0.012) + 2.0)) + INT(3.0 * SIN((FLOAT(y) * 0.13) - (FLOAT(sc) * 0.02) + 1.0))
        FillRectSolid(224 - ww, y, ww, 1, 0xFF1E5028)
        FillRectSolid(224 - ww, y, 2, 1, 0xFF5AB43C)
    NEXT y
    ' drifting glowing spores
    FOR i = 0 TO 19
        x = (BgH(i, 1) * 224) / 997
        y0 = ((((BgH(i, 2) * 288) / 997) + ((sc * (3 + (i % 4))) / 10))) % 288
        x = x + INT(8.0 * SIN((FLOAT(y0) * 0.03) + FLOAT(i)))
        FOR dy = -2 TO 2
            FOR dx = -2 TO 2
                d2 = (dx * dx) + (dy * dy)
                IF d2 <= 5 THEN BlendPix(x + dx, y0 + dy, 0xFFB4FF50, 130 - (d2 * 22))
            NEXT dx
        NEXT dy
    NEXT i
ENDSUB

SUB DrawBgEmpire(sc:INT)
    INT k, y, col
    DrawBgGrad(0xFF0C0614, 0xFF2A1040)
    FOR k = 0 TO 9
        y = ((k * 32) + ((sc * 4) / 10)) % 320 - 16
        FillRectSolid(0, y, 224, 1, 0xFF22183C)
    NEXT k
    ' girders on both sides with blinking lights
    FillRectSolid(0, 0, 12, 288, 0xFF2A2A44)
    FillRectSolid(12, 0, 2, 288, 0xFF50507A)
    FillRectSolid(212, 0, 12, 288, 0xFF2A2A44)
    FillRectSolid(210, 0, 2, 288, 0xFF50507A)
    FOR k = 0 TO 9
        y = ((k * 32) + ((sc * 7) / 10)) % 320 - 16
        FillRectSolid(0, y, 12, 3, 0xFF50507A)
        FillRectSolid(212, y, 12, 3, 0xFF50507A)
        col = 0xFFD23CFF
        IF ((k + (g_tick / 20)) % 3) = 0 THEN col = 0xFFFF3C3C
        FillRectSolid(4, y + 5, 3, 3, col)
        FillRectSolid(217, y + 5, 3, 3, col)
    NEXT k
ENDSUB

SUB BgBegin(pDst:POINTER, nPix:INT)
    g_pLoadDst = pDst
    g_bgPos = 0
    g_bgLimit = nPix
ENDSUB

' same runs, but stored as palette indices (one byte per pixel): the colours come from the animated tables when drawn
SUB BgRunB(s:STRING)
    INT i, n, c, cnt, idx, k
    POINTER p
    p = &s
    n = LEN(s)
    i = 0
    WHILE i < n
        c = *<CHAR>(p + i)
        IF c >= 65 THEN idx = c - 55 ELSE idx = c - 48
        c = *<CHAR>(p + i + 1)
        IF c >= 65 AND c <= 90 THEN
            cnt = c - 65
        ELSEIF c >= 97 AND c <= 122 THEN
            cnt = c - 71
        ELSEIF c >= 48 AND c <= 57 THEN
            cnt = c + 4
        ELSEIF c = 43 THEN
            cnt = 62
        ELSE
            cnt = 63
        ENDIF
        cnt = cnt + 1
        FOR k = 1 TO cnt
            IF g_bgPos < g_bgLimit THEN
                *<CHAR>(g_pLoadDst + g_bgPos) = idx
                g_bgPos = g_bgPos + 1
            ENDIF
        NEXT k
        i = i + 2
    ENDWHILE
ENDSUB

' decodes runs of "colour, count" pairs: colour = one hex digit (palette index), count = one of A-Z a-z 0-9 + / (1 to 64)
SUB BgRun(s:STRING)
    INT i, n, c, cnt, idx, col, k
    POINTER p
    p = &s
    n = LEN(s)
    i = 0
    WHILE i < n
        c = *<CHAR>(p + i)
        IF c >= 65 THEN idx = c - 55 ELSE idx = c - 48
        c = *<CHAR>(p + i + 1)
        IF c >= 65 AND c <= 90 THEN
            cnt = c - 65
        ELSEIF c >= 97 AND c <= 122 THEN
            cnt = c - 71
        ELSEIF c >= 48 AND c <= 57 THEN
            cnt = c + 4
        ELSEIF c = 43 THEN
            cnt = 62
        ELSE
            cnt = 63
        ENDIF
        cnt = cnt + 1
        IF idx > 15 THEN col = 0 ELSE col = g_bgPal[idx]
        FOR k = 1 TO cnt
            IF g_bgPos < g_bgLimit THEN
                *<INT>(g_pLoadDst + (g_bgPos * 4)) = col
                g_bgPos = g_bgPos + 1
            ENDIF
        NEXT k
        i = i + 2
    ENDWHILE
ENDSUB

' blend of two colours, a = 0..256
SUB MixCol(c0:INT, c1:INT, a:INT), INT
    INT r, g, b
    r = ((c0 >> 16) & 255) + (((((c1 >> 16) & 255) - ((c0 >> 16) & 255)) * a) / 256)
    g = ((c0 >> 8) & 255) + (((((c1 >> 8) & 255) - ((c0 >> 8) & 255)) * a) / 256)
    b = (c0 & 255) + ((((c1 & 255) - (c0 & 255)) * a) / 256)
    RETURN 0xFF000000 | (r << 16) | (g << 8) | b
ENDSUB

' colour tables of one branch (g_bgPal must hold its palette): 16 phases x 16 colours, once for the surface and once for the orbital view
SUB BuildAnim(br:INT)
    INT k, ph, i, base, s1, s2
    FOR k = 0 TO 1
        FOR ph = 0 TO 15
            base = (((br * 2) + k) * 256) + (ph * 16)
            s1 = INT((SIN(FLOAT(ph) * 0.3927) + 1.0) * 127.0)
            s2 = INT((SIN((FLOAT(ph) * 0.3927) + 2.1) + 1.0) * 127.0)
            FOR i = 0 TO 15
                g_animTab[base + i] = g_bgPal[i]
            NEXT i
            IF br = 0 AND k = 0 THEN                                           ' ice: water glints
                g_animTab[base + 11] = MixCol(g_bgPal[11], g_bgPal[12], (s1 * 180) / 256)
                g_animTab[base + 12] = MixCol(g_bgPal[12], g_bgPal[7], (s2 * 150) / 256)
            ENDIF
            IF br = 1 THEN                                                     ' fire: pulsing lava
                g_animTab[base + 12] = MixCol(g_bgPal[12], g_bgPal[13], (s1 * 200) / 256)
                g_animTab[base + 13] = MixCol(g_bgPal[13], g_bgPal[11], (s2 * 160) / 256)
                g_animTab[base + 4] = MixCol(g_bgPal[4], g_bgPal[5], (s1 * 90) / 256)
            ENDIF
            IF br = 2 THEN                                                     ' hive: breathing pores, shimmering water
                g_animTab[base + 12] = MixCol(g_bgPal[12], g_bgPal[13], (s2 * 160) / 256)
                g_animTab[base + 11] = MixCol(g_bgPal[11], g_bgPal[12], (s1 * 120) / 256)
                IF k = 0 THEN g_animTab[base + 14] = MixCol(g_bgPal[14], 0xFF6A58A0, (s1 * 190) / 256)
            ENDIF
            IF br = 3 THEN                                                     ' empire: blinking lights
                g_animTab[base + 12] = MixCol(g_bgPal[12], g_bgPal[13], (s1 * 220) / 256)
                g_animTab[base + 11] = MixCol(g_bgPal[11], g_bgPal[12], (s2 * 200) / 256)
            ENDIF
        NEXT ph
    NEXT k
ENDSUB

' the planet surface: scrolls down, wraps every 384 rows; the colours ripple down the screen
SUB DrawStrip(pSrc:POINTER, br:INT, sc:INT)
    INT y, x, srcRow, ph, tb, c
    POINTER pd, ps
    FOR y = 0 TO 287
        srcRow = (y + 384 - (sc % 384)) % 384
        pd = pPixelBuffer + (y * 224 * 4)
        ps = pSrc + (srcRow * 224)
        ph = ((y / 3) + (g_tick / 4)) & 15
        tb = (br * 512) + (ph * 16)
        FOR x = 0 TO 223
            c = *<CHAR>(ps + x)
            *<INT>(pd + (x * 4)) = g_animTab[tb + c]
        NEXT x
    NEXT y
ENDSUB

' the orbital view: the whole picture shares one phase
' ---- the campaign sky: the orbital pictures are split into a galaxy layer and a planet, which are put together differently on every run ----
' cut one planet out of its orbital picture: the sprite keeps the picture's colour indices (16 = transparent), the picture loses the planet
SUB ExtractPlanet(b:INT, pOrb:POINTER, pSpr:POINTER)
    INT x, y, x0, y0, w, h, dx, dy, d2, v, take
    x0 = 96
    w = 107
    IF b = 3 THEN
        x0 = 73
        w = 151
    ENDIF
    y0 = 154
    h = 107
    FOR y = 0 TO h - 1
        FOR x = 0 TO w - 1
            dx = x0 + x - 149
            dy = y0 + y - 207
            d2 = (dx * dx) + (dy * dy)
            v = *<CHAR>(pOrb + (((y0 + y) * 224) + x0 + x))
            take = 0
            IF d2 <= 2352 THEN
                take = 1                                           ' the planet itself
            ELSEIF d2 <= 2809 AND v <> 0 THEN
                take = 1                                           ' its lit rim
            ELSEIF b = 3 AND v <> 0 AND y0 + y >= 158 AND y0 + y <= 258 THEN
                take = 1                                           ' the ring of the empire world
            ENDIF
            IF take = 1 THEN
                *<CHAR>(pSpr + ((y * w) + x)) = v
                *<CHAR>(pOrb + (((y0 + y) * 224) + x0 + x)) = 0
            ELSE
                *<CHAR>(pSpr + ((y * w) + x)) = 16
            ENDIF
        NEXT x
    NEXT y
ENDSUB

' a new layout: the galaxy arm flipped or not, the planet and the plasma cloud anywhere
SUB RollSky()
    g_skyFx = INT(RND(2.0))
    g_skyFy = INT(RND(2.0))
    g_skyPx = 40 + INT(RND(145.0))
    g_skyPy = 70 + INT(RND(161.0))
    g_skyCy = INT(RND(210.0)) - 20
    g_skyCfx = INT(RND(2.0))
    g_skyCfy = INT(RND(2.0))
    IF g_skyFx > 1 THEN g_skyFx = 1
    IF g_skyFy > 1 THEN g_skyFy = 1
    IF g_skyCfx > 1 THEN g_skyCfx = 1
    IF g_skyCfy > 1 THEN g_skyCfy = 1
ENDSUB

SUB SkyInit()
    INT i, c, r, g, b
    g_skyInit = 1
    g_pPlanA = API_GlobalAlloc(0x40, 107 * 107)
    g_pPlanB = API_GlobalAlloc(0x40, 107 * 107)
    g_pPlanC = API_GlobalAlloc(0x40, 107 * 107)
    g_pPlanD = API_GlobalAlloc(0x40, 151 * 107)
    IF g_pOrb <> 0 AND g_pPlanA <> 0 THEN ExtractPlanet(0, g_pOrb, g_pPlanA)
    IF g_pOrbF <> 0 AND g_pPlanB <> 0 THEN ExtractPlanet(1, g_pOrbF, g_pPlanB)
    IF g_pOrbH <> 0 AND g_pPlanC <> 0 THEN ExtractPlanet(2, g_pOrbH, g_pPlanC)
    IF g_pOrbE <> 0 AND g_pPlanD <> 0 THEN ExtractPlanet(3, g_pOrbE, g_pPlanD)
    g_pCloudR = API_GlobalAlloc(0x40, 224 * 96 * 4)
    g_pCloudM = API_GlobalAlloc(0x40, 224 * 96 * 4)
    g_pCloudV = API_GlobalAlloc(0x40, 224 * 96 * 4)
    IF g_pCloud <> 0 AND g_pCloudR <> 0 AND g_pCloudM <> 0 AND g_pCloudV <> 0 THEN
        FOR i = 0 TO (224 * 96) - 1
            c = *<INT>(g_pCloud + (i * 4))
            IF c <> 0 THEN
                r = (c >> 16) & 255
                g = (c >> 8) & 255
                b = c & 255
                *<INT>(g_pCloudR + (i * 4)) = 0xFF000000 | (b << 16) | ((g >> 1) << 8) | r                          ' red: the blue and red channels swapped
                *<INT>(g_pCloudM + (i * 4)) = 0xFF000000 | (b << 16) | ((g >> 2) << 8) | (b - (b >> 2))             ' magenta
                *<INT>(g_pCloudV + (i * 4)) = 0xFF000000 | ((((b * 5) >> 3) + (r >> 1)) << 16) | ((g >> 1) << 8) | b   ' violet
            ENDIF
        NEXT i
    ENDIF
    RollSky()
ENDSUB

' the galaxy layer of an orbital picture (flipped as rolled), the shared palette animation
SUB DrawOrbSky(pSrc:POINTER, br:INT, pSpr:POINTER)
    INT x, y, sx, sy, c, tb
    tb = (br * 512) + 256 + (((g_tick / 5) & 15) * 16)
    FOR y = 0 TO 287
        sy = y
        IF g_skyFy = 1 THEN sy = 287 - y
        FOR x = 0 TO 223
            sx = x
            IF g_skyFx = 1 THEN sx = 223 - x
            c = *<CHAR>(pSrc + ((sy * 224) + sx))
            *<INT>(pPixelBuffer + (((y * 224) + x) * 4)) = g_animTab[tb + c]
        NEXT x
    NEXT y
    DrawSkyCloud(br)
    DrawSkyPlanet(br, pSpr)
ENDSUB

' the plasma cloud, in the colour of the world (ice blue, fire red, hive magenta, empire violet); it is added over the galaxy and drifts sideways
SUB DrawSkyCloud(b:INT)
    INT x, y, sx, dy, off, c, d, r, g, bl, m
    POINTER pc
    pc = g_pCloud
    IF b = 1 THEN pc = g_pCloudR
    IF b = 2 THEN pc = g_pCloudM
    IF b = 3 THEN pc = g_pCloudV
    IF pc = 0 THEN RETURN
    g_clX = g_clX + (0.06 * g_warp)
    IF g_clX >= 224.0 THEN g_clX = g_clX - 224.0
    off = INT(g_clX)
    FOR y = 0 TO 95
        dy = g_skyCy + y
        IF g_skyCfy = 1 THEN dy = g_skyCy + 95 - y
        m = 80                                                  ' 5/8 strength, fading in over the first 16 rows so the dense edge has no hard line
        IF y < 16 THEN m = y * 5
        IF dy >= 0 AND dy < 288 THEN
            FOR x = 0 TO 223
                sx = x + off
                IF sx >= 224 THEN sx = sx - 224
                IF g_skyCfx = 1 THEN sx = 223 - sx
                c = *<INT>(pc + (((y * 224) + sx) * 4))
                IF c <> 0 THEN
                    d = *<INT>(pPixelBuffer + (((dy * 224) + x) * 4))
                    r = ((d >> 16) & 255) + ((((c >> 16) & 255) * m) >> 7)
                    g = ((d >> 8) & 255) + ((((c >> 8) & 255) * m) >> 7)
                    bl = (d & 255) + (((c & 255) * m) >> 7)
                    IF r > 255 THEN r = 255
                    IF g > 255 THEN g = 255
                    IF bl > 255 THEN bl = 255
                    *<INT>(pPixelBuffer + (((dy * 224) + x) * 4)) = 0xFF000000 | (r << 16) | (g << 8) | bl
                ENDIF
            NEXT x
        ENDIF
    NEXT y
ENDSUB

SUB DrawSkyPlanet(b:INT, pSpr:POINTER)
    INT x, y, w, h, x0, y0, dx, dy, c, tb
    IF pSpr = 0 THEN RETURN
    w = 107
    IF b = 3 THEN w = 151
    h = 107
    x0 = g_skyPx - (w / 2)
    y0 = g_skyPy - (h / 2)
    tb = (b * 512) + 256 + (((g_tick / 5) & 15) * 16)
    FOR y = 0 TO h - 1
        dy = y0 + y
        IF dy >= 0 AND dy < 288 THEN
            FOR x = 0 TO w - 1
                dx = x0 + x
                IF dx >= 0 AND dx < 224 THEN
                    c = *<CHAR>(pSpr + ((y * w) + x))
                    IF c < 16 THEN *<INT>(pPixelBuffer + (((dy * 224) + dx) * 4)) = g_animTab[tb + c]
                ENDIF
            NEXT x
        ENDIF
    NEXT y
ENDSUB

