    SetSprRow(34, 9, "0777774AA4777770")
    SetSprRow(34, 10, "0007007447007000")
    SetSprRow(34, 11, "0000007AA7000000")
    SetSprRow(34, 12, "0000000AA0000000")
    SetSprRow(34, 13, "0000000FF0000000")
    SetSprRow(34, 14, "0000000000000000")
    SetSprRow(34, 15, "0000000000000000")
    SetSprRow(35, 0, "0000000000000000")
    SetSprRow(35, 1, "0000A000000A0000")
    SetSprRow(35, 2, "00000A0000A00000")
    SetSprRow(35, 3, "0000007777000000")
    SetSprRow(35, 4, "0000074444700000")
    SetSprRow(35, 5, "000007F44F700000")
    SetSprRow(35, 6, "0000007777000000")
    SetSprRow(35, 7, "0000074444700000")
    SetSprRow(35, 8, "0000A74AA47A0000")
    SetSprRow(35, 9, "0777774AA4777770")
    SetSprRow(35, 10, "0770007447000770")
    SetSprRow(35, 11, "0700007AA7000070")
    SetSprRow(35, 12, "0000000AA0000000")
    SetSprRow(35, 13, "0000000FF0000000")
    SetSprRow(35, 14, "0000000000000000")
    SetSprRow(35, 15, "0000000000000000")
    SetSprRow(36, 0, "0000000000000000")
    SetSprRow(36, 1, "0000A000000A0000")
    SetSprRow(36, 2, "00000A0000A00000")
    SetSprRow(36, 3, "0000002332000000")
    SetSprRow(36, 4, "0000023FF3200000")
    SetSprRow(36, 5, "2200033333300022")
    SetSprRow(36, 6, "2222333223332222")
    SetSprRow(36, 7, "2A223332233322A2")
    SetSprRow(36, 8, "22AA33322333AA22")
    SetSprRow(36, 9, "0222233333322220")
    SetSprRow(36, 10, "0022023333202200")
    SetSprRow(36, 11, "0000002332000000")
    SetSprRow(36, 12, "0000000220000000")
    SetSprRow(36, 13, "0000000000000000")
    SetSprRow(36, 14, "0000000000000000")
    SetSprRow(36, 15, "0000000000000000")
    SetSprRow(37, 0, "0000000000000000")
    SetSprRow(37, 1, "0000A000000A0000")
    SetSprRow(37, 2, "00000A0000A00000")
    SetSprRow(37, 3, "0000002332000000")
    SetSprRow(37, 4, "0000023FF3200000")
    SetSprRow(37, 5, "0200033333300020")
    SetSprRow(37, 6, "0222333223332220")
    SetSprRow(37, 7, "022A33322333A220")
    SetSprRow(37, 8, "02AA33322333AA20")
    SetSprRow(37, 9, "0022233333322200")
    SetSprRow(37, 10, "0000023333200000")
    SetSprRow(37, 11, "0000002332000000")
    SetSprRow(37, 12, "0000000220000000")
    SetSprRow(37, 13, "0000000000000000")
    SetSprRow(37, 14, "0000000000000000")
    SetSprRow(37, 15, "0000000000000000")

    FOR s = 0 TO 3
        FOR i = 0 TO 15
            g_skinMap[(s * 16) + i] = i
        NEXT i
    NEXT s
    ' frost: ice blue bees, teal / violet butterflies, pink bosses
    SkinCol(1, 4, 0xFF5AD2FF)
    SkinCol(1, 7, 0xFF2850B4)
    SkinCol(1, 10, 0xFFE6F5FF)
    SkinCol(1, 2, 0xFF3CB4A0)
    SkinCol(1, 3, 0xFF8C64FF)
    SkinCol(1, 6, 0xFFFF5A78)
    SkinCol(1, 11, 0xFFFFB43C)
    ' ember
    SkinCol(2, 4, 0xFFFF7828)
    SkinCol(2, 7, 0xFF8C1E1E)
    SkinCol(2, 10, 0xFFFFE664)
    SkinCol(2, 2, 0xFFE6325A)
    SkinCol(2, 3, 0xFFFF9628)
    SkinCol(2, 6, 0xFF3CC8E6)
    SkinCol(2, 11, 0xFFE6E6FF)
    ' toxic
    SkinCol(3, 4, 0xFFB4FF3C)
    SkinCol(3, 7, 0xFF1E8C5A)
    SkinCol(3, 10, 0xFFFF3CC8)
    SkinCol(3, 2, 0xFF9632DC)
    SkinCol(3, 3, 0xFF3CFF8C)
    SkinCol(3, 6, 0xFFFF3C3C)
    SkinCol(3, 11, 0xFFFFDC3C)

    FOR s = 1 TO 3
        FOR k = 0 TO 7
            srcSpr = k + 1
            IF s >= 2 AND k < 2 THEN srcSpr = 34 + k        ' hornet frames
            IF s = 3 AND (k = 2 OR k = 3) THEN srcSpr = 34 + k        ' moth frames (36 / 37)
            FOR i = 0 TO 255
                v = g_spr[(srcSpr * 256) + i]
                g_spr[((10 + ((s - 1) * 8) + k) * 256) + i] = g_skinMap[(s * 16) + v]
            NEXT i
        NEXT k
    NEXT s
ENDSUB

SUB SetGlyph(gi:INT, r0:INT, r1:INT, r2:INT, r3:INT, r4:INT, r5:INT, r6:INT)
    INT b
    b = gi * 7
    g_fnt[b]     = r0
    g_fnt[b + 1] = r1
    g_fnt[b + 2] = r2
    g_fnt[b + 3] = r3
    g_fnt[b + 4] = r4
    g_fnt[b + 5] = r5
    g_fnt[b + 6] = r6
ENDSUB

SUB InitFont()
    INT i
    SetGlyph(0, 14, 17, 19, 21, 25, 17, 14)    ' 0
    SetGlyph(1, 4, 12, 4, 4, 4, 4, 14)    ' 1
    SetGlyph(2, 14, 17, 1, 2, 4, 8, 31)    ' 2
    SetGlyph(3, 31, 2, 4, 2, 1, 17, 14)    ' 3
    SetGlyph(4, 2, 6, 10, 18, 31, 2, 2)    ' 4
    SetGlyph(5, 31, 16, 30, 1, 1, 17, 14)    ' 5
    SetGlyph(6, 6, 8, 16, 30, 17, 17, 14)    ' 6
    SetGlyph(7, 31, 1, 2, 4, 8, 8, 8)    ' 7
    SetGlyph(8, 14, 17, 17, 14, 17, 17, 14)    ' 8
    SetGlyph(9, 14, 17, 17, 15, 1, 2, 12)    ' 9
    SetGlyph(10, 14, 17, 17, 31, 17, 17, 17)    ' A
    SetGlyph(11, 30, 17, 17, 30, 17, 17, 30)    ' B
    SetGlyph(12, 14, 17, 16, 16, 16, 17, 14)    ' C
    SetGlyph(13, 30, 17, 17, 17, 17, 17, 30)    ' D
    SetGlyph(14, 31, 16, 16, 30, 16, 16, 31)    ' E
    SetGlyph(15, 31, 16, 16, 30, 16, 16, 16)    ' F
    SetGlyph(16, 14, 17, 16, 23, 17, 17, 15)    ' G
    SetGlyph(17, 17, 17, 17, 31, 17, 17, 17)    ' H
    SetGlyph(18, 14, 4, 4, 4, 4, 4, 14)    ' I
    SetGlyph(19, 7, 2, 2, 2, 2, 18, 12)    ' J
    SetGlyph(20, 17, 18, 20, 24, 20, 18, 17)    ' K
    SetGlyph(21, 16, 16, 16, 16, 16, 16, 31)    ' L
    SetGlyph(22, 17, 27, 21, 21, 17, 17, 17)    ' M
    SetGlyph(23, 17, 25, 21, 19, 17, 17, 17)    ' N
    SetGlyph(24, 14, 17, 17, 17, 17, 17, 14)    ' O
    SetGlyph(25, 30, 17, 17, 30, 16, 16, 16)    ' P
    SetGlyph(26, 14, 17, 17, 17, 21, 18, 13)    ' Q
    SetGlyph(27, 30, 17, 17, 30, 20, 18, 17)    ' R
    SetGlyph(28, 15, 16, 16, 14, 1, 1, 30)    ' S
    SetGlyph(29, 31, 4, 4, 4, 4, 4, 4)    ' T
    SetGlyph(30, 17, 17, 17, 17, 17, 17, 14)    ' U
    SetGlyph(31, 17, 17, 17, 17, 17, 10, 4)    ' V
    SetGlyph(32, 17, 17, 17, 21, 21, 27, 17)    ' W
    SetGlyph(33, 17, 17, 10, 4, 10, 17, 17)    ' X
    SetGlyph(34, 17, 17, 10, 4, 4, 4, 4)    ' Y
    SetGlyph(35, 31, 1, 2, 4, 8, 16, 31)    ' Z
    SetGlyph(36, 0, 0, 0, 31, 0, 0, 0)    ' -
    SetGlyph(37, 0, 4, 4, 0, 4, 4, 0)    ' :
    SetGlyph(38, 4, 4, 4, 4, 4, 0, 4)    ' !
    SetGlyph(39, 0, 0, 0, 0, 0, 12, 12)    ' .
    SetGlyph(40, 0, 21, 14, 31, 14, 21, 0)    ' *
    SetGlyph(41, 0, 0, 0, 0, 0, 0, 0)    ' space
    FOR i = 0 TO 127
        g_fontIdx[i] = 41
    NEXT i
    FOR i = 0 TO 9
        g_fontIdx[48 + i] = i
    NEXT i
    FOR i = 0 TO 25
        g_fontIdx[65 + i] = 10 + i
        g_fontIdx[97 + i] = 10 + i
    NEXT i
    g_fontIdx[45] = 36
    g_fontIdx[58] = 37
    g_fontIdx[33] = 38
    g_fontIdx[46] = 39
    g_fontIdx[42] = 40
    g_fontIdx[32] = 41
    SetGlyph(42, 25, 26, 2, 4, 8, 11, 19)      ' %
    g_fontIdx[37] = 42
    SetGlyph(43, 14, 8, 8, 8, 8, 8, 14)        ' [
    SetGlyph(44, 14, 2, 2, 2, 2, 2, 14)        ' ]
    SetGlyph(45, 0, 4, 4, 31, 4, 4, 0)         ' +
    g_fontIdx[43] = 45
    g_fontIdx[91] = 43
    g_fontIdx[93] = 44
    SetGlyph(46, 2, 4, 8, 8, 8, 4, 2)          ' (
    SetGlyph(47, 8, 4, 2, 2, 2, 4, 8)          ' )
    SetGlyph(48, 0, 0, 0, 0, 12, 4, 8)         ' ,
    SetGlyph(49, 12, 4, 8, 0, 0, 0, 0)         ' '
    SetGlyph(50, 1, 1, 2, 4, 8, 16, 16)        ' /
    SetGlyph(51, 14, 17, 1, 2, 4, 0, 4)        ' ?
    SetGlyph(52, 14, 17, 23, 21, 23, 17, 14)   ' copyright sign (typed as @ in a string: a code above 127 would be masked)
    g_fontIdx[40] = 46
    g_fontIdx[41] = 47
    g_fontIdx[44] = 48
    g_fontIdx[39] = 49
    g_fontIdx[47] = 50
    g_fontIdx[63] = 51
    g_fontIdx[64] = 52
ENDSUB

SUB SetWave(idx:INT, r:INT, cc:INT)
    g_wRow[idx] = r
    g_wCol[idx] = cc
ENDSUB

SUB InitWaves()
    g_wTempl[0] = 0
    g_wMirror[0] = 0
    SetWave(0, 0, 3)
    SetWave(1, 1, 3)
    SetWave(2, 0, 4)
    SetWave(3, 1, 4)
    SetWave(4, 0, 5)
    SetWave(5, 1, 5)
    SetWave(6, 0, 6)
    SetWave(7, 1, 6)
    g_wTempl[1] = 1
    g_wMirror[1] = 1
    SetWave(8, 1, 1)
    SetWave(9, 2, 1)
    SetWave(10, 1, 2)
    SetWave(11, 2, 2)
    SetWave(12, 1, 7)
    SetWave(13, 2, 7)
    SetWave(14, 1, 8)
    SetWave(15, 2, 8)
    g_wTempl[2] = 2
    g_wMirror[2] = 0
    SetWave(16, 2, 3)
    SetWave(17, 3, 3)
    SetWave(18, 2, 4)
    SetWave(19, 3, 4)
    SetWave(20, 2, 5)
    SetWave(21, 3, 5)
    SetWave(22, 2, 6)
    SetWave(23, 3, 6)
    g_wTempl[3] = 3
    g_wMirror[3] = 1
    SetWave(24, 3, 0)
    SetWave(25, 3, 1)
    SetWave(26, 3, 2)
    SetWave(27, 3, 7)
    SetWave(28, 3, 8)
    SetWave(29, 3, 9)
    SetWave(30, 4, 4)
    SetWave(31, 4, 5)
    g_wTempl[4] = 0
    g_wMirror[4] = 1
    SetWave(32, 4, 0)
    SetWave(33, 4, 1)
    SetWave(34, 4, 2)
    SetWave(35, 4, 3)
    SetWave(36, 4, 6)
    SetWave(37, 4, 7)
    SetWave(38, 4, 8)
    SetWave(39, 4, 9)
ENDSUB

' ---- background asteroid field (arcade stages): slow rocks drifting down behind the aliens, above the stars -----
' 1 while the backdrop is the derelict fleet (arcade: every 4th pair of stages; campaign: the orbit of the Empire world). Cosmonauts only drift here.
SUB DerelictOn(), INT
    IF g_mode = 0 THEN
        IF g_challenge = 0 AND g_theme = 3 THEN RETURN 1
        RETURN 0
    ENDIF
    IF g_cBranch = 3 AND g_cStep >= 1 AND g_cStep <= 5 THEN RETURN 1
    RETURN 0
ENDSUB

SUB ResetRock(i:INT, top:INT)
    INT t
    t = 0
    IF i >= 2 THEN t = 1
    IF i >= 4 THEN t = 2
    g_rkX[i] = RND(224.0)
    IF t = 0 THEN
        g_rkV[i] = 0.28 + RND(0.12)
    ELSEIF t = 1 THEN
        g_rkV[i] = 0.2 + RND(0.1)
    ELSE
        g_rkV[i] = 0.12 + RND(0.08)
    ENDIF
    g_rkDX[i] = (RND(0.2)) - 0.1
    IF DerelictOn() = 1 THEN
        ' wreckage tumbles away at its own angle: every piece gets a sideways drift of its own (left or right, slow or brisk)
        g_rkDX[i] = 0.12 + RND(0.38)
        IF RND(2.0) < 1.0 THEN g_rkDX[i] = 0.0 - g_rkDX[i]
        g_rkV[i] = g_rkV[i] * (0.6 + RND(0.8))
    ENDIF
    g_rkF[i] = INT(RND(2.0))
    IF g_rkF[i] > 1 THEN g_rkF[i] = 1
    IF top = 1 THEN g_rkY[i] = -40.0 - RND(120.0) ELSE g_rkY[i] = RND(300.0) - 20.0
ENDSUB

SUB InitRocks()
    INT i
    FOR i = 0 TO 5
        ResetRock(i, 0)
    NEXT i
ENDSUB

SUB UpdateRocks()
    INT i
    FOR i = 0 TO 5
        g_rkY[i] = g_rkY[i] + (g_rkV[i] * g_warp)
        g_rkX[i] = g_rkX[i] + g_rkDX[i]
        IF g_rkY[i] > 320.0 OR g_rkX[i] < -70.0 OR g_rkX[i] > 294.0 THEN ResetRock(i, 1)
    NEXT i
ENDSUB

' the giant derelict crosses the screen very slowly (one pass takes about a minute)
SUB UpdateHulk()
    g_hkY = g_hkY + (0.09 * g_warp)
    IF g_hkY > 300.0 THEN
        g_hkY = -60.0
        g_hkX = 4.0 + RND(66.0)
    ENDIF
ENDSUB

' which picture the slot i of a drifting backdrop shows (th: 0 rocks, 2 icy asteroids, 3 derelict fleet); g_dsP = 0: nothing in this slot
SUB DriftSpec(th:INT, i:INT)
    INT t
    g_dsP = 0
    IF th = 0 THEN
        IF g_pRockBg = 0 THEN RETURN
        t = 0
        IF i >= 2 THEN t = 1
        IF i >= 4 THEN t = 2
        IF t = 0 THEN
            g_dsW = 34
            g_dsH = 30
            g_dsP = g_pRockBg
        ELSEIF t = 1 THEN
            g_dsW = 22
            g_dsH = 20
            g_dsP = g_pRockBg + (1020 * 4)
        ELSE
            g_dsW = 12
            g_dsH = 11
            g_dsP = g_pRockBg + (1460 * 4)
        ENDIF
    ELSEIF th = 2 THEN
        IF g_pIceBg = 0 OR i = 5 THEN RETURN
        IF i = 0 THEN
            g_dsW = 36
            g_dsH = 32
            g_dsP = g_pIceBg
        ELSEIF i = 1 THEN
            g_dsW = 34
            g_dsH = 30
            g_dsP = g_pIceBg + (1152 * 4)
        ELSEIF i = 3 THEN
            g_dsW = 20
            g_dsH = 18
            g_dsP = g_pIceBg + (2612 * 4)
        ELSE
            g_dsW = 22
            g_dsH = 20
            g_dsP = g_pIceBg + (2172 * 4)
        ENDIF
    ELSEIF th = 3 THEN
        IF g_pWreckBg = 0 THEN RETURN
        IF i = 0 THEN
            g_dsW = 58
            g_dsH = 28
            g_dsP = g_pWreckBg
        ELSEIF i = 1 THEN
            g_dsW = 52
            g_dsH = 30
            g_dsP = g_pWreckBg + (1624 * 4)
        ELSEIF i = 2 THEN
            g_dsW = 30
            g_dsH = 20
            g_dsP = g_pWreckBg + (3184 * 4)
        ELSEIF i = 3 THEN
            g_dsW = 28
            g_dsH = 18
            g_dsP = g_pWreckBg + (3784 * 4)
        ELSEIF i = 4 THEN
            g_dsW = 16
            g_dsH = 10
            g_dsP = g_pWreckBg + (4288 * 4)
        ELSE
            g_dsW = 12
            g_dsH = 9
            g_dsP = g_pWreckBg + (4448 * 4)
        ENDIF
    ENDIF
ENDSUB

' the drifting backdrop: arcade asteroids / icy asteroids / derelict fleet, and the icy asteroids over the orbit of Cryos (campaign).
' The bright pictures (ice, wrecks) are dimmed so that the shots and the aliens stay readable.
SUB DrawRockBg()
    INT i, th, w, h, x, y, sx, cc
    POINTER p
    th = -1
    IF g_mode = 0 THEN
        IF g_challenge = 0 THEN th = g_theme
    ELSEIF g_cBranch = 0 AND g_cStep >= 1 AND g_cStep <= 5 THEN
        th = 2
    ELSEIF DerelictOn() = 1 THEN
        th = 3                                          ' campaign: the orbit of the Empire world is strewn with the wrecks of the first fleet
    ENDIF
    IF th < 0 OR th = 1 THEN RETURN
    IF g_gstate < GS_READY OR g_gstate > GS_CLEAR THEN RETURN
    IF th = 3 AND g_pHulk <> 0 AND g_hkY > -50.0 AND g_hkY < 290.0 THEN
        FOR y = 0 TO 47
            FOR x = 0 TO 151
                cc = *<INT>(g_pHulk + (((y * 152) + x) * 4))
                IF cc <> 0 THEN PutPix(INT(g_hkX) + x, INT(g_hkY) + y, 0xFF000000 | (((cc >> 1) & 0x7F7F7F) + ((cc >> 4) & 0x0F0F0F)))
            NEXT x
        NEXT y
        sx = INT(g_hkX)
        cc = INT(g_hkY)
        IF ((g_tick / 24) % 3) = 0 THEN PutPix(sx + 119, cc + 1, 0xFFFF3030)                 ' the dead ship's lights, still blinking
        IF ((g_tick / 24) % 3) = 1 THEN PutPix(sx + 23, cc + 14, 0xFFFFD040)
        IF ((g_tick / 24) % 3) = 2 THEN PutPix(sx + 139, cc + 17, 0xFFFF3030)
        IF ((g_tick / 36) % 2) = 0 THEN PutPix(sx + 81, cc + 13, 0xFFFFD040)
        IF ((g_tick / 7) % 4) < 2 THEN PutPix(sx + 13, cc + 21, 0xFFFFD040)                  ' a fire on the torn stern
    ENDIF
    FOR i = 0 TO 5
        DriftSpec(th, i)
        IF g_dsP <> 0 AND g_rkY[i] > -40.0 AND g_rkY[i] < 290.0 THEN
            p = g_dsP
            w = g_dsW
            h = g_dsH
            FOR y = 0 TO h - 1
                FOR x = 0 TO w - 1
                    sx = x
                    IF g_rkF[i] = 1 THEN sx = w - 1 - x
                    cc = *<INT>(p + (((y * w) + sx) * 4))
                    IF cc <> 0 THEN
                        IF th <> 0 THEN cc = 0xFF000000 | (((cc >> 1) & 0x7F7F7F) + ((cc >> 4) & 0x0F0F0F))
                        PutPix(INT(g_rkX[i]) - (w / 2) + x, INT(g_rkY[i]) - (h / 2) + y, cc)
                    ENDIF
                NEXT x
            NEXT y
        ENDIF
    NEXT i
ENDSUB

' ---- arcade backdrop: a bluish plasma cloud along the top, the OMEGA station drifting at the bottom right -------
SUB CloudN(o:INT, x:FLOAT, y:FLOAT), FLOAT
    INT nx, ny, base, ix, iy, jx
    FLOAT u, v, fx, fy, a, b, c, d
    IF o = 0 THEN
        nx = 7
        ny = 4
        base = 0
    ELSEIF o = 1 THEN
        nx = 14
        ny = 8
        base = 35
    ELSE
        nx = 28
        ny = 16
        base = 161
    ENDIF
    u = x * FLOAT(nx) / 224.0
    v = y * FLOAT(ny) / 96.0
    ix = INT(u)
    iy = INT(v)
    IF iy >= ny THEN iy = ny - 1
    fx = u - FLOAT(ix)
    fy = v - FLOAT(iy)
    fx = fx * fx * (3.0 - (2.0 * fx))
    fy = fy * fy * (3.0 - (2.0 * fy))
    ix = ix % nx
    jx = (ix + 1) % nx
    a = g_cn[base + (iy * nx) + ix]
    b = g_cn[base + (iy * nx) + jx]
    c = g_cn[base + ((iy + 1) * nx) + ix]
    d = g_cn[base + ((iy + 1) * nx) + jx]
    RETURN ((a + ((b - a) * fx)) * (1.0 - fy)) + ((c + ((d - c) * fx)) * fy)
ENDSUB

SUB InitCloud()
    INT i, x, y, c, k, cr, cg, cb
    FLOAT n, m, env, s, f
    g_clX = 0.0
    FOR i = 0 TO 639
        g_cn[i] = RND(1.0)
    NEXT i
    g_pCloud = API_GlobalAlloc(0x40, 224 * 96 * 4)
    IF g_pCloud = 0 THEN RETURN
    FOR y = 0 TO 95
        env = 1.0 - (FLOAT(y) / 96.0)
        FOR x = 0 TO 223
            n = (0.5 * CloudN(0, FLOAT(x), FLOAT(y))) + (0.3 * CloudN(1, FLOAT(x), FLOAT(y))) + (0.2 * CloudN(2, FLOAT(x), FLOAT(y)))
            m = (env * 1.3) + ((n - 0.5) * 0.9) - 0.42                ' the body of the cloud: dense at the top, ragged lower edge
            c = 0
            IF m > 0.0 THEN
                s = (CloudN(1, FLOAT(x) + 37.0, FLOAT(y)) * 0.6) + (CloudN(2, FLOAT(x), FLOAT(y) + 11.0) * 0.4)      ' mottled patches inside
                k = INT((s * 6.5) + RND(1.6) - 0.8)
                IF k < 0 THEN k = 0
                IF k > 6 THEN k = 6
                IF k = 0 THEN c = 0xFF0C0C30
                IF k = 1 THEN c = 0xFF141450
                IF k = 2 THEN c = 0xFF201A58
                IF k = 3 THEN c = 0xFF202068
                IF k = 4 THEN c = 0xFF2A2A80
                IF k = 5 THEN c = 0xFF30308C
                IF k = 6 THEN c = 0xFF3A44A8
                IF RND(120.0) < 1.0 THEN c = 0xFF2870B8                ' tiny cold sparks
                IF RND(900.0) < 1.0 THEN c = 0xFF5A90E0
                IF m < 0.55 THEN                                         ' no hard border: the cloud simply darkens away into the sky
                    f = m / 0.55
                    f = f * f * (3.0 - (2.0 * f))
                    cr = INT(FLOAT((c >> 16) & 255) * f)
                    cg = INT(FLOAT((c >> 8) & 255) * f)
                    cb = INT(FLOAT(c & 255) * f)
                    c = 0xFF000000 | (cr << 16) | (cg << 8) | cb
                    IF cr + cg + cb < 6 THEN c = 0
                ENDIF
            ENDIF
            *<INT>(g_pCloud + (((y * 224) + x) * 4)) = c
        NEXT x
    NEXT y
ENDSUB

SUB DrawCloudBg()
    INT x, y, sx, off, c
    IF g_pCloud = 0 THEN RETURN
    IF g_mode <> 0 THEN RETURN
    IF g_gstate < GS_READY OR g_gstate > GS_CLEAR THEN RETURN
    g_clX = g_clX + (0.06 * g_warp)
    IF g_clX >= 224.0 THEN g_clX = g_clX - 224.0
    off = INT(g_clX)
    FOR y = 0 TO 95
        FOR x = 0 TO 223
            sx = x + off
            IF sx >= 224 THEN sx = sx - 224
            c = *<INT>(g_pCloud + (((y * 224) + sx) * 4))
            IF c <> 0 THEN PutPix(x, y, c)
        NEXT x
    NEXT y
ENDSUB

SUB DrawOmegaBg()
    INT x, y, dx, dy, c
    IF g_pOmegaBg = 0 THEN RETURN
    IF g_mode <> 0 OR g_theme <> 1 THEN RETURN
    IF g_gstate < GS_READY OR g_gstate > GS_CLEAR THEN RETURN
    dx = INT(172.0 + (7.0 * SIN(FLOAT(g_tick) * 0.0021))) - 39
    dy = INT(206.0 + (5.0 * SIN((FLOAT(g_tick) * 0.0017) + 1.0))) - 44
    FOR y = 0 TO 87
        FOR x = 0 TO 77
            c = *<INT>(g_pOmegaBg + (((y * 78) + x) * 4))
            IF c <> 0 THEN PutPix(dx + x, dy + y, c)
        NEXT x
    NEXT y
ENDSUB

' ---- the drifting backdrops: icy asteroids (arcade, and the orbit of Cryos in the campaign) and the derelict fleet, hand-pixelled 16-colour bitmaps ----
