DECLARE IMPORT, API_ReadFile ALIAS "ReadFile"(hFile:INT, lpBuf:POINTER, nBytes:INT, lpRead:POINTER, lpOvl:INT), INT
DECLARE IMPORT, API_WriteFile ALIAS "WriteFile"(hFile:INT, lpBuf:POINTER, nBytes:INT, lpWritten:POINTER, lpOvl:INT), INT
