' one output sample: sum of the running voices, clipped
SUB MixOne(), INT
    INT vi, sx, vp, acc

    acc = 0
    FOR vi = 0 TO 7
        sx = g_vSfx[vi]
        IF sx <> 0 THEN
            vp = g_vPos[vi]
            acc = acc + g_sfxData[g_sfxStart[sx] + vp]
            vp = vp + 1
            IF vp >= g_sfxLen[sx] THEN
                g_vSfx[vi] = 0
            ELSE
                g_vPos[vi] = vp
            ENDIF
        ENDIF
    NEXT vi
    acc = ((acc * g_volSfx * g_volSfx) / 100) + MusicSample()
    IF acc > 30000 THEN acc = 30000
    IF acc < -30000 THEN acc = -30000
    RETURN acc
ENDSUB

' fill buffer #bi with 512 samples (two 16-bit samples packed in each INT write)
SUB FillAudioBuf(bi:INT)
    INT k, s0, s1, baseOff

    baseOff = bi * 1024
    FOR k = 0 TO 255
        s0 = MixOne()
        s1 = MixOne()
        *<INT>(g_pAudBuf + baseOff + (k * 4)) = (s0 & 0xFFFF) | ((s1 & 0xFFFF) << 16)
    NEXT k
ENDSUB

SUB AudioThreadWorker(pParam AS POINTER), INT
    WHILE g_audStop = 0
        AudApplyRequest()
        PumpAudio()
        Sleep(4)
    ENDWHILE
    g_audThreadOn = 2
    RETURN 0
ENDSUB

SUB InitAudio()
    INT i, hoff, res, bufAddr, threadId
    POINTER ph

    g_audioOk = 0
    g_audThreadOn = 0
    g_audStop = 0
    g_reqCmd = 0
    g_audNext = 0
    FOR i = 0 TO 7
        g_vSfx[i] = 0
        g_vPos[i] = 0
    NEXT i

    BuildSounds()
    BuildMusic()

    g_pAud = API_GlobalAlloc(0x40, 256)             ' GPTR: fixed + zeroed
    g_pAudBuf = API_GlobalAlloc(0x40, 4096)
    i = g_pAud
    IF i = 0 THEN RETURN
    i = g_pAudBuf
    IF i = 0 THEN RETURN
    bufAddr = i

    ' WAVEFORMATEX: PCM, mono, 22050 Hz, 44100 bytes/s, block align 2, 16 bit
    *<INT>(g_pAud + 0) = 0x00010001
    *<INT>(g_pAud + 4) = 22050
    *<INT>(g_pAud + 8) = 44100
    *<INT>(g_pAud + 12) = 0x00100002
    *<INT>(g_pAud + 16) = 0

    ph = g_pAud + 160
    res = API_waveOutOpen(ph, -1, g_pAud, 0, 0, 0)  ' WAVE_MAPPER, no callback
    IF res <> 0 THEN RETURN
    g_hWave = *<INT>(g_pAud + 160)

    FOR i = 0 TO 3
        hoff = 32 + (i * 32)
        *<INT>(g_pAud + hoff) = bufAddr + (i * 1024)
        *<INT>(g_pAud + hoff + 4) = 1024
        ph = g_pAud + hoff
        API_waveOutPrepareHeader(g_hWave, ph, 32)
        FillAudioBuf(i)
        API_waveOutWrite(g_hWave, ph, 32)
    NEXT i
    g_audioOk = 1
    threadId = 0
    g_audThreadOn = 1                               ' from now on the music is driven by requests
    CreateThread(NULL, 0, &AudioThreadWorker, NULL, 0, &threadId)
ENDSUB

' call once per main-loop pass: refill and re-queue every buffer the driver has finished, in play order
SUB PumpAudio()
    INT hoff, flg, guard
    POINTER ph

    IF g_audioOk = 0 THEN RETURN
    guard = 0
    WHILE guard < 4
        hoff = 32 + (g_audNext * 32)
        flg = *<INT>(g_pAud + hoff + 16)
        IF (flg & 1) = 0 THEN BREAK                ' WHDR_DONE not set: still playing
        FillAudioBuf(g_audNext)
        ph = g_pAud + hoff
        API_waveOutWrite(g_hWave, ph, 32)
        g_audNext = (g_audNext + 1) & 3
        guard = guard + 1
    ENDWHILE
ENDSUB

SUB CloseAudio()
    INT i, hoff
    POINTER ph

    IF g_audioOk = 0 THEN RETURN
    IF g_audThreadOn = 1 THEN
        g_audStop = 1                               ' let the audio thread finish its pass (at most about 0.4 s)
        i = 0
        WHILE g_audThreadOn = 1 AND i < 100
            Sleep(4)
            i = i + 1
        ENDWHILE
    ENDIF
    g_audioOk = 0
    API_waveOutReset(g_hWave)
    FOR i = 0 TO 3
        hoff = 32 + (i * 32)
        ph = g_pAud + hoff
        API_waveOutUnprepareHeader(g_hWave, ph, 32)
    NEXT i
    API_waveOutClose(g_hWave)
ENDSUB

' sfxId: 1 player shot, 2 enemy hit, 3 enemy killed, 4 player killed, 5 enemy shot, 6 extra life, 7 stage start
SUB PlaySfx(sfxId:INT)
    INT vi, pick, oldest

    IF g_audioOk = 0 THEN RETURN
    IF g_mute = 1 THEN RETURN
    IF g_demo = 1 THEN RETURN                       ' the demo is silent
    IF sfxId < 1 THEN RETURN
    IF sfxId > 13 THEN RETURN

    pick = -1
    FOR vi = 0 TO 7
        IF pick = -1 AND g_vSfx[vi] = 0 THEN pick = vi
    NEXT vi
    IF pick = -1 THEN
        ' all voices busy: steal the one that has been playing the longest
        oldest = -1
        FOR vi = 0 TO 7
            IF g_vPos[vi] > oldest THEN
                oldest = g_vPos[vi]
                pick = vi
            ENDIF
        NEXT vi
    ENDIF
    g_vPos[pick] = 0
    g_vSfx[pick] = sfxId
ENDSUB

' ===============================================================================
' PATH BUILDING  (bezier chains -> dense polyline -> constant 2 px spacing)
' ===============================================================================
SUB TmpAdd(x:FLOAT, y:FLOAT)
    IF g_tmpN < 2400 THEN
        g_tmpX[g_tmpN] = x
        g_tmpY[g_tmpN] = y
        g_tmpN = g_tmpN + 1
    ENDIF
ENDSUB

SUB TmpBezier(x0:FLOAT, y0:FLOAT, x1:FLOAT, y1:FLOAT, x2:FLOAT, y2:FLOAT, x3:FLOAT, y3:FLOAT, n:INT, skipFirst:INT)
    INT i, i0
    FLOAT t, u
    IF skipFirst = 1 THEN i0 = 1 ELSE i0 = 0
    FOR i = i0 TO n
        t = FLOAT(i) / FLOAT(n)
        u = 1.0 - t
        TmpAdd((u * u * u * x0) + (3.0 * u * u * t * x1) + (3.0 * u * t * t * x2) + (t * t * t * x3), (u * u * u * y0) + (3.0 * u * u * t * y1) + (3.0 * u * t * t * y2) + (t * t * t * y3))
    NEXT i
ENDSUB

' walks the dense polyline and stores one point every 2 px into enemy e's path buffer
SUB ResampleToEnemy(e:INT, mirror:INT)
    INT i, cnt
    FLOAT acc, px, py, x, y, segLen, need, t

    px = g_tmpX[0]
    IF mirror = 1 THEN px = 223.0 - px
    py = g_tmpY[0]
    g_pathX[e, 0] = px
    g_pathY[e, 0] = py
    cnt = 1
    acc = 0.0

    FOR i = 1 TO g_tmpN - 1
        x = g_tmpX[i]
        IF mirror = 1 THEN x = 223.0 - x
        y = g_tmpY[i]
        segLen = SQRT(((x - px) * (x - px)) + ((y - py) * (y - py)))
        WHILE segLen > 0.0 AND (acc + segLen) >= 2.0
            need = 2.0 - acc
            t = need / segLen
            px = px + ((x - px) * t)
            py = py + ((y - py) * t)
            IF cnt < 420 THEN
                g_pathX[e, cnt] = px
                g_pathY[e, cnt] = py
                cnt = cnt + 1
            ENDIF
            segLen = SQRT(((x - px) * (x - px)) + ((y - py) * (y - py)))
            acc = 0.0
        ENDWHILE
        acc = acc + segLen
        px = x
        py = y
    NEXT i
    g_eLen[e] = cnt
ENDSUB

' templ 0 = A (top left corner, loop low, rise to centre), 1 = B (from the left edge), 2 = C (top right corner),
' 3 = D (from the bottom left). mirror = 1 flips left/right.
SUB BuildEntryPath(e:INT, templ:INT, mirrorIn:INT)
    INT i, mirror
    FLOAT a, r, x
    mirror = mirrorIn
    IF templ = 9 AND (e % 2) = 1 THEN mirror = 1 - mirror
    g_tmpN = 0
    SELECT templ
        CASE 0
            TmpBezier(36.0, -16.0, 36.0, 80.0, 8.0, 112.0, 22.0, 160.0, 60, 0)
            TmpBezier(22.0, 160.0, 36.0, 216.0, 112.0, 220.0, 112.0, 176.0, 60, 1)
            TmpBezier(112.0, 176.0, 112.0, 164.0, 112.0, 152.0, 112.0, 140.0, 60, 1)
        CASE 1
            TmpBezier(-16.0, 196.0, 70.0, 196.0, 134.0, 190.0, 134.0, 154.0, 60, 0)
            TmpBezier(134.0, 154.0, 134.0, 122.0, 98.0, 122.0, 98.0, 154.0, 60, 1)
            TmpBezier(98.0, 154.0, 98.0, 178.0, 112.0, 164.0, 112.0, 140.0, 60, 1)
        CASE 2
            TmpBezier(187.0, -16.0, 187.0, 80.0, 215.0, 112.0, 201.0, 160.0, 60, 0)
            TmpBezier(201.0, 160.0, 187.0, 216.0, 112.0, 220.0, 112.0, 176.0, 60, 1)
            TmpBezier(112.0, 176.0, 112.0, 164.0, 112.0, 152.0, 112.0, 140.0, 60, 1)
        CASE 3
            TmpBezier(-16.0, 250.0, 40.0, 244.0, 76.0, 214.0, 80.0, 172.0, 60, 0)
            TmpBezier(80.0, 172.0, 84.0, 136.0, 40.0, 128.0, 34.0, 166.0, 60, 1)
            TmpBezier(34.0, 166.0, 30.0, 198.0, 96.0, 196.0, 112.0, 140.0, 60, 1)
        CASE 4                                                    ' high sweep from the left edge, loop on the far side
            TmpBezier(-16.0, 56.0, 60.0, 50.0, 150.0, 40.0, 176.0, 84.0, 60, 0)
            TmpBezier(176.0, 84.0, 200.0, 126.0, 150.0, 150.0, 140.0, 118.0, 50, 1)
            TmpBezier(140.0, 118.0, 132.0, 94.0, 112.0, 110.0, 112.0, 140.0, 40, 1)
        CASE 5                                                    ' spiral in from the top centre
            TmpBezier(112.0, -16.0, 112.0, 4.0, 112.0, 24.0, 112.0, 44.0, 20, 0)
            FOR i = 1 TO 105
                a = -1.5707963 + (FLOAT(i) * 0.0623)
                r = 76.0 - (FLOAT(i) * 0.5)
                TmpAdd(112.0 + (r * COS(a)), 120.0 + (r * SIN(a)))
            NEXT i
            TmpBezier(g_tmpX[g_tmpN - 1], g_tmpY[g_tmpN - 1], 112.0, 120.0, 112.0, 130.0, 112.0, 140.0, 20, 1)
        CASE 6                                                    ' long S-curve across the whole screen
            TmpBezier(30.0, -16.0, 30.0, 50.0, 190.0, 40.0, 190.0, 100.0, 60, 0)
            TmpBezier(190.0, 100.0, 190.0, 160.0, 40.0, 140.0, 56.0, 200.0, 60, 1)
            TmpBezier(56.0, 200.0, 70.0, 250.0, 112.0, 200.0, 112.0, 140.0, 50, 1)
        CASE 7                                                    ' rising from below the screen
            TmpBezier(112.0, 306.0, 20.0, 280.0, 20.0, 170.0, 70.0, 130.0, 70, 0)
            TmpBezier(70.0, 130.0, 110.0, 96.0, 160.0, 120.0, 150.0, 156.0, 40, 1)
            TmpBezier(150.0, 156.0, 140.0, 184.0, 112.0, 170.0, 112.0, 140.0, 40, 1)
        CASE 8                                                    ' curtain: each of the 8 drops from its own x
            x = 28.0 + (FLOAT(e % 8) * 24.0)
            TmpBezier(x, -16.0, x, 40.0, x, 70.0, x, 100.0, 40, 0)
            TmpBezier(x, 100.0, x, 130.0, 112.0, 100.0, 112.0, 140.0, 50, 1)
        CASE 9                                                    ' crossing: even enemies from the left, odd from the right
            TmpBezier(-16.0, 120.0, 60.0, 112.0, 150.0, 80.0, 150.0, 110.0, 60, 0)
            TmpBezier(150.0, 110.0, 150.0, 146.0, 100.0, 146.0, 100.0, 110.0, 40, 1)
            TmpBezier(100.0, 110.0, 100.0, 90.0, 112.0, 120.0, 112.0, 140.0, 30, 1)
        CASE 10                                                   ' big lap round the edge of the screen
            TmpBezier(24.0, -16.0, 14.0, 60.0, 14.0, 120.0, 30.0, 170.0, 60, 0)
            TmpBezier(30.0, 170.0, 60.0, 236.0, 164.0, 236.0, 194.0, 170.0, 70, 1)
            TmpBezier(194.0, 170.0, 210.0, 120.0, 210.0, 60.0, 150.0, 70.0, 60, 1)
            TmpBezier(150.0, 70.0, 124.0, 74.0, 112.0, 110.0, 112.0, 140.0, 30, 1)
        CASE 11                                                   ' zigzag down from the top centre
            TmpBezier(112.0, -16.0, 112.0, 20.0, 50.0, 10.0, 50.0, 50.0, 30, 0)
            TmpBezier(50.0, 50.0, 50.0, 80.0, 174.0, 60.0, 174.0, 100.0, 50, 1)
            TmpBezier(174.0, 100.0, 174.0, 130.0, 50.0, 110.0, 50.0, 150.0, 50, 1)
            TmpBezier(50.0, 150.0, 50.0, 176.0, 112.0, 166.0, 112.0, 140.0, 40, 1)
        CASE 12                                                   ' figure eight across the middle of the screen
            TmpBezier(-16.0, 60.0, 60.0, 50.0, 160.0, 70.0, 174.0, 110.0, 50, 0)
            FOR i = 1 TO 100
                a = FLOAT(i) * 0.0628318
                TmpAdd(112.0 + (62.0 * COS(a)), 110.0 + (34.0 * SIN(2.0 * a)))
            NEXT i
            TmpBezier(174.0, 110.0, 170.0, 150.0, 112.0, 170.0, 112.0, 140.0, 40, 1)
        CASE 13                                                   ' three bouncing hops, each lower than the last
            FOR i = 0 TO 120
                a = FLOAT(i) / 120.0
                TmpAdd(-16.0 + (128.0 * a), 190.0 - (120.0 * (1.0 - (0.5 * a)) * ABS(SIN(9.42477796 * a))))
            NEXT i
            TmpBezier(112.0, 190.0, 112.0, 175.0, 112.0, 160.0, 112.0, 140.0, 15, 1)
        CASE 14                                                   ' down the left side, across the bottom, up the right
            TmpBezier(44.0, -16.0, 44.0, 40.0, 44.0, 120.0, 44.0, 170.0, 40, 0)
            TmpBezier(44.0, 170.0, 44.0, 215.0, 180.0, 215.0, 180.0, 170.0, 60, 1)
            TmpBezier(180.0, 170.0, 180.0, 110.0, 140.0, 100.0, 112.0, 140.0, 50, 1)
        CASE 15                                                   ' a pendulum swing from the top left corner
            TmpBezier(20.0, -16.0, 20.0, 100.0, 70.0, 200.0, 112.0, 200.0, 60, 0)
            TmpBezier(112.0, 200.0, 160.0, 200.0, 210.0, 110.0, 206.0, 40.0, 60, 1)
            TmpBezier(206.0, 40.0, 204.0, 10.0, 150.0, 50.0, 112.0, 140.0, 50, 1)
    ENDSELECT
    ResampleToEnemy(e, mirror)
ENDSUB

' bonus-stage paths: they start and end off screen, nobody joins the formation.
' wave 0 / 1 = S sweep from the top left / top right, 2 / 3 = loop-the-loop from the left / right edge,
' wave 4 = zigzag from the top centre
' ---- planetary defence waves: five trains of eight fighters that cross the screen, shoot on the way and leave -------
SUB BuildStreamPath(e:INT, w:INT)
    INT i, pat, mirror
    pat = (w + g_stage) % 5
    mirror = w % 2
    g_tmpN = 0
    IF pat = 0 THEN
        TmpBezier(40.0, -16.0, 40.0, 120.0, 190.0, 80.0, 190.0, 200.0, 70, 0)
        TmpBezier(190.0, 200.0, 190.0, 260.0, 150.0, 290.0, 150.0, 340.0, 40, 1)
    ELSEIF pat = 1 THEN
        TmpBezier(180.0, -16.0, 180.0, 70.0, 40.0, 60.0, 40.0, 170.0, 70, 0)
        TmpBezier(40.0, 170.0, 40.0, 240.0, 160.0, 250.0, 170.0, 340.0, 60, 1)
    ELSEIF pat = 2 THEN
        TmpBezier(-16.0, 50.0, 100.0, 30.0, 160.0, 100.0, 200.0, 190.0, 70, 0)
        TmpBezier(200.0, 190.0, 220.0, 230.0, 240.0, 270.0, 250.0, 320.0, 30, 1)
    ELSEIF pat = 3 THEN
        FOR i = 0 TO 120
            TmpAdd(112.0 + (70.0 * SIN((FLOAT(i) * 0.07) + FLOAT(w))), -16.0 + (FLOAT(i) * 2.9))
        NEXT i
    ELSE
        TmpBezier(112.0, -16.0, 112.0, 100.0, 200.0, 60.0, 200.0, 150.0, 60, 0)
        TmpBezier(200.0, 150.0, 200.0, 230.0, 60.0, 200.0, 60.0, 330.0, 60, 1)
    ENDIF
    ResampleToEnemy(e, mirror)
ENDSUB

SUB BuildChallengePath(e:INT, w:INT)
    INT mirror
    mirror = w % 2
    g_tmpN = 0
    IF w <= 1 THEN
        TmpBezier(24.0, -16.0, 24.0, 140.0, 200.0, 60.0, 190.0, 150.0, 60, 0)
        TmpBezier(190.0, 150.0, 184.0, 230.0, 120.0, 260.0, 110.0, 340.0, 60, 1)
    ELSEIF w <= 3 THEN
        TmpBezier(-16.0, 70.0, 80.0, 70.0, 150.0, 60.0, 150.0, 110.0, 50, 0)
        TmpBezier(150.0, 110.0, 150.0, 160.0, 76.0, 160.0, 76.0, 110.0, 50, 1)
        TmpBezier(76.0, 110.0, 76.0, 70.0, 170.0, 90.0, 250.0, 200.0, 50, 1)
    ELSE
        mirror = 0
        TmpBezier(112.0, -16.0, 112.0, 60.0, 30.0, 60.0, 30.0, 120.0, 40, 0)
        TmpBezier(30.0, 120.0, 30.0, 180.0, 190.0, 150.0, 190.0, 210.0, 50, 1)
        TmpBezier(190.0, 210.0, 190.0, 262.0, 112.0, 250.0, 112.0, 330.0, 50, 1)
    ENDIF
    ResampleToEnemy(e, mirror)
ENDSUB

' attack run: a loop of radius 20 beside the slot, then a swoop to the bottom aimed at x = tx.
' dirsign = +1 loops to the right, -1 to the left.
SUB BuildDivePath(e:INT, x0:FLOAT, y0:FLOAT, tx:FLOAT, dirsign:INT)
    INT i
    FLOAT r, cxl, cyl, a0, a, ex, ey, dirF
    r = 20.0
    dirF = FLOAT(dirsign)
    cxl = x0 + (dirF * r)
    cyl = y0
    IF dirsign > 0 THEN a0 = 3.14159265 ELSE a0 = 0.0
    g_tmpN = 0
    FOR i = 0 TO 90
        a = a0 - (dirF * (FLOAT(i) / 90.0) * 3.926990817)
        TmpAdd(cxl + (r * COS(a)), cyl - (r * SIN(a)))
    NEXT i
    ex = g_tmpX[g_tmpN - 1]
    ey = g_tmpY[g_tmpN - 1]
    TmpBezier(ex, ey, ex + (dirF * 10.0), ey + 80.0, tx + (dirF * 40.0), 200.0, tx, 312.0, 80, 1)
    ResampleToEnemy(e, 0)
ENDSUB

' ===============================================================================
' GAME LOGIC
' ===============================================================================
' formation slot position (it sways and "breathes"); result in g_slotX / g_slotY
SUB GetSlot(r:INT, cc:INT)
    FLOAT sxs, ox, swayAmp, swayFr
    INT stg
    stg = g_stage
    IF stg > 8 THEN stg = 8
    swayAmp = 10.0 + (1.25 * FLOAT(stg))                    ' the whole formation cruises further and faster each stage
    swayFr = 0.02 + (0.0015 * FLOAT(stg))
    sxs = 1.0 + (0.10 * (0.5 + (0.5 * SIN(FLOAT(g_ftick) * 0.03))))
    ox = SIN(FLOAT(g_ftick) * swayFr) * swayAmp
    g_slotX = 112.0 + ox + ((FLOAT(cc) - 4.5) * 16.0 * sxs)
    g_slotY = 48.0 + (FLOAT(r) * 16.0)
ENDSUB

' dive manoeuvres. 0 loop + swoop (the original), 1 kamikaze, 2 zigzag, 3 wide arc, 4 double loop, 5 hairpin,
' 6 spin on the spot, 7 diagonal drift, 8 double-back.
' Every one ends in a swoop to y = 312 at x = tx; dirsign mirrors the sideways part.
SUB BuildDiveT(e:INT, templ:INT, x0:FLOAT, y0:FLOAT, tx:FLOAT, dirsign:INT)
    INT i
    FLOAT d, r, a, a0

    IF templ = 0 THEN
        BuildDivePath(e, x0, y0, tx, dirsign)
        RETURN
    ENDIF

    d = FLOAT(dirsign)
    g_tmpN = 0
    IF templ = 1 THEN
        TmpBezier(x0, y0, x0, y0 + 50.0, tx, 200.0, tx, 312.0, 90, 0)
    ELSEIF templ = 2 THEN
        TmpBezier(x0, y0, x0, y0 + 40.0, x0 + (d * 50.0), y0 + 30.0, x0 + (d * 50.0), y0 + 70.0, 30, 0)
        TmpBezier(x0 + (d * 50.0), y0 + 70.0, x0 + (d * 50.0), y0 + 110.0, x0 - (d * 10.0), y0 + 80.0, x0 - (d * 10.0), y0 + 120.0, 30, 1)
        TmpBezier(x0 - (d * 10.0), y0 + 120.0, x0 - (d * 10.0), y0 + 170.0, tx, 200.0, tx, 312.0, 70, 1)
    ELSEIF templ = 3 THEN
        TmpBezier(x0, y0, x0 + (d * 60.0), y0 - 20.0, x0 + (d * 100.0), y0 + 40.0, x0 + (d * 90.0), y0 + 100.0, 50, 0)
        TmpBezier(x0 + (d * 90.0), y0 + 100.0, x0 + (d * 80.0), y0 + 160.0, tx, 190.0, tx, 312.0, 70, 1)
    ELSEIF templ = 4 THEN
        r = 14.0
        IF dirsign > 0 THEN a0 = 3.14159265 ELSE a0 = 0.0
        FOR i = 0 TO 60                                           ' first full circle, back at the start point
            a = a0 - (d * (FLOAT(i) / 60.0) * 6.2831853)
            TmpAdd(x0 + (d * r) + (r * COS(a)), y0 - (r * SIN(a)))
        NEXT i
        TmpBezier(x0, y0, x0, y0 + 17.0, x0, y0 + 33.0, x0, y0 + 50.0, 12, 1)
        FOR i = 1 TO 60                                           ' second circle, 50 px lower
            a = a0 - (d * (FLOAT(i) / 60.0) * 6.2831853)
            TmpAdd(x0 + (d * r) + (r * COS(a)), y0 + 50.0 - (r * SIN(a)))
        NEXT i
        TmpBezier(x0, y0 + 50.0, x0, y0 + 100.0, tx, 200.0, tx, 312.0, 70, 1)
    ELSEIF templ = 5 THEN
        TmpBezier(x0, y0, x0, y0 + 70.0, x0 + (d * 30.0), y0 + 120.0, x0 + (d * 50.0), y0 + 110.0, 40, 0)
        TmpBezier(x0 + (d * 50.0), y0 + 110.0, x0 + (d * 80.0), y0 + 100.0, x0 + (d * 80.0), y0 + 50.0, x0 + (d * 50.0), y0 + 40.0, 40, 1)
        TmpBezier(x0 + (d * 50.0), y0 + 40.0, x0 + (d * 20.0), y0 + 30.0, tx, 190.0, tx, 312.0, 80, 1)
    ELSEIF templ = 6 THEN                                         ' spin on the spot twice, then drop
        r = 9.0
        IF dirsign > 0 THEN a0 = 3.14159265 ELSE a0 = 0.0
        FOR i = 0 TO 120
            a = a0 - (d * (FLOAT(i) / 60.0) * 6.2831853)
            TmpAdd(x0 + (d * r) + (r * COS(a)), y0 - (r * SIN(a)))
        NEXT i
        TmpBezier(x0, y0, x0, y0 + 24.0, x0, y0 + 46.0, x0, y0 + 70.0, 20, 1)
        TmpBezier(x0, y0 + 70.0, x0, y0 + 120.0, tx, 200.0, tx, 312.0, 70, 1)
    ELSEIF templ = 7 THEN                                         ' diagonal drift, then a late hard turn
        TmpBezier(x0, y0, x0 + (d * 30.0), y0 + 30.0, x0 + (d * 60.0), y0 + 70.0, x0 + (d * 80.0), y0 + 100.0, 50, 0)
        TmpBezier(x0 + (d * 80.0), y0 + 100.0, x0 + (d * 80.0), y0 + 150.0, tx, 200.0, tx, 312.0, 70, 1)
    ELSE                                                          ' double-back: out, up a little, across, down
        TmpBezier(x0, y0, x0, y0 + 60.0, x0 + (d * 70.0), y0 + 70.0, x0 + (d * 70.0), y0 + 40.0, 40, 0)
        TmpBezier(x0 + (d * 70.0), y0 + 40.0, x0 + (d * 70.0), y0 + 10.0, x0 - (d * 50.0), y0 + 10.0, x0 - (d * 50.0), y0 + 70.0, 45, 1)
        TmpBezier(x0 - (d * 50.0), y0 + 70.0, x0 - (d * 50.0), y0 + 130.0, tx, 190.0, tx, 312.0, 70, 1)
    ENDIF
    ResampleToEnemy(e, 0)
ENDSUB

' a diving boss takes up to two butterflies of the row below along: same manoeuvre, fanned out 12 px either side
SUB LaunchEscorts(b:INT, templ:INT, dirF:INT, tx:FLOAT)
    INT k, n, dcol
    FLOAT tx2

    n = 0
    FOR k = 0 TO 39
        IF n < 2 AND g_eState[k] = ES_FORM AND g_eType[k] = 1 AND g_eRow[k] = 1 THEN
            dcol = g_eCol[k] - g_eCol[b]
            IF dcol >= -1 AND dcol <= 1 THEN
                tx2 = tx + (FLOAT((n * 2) - 1) * 12.0)
                BuildDiveT(k, templ, g_eX[k], g_eY[k], tx2, dirF)
                g_ePos[k] = 0.0
                g_eState[k] = ES_DIVE
                g_eShots[k] = 0
                g_eEsc[k] = b
                g_eSpeed[k] = g_eSpeed[b]
                n = n + 1
            ENDIF
        ENDIF
    NEXT k
ENDSUB

SUB SpawnPopup(x:FLOAT, y:FLOAT, v:INT)
    INT i
    FOR i = 0 TO 7
        IF g_popOn[i] = 0 THEN
            g_popOn[i] = 1
            g_popAge[i] = 0
            g_popVal[i] = v
            g_popX[i] = x
            g_popY[i] = y
            RETURN
        ENDIF
    NEXT i
ENDSUB

' ---- power-up prizes -----------------------------------------------------------------------------------------
' types: 1 S spread, 2 R rapid fire, 3 H shield, 4 V speed, 5 L lemon (bad), 6 1UP
' a shuffled bag of 20 capsules: 5 spread, 4 rapid, 4 shield, 3 speed, 3 lemon, 1 extra life. It is emptied before it is refilled,
' so the mix is fair over a game.
SUB FillBag()
    INT i, j, k, tp
    FOR i = 0 TO 19
        IF i < 5 THEN
            tp = 1
        ELSEIF i < 9 THEN
            tp = 2
        ELSEIF i < 13 THEN
            tp = 3
        ELSEIF i < 16 THEN
            tp = 4
        ELSEIF i < 19 THEN
            tp = 5
        ELSE
            tp = 6
        ENDIF
        g_bag[i] = tp
    NEXT i
    FOR k = 0 TO 18
        i = 19 - k
        j = INT(RND(FLOAT(i + 1)))
        IF j > i THEN j = i
        tp = g_bag[i]
        g_bag[i] = g_bag[j]
        g_bag[j] = tp
    NEXT k
    g_bagPos = 0
ENDSUB

' how many upgrade levels a power-up can stack to, and how many shield layers
SUB StackMax(), INT
    IF g_diff = 2 THEN RETURN 1
    RETURN 2
ENDSUB

SUB ShieldMax(), INT
    IF g_diff = 0 THEN RETURN 3
    RETURN 2
ENDSUB

SUB SpawnPrize(x:FLOAT, y:FLOAT)
    INT i, tp

    IF g_bagPos >= 20 THEN FillBag()
    tp = g_bag[g_bagPos]
    IF g_mode = 1 AND g_cStep >= 1 AND g_cStep <= 6 AND g_podDrop = 0 AND g_warpPod = 0 AND g_challenge = 0 THEN
        IF INT(RND(3.0)) = 0 THEN
            tp = 7                                      ' a warp pod: skips the next step of the world (one per stage at most)
            g_podDrop = 1
        ENDIF
    ENDIF
    IF tp <> 7 THEN g_bagPos = g_bagPos + 1
    FOR i = 0 TO 3
        IF g_prOn[i] = 0 THEN
            g_prOn[i] = 1
            g_prType[i] = tp
            g_prAge[i] = 0
            g_prX[i] = x
            g_prY[i] = y
            RETURN
        ENDIF
    NEXT i
ENDSUB

' a survivor of a wrecked ship drifts down (prize type 8)
SUB SpawnSurvivor(x:FLOAT, y:FLOAT)
    INT i
    FOR i = 0 TO 3
        IF g_prOn[i] = 0 THEN
            g_prOn[i] = 1
            g_prType[i] = 8
            g_prAge[i] = 0
            g_prX[i] = x
            g_prY[i] = y
            RETURN
        ENDIF
    NEXT i
ENDSUB

' our own little random generator (the built-in RND gave the same few tunes in the same order)
SUB RngNext(n:INT), INT
    g_rngS = (g_rngS * 1664525) + 1013904223
    RETURN ((g_rngS >> 12) & 0xFFFF) % n
ENDSUB

' the next stage tune: a shuffled "bag" holding every stage tune once; when the bag is empty it is shuffled again,
' and the new bag never starts with the tune that has just been played
SUB NextTune(avoid:INT), INT
    INT i, j, k, tmp, pick

    g_rngS = g_rngS + timeGetTime()
    IF g_tBagPos >= g_tBagN THEN
        g_tBagN = g_nStage
        FOR i = 0 TO g_nStage - 1
            g_tBag[i] = g_stageList[i]
        NEXT i
        FOR k = 0 TO g_nStage - 2
            i = g_nStage - 1 - k
            j = RngNext(i + 1)
            tmp = g_tBag[i]
            g_tBag[i] = g_tBag[j]
            g_tBag[j] = tmp
        NEXT k
        g_tBagPos = 0
        IF g_tBag[0] = avoid AND g_nStage > 1 THEN
            tmp = g_tBag[0]
            g_tBag[0] = g_tBag[g_nStage - 1]
            g_tBag[g_nStage - 1] = tmp
        ENDIF
    ENDIF
    pick = g_tBag[g_tBagPos]
    g_tBagPos = g_tBagPos + 1
    RETURN pick
ENDSUB

' a stage tune that is not the one to avoid
SUB RandTune(avoid:INT), INT
    RETURN NextTune(avoid)
ENDSUB

' starts the tune of the current stage (campaign: boss theme, else one of the five stage themes; arcade: the five in turn)
' bonus stages: the speed of the aliens follows the beat of the waltz (full stop on every beat, push on the first beat of the bar).
' The mean factor is 1, so a wave lasts as long as before. About 1550 samples (70 ms) of audio buffer are taken off the music clock.
SUB DanceFactor(), FLOAT
    INT beatLen, pos, bt, spd
    FLOAT p, f

    IF g_audioOk = 0 THEN RETURN 1.0
    IF g_musSong <> 16 THEN RETURN 1.0
    spd = g_songSpeed[16]
    beatLen = g_mTickLen * spd * 4
    IF beatLen < 8 THEN RETURN 1.0
    pos = ((((g_mRow % 4) * spd) + g_mTick) * g_mTickLen) + g_mSamp - 1550
    bt = (g_mRow / 4) % 3
    IF pos < 0 THEN
        pos = pos + beatLen
        bt = (bt + 2) % 3
    ENDIF
    IF pos >= beatLen THEN pos = beatLen - 1
    p = FLOAT(pos) / FLOAT(beatLen)
    f = 1.0 - COS(6.2831853 * p)
    IF bt = 0 THEN f = f * 1.3 ELSE f = f * 0.85
    RETURN f
ENDSUB

SUB StageMusic()
    IF g_demo = 1 THEN
        g_stMus = 0                                               ' the demo keeps the title tune: nothing to pick
        RETURN
    ENDIF
    IF g_challenge = 1 THEN
        PlayMusic(16, 1)                                          ' bonus stage: the Starlight Waltz (the aliens dance to it)
    ELSEIF g_mode = 1 AND g_cStep >= 9 THEN
        PlayMusic(9, 1)                                           ' the boss theme
    ELSE
        g_lastTune = RandTune(g_lastTune)                          ' a random stage tune, never the one of the last stage;
        PlayMusic(g_lastTune, 2)                                   ' when it ends another one follows
    ENDIF
    g_stMus = 0
ENDSUB

' removes every sprite from the playfield (game over: a clean background for the title)
SUB FlushWorld()
    INT i
    FOR i = 0 TO 39
        g_eState[i] = ES_DEAD
    NEXT i
    FOR i = 0 TO 15
        g_pbOn[i] = 0
        g_exOn[i] = 0
    NEXT i
    FOR i = 0 TO 9
        g_ebOn[i] = 0
    NEXT i
    FOR i = 0 TO 7
        g_popOn[i] = 0
    NEXT i
    FOR i = 0 TO 3
        g_prOn[i] = 0
    NEXT i
    FOR i = 0 TO 31
        g_bbOn[i] = 0
    NEXT i
    g_bsOn = 0
    g_bsDying = 0
    g_invert = 0
    g_flash = 0
    g_grab = 0
ENDSUB

SUB ClearPrizes()
    INT i
    FOR i = 0 TO 3
        g_prOn[i] = 0
    NEXT i
ENDSUB

' ---- boss bombs --------------------------------------------------------------------------------------------------
SUB ClearBombs()
    INT i
    FOR i = 0 TO 3
        g_bmOn[i] = 0
    NEXT i
ENDSUB

' a bomb goes off: everything within 28 pixels is destroyed (aliens, the obstacles that shelter them, capsules, enemy shots, a nearby ship)
SUB DetonateBomb(b:INT)
    INT e, i, eSt
    FLOAT x, y, dx, dy
    x = g_bmX[b]
    y = g_bmY[b]
    g_bmOn[b] = 0
    SpawnExplosion(x, y)
    SpawnExplosion(x - 9.0, y + 3.0)
    SpawnExplosion(x + 9.0, y - 3.0)
    PlaySfx(3)
    FOR e = 0 TO 39
        eSt = g_eState[e]
        IF eSt = ES_ENTER OR eSt = ES_HOME OR eSt = ES_FORM OR eSt = ES_DIVE OR eSt = ES_TRACT THEN
            dx = g_eX[e] - x
            dy = g_eY[e] - y
            IF ((dx * dx) + (dy * dy)) < 784.0 THEN
                g_eHp[e] = 1
                HitEnemy(e)
            ENDIF
        ENDIF
    NEXT e
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 THEN
            dx = g_obX[i] - x
            dy = g_obY[i] - y
            IF ((dx * dx) + (dy * dy)) < 1024.0 THEN
                g_obOn[i] = 0
                SpawnExplosion(g_obX[i], g_obY[i])
            ENDIF
        ENDIF
    NEXT i
    FOR i = 0 TO 3
        IF g_prOn[i] = 1 THEN
            dx = g_prX[i] - x
            dy = g_prY[i] - y
            IF ((dx * dx) + (dy * dy)) < 784.0 THEN g_prOn[i] = 0
        ENDIF
    NEXT i
    FOR i = 0 TO 9
        IF g_ebOn[i] = 1 THEN
            dx = g_ebX[i] - x
            dy = g_ebY[i] - y
            IF ((dx * dx) + (dy * dy)) < 784.0 THEN g_ebOn[i] = 0          ' enemy shots in the blast vanish
        ENDIF
    NEXT i
    FOR i = 0 TO 3
        IF g_bmOn[i] = 1 THEN
            dx = g_bmX[i] - x
            dy = g_bmY[i] - y
            IF ((dx * dx) + (dy * dy)) < 784.0 THEN
                g_bmOn[i] = 0                                ' the neighbouring bomb goes with it
                SpawnExplosion(g_bmX[i], g_bmY[i])
            ENDIF
        ENDIF
    NEXT i
    IF g_palive = 1 THEN
        dx = g_px - x
        dy = g_py - y
        IF ABS(dx) < (24.0 + (8.0 * FLOAT(g_dual))) AND ABS(dy) < 22.0 THEN KillPlayer()
    ENDIF
ENDSUB

' a player shot at (bx, by): 1 if it hit a bomb (which then explodes)
SUB HitBomb(bx:FLOAT, by:FLOAT), INT
    INT i
    FOR i = 0 TO 3
        IF g_bmOn[i] = 1 THEN
            IF ABS(bx - g_bmX[i]) < 8.0 AND ABS(by - g_bmY[i]) < 9.0 THEN
                AddScore(30)
                DetonateBomb(i)
                RETURN 1
            ENDIF
        ENDIF
    NEXT i
    RETURN 0
ENDSUB

' arcade, normal stages 11 and up: a boss in the formation lets a bomb fall now and then (never more than 2 at a time)
SUB UpdateBombs()
    INT i, e, cnt, n, pick, act
    IF g_mode <> 0 OR g_challenge = 1 OR g_swarm > 0 OR g_stream = 1 THEN RETURN
    IF g_stage < 11 OR g_gstate <> GS_PLAY THEN RETURN
    act = 0
    FOR i = 0 TO 3
        IF g_bmOn[i] = 1 THEN
            act = act + 1
            g_bmAge[i] = g_bmAge[i] + 1
            g_bmY[i] = g_bmY[i] + 1.0
            IF g_palive = 1 AND g_bmY[i] >= (g_py - 10.0) THEN
                DetonateBomb(i)                          ' it reaches the ship's level
            ELSEIF g_bmY[i] > 296.0 THEN
                g_bmOn[i] = 0
            ENDIF
        ENDIF
    NEXT i
    IF g_bmCd > 0 THEN
        g_bmCd = g_bmCd - 1
        RETURN
    ENDIF
    IF act >= 2 THEN
        g_bmCd = 60
        RETURN
    ENDIF
    cnt = 0
    FOR e = 0 TO 39
        IF g_eState[e] = ES_FORM AND g_eType[e] = 2 THEN cnt = cnt + 1
    NEXT e
    g_bmCd = 90
    IF cnt = 0 THEN RETURN
    pick = INT(RND(FLOAT(cnt)))
    n = 0
    FOR e = 0 TO 39
        IF g_eState[e] = ES_FORM AND g_eType[e] = 2 THEN
            IF n = pick THEN
                FOR i = 0 TO 3
                    IF g_bmOn[i] = 0 AND n >= 0 THEN
                        g_bmOn[i] = 1
                        g_bmAge[i] = 0
                        g_bmX[i] = g_eX[e]
                        g_bmY[i] = g_eY[e] + 8.0
                        n = -100
                        PlaySfx(5)
                    ENDIF
                NEXT i
            ENDIF
            n = n + 1
        ENDIF
    NEXT e
    g_bmCd = 420 - (12 * (g_stage - 11))
    IF g_bmCd < 220 THEN g_bmCd = 220
    g_bmCd = g_bmCd + INT(RND(120.0))
ENDSUB

SUB DrawBombs()
    INT i, x, y, dy, hf, col
    FOR i = 0 TO 3
        IF g_bmOn[i] = 1 THEN
            x = INT(g_bmX[i])
            y = INT(g_bmY[i])
            FOR dy = -4 TO 4
                hf = INT(4.5 * SQRT(1.0 - (FLOAT(dy * dy) / 20.25)))
                FillRectSolid(x - hf, y + dy, (hf * 2) + 1, 1, 0xFF2A2E3C)
            NEXT dy
            FillRectSolid(x - 3, y - 3, 2, 2, 0xFF8C94AC)
            FillRectSolid(x - 1, y - 6, 3, 2, 0xFF50586A)
            IF ((g_bmAge[i] / 3) % 2) = 0 THEN col = 0xFFFFE650 ELSE col = 0xFFFFFFFF
            PutPix(x, y - 7, col)
            IF ((g_bmAge[i] / (4 + ((296 - y) / 40))) % 2) = 0 THEN col = 0xFFFF3030 ELSE col = 0xFF601818
            FillRectSolid(x - 1, y, 3, 3, col)
        ENDIF
    NEXT i
ENDSUB

' ---- shield obstacles: they are part of the formation. Each one fills two tiles of row 1 (right under the bosses), so no alien is
' ever placed there, and it sways with the formation. It must be shot to pieces; each one drops a capsule ----------------
' the obstacles follow the formation: the middle of their two tiles
SUB ObSync()
    INT i
    FLOAT x0
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 THEN
            GetSlot(1, g_obCol[i])
            x0 = g_slotX
            GetSlot(1, g_obCol[i] + 1)
            g_obX[i] = (x0 + g_slotX) / 2.0
            g_obY[i] = g_slotY + 1.0
        ENDIF
    NEXT i
ENDSUB

' 1 if an obstacle fills the tile (row r, column c) of the formation
SUB TileBlocked(r:INT, c:INT), INT
    INT i
    IF r <> 1 THEN RETURN 0
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 THEN
            IF c = g_obCol[i] OR c = g_obCol[i] + 1 THEN RETURN 1
        ENDIF
    NEXT i
    RETURN 0
ENDSUB

SUB ClearObstacles(blast:INT)
    INT i
    ObSync()
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 AND blast = 1 THEN SpawnExplosion(g_obX[i], g_obY[i])
        g_obOn[i] = 0
    NEXT i
ENDSUB

' arcade only, normal stages 11, 13, 16, 18, 21, 23 ... (never a bonus or swarm stage); 2 obstacles hide the four bosses, 4 from stage 16 on
' (they fill the whole of row 1). The alien that would have stood on a tile is simply not there.
SUB SpawnObstacles()
    INT i, n, k, ot, e
    FOR i = 0 TO 7
        g_obOn[i] = 0
    NEXT i
    IF g_challenge = 1 OR g_swarm > 0 OR g_stream = 1 THEN RETURN
    IF g_mode = 1 THEN
        ' campaign: the orbital stages 3 to 5 of the three first worlds (Cryos: ice blocks, Pyrra: asteroids, Xenos: beacons)
        IF g_cBranch < 0 OR g_cBranch > 2 OR g_cStep < 3 OR g_cStep > 5 THEN RETURN
        n = 2
        IF g_cStep = 5 THEN n = 4
        IF g_cBranch = 0 THEN ot = 2
        IF g_cBranch = 1 THEN ot = 0
        IF g_cBranch = 2 THEN ot = 1
    ELSE
        IF g_stage < 11 THEN RETURN
        k = g_stage % 5
        IF k <> 1 AND k <> 3 THEN RETURN
        n = 2
        IF g_stage >= 16 THEN n = 4
        ot = g_theme
    ENDIF
    FOR i = 0 TO n - 1
        g_obOn[i] = 1
        g_obHp[i] = 5
        g_obFl[i] = 0
        g_obType[i] = ot                                ' arcade: asteroids in the field, beacons at the station, ice blocks in the icy field, hull plates in the derelict fleet
        IF i = 0 THEN g_obCol[i] = 3                    ' the two in front of the bosses first, then the two on the sides
        IF i = 1 THEN g_obCol[i] = 5
        IF i = 2 THEN g_obCol[i] = 1
        IF i = 3 THEN g_obCol[i] = 7
        FOR e = 0 TO 39
            IF g_eRow[e] = 1 AND (g_eCol[e] = g_obCol[i] OR g_eCol[e] = g_obCol[i] + 1) THEN g_eState[e] = ES_DEAD
        NEXT e
    NEXT i
    ObSync()
ENDSUB

' a player shot at (bx, by): 1 if an obstacle stopped it
SUB HitObstacle(bx:FLOAT, by:FLOAT), INT
    INT i
    ObSync()
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 THEN
            IF ABS(bx - g_obX[i]) < 14.0 AND ABS(by - g_obY[i]) < 9.0 THEN
                g_obHp[i] = g_obHp[i] - 1
                IF g_obHp[i] > 0 THEN
                    g_obFl[i] = 6
                    PlaySfx(2)
                ELSE
                    g_obOn[i] = 0
                    AddScore(50)
                    SpawnExplosion(g_obX[i] - 6.0, g_obY[i])
                    SpawnExplosion(g_obX[i] + 6.0, g_obY[i] + 2.0)
                    IF g_obType[i] = 3 AND INT(RND(100.0)) < 45 THEN
                        SpawnSurvivor(g_obX[i], g_obY[i])         ' a wrecked hull plate sometimes hides a survivor
                    ELSE
                        SpawnPrize(g_obX[i], g_obY[i])
                    ENDIF
                    PlaySfx(3)
                ENDIF
                RETURN 1
            ENDIF
        ENDIF
    NEXT i
    RETURN 0
ENDSUB

' one row of the ice block sprite: "." transparent, 1..6 = navy, dark blue, blue, light blue, cyan, pale
SUB IceRow(x:INT, y:INT, s:STRING)
    INT i, c, col
    POINTER p
    p = &s
    FOR i = 0 TO 27
        c = *<CHAR>(p + i)
        IF c <> 46 THEN
            IF c = 49 THEN
                col = 0xFF181F70
            ELSEIF c = 50 THEN
                col = 0xFF283898
            ELSEIF c = 51 THEN
                col = 0xFF3C58C8
            ELSEIF c = 52 THEN
                col = 0xFF648CF0
            ELSEIF c = 53 THEN
                col = 0xFF50D2FF
            ELSE
                col = 0xFFC8F8FF
            ENDIF
            PutPix(x + i, y, col)
        ENDIF
    NEXT i
ENDSUB

' one row of the asteroid sprite: "." transparent, 1..6 = darkest red-brown ... pale sand
SUB AstRow(x:INT, y:INT, s:STRING)
    INT i, c, col
    POINTER p
    p = &s
    FOR i = 0 TO 25
        c = *<CHAR>(p + i)
        IF c <> 46 THEN
            IF c = 49 THEN
                col = 0xFF2C1018
            ELSEIF c = 50 THEN
                col = 0xFF662630
            ELSEIF c = 51 THEN
                col = 0xFF96403C
            ELSEIF c = 52 THEN
                col = 0xFFC47454
            ELSEIF c = 53 THEN
                col = 0xFFE6AE7C
            ELSE
                col = 0xFFF8DCB0
            ENDIF
            PutPix(x + i, y, col)
        ENDIF
    NEXT i
ENDSUB

SUB DrawOneObstacle(x:INT, y:INT, tp:INT, hp:INT, fl:INT)
    INT dy, hf, a, k, col
    IF tp = 0 THEN
        ' asteroid: a rough red-brown rock (26 x 20 pixels)
        AstRow(x - 13, y - 10 + 0, "......113333444...........")
        AstRow(x - 13, y - 10 + 1, "....111232233234555.......")
        AstRow(x - 13, y - 10 + 2, "....22233222334455555.....")
        AstRow(x - 13, y - 10 + 3, "...3333222222333334555....")
        AstRow(x - 13, y - 10 + 4, "...33332222233334444555...")
        AstRow(x - 13, y - 10 + 5, "...22332222233332234454...")
        AstRow(x - 13, y - 10 + 6, "..2223333223333222344544..")
        AstRow(x - 13, y - 10 + 7, "..32333333333333334444443.")
        AstRow(x - 13, y - 10 + 8, "..333321223333223334444443")
        AstRow(x - 13, y - 10 + 9, ".2233322223222223433344433")
        AstRow(x - 13, y - 10 + 10, ".2233332222222223333334433")
        AstRow(x - 13, y - 10 + 11, "11233222211333333343334434")
        AstRow(x - 13, y - 10 + 12, "11122222212344333333333444")
        AstRow(x - 13, y - 10 + 13, "11111112211222233333334343")
        AstRow(x - 13, y - 10 + 14, ".1121112211111123223444211")
        AstRow(x - 13, y - 10 + 15, ".11211112322111233333431..")
        AstRow(x - 13, y - 10 + 16, "...1111111111122233333....")
        AstRow(x - 13, y - 10 + 17, "....111111111222211.......")
        AstRow(x - 13, y - 10 + 18, "......11111222222.........")
        AstRow(x - 13, y - 10 + 19, ".........112211...........")
        IF hp <= 3 THEN
            FOR k = 0 TO 17
                PutPix(x - 2 + (k / 3) + (k % 2), y - 9 + k, 0xFF140606)
            NEXT k
        ENDIF
        IF hp <= 1 THEN
            FOR k = 0 TO 16
                PutPix(x - 9 + k, y + 2 + (k / 4) + (k % 2), 0xFF140606)
            NEXT k
        ENDIF
    ELSEIF tp = 1 THEN
        ' beacon: a steel sphere with a hazard belt, solar wings and a mast (30 x 30 bitmap): intact, dented (hp 3), blown open (hp 1)
        IF g_pBeacon <> 0 THEN
            IF hp <= 1 THEN
                k = 2
            ELSEIF hp <= 3 THEN
                k = 1
            ELSE
                k = 0
            ENDIF
            k = (k * 2) + ((g_tick / 10) % 2)                     ' the lamps blink
            IF fl > 0 THEN a = 1 ELSE a = 0
            DrawSpr(g_pBeacon + (k * 900 * 4), 30, 30, x - 15, y - 16, a)
        ELSE
            FillRectSolid(x - 11, y - 9, 23, 19, 0xFFB0B6C4)
        ENDIF
    ELSEIF tp = 3 THEN
        ' hull plate of a wrecked ship (30 x 22 bitmap), more and more cracked
        IF g_pWreckBg <> 0 THEN
            IF fl > 0 THEN k = 1 ELSE k = 0
            DrawSpr(g_pWreckBg + (4556 * 4), 30, 22, x - 15, y - 11, k)
        ELSE
            FillRectSolid(x - 13, y - 9, 27, 19, 0xFF808AAC)
        ENDIF
        IF hp <= 3 THEN
            FOR k = 0 TO 9
                PutPix(x - 6 + k, y - 8 + k, 0xFF181018)
            NEXT k
        ENDIF
        IF hp <= 1 THEN
            FOR k = 0 TO 11
                PutPix(x + 8 - k, y - 7 + k, 0xFF181018)
            NEXT k
            PutPix(x - 2, y + 1, 0xFFFF7A20)
            PutPix(x + 3, y + 4, 0xFFFFD040)
        ENDIF
    ELSE
        ' ice block: a faceted blue crystal cluster (28 x 20 pixels)
        IceRow(x - 14, y - 10 + 0, ".......353221113332.........")
        IceRow(x - 14, y - 10 + 1, "......455433334555411.......")
        IceRow(x - 14, y - 10 + 2, ".....15554333555541121......")
        IceRow(x - 14, y - 10 + 3, "....145554344555431131......")
        IceRow(x - 14, y - 10 + 4, "...3444443323444332234343...")
        IceRow(x - 14, y - 10 + 5, "13331233211233333333455541..")
        IceRow(x - 14, y - 10 + 6, "155211221111233333333443111.")
        IceRow(x - 14, y - 10 + 7, "1542111111111333333333311111")
        IceRow(x - 14, y - 10 + 8, "1432111333332332233333321111")
        IceRow(x - 14, y - 10 + 9, ".232113455543321223333212211")
        IceRow(x - 14, y - 10 + 10, "..12123345332111223332112111")
        IceRow(x - 14, y - 10 + 11, "...1333333332111222221111111")
        IceRow(x - 14, y - 10 + 12, "...1333343332111122212311...")
        IceRow(x - 14, y - 10 + 13, "...1333443332111122224541...")
        IceRow(x - 14, y - 10 + 14, "...11125433321133333444441..")
        IceRow(x - 14, y - 10 + 15, "......2553332123333333321...")
        IceRow(x - 14, y - 10 + 16, "......3543332223333332111...")
        IceRow(x - 14, y - 10 + 17, "......244332111133333111....")
        IceRow(x - 14, y - 10 + 18, ".......1331111111332211.....")
        IceRow(x - 14, y - 10 + 19, "........111......1211.......")
        IF hp <= 3 THEN
            FOR k = 0 TO 8
                PutPix(x + 1 + (k / 3), y - 9 + k, 0xFFDFF6FF)
            NEXT k
        ENDIF
        IF hp <= 1 THEN
            FOR k = 0 TO 9
                PutPix(x - 9 + k, y + 3 + (k / 3), 0xFFDFF6FF)
                PutPix(x - 6 - (k / 3), y - 8 + k, 0xFFDFF6FF)
            NEXT k
        ENDIF
    ENDIF
    IF fl > 0 THEN
        FOR k = 0 TO 3
            PutPix(x - 9 + ((k * 7) + (fl * 5)) % 19, y - 6 + ((k * 5) + (fl * 3)) % 13, 0xFFFFFFFF)
        NEXT k
        FillRectSolid(x - 1, y - 1, 3, 3, 0xFFFFFFFF)
    ENDIF
ENDSUB

SUB DrawObstacles()
    INT i
    ObSync()
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 THEN
            DrawOneObstacle(INT(g_obX[i]), INT(g_obY[i]), g_obType[i], g_obHp[i], g_obFl[i])
            IF g_obFl[i] > 0 THEN g_obFl[i] = g_obFl[i] - 1
        ENDIF
    NEXT i
ENDSUB

SUB ApplyPrize(t:INT)
    IF t = 5 THEN
        g_lemon = 360
        PlaySfx(13)
        SpawnPopup(g_px, 246.0, -5)
    ELSE
        IF t = 1 AND g_spread < StackMax() THEN g_spread = g_spread + 1
        IF t = 2 AND g_rapid < StackMax() THEN g_rapid = g_rapid + 1
        IF t = 3 AND g_shield < ShieldMax() THEN g_shield = g_shield + 1
        IF t = 4 AND g_pspeed < 3 THEN g_pspeed = g_pspeed + 1
        IF t = 6 THEN g_lives = g_lives + 1
        IF t = 7 THEN g_warpPod = 1
        AddScore(200)
        IF t = 8 THEN
            AddScore(1300)                                  ' a survivor of the fleet: 1500 in all
            g_cosmo = g_cosmo + 1
            IF g_mode = 0 AND (g_cosmo % 3) = 0 AND g_medals < 99 THEN
                g_medals = g_medals + 1                     ' arcade: a medal for every 3 cosmonauts brought home
                SpawnPopup(g_px, 228.0, -9)
            ENDIF
        ENDIF
        IF t = 6 OR t = 7 OR t = 8 THEN PlaySfx(6) ELSE PlaySfx(12)
        SpawnPopup(g_px, 246.0, 0 - t)
    ENDIF
ENDSUB

SUB UpdatePrizes()
    INT i
    FLOAT px

    FOR i = 0 TO 3
        IF g_prOn[i] = 1 THEN
            g_prAge[i] = g_prAge[i] + 1
            g_prY[i] = g_prY[i] + 1.1
            IF g_prY[i] > 292.0 THEN
                g_prOn[i] = 0
            ELSEIF g_palive = 1 AND g_gstate = GS_PLAY AND g_capPhase <> 3 THEN
                px = g_prX[i] + (4.0 * SIN(FLOAT(g_prAge[i]) * 0.1))
                IF ABS(px - g_px) < (12.0 + (8.0 * FLOAT(g_dual))) AND ABS(g_prY[i] - g_py) < 12.0 THEN
                    g_prOn[i] = 0
                    ApplyPrize(g_prType[i])
                ENDIF
            ENDIF
        ENDIF
    NEXT i
ENDSUB

SUB FireBullet(x:FLOAT, vx:FLOAT)
    INT i
    FOR i = 0 TO 15
        IF g_pbOn[i] = 0 THEN
            g_pbOn[i] = 1
            g_pbX[i] = x
            g_pbY[i] = g_py - 8.0
            g_pbVX[i] = vx
            g_stShots = g_stShots + 1
            g_totShots = g_totShots + 1
            RETURN
        ENDIF
    NEXT i
ENDSUB

' one row of a 9-pixel capsule icon: "1" = lit pixel
SUB CapRow(x:INT, y:INT, s:STRING, col:INT)
    INT i
    POINTER p
    p = &s
    FOR i = 0 TO 8
        IF *<CHAR>(p + i) = 49 THEN PutPix(x + i, y, col)
    NEXT i
ENDSUB

' the 9 x 7 pixel symbol of a prize (1 spread, 2 rapid fire, 3 shield, 4 speed, 5 lemon, 6 1UP); x, y = top left
SUB CapIcon(x:INT, y:INT, tp:INT, col:INT)
    IF tp = 1 THEN
        CapRow(x, y, "100010001", col)
        CapRow(x, y + 1, "010010010", col)
        CapRow(x, y + 2, "010010010", col)
        CapRow(x, y + 3, "001010100", col)
        CapRow(x, y + 4, "001010100", col)
        CapRow(x, y + 5, "000111000", col)
        CapRow(x, y + 6, "000010000", col)
    ELSEIF tp = 2 THEN
        CapRow(x, y, "000010000", col)
        CapRow(x, y + 1, "000111000", col)
        CapRow(x, y + 2, "001010100", col)
        CapRow(x, y + 3, "000010000", col)
        CapRow(x, y + 4, "000111000", col)
        CapRow(x, y + 5, "001010100", col)
        CapRow(x, y + 6, "000010000", col)
    ELSEIF tp = 3 THEN
        CapRow(x, y, "111111111", col)
        CapRow(x, y + 1, "100000001", col)
        CapRow(x, y + 2, "100000001", col)
        CapRow(x, y + 3, "010000010", col)
        CapRow(x, y + 4, "001000100", col)
        CapRow(x, y + 5, "000101000", col)
        CapRow(x, y + 6, "000010000", col)
    ELSEIF tp = 4 THEN
        CapRow(x, y, "000000110", col)
        CapRow(x, y + 1, "000001100", col)
        CapRow(x, y + 2, "000011000", col)
        CapRow(x, y + 3, "000111110", col)
        CapRow(x, y + 4, "000001100", col)
        CapRow(x, y + 5, "000011000", col)
        CapRow(x, y + 6, "000110000", col)
    ELSEIF tp = 7 THEN
        CapRow(x, y, "001111100", col)
        CapRow(x, y + 1, "010000010", col)
        CapRow(x, y + 2, "100111001", col)
        CapRow(x, y + 3, "101000101", col)
        CapRow(x, y + 4, "100111001", col)
        CapRow(x, y + 5, "010000010", col)
        CapRow(x, y + 6, "001111100", col)
    ELSEIF tp = 5 THEN
        CapRow(x, y, "011111110", col)
        CapRow(x, y + 1, "111111111", col)
        CapRow(x, y + 2, "100111001", col)
        CapRow(x, y + 3, "100111001", col)
        CapRow(x, y + 4, "111111111", col)
        CapRow(x, y + 5, "010101010", col)
        CapRow(x, y + 6, "001111100", col)
    ELSE
        CapRow(x, y, "000010000", col)
        CapRow(x, y + 1, "000010000", col)
        CapRow(x, y + 2, "000111000", col)
        CapRow(x, y + 3, "001111100", col)
        CapRow(x, y + 4, "011111110", col)
        CapRow(x, y + 5, "110111011", col)
        CapRow(x, y + 6, "100010001", col)
    ENDIF
ENDSUB

' capsule: a pod (17 x 23) with a symbol window; the symbol blinks
SUB DrawCapsule(x:INT, y:INT, tp:INT, age:INT)
    INT bc, lc, slot

    slot = tp - 1
    IF slot < 0 OR slot > 6 THEN slot = 5
    IF tp = 1 THEN
        bc = 0xFF3CE1FF
    ELSEIF tp = 2 THEN
        bc = 0xFFFF8C1E
    ELSEIF tp = 3 THEN
        bc = 0xFF325AFF
    ELSEIF tp = 4 THEN
        bc = 0xFF46E146
    ELSEIF tp = 5 THEN
        bc = 0xFFFFE132
    ELSEIF tp = 7 THEN
        bc = 0xFF9B5CFF
    ELSE
        bc = 0xFFCD46E1
    ENDIF
    IF ((age / 4) % 2) = 0 THEN lc = 0xFFFFFFFF ELSE lc = bc
    IF g_pCaps <> 0 THEN
        DrawSpr(g_pCaps + (((slot * 2) + ((age / 10) % 2)) * 391 * 4), 17, 23, x - 8, y - 11, 0)
    ELSE
        FillRectSolid(x - 7, y - 5, 15, 11, bc)
        FillRectSolid(x - 6, y - 4, 13, 9, 0xFF0C0E28)
    ENDIF
    CapIcon(x - 4, y - 4, tp, lc)
ENDSUB

' falling capsules sway sideways
SUB DrawPrizes()
    INT i
    FOR i = 0 TO 3
        IF g_prOn[i] = 1 THEN
            IF g_prType[i] = 8 THEN
                IF g_pAstro <> 0 THEN DrawSpr(g_pAstro + (((g_prAge[i] / 14) % 2) * 224 * 4), 14, 16, INT(g_prX[i] + (4.0 * SIN(FLOAT(g_prAge[i]) * 0.1))) - 7, INT(g_prY[i]) - 8, 0)
            ELSE
                DrawCapsule(INT(g_prX[i] + (4.0 * SIN(FLOAT(g_prAge[i]) * 0.1))), INT(g_prY[i]), g_prType[i], g_prAge[i])
            ENDIF
        ENDIF
    NEXT i
ENDSUB

' a thin translucent ring (extra shield layers)
SUB DrawRing(cx:INT, cy:INT, r:INT, col:INT, a:INT)
    INT dx, dy, d2, rLo, rHi
    rLo = (r * r) - (2 * r)
    rHi = (r * r) + r
    FOR dy = 0 - r - 1 TO r + 1
        FOR dx = 0 - r - 1 TO r + 1
            d2 = (dx * dx) + (dy * dy)
            IF d2 > rLo AND d2 <= rHi THEN BlendPix(cx + dx, cy + dy, col, a)
        NEXT dx
    NEXT dy
ENDSUB

' shield: a flickering ring around each ship, blinking during the last 2 seconds
SUB DrawShield()
    INT s, cx

    IF g_shield <= 0 OR g_palive = 0 OR g_capPhase = 3 THEN RETURN
    IF g_shHit > 0 AND ((g_tick / 3) % 2) = 1 THEN RETURN          ' flickers while a layer is breaking
    FOR s = 0 TO g_dual
        IF g_dual = 1 THEN cx = INT(g_px) + ((s * 16) - 8) ELSE cx = INT(g_px)
        DrawBubble(cx, INT(g_py))
        IF g_shield >= 2 THEN DrawRing(cx, INT(g_py), 16, 0xFF8CF0FF, 120)
        IF g_shield >= 3 THEN DrawRing(cx, INT(g_py), 19, 0xFF8CF0FF, 90)
    NEXT s
ENDSUB

' one power bar: the symbol of the capsule, then a little trough of mx segments of which n are lit (x, y = top left; 10 + 5 * mx + 2 wide, 7 high)
SUB HudBar(x:INT, y:INT, tp:INT, n:INT, mx:INT, col:INT, hi:INT, dk:INT)
    INT i, sx
    IF n > 0 THEN CapIcon(x, y, tp, col) ELSE CapIcon(x, y, tp, 0xFF30344C)
    FillRectSolid(x + 10, y, (mx * 5) + 2, 7, 0xFF3C4468)                 ' the trough: light rim on the top and left, dark inside
    FillRectSolid(x + 11, y + 1, (mx * 5) + 1, 6, 0xFF0C1024)
    FOR i = 0 TO mx - 1
        sx = x + 11 + (i * 5)
        IF i < n THEN
            FillRectSolid(sx, y + 2, 4, 4, col)
            FillRectSolid(sx, y + 2, 4, 1, hi)                         ' a shine on every lit segment
            FillRectSolid(sx, y + 5, 4, 1, dk)
        ELSE
            FillRectSolid(sx, y + 2, 4, 4, dk)
        ENDIF
    NEXT i
ENDSUB

' the four power bars, top right: spread, rapid fire (upper row), shield, speed (lower row); a blinking lemon next to them when it is active
SUB DrawPowerHud()
    HudBar(170, 3, 1, g_spread, StackMax(), 0xFF3CE1FF, 0xFFB4F4FF, 0xFF0E3038)
    HudBar(170, 12, 2, g_rapid, StackMax(), 0xFFFF8C1E, 0xFFFFD6A0, 0xFF3A2008)
    HudBar(195, 3, 3, g_shield, ShieldMax(), 0xFF3C78FF, 0xFFB4CCFF, 0xFF0C1A44)
    HudBar(195, 12, 4, g_pspeed, 3, 0xFF46E146, 0xFFC0FFC0, 0xFF0E300E)
    IF g_lemon > 0 THEN
        IF ((g_tick / 6) % 2) = 0 THEN CapIcon(156, 12, 5, 0xFFFFE132)
    ENDIF
ENDSUB

' the name shown when a prize is caught (negative popup values)
SUB DrawPopupText(x:INT, y:INT, id:INT, col:INT)
    INT w, x0

    w = 30
    IF id = -1 OR id = -3 THEN w = 36
    IF id = -6 THEN w = 18
    IF id = -7 THEN w = 24
    IF id = -8 THEN w = 48
    IF id = -9 THEN w = 30
    x0 = x - (w / 2)
    IF x0 < 2 THEN x0 = 2
    IF x0 > 222 - w THEN x0 = 222 - w
    IF id = -1 THEN
        DrawGlyphText(x0, y, "SPREAD", col, 1)
    ELSEIF id = -2 THEN
        DrawGlyphText(x0, y, "RAPID", col, 1)
    ELSEIF id = -3 THEN
        DrawGlyphText(x0, y, "SHIELD", col, 1)
    ELSEIF id = -4 THEN
        DrawGlyphText(x0, y, "SPEED", col, 1)
    ELSEIF id = -5 THEN
        DrawGlyphText(x0, y, "LEMON", col, 1)
    ELSEIF id = -7 THEN
        DrawGlyphText(x0, y, "WARP", col, 1)
    ELSEIF id = -8 THEN
        DrawGlyphText(x0, y, "SURVIVOR", col, 1)
    ELSEIF id = -9 THEN
        DrawGlyphText(x0, y, "MEDAL", 0xFFFFD84A, 1)
    ELSE
        DrawGlyphText(x0, y, "1UP", col, 1)
    ENDIF
ENDSUB

SUB SpawnExplosion(x:FLOAT, y:FLOAT)
    INT i, p
    FLOAT ang, spd
    FOR i = 0 TO 15
        IF g_exOn[i] = 0 THEN
            g_exOn[i] = 1
            g_exAge[i] = 0
            g_exX[i] = x
            g_exY[i] = y
            FOR p = 0 TO 15
                ang = FLOAT(p) * 0.3926991                 ' the original shape: a 16-ray starburst, every other ray shorter
                spd = 1.0
                IF (p % 2) = 1 THEN spd = 0.6
                spd = spd * (0.92 + RND(0.16))
                g_xpX[(i * 24) + p] = x
                g_xpY[(i * 24) + p] = y
                g_xpVX[(i * 24) + p] = COS(ang) * spd
                g_xpVY[(i * 24) + p] = SIN(ang) * spd
            NEXT p
            RETURN
        ENDIF
    NEXT i
ENDSUB

' aimed at the player's ship (y = 264)
SUB SpawnEBullet(x:FLOAT, y:FLOAT, speed:FLOAT)
    INT i, n, capN
    FLOAT dx, dy, d, drift
    n = 0
    FOR i = 0 TO 9
        IF g_ebOn[i] = 1 THEN n = n + 1
    NEXT i
    capN = 4 + (g_stage / 2)                            ' only so many shots in the air, more as the stages go on
    IF g_diff = 0 THEN capN = capN - 1
    IF capN > 10 THEN capN = 10
    IF n >= capN THEN RETURN
    drift = 0.12 * FLOAT(g_stage)                        ' shots wander a little off the aim line
    IF drift > 0.8 THEN drift = 0.8
    FOR i = 0 TO 9
        IF g_ebOn[i] = 0 THEN
            dx = g_px - x
            dy = g_py - y
            d = SQRT((dx * dx) + (dy * dy))
            IF d < 1.0 THEN d = 1.0
            g_ebOn[i] = 1
            g_ebKind[i] = g_nextKind
            g_ebX[i] = x
            g_ebY[i] = y
            g_ebVX[i] = ((dx / d) * speed) + ((RND(2.0) - 1.0) * drift)
            g_ebVY[i] = (dy / d) * speed
            IF g_nextStraight = 1 THEN
                g_ebVX[i] = 0.0                                   ' the jets only shoot straight ahead
                g_ebVY[i] = speed
            ENDIF
            PlaySfx(5)
            RETURN
        ENDIF
    NEXT i
ENDSUB

' ---- difficulty: easy / normal / hard -------------------------------------------------------------------------
SUB DiffPrize(), INT
    IF g_diff = 0 THEN RETURN 8                       ' kills between two capsule drops
    IF g_diff = 2 THEN RETURN 18
    RETURN 12
ENDSUB

SUB DiffTractor(), FLOAT
    IF g_diff = 0 THEN RETURN 0.25
    IF g_diff = 2 THEN RETURN 0.5
    RETURN 0.4
ENDSUB

SUB DiffDiveSpeed(), FLOAT
    IF g_diff = 0 THEN RETURN 0.85
    IF g_diff = 2 THEN RETURN 1.1
    RETURN 1.0
ENDSUB

SUB DiffAllOut(), INT
    IF g_diff = 0 THEN RETURN 4
    IF g_diff = 2 THEN RETURN 7
    RETURN 6
ENDSUB

' dive timer multiplier in tenths: bigger = longer pauses between attacks
SUB DiffPace(), INT
    IF g_diff = 0 THEN RETURN 14
    IF g_diff = 2 THEN RETURN 8
    RETURN 10
ENDSUB

SUB DiffShots(), INT
    IF g_diff = 0 THEN RETURN 1
    RETURN 2
ENDSUB

SUB DiffFire(), FLOAT
    IF g_diff = 0 THEN RETURN 0.022
    IF g_diff = 2 THEN RETURN 0.045
    RETURN 0.035
ENDSUB

SUB DiffBulletSpeed(), FLOAT
    IF g_diff = 0 THEN RETURN 0.8
    IF g_diff = 2 THEN RETURN 1.12
    RETURN 1.0
ENDSUB

SUB StartDive(e:INT)
    INT dirF, templ, avail, thin
    FLOAT tx
    IF g_eType[e] = 2 AND g_capPhase = 0 AND g_heldShip = 0 AND g_dual = 0 AND g_resc = 0 AND g_palive = 1 AND g_challenge = 0 AND g_stage >= 2 AND g_capCool <= 0 THEN
        IF RND(1.0) < DiffTractor() THEN
            StartTractor(e)
            RETURN
        ENDIF
    ENDIF
    dirF = 1
    IF g_eX[e] >= 112.0 THEN dirF = -1
    IF RND(1.0) < 0.3 THEN dirF = -dirF
    tx = g_px + (RND(80.0) - 40.0)
    avail = 2 + g_stage                            ' stage 1: 3 manoeuvres ... stage 7 and up: all 9
    IF avail > 9 THEN avail = 9
    templ = INT(RND(FLOAT(avail)))
    thin = 40 - AliveCount()                       ' how far the formation has thinned out
    IF thin < 0 THEN thin = 0
    IF thin > 30 THEN thin = 30
    BuildDiveT(e, templ, g_eX[e], g_eY[e], tx, dirF)
    g_ePos[e] = 0.0
    g_eState[e] = ES_DIVE
    g_eShots[e] = 0
    g_eEsc[e] = -1
    g_eSpeed[e] = 1.2 + (0.05 * FLOAT(g_stage)) + (0.01 * FLOAT(thin))
    IF templ = 1 THEN g_eSpeed[e] = g_eSpeed[e] * 1.25
    g_eSpeed[e] = g_eSpeed[e] * DiffDiveSpeed()
    IF g_eType[e] = 3 THEN
        g_eSpeed[e] = g_eSpeed[e] * 1.25                ' spiders are quick and bite instead of shooting
        g_eShots[e] = 9
    ENDIF
    IF g_eType[e] = 7 THEN
        g_eSpeed[e] = g_eSpeed[e] * 0.85                ' octopuses swim slowly and grab the ship
    ENDIF
    IF g_eType[e] = 2 THEN LaunchEscorts(e, templ, dirF, tx)
ENDSUB

SUB CountState(s:INT), INT
    INT e, n
    n = 0
    FOR e = 0 TO 39
        IF g_eState[e] = s THEN n = n + 1
    NEXT e
    RETURN n
ENDSUB

SUB AliveCount(), INT
    INT e, n
    n = 0
    FOR e = 0 TO 39
        IF g_eState[e] <> ES_DEAD THEN n = n + 1
    NEXT e
    IF g_bsOn = 1 THEN n = n + 1                  ' a big boss counts until its explosion is over
    IF g_crOn = 1 THEN n = n + 1                  ' so does the carrier
    RETURN n
ENDSUB

' accuracy bonus: from 50% hits, every 5% slice adds 5% to the points earned in the stage (50% = +5% ... 100% = +55%)
SUB AccuracyBonus()
    INT gained
    g_accBonus = 0
    g_accPts = 0
    g_accPct = 0
    IF g_stShots > 0 THEN g_accPct = (g_stHits * 100) / g_stShots
    IF g_stShots < 10 OR g_accPct < 50 THEN RETURN      ' too few shots to judge: no bonus
    g_accBonus = (((g_accPct - 50) / 5) + 1) * 5
    gained = g_score - g_stScore0
    IF gained < 0 THEN gained = 0
    g_accPts = (gained * g_accBonus) / 100
    IF g_accPts > 0 THEN AddScore(g_accPts)
ENDSUB

SUB AddScore(pts:INT)
    g_score = g_score + pts
    IF g_score > g_hiscore THEN g_hiscore = g_score
    IF g_score >= g_nextLife THEN
        g_lives = g_lives + 1
        IF g_nextLife = 20000 THEN g_nextLife = 70000 ELSE g_nextLife = g_nextLife + 70000
        PlaySfx(6)
    ENDIF
ENDSUB

' stage 1 keeps the classic five waves; later stages pick from more and more of the 12 entry patterns
SUB PickRecipe()
    INT w, t, avail, prev, m

    m = g_stage - (g_stage / 10)                    ' number of this stage among the normal (non bonus) ones
    g_useLevel = 0
    IF g_challenge = 0 AND (m % 2) = 1 THEN
        g_useLevel = 1                              ' every other normal stage plays one of the 15 XGalaga levels in order
        g_lvl = ((m - 1) / 2) % 15
    ENDIF
    IF g_stage <= 1 THEN
        FOR w = 0 TO 4
            g_rTempl[w] = g_wTempl[w]
            g_rMirror[w] = g_wMirror[w]
        NEXT w
        RETURN
    ENDIF
    avail = 6 + (g_stage * 2)
    IF avail > 16 THEN avail = 16
    prev = -1
    FOR w = 0 TO 4
        t = INT(RND(FLOAT(avail)))
        IF t = prev THEN t = (t + 1) % avail
        g_rTempl[w] = t
        g_rMirror[w] = INT(RND(2.0))
        prev = t
    NEXT w
ENDSUB

' ---- XGalaga level data ----------------------------------------------------------------------------------------
' A path is a start point plus steps (heading, frames). Headings run clockwise: 0 north, 4 east, 8 south, 12 west. Every
' frame the alien moves 5 units of XGalaga's 400 x 500 field; scaled by 0.56 / 0.576 into our 224 x 288 screen.
' tok = 3 characters per step: heading in hex, frames as 2 digits.
SUB XgPath(id:INT, x:INT, y:INT, tok:STRING)
    INT i, n, c1, c2, c3
    POINTER p

    p = &tok
    n = LEN(tok) / 3
    IF n > 48 THEN n = 48
    g_xgSX[id] = FLOAT(x)
    g_xgSY[id] = FLOAT(y)
    g_xgN[id] = n
    FOR i = 0 TO n - 1
        c1 = *<CHAR>(p + (i * 3))
        c2 = *<CHAR>(p + (i * 3) + 1)
        c3 = *<CHAR>(p + (i * 3) + 2)
        IF c1 >= 97 THEN c1 = c1 - 87 ELSE c1 = c1 - 48
        g_xgDir[(id * 48) + i] = c1
        g_xgDur[(id * 48) + i] = ((c2 - 48) * 10) + (c3 - 48)
    NEXT i
ENDSUB

' one row of a level's path grid: 10 characters, '-' = empty slot, 0-9 / a-q = path id.
' Levels 9 and 12 define their own h..q (the weaving columns), stored as ids 27-36 and 37-46.
SUB LvPaths(l:INT, r:INT, txt:STRING)
    INT c, cc, id
    POINTER p

    p = &txt
    FOR c = 0 TO 9
        cc = *<CHAR>(p + c)
        id = -1
        IF cc >= 48 AND cc <= 57 THEN id = cc - 48
        IF cc >= 97 AND cc <= 113 THEN id = cc - 87
        IF id >= 17 AND l = 8 THEN id = id + 10
        IF id >= 17 AND id <= 26 AND l = 11 THEN id = id + 20
        g_lvPath[(l * 60) + (r * 10) + c] = id
    NEXT c
ENDSUB

' one row of the launch delays: ten groups of three digits (or ---) separated by spaces
SUB LvDelays(l:INT, r:INT, txt:STRING)
    INT c, o, c1, c2, c3
    POINTER p

    p = &txt
    FOR c = 0 TO 9
        o = c * 4
        c1 = *<CHAR>(p + o)
        c2 = *<CHAR>(p + o + 1)
        c3 = *<CHAR>(p + o + 2)
        IF c1 = 45 THEN
            g_lvDelay[(l * 60) + (r * 10) + c] = -1
        ELSE
            g_lvDelay[(l * 60) + (r * 10) + c] = ((c1 - 48) * 100) + ((c2 - 48) * 10) + (c3 - 48)
        ENDIF
    NEXT c
ENDSUB

