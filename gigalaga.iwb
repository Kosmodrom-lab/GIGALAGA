SUB BuildXgPath(e:INT, pid:INT)
    INT k, f, n, d
    FLOAT x, y, a, vx, vy

    g_tmpN = 0
    n = g_xgN[pid]
    x = g_xgSX[pid] * 0.56
    y = g_xgSY[pid] * 0.576
    TmpAdd(x, y)
    FOR k = 0 TO n - 1
        d = g_xgDir[(pid * 48) + k]
        a = FLOAT(d) * 0.3926991
        vx = 5.0 * SIN(a) * 0.56
        vy = 0.0 - (5.0 * COS(a) * 0.576)
        FOR f = 1 TO g_xgDur[(pid * 48) + k]
            x = x + vx
            y = y + vy
            TmpAdd(x, y)
        NEXT f
    NEXT k
    ResampleToEnemy(e, 0)
ENDSUB

' path and launch delay of one of our 40 slots, taken from the current level's grid (same column; when that cell is empty the
' nearest filled one below it, a little later so the two do not fly on top of each other)
SUB LevelSlot(e:INT)
    INT r, c, k, tr, idx, pid, dl, steps
    FLOAT sc

    r = g_eRow[e]
    c = g_eCol[e]
    pid = -1
    dl = 0
    steps = 0
    FOR k = 0 TO 2
        tr = r + k
        IF pid < 0 AND tr <= 5 THEN
            idx = (g_lvl * 60) + (tr * 10) + c
            IF g_lvPath[idx] >= 0 THEN
                pid = g_lvPath[idx]
                dl = g_lvDelay[idx]
                steps = k
            ENDIF
        ENDIF
    NEXT k
    IF pid < 0 OR pid > 46 THEN pid = 1
    IF g_xgN[pid] = 0 THEN pid = 1
    sc = 0.02 * FLOAT(g_stage)
    IF sc > 0.3 THEN sc = 0.3
    g_eDelay[e] = 40 + INT(FLOAT(dl) * 1.05 * (1.0 - sc)) + (steps * 14)
    BuildXgPath(e, pid)
ENDSUB

' percent of the bottom-row aliens that are spiders: none on stage 1, then more and more
SUB SpiderPct(), INT
    INT p
    p = 10 + (3 * g_stage)
    IF p > 40 THEN p = 40
    IF g_diff = 0 THEN p = p / 2
    RETURN p
ENDSUB

' percent of the bees that are splitters / of the butterflies that are orbiters
SUB SplitPct(), INT
    INT p
    p = 6 + (2 * g_stage)
    IF p > 24 THEN p = 24
    IF g_diff = 0 THEN p = p / 2
    RETURN p
ENDSUB

SUB OrbPct(), INT
    INT p
    p = 8 + (2 * g_stage)
    IF p > 30 THEN p = 30
    IF g_diff = 0 THEN p = p / 2
    RETURN p
ENDSUB

' a splitter has been shot: two small fast fragments dive out of it (they use free enemy slots)
SUB SpawnFragments(x:FLOAT, y:FLOAT)
    INT f, made
    FLOAT tx
    made = 0
    FOR f = 0 TO 39
        IF made < 2 AND g_eState[f] = ES_DEAD THEN
            tx = g_px + (FLOAT((made * 2) - 1) * 24.0)
            g_eType[f] = 6
            g_eHp[f] = 1
            g_eRow[f] = 0
            g_eCol[f] = 0
            g_eEsc[f] = -1
            g_eShots[f] = 9
            g_eX[f] = x
            g_eY[f] = y
            g_eAng[f] = 0.0
            BuildDiveT(f, 3, x, y, tx, (made * 2) - 1)
            g_ePos[f] = 0.0
            g_eSpeed[f] = (1.9 + (0.05 * FLOAT(g_stage))) * DiffDiveSpeed()
            g_eState[f] = ES_DIVE
            made = made + 1
        ENDIF
    NEXT f
ENDSUB

' the little ball that circles an orbiter until it is shot off
SUB DrawOrb(x:INT, y:INT, e:INT)
    FLOAT a
    INT ox, oy
    a = (FLOAT(g_tick) * 0.13) + FLOAT(e)
    ox = x + INT(12.0 * COS(a))
    oy = y + INT(10.0 * SIN(a))
    FillRectSolid(ox - 1, oy - 1, 3, 3, 0xFFFFE132)
    PutPix(ox, oy, 0xFFFFFFFF)
ENDSUB

' "STAGE n" centred on the screen whatever the number of digits
SUB DrawStageBanner(y:INT)
    INT nd, x0
    nd = 1
    IF g_stage >= 10 THEN nd = 2
    IF g_stage >= 100 THEN nd = 3
    x0 = 112 - (3 * (6 + nd))
    DrawGlyphText(x0, y, "STAGE", 0xFF3CE1FF, 1)
    DrawNumber(x0 + 36 + (6 * nd) - 1, y, g_stage, 0xFF3CE1FF)
ENDSUB

' percent of the bees that are octopuses (from stage 5)
SUB OctoPct(), INT
    INT p
    p = 4 + (2 * g_stage)
    IF p > 18 THEN p = 18
    IF g_diff = 0 THEN p = p / 2
    RETURN p
ENDSUB


SUB StartStage()
    INT e, w, k, i, gap, mir, keepTune
    g_stage = g_stage + 1
    g_theme = ((g_stage - 1) / 2) % 4                 ' the backdrop (and the obstacles that go with it) changes every 2 stages
    g_cosT = 600                                       ' the first cosmonaut drifts out after 10 s
    IF g_mode = 0 OR g_cBranch >= 0 THEN
        IF DerelictOn() = 1 THEN
            g_hkY = -50.0                              ' derelict fleet: the giant carrier comes in from the top
            g_hkX = 4.0 + RND(66.0)
        ENDIF
    ENDIF
    IF g_mode = 0 THEN g_stream = 0
    ClearObstacles(0)
    ClearBombs()
    g_bmCd = 360
    g_podDrop = 0
    g_crOn = 0
    g_crDone = 0
    g_stT = 0
    g_skin = ((g_stage - 1) / 5) % 4                 ' new look every 5 stages
    IF g_mode = 1 AND g_cBranch >= 0 THEN
        g_skin = 2                                  ' campaign: enemy colours that stand out from the scenery (ember: orange / yellow / cyan)
        IF g_cBranch = 1 THEN g_skin = 1            ' lava planet (red browns): frost skin, ice blue / teal / pink
        IF g_cBranch = 3 THEN g_skin = 3            ' empire (dark purple): toxic skin, lime / magenta
    ENDIF
    IF (g_stage % 10) = 0 THEN g_challenge = 1 ELSE g_challenge = 0      ' a bonus stage every 10 levels: 10, 20, 30 ...
    IF g_mode = 1 THEN g_challenge = 0
    g_grab = 0
    g_grabCool = 0
    keepTune = 0                                    ' perpetual music: a stage tune that is already running goes on from stage to stage;
    IF g_demo = 0 AND g_challenge = 0 AND g_musLoop = 2 AND g_musSong <> 0 THEN keepTune = 1
    IF g_mode = 1 AND g_cStep >= 9 THEN keepTune = 0         ' only the bonus waltz and the boss battle interrupt it
    IF keepTune = 1 THEN
        g_stMus = 0
    ELSE
        StopMusic()                                 ' (title tune, waltz, boss theme...) the stage tune starts in the next frame
        g_stMus = 1
    ENDIF
    g_bsOn = 0
    g_swarm = 0
    IF g_challenge = 0 AND g_stage >= 9 AND (g_stage % 10) = 9 THEN g_swarm = 1 + (((g_stage - 9) / 10) % 3)     ' the stage before each bonus stage, from 9: one species only
    IF g_mode = 1 THEN g_swarm = g_cForce                  ' campaign: only the boss wave is a swarm (placeholder until the big bosses)
    g_chHits = 0
    g_stShots = 0
    g_stHits = 0
    g_stScore0 = g_score
    g_accBonus = 0
    g_accPts = 0
    PickRecipe()
    FOR w = 0 TO 4
        g_rSplit[w] = 0                                  ' some waves arrive from both sides at once
        IF g_stage >= 2 AND g_rTempl[w] <> 9 AND RND(100.0) < 35.0 THEN g_rSplit[w] = 1
    NEXT w
    gap = 150 - (6 * g_stage)
    IF gap < 90 THEN gap = 90
    FOR w = 0 TO 4
        FOR k = 0 TO 7
            e = (w * 8) + k
            g_eRow[e] = g_wRow[e]
            g_eCol[e] = g_wCol[e]
            g_eState[e] = ES_WAIT
            IF g_eRow[e] = 0 THEN
                g_eType[e] = 2
                g_eHp[e] = 2
            ELSEIF g_eRow[e] <= 2 THEN
                g_eType[e] = 1
                g_eHp[e] = 1
            ELSE
                g_eType[e] = 0
                g_eHp[e] = 1
            ENDIF
            g_eDelay[e] = 40 + (w * gap) + (k * 7)
            IF g_stream = 1 THEN g_eDelay[e] = 40 + (w * 120) + (k * 8)
            IF g_stream = 1 AND g_mode = 1 THEN
                ' campaign planetary defence: only the three fighter types (interceptor, striker, heavy), one kind per wave
                g_eType[e] = 8 + (w % 3)
                g_eHp[e] = 1
                IF g_eType[e] = 10 THEN g_eHp[e] = 2
                IF g_cBranch = 2 THEN
                    ' the Hive planet: living weapons instead of jets - blade mantis, acid spitter, carapace guard
                    g_eType[e] = 11 + (w % 3)
                    g_eHp[e] = 1 + (w % 3)
                ENDIF
            ENDIF
            IF g_challenge = 1 THEN
                g_eHp[e] = 1
                IF w = 4 THEN g_eType[e] = k % 2 ELSE g_eType[e] = w % 2
                g_eDelay[e] = 40 + (w * 130) + (k * 8)
            ENDIF
            IF g_challenge = 0 AND g_stage >= 2 AND g_eRow[e] >= 3 AND g_eType[e] < 8 THEN
                IF RND(100.0) < FLOAT(SpiderPct()) THEN g_eType[e] = 3      ' some of the bees are spiders
            ENDIF
            IF g_challenge = 0 AND g_stage >= 3 AND g_eType[e] = 0 THEN
                IF RND(100.0) < FLOAT(SplitPct()) THEN g_eType[e] = 4      ' ... and some are splitters
            ENDIF
            IF g_challenge = 0 AND g_stage >= 4 AND g_eType[e] = 1 THEN
                IF RND(100.0) < FLOAT(OrbPct()) THEN
                    g_eType[e] = 5                                           ' some butterflies are orbiters (two hits)
                    g_eHp[e] = 2
                ENDIF
            ENDIF
            IF g_challenge = 0 AND g_stage >= 5 AND g_eType[e] = 0 THEN
                IF RND(100.0) < FLOAT(OctoPct()) THEN
                    g_eType[e] = 7                                           ' ... and a few are octopuses (two hits)
                    g_eHp[e] = 2
                ENDIF
            ENDIF
            IF g_swarm > 0 THEN
                IF g_swarm = 1 THEN g_eType[e] = 3
                IF g_swarm = 2 THEN g_eType[e] = 4
                IF g_swarm = 3 THEN g_eType[e] = 5
                g_eHp[e] = 1
                IF g_swarm = 3 THEN g_eHp[e] = 2
            ENDIF
            g_eShots[e] = 0
            g_eEsc[e] = -1
            g_eAng[e] = 0.0
            g_ePos[e] = 0.0
            g_eSpeed[e] = 1.0
            g_eX[e] = -50.0
            g_eY[e] = -50.0
            IF g_challenge = 1 THEN
                BuildChallengePath(e, w)
            ELSEIF g_stream = 1 THEN
                BuildStreamPath(e, w)
            ELSEIF g_useLevel = 1 THEN
                LevelSlot(e)
            ELSE
                mir = g_rMirror[w]
                IF g_rSplit[w] = 1 AND (k % 2) = 1 THEN mir = 1 - mir
                BuildEntryPath(e, g_rTempl[w], mir)
            ENDIF
        NEXT k
    NEXT w
    g_ftick = 0
    g_diveTimer = 300
    g_attackHold = 0
    FOR i = 0 TO 9
        g_ebOn[i] = 0
    NEXT i
    FOR i = 0 TO 15
        g_pbOn[i] = 0
    NEXT i
    ClearPrizes()
    SpawnObstacles()
ENDSUB

SUB NewGame()
    g_bank = 0.0
    g_cosmo = 0
    g_medals = 0
    g_nameRank = -1
    g_score = 0
    IF g_diff = 0 THEN g_lives = 4 ELSE g_lives = 3
    g_nextLife = 20000
    g_stage = 0
    g_px = 112.0
    g_py = 264.0
    g_palive = 1
    g_dual = 0
    g_resc = 0
    g_heldShip = 0
    g_capPhase = 0
    g_capCool = 0
    g_capBoss = -1
    g_capMsg = 0
    g_flash = 0
    g_spread = 0
    g_rapid = 0
    g_pspeed = 0
    g_shield = ShieldMax()
    g_shHit = 0
    g_bagPos = 20
    g_prWait = 14
    g_lemon = 0
    g_warp = 1.0
    g_totShots = 0
    g_totHits = 0
    g_bossCheat = 0
    IF g_mode = 1 THEN
        CampInit()
        g_gtimer = 0
        IF g_cSaveDone > 0 THEN PlayMusic(1, 1) ELSE PlayMusic(12, 1)          ' a new campaign opens with the briefing room tune
        IF g_cSaveDone > 0 THEN
            g_cDone = g_cSaveDone                          ' continue: back on the galaxy map with the saved score
            g_score = g_cSaveScore
            IF g_lives < g_cSaveLives THEN g_lives = g_cSaveLives
            g_nextLife = 20000
            WHILE g_score >= g_nextLife
                IF g_nextLife = 20000 THEN g_nextLife = 70000 ELSE g_nextLife = g_nextLife + 70000
            ENDWHILE
            g_gstate = GS_MAP
            CampPickSel()
        ELSE
            g_gstate = GS_STORY
        ENDIF
        RETURN
    ENDIF
    StartStage()
    g_gstate = GS_READY
    g_gtimer = 120
ENDSUB

SUB UpdateEnemies()
    INT e, eSt, i
    FLOAT f, x0, y0, x1, y1, dx, dy, d, spd, stepv, bsp

    FOR e = 0 TO 39
        eSt = g_eState[e]
        IF eSt = ES_WAIT THEN
            g_eDelay[e] = g_eDelay[e] - 1
            IF g_eDelay[e] <= 0 THEN
                g_eState[e] = ES_ENTER
                g_ePos[e] = 0.0
                g_eX[e] = g_pathX[e, 0]
                g_eY[e] = g_pathY[e, 0]
            ENDIF

        ELSEIF eSt = ES_ENTER OR eSt = ES_DIVE THEN
            IF eSt = ES_DIVE THEN
                stepv = g_eSpeed[e]
            ELSE
                stepv = 1.15 + (0.03 * FLOAT(g_stage))
                IF stepv > 1.6 THEN stepv = 1.6
            ENDIF
            IF g_challenge = 1 OR g_stream = 1 THEN
                stepv = 1.35 + (0.03 * FLOAT(g_stage))
                IF stepv > 2.0 THEN stepv = 2.0
                IF g_eType[e] = 11 THEN stepv = stepv * 1.3                ' the mantis is fast, the carapace guard slow
                IF g_eType[e] = 13 THEN stepv = stepv * 0.78
                IF g_challenge = 1 AND g_demo = 0 THEN stepv = stepv * DanceFactor()          ' the dance
            ENDIF
            g_ePos[e] = g_ePos[e] + stepv
            i = INT(g_ePos[e])
            IF i >= g_eLen[e] - 1 THEN
                IF g_challenge = 1 OR g_stream = 1 OR g_eType[e] = 6 OR g_bsOn = 1 THEN
                    g_eState[e] = ES_DEAD              ' bonus stage / a fragment: it simply flies away
                ELSE
                    g_eEsc[e] = -1
                    g_eState[e] = ES_HOME              ' entry done, or dive left the screen: fly to the slot
                    IF eSt = ES_DIVE THEN               ' a diver comes back in from the top
                        GetSlot(g_eRow[e], g_eCol[e])
                        g_eX[e] = g_slotX
                        g_eY[e] = -16.0
                    ENDIF
                ENDIF
            ELSE
                f = g_ePos[e] - FLOAT(i)
                x0 = g_pathX[e, i]
                y0 = g_pathY[e, i]
                x1 = g_pathX[e, i + 1]
                y1 = g_pathY[e, i + 1]
                g_eX[e] = x0 + ((x1 - x0) * f)
                g_eY[e] = y0 + ((y1 - y0) * f)
                g_eAng[e] = GlAtan2(x1 - x0, y1 - y0)
                IF eSt = ES_DIVE AND g_eType[e] = 3 THEN g_eX[e] = g_eX[e] + (10.0 * SIN(g_ePos[e] * 0.08))    ' a spider weaves from side to side
                IF g_eType[e] = 11 THEN g_eX[e] = g_eX[e] + (8.0 * SIN(g_ePos[e] * 0.11))                       ' a mantis darts from side to side
                IF (eSt = ES_DIVE OR g_stream = 1) AND g_attackHold = 0 AND g_palive = 1 THEN
                    IF g_eShots[e] < DiffShots() AND g_eY[e] > 70.0 AND g_eY[e] < 200.0 THEN
                        IF RND(1.0) < DiffFire() THEN
                            g_eShots[e] = g_eShots[e] + 1
                            IF g_eType[e] >= 8 THEN g_nextStraight = 1
                            bsp = (1.7 + (0.08 * FLOAT(g_stage))) * DiffBulletSpeed()
                            IF g_eType[e] = 12 THEN bsp = bsp * 0.7              ' the spitter's acid is slow
                            SpawnEBullet(g_eX[e], g_eY[e] + 10.0, bsp)
                            g_nextStraight = 0
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF

        ELSEIF eSt = ES_HOME THEN
            GetSlot(g_eRow[e], g_eCol[e])
            dx = g_slotX - g_eX[e]
            dy = g_slotY - g_eY[e]
            d = SQRT((dx * dx) + (dy * dy))
            spd = 2.6
            IF d <= spd THEN
                g_eX[e] = g_slotX
                g_eY[e] = g_slotY
                g_eState[e] = ES_FORM
                g_eAng[e] = 0.0
            ELSE
                g_eX[e] = g_eX[e] + ((dx / d) * spd)
                g_eY[e] = g_eY[e] + ((dy / d) * spd)
                IF d < 30.0 THEN
                    g_eAng[e] = g_eAng[e] * 0.85       ' turn upright while arriving
                ELSE
                    g_eAng[e] = GlAtan2(dx, dy)
                ENDIF
            ENDIF

        ELSEIF eSt = ES_FORM THEN
            GetSlot(g_eRow[e], g_eCol[e])
            g_eX[e] = g_slotX
            g_eY[e] = g_slotY
            g_eAng[e] = 0.0
            IF g_eType[e] = 5 THEN                              ' orbiters circle on the spot
                g_eX[e] = g_eX[e] + (5.0 * COS((FLOAT(g_ftick) * 0.07) + FLOAT(e)))
                g_eY[e] = g_eY[e] + (4.0 * SIN((FLOAT(g_ftick) * 0.07) + FLOAT(e)))
            ENDIF
        ENDIF
    NEXT e
ENDSUB

SUB UpdateAttacks()
    INT e, n, k, maxDivers, pick, alive, thin
    IF g_challenge = 1 OR g_stream = 1 THEN RETURN
    IF g_attackHold > 0 THEN
        g_attackHold = g_attackHold - 1
        RETURN
    ENDIF
    IF CountState(ES_WAIT) > 0 OR CountState(ES_ENTER) > 0 THEN RETURN    ' attacks start when the formation is complete
    g_diveTimer = g_diveTimer - 1
    IF g_diveTimer > 0 THEN RETURN

    alive = AliveCount()
    thin = 40 - alive                                  ' the fewer enemies are left, the harder they come
    IF thin < 0 THEN thin = 0
    maxDivers = 2 + (g_stage / 2) + (thin / 8) + (g_diff - 1)
    IF maxDivers > 8 THEN maxDivers = 8
    IF maxDivers < 1 THEN maxDivers = 1
    IF alive <= DiffAllOut() THEN maxDivers = alive    ' the last few: all-out attack
    IF CountState(ES_DIVE) < maxDivers THEN
        n = CountState(ES_FORM)
        IF n > 0 THEN
            pick = INT(RND(FLOAT(n)))
            k = 0
            FOR e = 0 TO 39
                IF g_eState[e] = ES_FORM THEN
                    IF k = pick THEN StartDive(e)
                    k = k + 1
                ENDIF
            NEXT e
        ENDIF
    ENDIF
    g_diveTimer = ((110 - (g_stage * 10)) * 40) / (40 + (thin * 3))
    g_diveTimer = (g_diveTimer * DiffPace()) / 10
    IF g_diveTimer < 18 THEN g_diveTimer = 18
    g_diveTimer = g_diveTimer + INT(RND(25.0))
ENDSUB

' ---- boss tractor beam ---------------------------------------------------------------------------------------
' g_capPhase: 0 none, 1 boss descending to y 168, 2 beam on (170 ticks), 3 the player's ship is pulled up (70 ticks)
SUB StartTractor(e:INT)
    FLOAT tx

    tx = g_px + (RND(60.0) - 30.0)
    IF tx < 40.0 THEN tx = 40.0
    IF tx > 184.0 THEN tx = 184.0
    g_tmpN = 0
    TmpBezier(g_eX[e], g_eY[e], g_eX[e], g_eY[e] + 70.0, tx, 130.0, tx, 168.0, 60, 0)
    ResampleToEnemy(e, 0)
    g_ePos[e] = 0.0
    g_eState[e] = ES_TRACT
    g_capBoss = e
    g_capPhase = 1
    g_capTimer = 0
    g_capCool = 500
ENDSUB

' the ship is captured: it costs a life, the boss flies home with its prize
SUB CapturePlayer(e:INT)
    INT i

    g_capPhase = 0
    g_heldShip = 1
    g_capCool = 900
    g_capMsg = 1
    g_palive = 0
    g_dual = 0
    g_spread = 0
    g_rapid = 0
    g_pspeed = 0
    g_shield = 0
    g_lemon = 0
    g_lives = g_lives - 1
    g_attackHold = 150
    FOR i = 0 TO 9
        g_ebOn[i] = 0
    NEXT i
    ClearBombs()
    g_gstate = GS_PDEAD
    g_gtimer = 150
    g_eState[e] = ES_HOME
ENDSUB

SUB UpdateTractor()
    INT e, i
    FLOAT f, x0, y0, x1, y1, bot, hw

    IF g_capCool > 0 THEN g_capCool = g_capCool - 1
    IF g_capPhase = 0 THEN RETURN
    e = g_capBoss
    IF g_eState[e] <> ES_TRACT THEN
        g_capPhase = 0
        RETURN
    ENDIF

    IF g_capPhase = 1 THEN
        g_ePos[e] = g_ePos[e] + 1.8
        i = INT(g_ePos[e])
        IF i >= g_eLen[e] - 1 THEN
            g_capPhase = 2
            g_capTimer = 0
            g_eAng[e] = 0.0
            PlaySfx(8)
        ELSE
            f = g_ePos[e] - FLOAT(i)
            x0 = g_pathX[e, i]
            y0 = g_pathY[e, i]
            x1 = g_pathX[e, i + 1]
            y1 = g_pathY[e, i + 1]
            g_eX[e] = x0 + ((x1 - x0) * f)
            g_eY[e] = y0 + ((y1 - y0) * f)
            g_eAng[e] = GlAtan2(x1 - x0, y1 - y0)
        ENDIF

    ELSEIF g_capPhase = 2 THEN
        g_capTimer = g_capTimer + 1
        IF (g_capTimer % 38) = 0 THEN PlaySfx(8)
        bot = g_eY[e] + 10.0 + (FLOAT(g_capTimer) * 5.0)         ' the beam grows downwards
        IF g_palive = 1 AND g_gstate = GS_PLAY AND g_flash = 0 AND g_shield = 0 AND bot >= 262.0 THEN
            hw = 4.0 + ((264.0 - g_eY[e]) * 0.3)                ' half width of the cone at the ship's height
            IF ABS(g_px - g_eX[e]) < hw THEN
                g_capPhase = 3
                g_capTimer = 0
                g_cpx = g_px
                g_cpy = 264.0
                g_cang = 0.0
                PlaySfx(9)
            ENDIF
        ENDIF
        IF g_capPhase = 2 AND g_capTimer >= 170 THEN              ' nobody caught: an ordinary dive
            g_capPhase = 0
            g_capCool = 400
            StartDive(e)
        ENDIF

    ELSEIF g_capPhase = 3 THEN
        g_capTimer = g_capTimer + 1
        f = FLOAT(g_capTimer) / 70.0
        g_cpx = g_px + ((g_eX[e] - g_px) * f)
        g_cpy = 264.0 + (((g_eY[e] + 16.0) - 264.0) * f)
        g_cang = g_cang + 0.35
        IF g_capTimer >= 70 THEN CapturePlayer(e)
    ENDIF
ENDSUB

' a freed fighter spins down and docks beside the player's ship -> dual fighter
SUB UpdateRescue()
    FLOAT tx, dx, dy, d

    IF g_resc = 0 THEN RETURN
    g_rang = g_rang + 0.35
    tx = g_px + 16.0
    dx = tx - g_rx
    dy = 264.0 - g_ry
    d = SQRT((dx * dx) + (dy * dy))
    IF d < 4.0 THEN
        IF g_palive = 1 AND g_gstate = GS_PLAY AND g_capPhase <> 3 THEN
            g_resc = 0
            g_dual = 1
            g_px = g_px + 8.0
            IF g_px > 206.0 THEN g_px = 206.0
            PlaySfx(10)
        ENDIF
    ELSE
        g_rx = g_rx + ((dx / d) * 3.0)
        g_ry = g_ry + ((dy / d) * 3.0)
    ENDIF
ENDSUB

' the beam: a cone below the boss, dark blue inside, bright bands running down it
SUB DrawBeam()
    INT bx, by, bot, y, hw, p

    bx = INT(g_eX[g_capBoss])
    by = INT(g_eY[g_capBoss]) + 10
    bot = by + (g_capTimer * 5)
    IF bot > 272 THEN bot = 272
    y = by
    WHILE y <= bot
        hw = 4 + (((y - by) * 3) / 10)
        p = (y + (g_tick * 3)) % 16
        IF p < 4 THEN
            FillRectSolid(bx - hw, y, (hw * 2) + 1, 1, 0xFF50C8FF)
        ELSE
            FillRectSolid(bx - hw + 1, y, (hw * 2) - 1, 1, 0xFF0C1C64)
            PutPix(bx - hw, y, 0xFF3C78FF)
            PutPix(bx + hw, y, 0xFF3C78FF)
        ENDIF
        y = y + 1
    ENDWHILE
ENDSUB

SUB UpdatePlayer(inL:INT, inR:INT, fire:INT)
    INT i, n, s, p, volley, maxOn, lo, cd
    FLOAT spd, sx, vx

    IF g_palive = 0 THEN RETURN
    IF g_capPhase = 3 THEN RETURN                  ' no control while the beam has the ship
    IF g_grab > 0 THEN RETURN                      ' ... or while an octopus holds it
    spd = 1.8 + (0.35 * FLOAT(g_pspeed))
    IF g_lemon > 0 THEN spd = spd * 0.5
    IF inL = 1 THEN g_px = g_px - spd
    IF inR = 1 THEN g_px = g_px + spd
    g_free = 0
    IF g_mode = 1 AND g_cStep >= 6 AND g_challenge = 0 THEN g_free = 1
    IF g_free = 1 THEN
        IF g_inU = 1 OR g_mouseU = 1 THEN g_py = g_py - spd
        IF g_inD = 1 OR g_mouseD = 1 THEN g_py = g_py + spd
        IF g_py < 16.0 THEN g_py = 16.0
        IF g_py > 266.0 THEN g_py = 266.0
    ELSE
        g_py = 264.0
    ENDIF
    lo = 10 + (8 * g_dual)
    IF g_px < FLOAT(lo) THEN g_px = FLOAT(lo)
    IF g_px > FLOAT(224 - lo) THEN g_px = FLOAT(224 - lo)
    IF g_fireCool > 0 THEN g_fireCool = g_fireCool - 1
    IF fire = 1 AND g_fireCool = 0 THEN
        volley = (1 + g_dual) * (1 + (2 * g_spread))   ' shots per trigger pull: ships x (1, 3 or 5 with spread)
        maxOn = volley * (1 + g_rapid)                 ' how many may be in flight (one volley at a time without rapid fire)
        IF maxOn > 16 THEN maxOn = 16
        n = 0
        FOR i = 0 TO 15
            IF g_pbOn[i] = 1 THEN n = n + 1
        NEXT i
        IF (n + volley) <= maxOn THEN
            FOR s = 0 TO g_dual
                IF g_dual = 1 THEN sx = g_px + FLOAT((s * 16) - 8) ELSE sx = g_px
                FOR p = 0 TO 2 * g_spread
                    vx = 0.0
                    IF p = 1 THEN vx = 0.0 - 1.6
                    IF p = 2 THEN vx = 1.6
                    IF p = 3 THEN vx = 0.0 - 3.0
                    IF p = 4 THEN vx = 3.0
                    FireBullet(sx, vx)
                NEXT p
            NEXT s
            cd = 7
            IF g_rapid = 1 THEN cd = 3
            IF g_rapid >= 2 THEN cd = 2
            IF g_spread >= 2 THEN cd = cd + 1              ' five shots at once cost a little rate of fire
            IF g_lemon > 0 THEN cd = cd * 2
            g_fireCool = cd
            PlaySfx(1)
        ENDIF
    ENDIF
ENDSUB

SUB HitEnemy(e:INT)
    INT t, diving, pts, k, ne
    FLOAT bhx, bhy
    g_eHp[e] = g_eHp[e] - 1
    IF g_eHp[e] > 0 THEN
        PlaySfx(2)
        RETURN
    ENDIF
    diving = 0
    IF g_eState[e] = ES_DIVE OR g_eState[e] = ES_HOME OR g_eState[e] = ES_ENTER OR g_eState[e] = ES_TRACT THEN diving = 1
    t = g_eType[e]
    IF t = 0 THEN
        IF diving = 1 THEN pts = 100 ELSE pts = 50
    ELSEIF t = 1 THEN
        IF diving = 1 THEN pts = 160 ELSE pts = 80
    ELSEIF t = 3 THEN
        IF diving = 1 THEN pts = 240 ELSE pts = 120
    ELSEIF t = 4 THEN
        IF diving = 1 THEN pts = 180 ELSE pts = 90
    ELSEIF t = 5 THEN
        IF diving = 1 THEN pts = 300 ELSE pts = 130
    ELSEIF t = 6 THEN
        pts = 60
    ELSEIF t = 7 THEN
        IF diving = 1 THEN pts = 350 ELSE pts = 150
    ELSEIF t = 8 THEN
        pts = 200
    ELSEIF t = 9 THEN
        pts = 260
    ELSEIF t = 10 THEN
        pts = 400
    ELSEIF t = 11 THEN
        pts = 220
    ELSEIF t = 12 THEN
        pts = 300
    ELSEIF t = 13 THEN
        pts = 450
    ELSE
        IF diving = 1 THEN pts = 400 ELSE pts = 150
    ENDIF
    IF t = 2 AND g_eState[e] = ES_DIVE THEN             ' a boss shot down with its escorts: 800 with one, 1600 with two
        ne = 0
        FOR k = 0 TO 39
            IF g_eEsc[k] = e AND g_eState[k] = ES_DIVE THEN ne = ne + 1
        NEXT k
        IF ne = 1 THEN pts = 800
        IF ne >= 2 THEN pts = 1600
    ENDIF
    FOR k = 0 TO 39
        IF g_eEsc[k] = e THEN g_eEsc[k] = -1            ' the escorts carry on by themselves
    NEXT k
    IF g_challenge = 1 THEN
        pts = 100
        g_chHits = g_chHits + 1
    ENDIF
    AddScore(pts)
    IF pts >= 400 THEN SpawnPopup(g_eX[e], g_eY[e], pts)
    SpawnExplosion(g_eX[e], g_eY[e])
    IF g_capBoss = e THEN
        IF g_capPhase <> 0 THEN g_capPhase = 0            ' beam over (a ship being pulled up is released)
        IF g_heldShip = 1 THEN
            bhx = g_eX[e] - (16.0 * SIN(g_eAng[e]))
            bhy = g_eY[e] - (16.0 * COS(g_eAng[e]))
            g_heldShip = 0
                        g_resc = 1                                  ' the captive can never be destroyed: whenever its boss dies the fighter is freed
            g_rx = bhx
            g_ry = bhy
            g_rang = 0.0
            IF g_eState[e] = ES_DIVE THEN
                AddScore(1000)                          ' bonus for the risky rescue (boss shot while diving)
                SpawnPopup(bhx, bhy, 1000)
            ENDIF
        ENDIF
    ENDIF
    IF g_challenge = 0 AND t <> 6 THEN
        g_prWait = g_prWait - 1                          ' capsules are paced by kills, and come from a diver
        IF g_prWait <= 0 AND (g_eState[e] = ES_DIVE OR g_eState[e] = ES_TRACT OR g_stream = 1) THEN
            SpawnPrize(g_eX[e], g_eY[e])
            g_prWait = DiffPrize() - 2 + INT(RND(5.0))
        ENDIF
    ENDIF
    g_eState[e] = ES_DEAD
    IF t = 4 AND g_challenge = 0 THEN SpawnFragments(g_eX[e], g_eY[e])
    PlaySfx(3)
ENDSUB

SUB KillPlayer()
    INT i
    IF g_capPhase = 3 THEN RETURN                 ' being pulled into the beam: nothing else can hurt the ship
    IF g_flash > 0 THEN RETURN                    ' respawn flash
    IF g_shHit > 0 THEN RETURN                    ' a shield layer was just lost: a moment of grace
    IF g_shield > 0 THEN
        g_shield = g_shield - 1                   ' every hit strips one layer of the shield
        g_shHit = 90                              ' 1.5 s of grace
        PlaySfx(2)
        RETURN
    ENDIF
    IF g_dual = 1 THEN
        g_dual = 0                                ' the twin fighter is lost, but the game goes on: no life is spent
        SpawnExplosion(g_px + 8.0, g_py)
        g_flash = 60                              ' a second of blinking grace
        PlaySfx(4)
        RETURN
    ENDIF

    g_palive = 0
    g_grab = 0
    g_shHit = 0
    g_invert = 0
    g_dual = 0
    g_spread = 0
    g_rapid = 0
    g_pspeed = 0
    g_lemon = 0
    g_capMsg = 0
    SpawnExplosion(g_px, g_py)
    g_lives = g_lives - 1
    g_attackHold = 150
    FOR i = 0 TO 9
        g_ebOn[i] = 0
    NEXT i
    ClearBombs()
    g_gstate = GS_PDEAD
    g_gtimer = 150
    PlaySfx(4)
ENDSUB

' ---- the carrier ---------------------------------------------------------------------------------------------------
' arcade only: a fleet wiped out in under 45 seconds by a ship with stacked capsules calls in a tough carrier. It drops reinforcements
' (shot-down aliens come back through the carrier's belly) and fires back at the player.
SUB SpawnCarrier()
    g_crOn = 1
    g_crDone = 1
    g_crPh = 0
    g_crT = 0
    g_crHp = 18 + (6 * g_diff)
    g_crFl = 0
    g_crDrop = 0
    g_crFire = 90
    g_crX = 112.0
    g_crY = -24.0
    PlaySfx(6)
ENDSUB

SUB UpdateCarrier()
    INT e, k, n, pick, t
    IF g_crOn = 0 THEN RETURN
    IF g_crFl > 0 THEN g_crFl = g_crFl - 1
    g_crT = g_crT + 1
    IF g_crPh = 0 THEN
        g_crY = g_crY + 0.8                          ' glides in from the top
        IF g_crY >= 40.0 THEN
            g_crY = 40.0
            g_crPh = 1
            g_crT = 0
        ENDIF
        RETURN
    ENDIF
    IF g_crPh = 1 THEN
        g_crX = 112.0 + (62.0 * SIN(FLOAT(g_crT) * 0.021))
        g_crY = 40.0 + (4.0 * SIN(FLOAT(g_crT) * 0.05))
        IF g_palive = 1 AND g_gstate = GS_PLAY THEN
            g_crFire = g_crFire - 1
            IF g_crFire <= 0 THEN
                g_nextKind = 1                                  ' the carrier fires rockets
                SpawnEBullet(g_crX - 14.0, g_crY + 12.0, 2.1)
                SpawnEBullet(g_crX + 14.0, g_crY + 12.0, 2.1)
                g_nextKind = 0
                g_crFire = 85 - (3 * g_stage)
                IF g_crFire < 45 THEN g_crFire = 45
            ENDIF
        ENDIF
        IF g_crDrop < 8 AND (g_crT % 55) = 30 THEN         ' a dead alien is called back and drops from the belly
            n = 0
            FOR e = 0 TO 39
                IF g_eState[e] = ES_DEAD AND g_eType[e] <> 6 AND TileBlocked(g_eRow[e], g_eCol[e]) = 0 THEN n = n + 1
            NEXT e
            IF n > 0 THEN
                pick = INT(RND(FLOAT(n)))
                IF pick >= n THEN pick = n - 1
                k = 0
                FOR e = 0 TO 39
                    IF g_eState[e] = ES_DEAD AND g_eType[e] <> 6 AND TileBlocked(g_eRow[e], g_eCol[e]) = 0 THEN
                        IF k = pick THEN
                            t = g_eType[e]
                            g_eHp[e] = 1
                            IF t = 2 OR t = 5 OR t = 7 THEN g_eHp[e] = 2
                            g_eEsc[e] = -1
                            g_eAng[e] = 0.0
                            g_eShots[e] = 0
                            g_eSpeed[e] = 1.0
                            g_eX[e] = g_crX
                            g_eY[e] = g_crY + 10.0
                            g_eState[e] = ES_HOME
                            g_crDrop = g_crDrop + 1
                        ENDIF
                        k = k + 1
                    ENDIF
                NEXT e
            ENDIF
        ENDIF
        IF g_crT > 1500 THEN g_crPh = 2                      ' it gives up after 25 seconds
        RETURN
    ENDIF
    g_crY = g_crY - 1.4                                       ' leaving
    IF g_crY < -30.0 THEN g_crOn = 0
ENDSUB

SUB HitCarrier(bx:FLOAT, by:FLOAT), INT
    IF g_crOn = 0 THEN RETURN 0
    IF ABS(bx - g_crX) < 22.0 AND ABS(by - g_crY) < 14.0 THEN
        g_crHp = g_crHp - 1
        IF g_crHp > 0 THEN
            g_crFl = 3
            PlaySfx(2)
        ELSE
            g_crOn = 0
            AddScore(3000)
            SpawnPopup(g_crX, g_crY, 3000)
            SpawnExplosion(g_crX - 16.0, g_crY)
            SpawnExplosion(g_crX + 16.0, g_crY + 2.0)
            SpawnExplosion(g_crX, g_crY - 4.0)
            SpawnExplosion(g_crX - 6.0, g_crY + 10.0)
            SpawnExplosion(g_crX + 8.0, g_crY + 9.0)
            SpawnPrize(g_crX, g_crY + 8.0)
            PlaySfx(3)
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0
ENDSUB

SUB DrawCarrier()
    INT w, mx
    IF g_crOn = 0 THEN RETURN
    IF g_pCarrier <> 0 THEN
        DrawSpr(g_pCarrier + (((g_tick / 10) % 2) * 48 * 38 * 4), 48, 38, INT(g_crX) - 24, INT(g_crY) - 19, g_crFl)
    ELSE
        FillRectSolid(INT(g_crX) - 22, INT(g_crY) - 8, 44, 16, 0xFFD84818)
    ENDIF
    mx = 18 + (6 * g_diff)
    w = (g_crHp * 28) / mx
    IF w < 1 THEN w = 1
    FillRectSolid(INT(g_crX) - 14, INT(g_crY) - 24, 28, 3, 0xFF301010)
    FillRectSolid(INT(g_crX) - 14, INT(g_crY) - 24, w, 3, 0xFFFF5030)
ENDSUB

SUB UpdateBullets()
    INT i, e, eSt, hit
    FLOAT bw, bh

    FOR i = 0 TO 15
        IF g_pbOn[i] = 1 THEN
            g_pbY[i] = g_pbY[i] - 5.0
            g_pbX[i] = g_pbX[i] + g_pbVX[i]
            IF g_pbY[i] < -8.0 OR g_pbX[i] < -4.0 OR g_pbX[i] > 228.0 THEN
                g_pbOn[i] = 0
            ELSE
                hit = 0
                FOR e = 0 TO 39
                    IF hit = 0 THEN
                        eSt = g_eState[e]
                        IF eSt = ES_ENTER OR eSt = ES_HOME OR eSt = ES_FORM OR eSt = ES_DIVE OR eSt = ES_TRACT THEN
                            bw = 8.0
                            bh = 9.0
                            IF g_eType[e] >= 8 THEN
                                bw = 12.0                           ' the jets are bigger (24x26)
                                bh = 13.0
                            ENDIF
                            IF g_eType[e] = 13 THEN bw = 20.0          ' the carapace guard is wide (40x28)
                            IF g_eType[e] = 5 AND g_eHp[e] >= 2 THEN
                                bw = 13.0                           ' the orbiting ball is part of the target
                                bh = 12.0
                            ENDIF
                            IF ABS(g_pbX[i] - g_eX[e]) < bw AND ABS(g_pbY[i] - g_eY[e]) < bh THEN
                                hit = 1
                                g_pbOn[i] = 0
                                g_stHits = g_stHits + 1
                                g_totHits = g_totHits + 1
                                HitEnemy(e)
                            ENDIF
                        ENDIF
                    ENDIF
                NEXT e
                IF hit = 0 THEN
                    IF HitCarrier(g_pbX[i], g_pbY[i]) = 1 THEN
                        hit = 1
                        g_pbOn[i] = 0
                        g_stHits = g_stHits + 1
                        g_totHits = g_totHits + 1
                    ENDIF
                ENDIF
                IF hit = 0 THEN
                    IF HitBomb(g_pbX[i], g_pbY[i]) = 1 THEN
                        hit = 1
                        g_pbOn[i] = 0
                        g_stHits = g_stHits + 1
                        g_totHits = g_totHits + 1
                    ENDIF
                ENDIF
                IF hit = 0 THEN
                    IF HitObstacle(g_pbX[i], g_pbY[i]) = 1 THEN
                        g_pbOn[i] = 0
                        g_stHits = g_stHits + 1
                        g_totHits = g_totHits + 1
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT i

    FOR i = 0 TO 9
        IF g_ebOn[i] = 1 THEN
            g_ebX[i] = g_ebX[i] + g_ebVX[i]
            g_ebY[i] = g_ebY[i] + g_ebVY[i]
            IF g_ebY[i] > 296.0 OR g_ebX[i] < -8.0 OR g_ebX[i] > 232.0 THEN
                g_ebOn[i] = 0
            ELSEIF g_palive = 1 THEN
                IF ABS(g_ebX[i] - g_px) < (6.0 + (8.0 * FLOAT(g_dual))) AND ABS(g_ebY[i] - g_py) < 7.0 THEN
                    g_ebOn[i] = 0
                    KillPlayer()
                ENDIF
            ENDIF
        ENDIF
    NEXT i
ENDSUB

' ---- octopus grip ------------------------------------------------------------------------------------------------
SUB StartGrab(e:INT)
    g_grab = 60                                     ' one second
    g_grabE = e
    g_grabS = g_eState[e]
    g_grabX = g_eX[e]
    g_grabY = g_eY[e]
    g_grabP = g_ePos[e]
    g_px = g_eX[e]                                  ' the ship is pulled under the octopus
    PlaySfx(8)
ENDSUB

SUB UpdateGrab()
    INT e
    IF g_grabCool > 0 THEN g_grabCool = g_grabCool - 1
    IF g_grab = 0 THEN RETURN
    e = g_grabE
    IF g_palive = 0 OR g_eState[e] <> g_grabS THEN
        g_grab = 0
        RETURN
    ENDIF
    g_ePos[e] = g_grabP                             ' the octopus stays where it is
    g_eX[e] = g_grabX
    g_eY[e] = g_grabY
    g_px = g_grabX
    g_grab = g_grab - 1
    IF g_grab <= 0 THEN
        g_grab = 0
        g_grabCool = 150                            ' it cannot grab again right away
        g_flash = 75                                ' the ship escapes: blinking and safe for 1.25 s
        PlaySfx(2)
    ENDIF
ENDSUB

' purple tentacles from the octopus wrapped round the ship
SUB DrawGrabFx()
    INT t, k, x, y, sx, sy, tx, ty, px, py, ex, ey, col
    FLOAT f, w
    IF g_grab = 0 THEN RETURN
    px = INT(g_px)
    py = INT(g_py)
    ex = INT(g_grabX)
    ey = INT(g_grabY)
    FOR t = 0 TO 3
        sx = ex + (t * 5) - 7
        sy = ey + 4
        tx = px + (t * 6) - 9
        ty = py + 2
        FOR k = 0 TO 10
            f = FLOAT(k) / 10.0
            w = SIN((FLOAT(g_tick) * 0.5) + FLOAT(t) + (f * 6.0)) * 2.0
            x = sx + INT(FLOAT(tx - sx) * f) + INT(w)
            y = sy + INT(FLOAT(ty - sy) * f)
            PutPix(x, y, 0xFFB43CE0)
            PutPix(x + 1, y, 0xFF7820A0)
            IF (k % 3) = 0 THEN PutPix(x, y - 1, 0xFFE68CFF)
        NEXT k
    NEXT t
    FOR x = -9 TO 9
        IF (((x + (g_tick / 2)) / 2) % 2) = 0 THEN col = 0xFFB43CE0 ELSE col = 0xFF7820A0
        PutPix(px + x, py - 2, col)
        PutPix(px + x, py + 3, col)
    NEXT x
ENDSUB

' an enemy flying into the ship kills both
SUB CheckRam()
    INT e, eSt
    IF g_palive = 0 THEN RETURN
    FOR e = 0 TO 39
        IF g_palive = 1 THEN
            eSt = g_eState[e]
            IF eSt = ES_DIVE OR eSt = ES_HOME OR eSt = ES_ENTER THEN
                IF ABS(g_eX[e] - g_px) < (11.0 + (8.0 * FLOAT(g_dual))) AND ABS(g_eY[e] - g_py) < 11.0 THEN
                    IF g_eType[e] = 7 AND (eSt = ES_DIVE OR (eSt = ES_ENTER AND g_stream = 1)) THEN
                        ' a diving octopus does not ram: it grabs the ship and holds it for a second
                        IF g_grab = 0 AND g_grabCool = 0 AND g_flash = 0 AND g_capPhase = 0 AND g_gstate = GS_PLAY THEN StartGrab(e)
                    ELSE
                        g_eHp[e] = 1
                        HitEnemy(e)
                        KillPlayer()                          ' a ram costs the ship in bonus stages too (the alien is smashed as well)
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT e
ENDSUB

' ---- visual helpers --------------------------------------------------------------------------------------------
' alpha blend one pixel over the frame buffer (a = 0..255)
SUB BlendPix(x:INT, y:INT, col:INT, a:INT)
    INT d, dr, dg, db, sr, sg, sb
    IF x < 0 OR x >= 224 OR y < 0 OR y >= 288 THEN RETURN
    d = *<INT>(pPixelBuffer + (((y * 224) + x) * 4))
    dr = (d >> 16) & 255
    dg = (d >> 8) & 255
    db = d & 255
    sr = (col >> 16) & 255
    sg = (col >> 8) & 255
    sb = col & 255
    dr = dr + (((sr - dr) * a) / 255)
    dg = dg + (((sg - dg) * a) / 255)
    db = db + (((sb - db) * a) / 255)
    *<INT>(pPixelBuffer + (((y * 224) + x) * 4)) = 0xFF000000 | (dr << 16) | (dg << 8) | db
ENDSUB

' translucent shield sphere: faint inside, bright rim, a highlight upper left
SUB DrawBubble(cx:INT, cy:INT)
    INT dx, dy, d2, a, col
    FOR dy = -13 TO 13
        FOR dx = -13 TO 13
            d2 = (dx * dx) + (dy * dy)
            IF d2 <= 169 THEN
                a = 14 + ((d2 * d2) / 400)
                col = 0xFF3CE1FF
                IF d2 > 132 THEN
                    a = a + 70
                    col = 0xFF8CF0FF
                ENDIF
                IF dx >= -8 AND dx <= -5 AND dy >= -9 AND dy <= -7 THEN
                    a = a + 90
                    col = 0xFFFFFFFF
                ENDIF
                IF ((g_tick / 3) + dx + dy) % 7 = 0 THEN a = a + 14
                BlendPix(cx + dx, cy + dy, col, a)
            ENDIF
        NEXT dx
    NEXT dy
ENDSUB

' engine flame under a ship at (x, y)
SUB DrawFlame(x:INT, y:INT)
    INT n, k, flen, t, w, col
    IF g_warp > 1.3 THEN
        ' warp: the propulsors blaze, the flame grows with the warp speed (white-hot core, orange body, red tip)
        flen = INT(g_warp * 1.8) + ((g_tick / 2) % 3)
        FOR k = 0 TO flen
            t = (k * 100) / (flen + 1)
            IF t < 12 THEN
                w = 4
                col = 0xFFFFFFC8
            ELSEIF t < 35 THEN
                w = 4
                col = 0xFFFFD25A
            ELSEIF t < 60 THEN
                w = 3
                col = 0xFFFF9628
            ELSEIF t < 85 THEN
                w = 2
                col = 0xFFFF5A1E
            ELSE
                w = 1
                col = 0xFFC83C14
            ENDIF
            FillRectSolid(x - (w / 2), y + 7 + k, w, 1, col)
        NEXT k
        RETURN
    ENDIF
    n = 2 + ((g_tick / 2) % 3)

    n = 2 + ((g_tick / 2) % 3)
    FillRectSolid(x - 1, y + 7, 2, 1, 0xFFFFF08C)
    FillRectSolid(x - 1, y + 8, 2, n, 0xFFFF7828)
    IF n >= 3 THEN PutPix(x, y + 8 + n, 0xFFC83C14)
ENDSUB

' chunky pixel-art logo: 4x4 blocks with an edge, a colour gradient, a drop shadow and a shine that sweeps across
SUB DrawLogo(y:INT, txt:STRING)
    INT ps, k, gi, row, a, bx, by, col, band, x0, cc
    POINTER p
    p = &txt
    band = ((g_tick * 3) % 330) - 60
    FOR ps = 0 TO 1
        FOR k = 0 TO 7
            cc = *<CHAR>(p + k)
            gi = g_fontIdx[cc & 127]
            x0 = 18 + (k * 24)
            FOR row = 0 TO 6
                FOR a = 0 TO 4
                    IF (g_fnt[(gi * 7) + row] & (16 >> a)) <> 0 THEN
                        bx = x0 + (a * 4)
                        by = y + (row * 4)
                        IF ps = 0 THEN
                            FillRectSolid(bx + 2, by + 2, 4, 4, 0xFF1E2878)
                        ELSE
                            IF row = 0 THEN
                                col = 0xFFFFF08C
                            ELSEIF row = 1 THEN
                                col = 0xFFFFDC3C
                            ELSEIF row = 2 THEN
                                col = 0xFFFFB428
                            ELSEIF row = 3 THEN
                                col = 0xFFFF8C1E
                            ELSEIF row = 4 THEN
                                col = 0xFFF0501E
                            ELSEIF row = 5 THEN
                                col = 0xFFC8281E
                            ELSE
                                col = 0xFF961428
                            ENDIF
                            IF ABS((bx + (by / 2)) - band) < 7 THEN col = 0xFFFFFFFF
                            FillRectSolid(bx, by, 4, 4, 0xFF6E1414)
                            FillRectSolid(bx, by, 3, 3, col)
                        ENDIF
                    ENDIF
                NEXT a
            NEXT row
        NEXT k
    NEXT ps
ENDSUB

' one piece of the ticker: draws txt starting at pixel x (only if doDraw = 1) and returns the x where the next piece starts
SUB TickSeg(x:INT, y:INT, txt:STRING, col:INT, doDraw:INT), INT
    INT i, n, px, cc
    POINTER p
    p = &txt
    n = LEN(txt)
    IF doDraw = 1 THEN
        FOR i = 0 TO n - 1
            px = x + (i * 6)
            IF px > -6 AND px < 224 THEN
                cc = *<CHAR>(p + i)
                DrawGlyphIdx(px, y, g_fontIdx[cc & 127], col, 1)
            ENDIF
        NEXT i
    ENDIF
    RETURN x + (n * 6)
ENDSUB

' the whole ticker tape; x0 = where it starts. Returns where it ends.
SUB TickTape(x0:INT, y:INT, col:INT, doDraw:INT), INT
    INT x
    x = x0
    x = TickSeg(x, y, "GIGALAGA - A RETRO ARCADE SHOOTER WRITTEN IN IWBASIC", col, doDraw)
    x = TickSeg(x, y, "   *   INSPIRED BY THE CLASSICS AND XGALAGA", col, doDraw)
    x = TickSeg(x, y, "   *   NO EXTERNAL FILES - LIVE TRACKER SYNTH SOUND SYSTEM", col, doDraw)
    x = TickSeg(x, y, "   *   SHOOT DIVING ENEMIES FOR POWER-UP CAPSULES", col, doDraw)
    x = TickSeg(x, y, "   *   LET A BOSS CAPTURE YOUR FIGHTER THEN SHOOT THAT BOSS", col, doDraw)
    x = TickSeg(x, y, " TO GET IT BACK AS A DUAL FIGHTER", col, doDraw)
    x = TickSeg(x, y, "   *   A PERFECT BONUS STAGE PAYS 10000   *   GOOD LUCK!", col, doDraw)
    RETURN x
ENDSUB

SUB DrawMarquee(y:INT, scrollX:INT, col:INT)
    INT tot, o, e, i, c, d, r, g, b, base, nPix
    POINTER pSave
    tot = TickTape(0, y, col, 0)
    IF g_pMq = 0 THEN
        o = scrollX % (224 + tot)
        e = TickTape(224 - o, y, col, 1)
        RETURN
    ENDIF
    ' the scroller leaves a long fading trail (SSE2 decay): it is drawn into its own buffer, the buffer decays every frame,
    ' and the result is added over the picture. Rows y-6 .. y+17 only.
    base = (y - 6) * 224
    nPix = 24 * 224
    ApplyTrailDecaySSE2(g_pMq + (base * 4), nPix, 200)
    pSave = pPixelBuffer
    pPixelBuffer = g_pMq
    o = scrollX % (224 + tot)
    e = TickTape(224 - o, y, col, 1)
    pPixelBuffer = pSave
    FOR i = 0 TO nPix - 1
        c = *<INT>(g_pMq + ((base + i) * 4))
        IF (c & 0xFFFFFF) <> 0 THEN
            d = *<INT>(pPixelBuffer + ((base + i) * 4))
            r = ((d >> 16) & 255) + ((c >> 16) & 255)
            g = ((d >> 8) & 255) + ((c >> 8) & 255)
            b = (d & 255) + (c & 255)
            IF r > 255 THEN r = 255
            IF g > 255 THEN g = 255
            IF b > 255 THEN b = 255
            *<INT>(pPixelBuffer + ((base + i) * 4)) = 0xFF000000 | (r << 16) | (g << 8) | b
        ENDIF
    NEXT i
ENDSUB

' bouncing PAUSED box (the way XGalaga bounces its pause picture up and down)
' ESC: the whole picture dims (alpha blended), a translucent panel asks if the player really wants to quit
SUB DrawQuitPrompt()
    INT n, c, x, y, col, px0, py0, pw, ph
    POINTER pRow
    g_quitT = g_quitT + 1
    FOR n = 0 TO 64511
        c = *<INT>(pPixelBuffer + (n * 4))
        *<INT>(pPixelBuffer + (n * 4)) = 0xFF000000 | ((c >> 1) & 0x007F7F7F)          ' the picture at half brightness
    NEXT n
    pw = 160
    ph = 66
    px0 = 32
    py0 = 108
    FOR y = py0 TO py0 + ph - 1
        pRow = pPixelBuffer + (y * 224 * 4)
        FOR x = px0 TO px0 + pw - 1
            c = *<INT>(pRow + (x * 4))
            *<INT>(pRow + (x * 4)) = 0xFF000000 | (((c >> 1) & 0x007F7F7F) + 0x00101C3C)          ' a second 50 % layer, tinted navy
        NEXT x
    NEXT y
    col = CycleColor(g_quitT * 4)
    FillRectSolid(px0, py0, pw, 2, col)
    FillRectSolid(px0, py0 + ph - 2, pw, 2, col)
    FillRectSolid(px0, py0, 2, ph, col)
    FillRectSolid(px0 + pw - 2, py0, 2, ph, col)
    DrawCentered(py0 + 12, "QUIT GIGALAGA ?", 0xFFFFFFFF)
    DrawCentered(py0 + 30, "ARE YOU SURE ?", 0xFFC8C8E6)
    DrawCentered(py0 + 48, "[Y]ES    [N]O", 0xFFFFDC3C)
ENDSUB

SUB DrawPauseBanner()
    INT m, y, col
    m = (g_pauseT * 2) % 420
    IF m > 210 THEN m = 420 - m
    y = 40 + m
    col = CycleColor(g_pauseT * 4)
    FillRectSolid(40, y - 6, 144, 38, 0xFF0C0E28)
    FillRectSolid(40, y - 6, 144, 2, col)
    FillRectSolid(40, y + 30, 144, 2, col)
    FillRectSolid(40, y - 6, 2, 38, col)
    FillRectSolid(182, y - 6, 2, 38, col)
    DrawGlyphText(58, y, "PAUSED", col, 3)
    DrawCentered(y + 23, "P TO RESUME", 0xFFFFFFFF)
ENDSUB

' N during a stage: jump to the next stage tune (boss, bonus-stage and story tunes are left alone)
SUB SkipTune()
    INT ns
    IF g_demo = 1 OR g_challenge = 1 THEN RETURN
    IF g_musLoop <> 2 OR g_musSong = 0 THEN RETURN
    ns = RandTune(g_musSong)
    g_lastTune = ns
    PlayMusic(ns, 2)
    g_tnSong = ns
    g_tnTick = 150
ENDSUB

SUB DrawTuneNotice()
    INT col
    IF g_tnTick <= 0 THEN RETURN
    g_tnTick = g_tnTick - 1
    col = 0xFFB4F0FF
    IF g_tnTick < 30 THEN col = 0xFF6E86A0
    IF g_tnSong = 4 THEN DrawCentered(250, "NEXT TRACK: SOLAR FLARE", col)
    IF g_tnSong = 5 THEN DrawCentered(250, "NEXT TRACK: EVENT HORIZON", col)
    IF g_tnSong = 6 THEN DrawCentered(250, "NEXT TRACK: BLACK PULSE", col)
ENDSUB

' Q: give up the current game (goes through the usual game over / name entry)
SUB EndGameNow()
    IF g_gstate = GS_READY OR g_gstate = GS_PLAY OR g_gstate = GS_PDEAD OR g_gstate = GS_CLEAR OR g_gstate = GS_MAP THEN
        g_paused = 0
        g_lives = 0
        g_palive = 0
        g_dual = 0
        g_capPhase = 0
        g_heldShip = 0
        g_resc = 0
        g_capMsg = 0
        g_gstate = GS_PDEAD
        g_gtimer = 1
        PlaySfx(4)
    ENDIF
ENDSUB

' ---- input: keyboard, gamepad, mouse ------------------------------------------------------------------------
' returns 1 on the first tick a direction is pressed and then on every 5th tick after a 20 tick delay
SUB KeyRep(k:INT, isDown:INT), INT
    IF isDown = 0 THEN
        g_kRep[k] = 0
        RETURN 0
    ENDIF
    g_kRep[k] = g_kRep[k] + 1
    IF g_kRep[k] = 1 THEN RETURN 1
    IF g_kRep[k] >= 20 AND ((g_kRep[k] - 20) % 5) = 0 THEN RETURN 1
    RETURN 0
ENDSUB

SUB ReadInputs()
    INT r, h, jx, jy, jb, pov, fg, cx, cy
    POINTER pPt
    FLOAT tx, ty

    g_inL = IsKeyDown(0x25) | IsKeyDown(0x41)
    g_inR = IsKeyDown(0x27) | IsKeyDown(0x44)
    g_inU = IsKeyDown(0x26) | IsKeyDown(0x57)
    g_inD = IsKeyDown(0x28) | IsKeyDown(0x53)
    g_inFire = IsKeyDown(0x20) | IsKeyDown(0x11) | IsKeyDown(0x5A) | IsKeyDown(0x58) | IsKeyDown(0x0D)
    g_mouseL = 0
    g_mouseR = 0
    g_mouseU = 0
    g_mouseD = 0

    ' gamepad 0 (looked for again every 3 seconds while none is found)
    h = g_pJoy
    IF h <> 0 AND (g_joyOk = 1 OR (g_tick % 180) = 0) THEN
        *<INT>(g_pJoy + 0) = 52
        *<INT>(g_pJoy + 4) = 255                   ' JOY_RETURNALL
        r = API_joyGetPosEx(0, g_pJoy)
        IF r = 0 THEN
            g_joyOk = 1
            jx = *<INT>(g_pJoy + 8)
            jy = *<INT>(g_pJoy + 12)
            jb = *<INT>(g_pJoy + 32)
            pov = *<INT>(g_pJoy + 40)
            IF jx < 16384 THEN g_inL = 1
            IF jx > 49152 THEN g_inR = 1
            IF jy < 16384 THEN g_inU = 1
            IF jy > 49152 THEN g_inD = 1
            IF pov >= 0 AND pov < 36000 THEN
                IF pov >= 22500 AND pov <= 31500 THEN g_inL = 1
                IF pov >= 4500 AND pov <= 13500 THEN g_inR = 1
                IF pov >= 31500 OR pov <= 4500 THEN g_inU = 1
                IF pov >= 13500 AND pov <= 22500 THEN g_inD = 1
            ENDIF
            IF (jb & 15) <> 0 THEN g_inFire = 1
        ELSE
            g_joyOk = 0
        ENDIF
    ENDIF

    ' mouse: moving it takes over the steering, the keys / pad take it back, left button fires
    IF g_inL = 1 OR g_inR = 1 OR g_inU = 1 OR g_inD = 1 THEN g_mouseOn = 0
    fg = API_GetForegroundWindow()
    IF fg = main_win.hwnd THEN
        pPt = g_pSav + 300
        API_GetCursorPos(pPt)
        API_ScreenToClient(main_win.hwnd, pPt)
        cx = *<INT>(g_pSav + 300)
        cy = *<INT>(g_pSav + 304)
        IF cx >= 0 AND cy >= 0 AND cx < g_winW AND cy < g_winH THEN
            IF cx <> g_mouseLastX OR cy <> g_mouseLastY THEN g_mouseOn = 1
            IF IsKeyDown(1) = 1 THEN g_inFire = 1
            IF g_mouseOn = 1 AND g_dstW > 0 THEN
                tx = FLOAT((cx - g_dstX) * 224) / FLOAT(g_dstW)
                IF tx < (g_px - 2.0) THEN g_mouseL = 1
                IF tx > (g_px + 2.0) THEN g_mouseR = 1
                IF g_dstH > 0 THEN
                    ty = FLOAT((cy - g_dstY) * 288) / FLOAT(g_dstH)
                    IF ty < (g_py - 2.0) THEN g_mouseU = 1
                    IF ty > (g_py + 2.0) THEN g_mouseD = 1
                ENDIF
            ENDIF
        ENDIF
        g_mouseLastX = cx
        g_mouseLastY = cy
    ENDIF
ENDSUB

' the "STAGE" cell of the table: "--" unknown, a number (arcade), or the world and step of the campaign ("ICE 3", "FIRE B" for the boss)
SUB DrawStageCode(x:INT, y:INT, v0:INT, col:INT)
    INT w, st, px, v
    v = v0 % 10000                                      ' the difficulty is kept above the stage: see DrawDiffTag
    IF v <= 0 THEN
        DrawGlyphText(x + 12, y, "--", col, 1)
    ELSEIF v < 1000 THEN
        DrawNumber(x + 24, y, v, col)
    ELSE
        px = x
        w = (v - 1000) / 100
        st = v % 100
        IF w = 0 THEN
            DrawGlyphText(px, y, "ICE", col, 1)
            px = px + 24
        ELSEIF w = 1 THEN
            DrawGlyphText(px, y, "FIRE", col, 1)
            px = px + 30
        ELSEIF w = 2 THEN
            DrawGlyphText(px, y, "HIVE", col, 1)
            px = px + 30
        ELSE
            DrawGlyphText(px, y, "EMPIRE", col, 1)
            px = px + 42
        ENDIF
        IF st >= 9 THEN DrawGlyphText(px, y, "B", col, 1) ELSE DrawGlyphIdx(px, y, st, col, 1)
    ENDIF
ENDSUB

' ---- name entry ----------------------------------------------------------------------------------------------
SUB FinishName()
    INT r, nm
    nm = NameOf(g_nameCh[0], g_nameCh[1], g_nameCh[2])
    r = InsertScore(g_score, nm)
    g_nameRank = r
    g_hiscore = g_hsScore[0]
    SaveSettings()
    g_gstate = GS_OVER
    ClearObstacles(0)
    ClearBombs()
    g_gtimer = 240
ENDSUB

SUB UpdateName()
    INT cur, rr

    g_nameTimer = g_nameTimer - 1
    cur = g_nameLen
    IF KeyRep(2, g_inU) = 1 THEN
        g_nameCh[cur] = g_nameCh[cur] + 1
        IF g_nameCh[cur] > 90 THEN g_nameCh[cur] = 65
        PlaySfx(2)
    ENDIF
    IF KeyRep(3, g_inD) = 1 THEN
        g_nameCh[cur] = g_nameCh[cur] - 1
        IF g_nameCh[cur] < 65 THEN g_nameCh[cur] = 90
        PlaySfx(2)
    ENDIF
    IF KeyRep(0, g_inL) = 1 THEN
        IF g_nameLen > 0 THEN g_nameLen = g_nameLen - 1
    ENDIF
    rr = KeyRep(1, g_inR)
    IF (rr = 1 AND g_kRep[1] = 1) OR g_fireEdge = 1 THEN
        g_nameLen = g_nameLen + 1
        PlaySfx(12)
        IF g_nameLen >= 3 THEN FinishName()
    ENDIF
    IF g_gstate = GS_NAME AND g_nameTimer <= 0 THEN FinishName()
ENDSUB

' ---- text helpers and screens --------------------------------------------------------------------------------
SUB DrawCentered(y:INT, txt:STRING, col:INT)
    INT x
    x = 112 - (3 * LEN(txt))
    DrawGlyphText(x, y, txt, col, 1)
ENDSUB

SUB DrawNameEntry()
    INT k, x, col, code

    DrawCentered(60, "NEW HIGH SCORE", CycleColor(g_tick * 3))
    DrawCentered(76, "YOU MADE THE TOP 8", 0xFF9090C8)
    DrawGlyphText(70, 104, "RANK", 0xFF3CE1FF, 1)
    DrawGlyphIdx(100, 104, g_nameRank + 1, 0xFFFFFFFF, 1)
    DrawGlyphText(70, 118, "SCORE", 0xFF3CE1FF, 1)
    DrawNumber(158, 118, g_score, 0xFFFFFFFF)
    DrawCentered(148, "ENTER YOUR NAME", 0xFFFFDC3C)
    FOR k = 0 TO 2
        x = 80 + (k * 24)
        code = g_nameCh[k]
        IF k < g_nameLen THEN
            col = 0xFFFFFFFF
        ELSEIF k = g_nameLen THEN
            IF ((g_tick / 8) % 2) = 0 THEN col = 0xFFFFDC3C ELSE col = 0xFFFF8C1E
        ELSE
            col = 0xFF505078
        ENDIF
        DrawGlyphIdx(x, 170, g_fontIdx[code & 127], col, 3)
        IF k = g_nameLen THEN FillRectSolid(x, 194, 15, 2, col)
    NEXT k
    DrawCentered(222, "UP DOWN  CHANGE LETTER", 0xFF9090C8)
    DrawCentered(234, "FIRE  OK    LEFT  BACK", 0xFF9090C8)
    DrawGlyphText(94, 252, "TIME", 0xFF3CE1FF, 1)
    DrawNumber(138, 252, g_nameTimer / 60, 0xFFFFFFFF)
ENDSUB

' title screen that cycles through 5 pages (7 seconds each)
SUB DrawAttract(frame:INT)
    INT pg, i, y, k, col, nm, ox, dv
    pg = (g_atTick / 420) % 5

    IF pg = 0 THEN
        DrawLogo(52, "GIGALAGA")
        DrawGlyphText(55, 98, "- CLASSIC EDITION -", 0xFF9090C8, 1)
        IF g_mode = 1 AND g_cSaveDone > 0 THEN
            IF ((g_tick / 24) % 2) = 0 THEN DrawCentered(180, "PRESS [SPACE] TO CONTINUE", 0xFFFFFFFF)
            DrawCentered(190, "[N] NEW CAMPAIGN", 0xFF9090C8)
            DrawNumber(64, 170, CampCount(g_cSaveDone), 0xFF46E146)
            DrawGlyphText(70, 170, "OF 4 WORLDS CLEAR", 0xFF46E146, 1)
        ELSE
            IF ((g_tick / 24) % 2) = 0 THEN DrawCentered(180, "PRESS [SPACE] TO START", 0xFFFFFFFF)
        ENDIF
        DrawCentered(200, "[ARROWS] MOVE   [SPACE] FIRE", 0xFF9090C8)
        DrawCentered(211, "[P] PAUSE  [O] OPTIONS  [ESC] QUIT", 0xFF9090C8)
        IF g_mode = 0 THEN
            DrawCentered(160, "[TAB] MODE: ARCADE", 0xFF3CE1FF)
        ELSE
            DrawCentered(160, "[TAB] MODE: CAMPAIGN", 0xFFFF8C3C)
        ENDIF
        IF g_scanLevel = 0 THEN
            DrawCentered(222, "[C] SCANLINES OFF", 0xFF9090C8)
        ELSEIF g_scanLevel = 1 THEN
            DrawCentered(222, "[C] SCANLINES LIGHT", 0xFF9090C8)
        ELSE
            DrawCentered(222, "[C] SCANLINES STRONG", 0xFF9090C8)
        ENDIF
        IF g_diff = 0 THEN
            DrawCentered(234, "[-] DIFFICULTY: EASY [+]", 0xFF46E146)
        ELSEIF g_diff = 1 THEN
            DrawCentered(234, "[-] DIFFICULTY: NORMAL [+]", 0xFFFFDC3C)
        ELSE
            DrawCentered(234, "[-] DIFFICULTY: HARD [+]", 0xFFFF3C3C)
        ENDIF
        ' parade of the three enemy kinds, just below the edition line
        LDrawSprite(1 + frame, 72, 122, 0.0)
        LDrawSprite(3 + frame, 112, 122, 0.0)
        LDrawSprite(5 + frame, 152, 122, 0.0)
        DrawCentered(264, "@ 2026 DALISSIER Y.", 0xFF505078)
    ELSEIF pg = 1 THEN
        ox = 14                                         ' the table (8 .. 190) is centred on the 224 pixel screen
        DrawCentered(46, "HIGH SCORES", CycleColor(g_tick * 3))
        DrawCentered(62, "- BEST 8 -", 0xFFFF3C3C)
        DrawGlyphText(ox + 8, 84, "RANK", 0xFFFFFFFF, 1)
        DrawGlyphText(ox + 34, 84, "LV", 0xFFFFFFFF, 1)
        DrawGlyphText(ox + 64, 84, "SCORE", 0xFFFFFFFF, 1)
        DrawGlyphText(ox + 114, 84, "STAGE", 0xFFFFFFFF, 1)
        DrawGlyphText(ox + 166, 84, "INI", 0xFFFFFFFF, 1)
        FOR i = 0 TO 7
            y = 102 + (i * 17)
            IF i = 0 THEN
                col = 0xFFFF3C3C
            ELSEIF i < 3 THEN
                col = 0xFFFFDC3C
            ELSEIF i < 5 THEN
                col = 0xFF46E146
            ELSE
                col = 0xFF3CE1FF
            ENDIF
            IF i = g_nameRank AND ((g_tick / 8) % 2) = 0 THEN col = 0xFFFFFFFF
            DrawGlyphText(ox + 8, y, "NO.", col, 1)
            DrawGlyphIdx(ox + 26, y, i + 1, col, 1)
            dv = (g_hsStage[i] / 10000) % 10
            IF dv = 1 THEN
                DrawGlyphText(ox + 37, y, "E", 0xFF46E146, 1)
            ELSEIF dv = 2 THEN
                DrawGlyphText(ox + 37, y, "N", 0xFFFFDC3C, 1)
            ELSEIF dv = 3 THEN
                DrawGlyphText(ox + 37, y, "H", 0xFFFF3C3C, 1)
            ELSE
                DrawGlyphText(ox + 37, y, "-", 0xFF808098, 1)
            ENDIF
            DrawNumber(ox + 104, y, g_hsScore[i], col)
            DrawStageCode(ox + 114, y, g_hsStage[i], col)
            IF g_hsStage[i] >= 100000 THEN
                DrawMedal(ox + 196, y + 4)                          ' the medal for 3 rescued cosmonauts; the little number is the multiplier
                IF (g_hsStage[i] / 100000) > 1 THEN DrawNumber(ox + 200, y + 11, g_hsStage[i] / 100000, 0xFF3C2008)
            ENDIF
            nm = g_hsName[i]
            FOR k = 0 TO 2
                DrawGlyphIdx(ox + 166 + (k * 6), y, g_fontIdx[((nm >> (8 * k)) & 255) & 127], col, 1)
            NEXT k
        NEXT i
    ELSEIF pg = 2 THEN
        DrawCentered(42, "SCORE ADVANCE", CycleColor(g_tick * 3))
        DrawGlyphText(114, 60, "FORM", 0xFF9090C8, 1)
        DrawGlyphText(160, 60, "DIVE", 0xFF9090C8, 1)
        LDrawSprite(1 + frame, 52, 82, 0.0)
        DrawGlyphText(76, 79, "BEE", 0xFFFFFFFF, 1)
        DrawNumber(138, 79, 50, 0xFFFFFFFF)
        DrawNumber(184, 79, 100, 0xFFFFFFFF)
        LDrawSprite(3 + frame, 52, 106, 0.0)
        DrawGlyphText(76, 103, "FLY", 0xFFFFFFFF, 1)
        DrawNumber(138, 103, 80, 0xFFFFFFFF)
        DrawNumber(184, 103, 160, 0xFFFFFFFF)
        LDrawSprite(5 + frame, 52, 130, 0.0)
        DrawGlyphText(76, 127, "BOSS", 0xFFFFFFFF, 1)
        DrawNumber(138, 127, 150, 0xFFFFFFFF)
        DrawNumber(184, 127, 400, 0xFFFFFFFF)
        LDrawSprite(38 + ((g_tick / 6) % 2), 52, 154, 0.0)
        DrawGlyphText(76, 151, "SPIDER", 0xFFFFFFFF, 1)
        DrawNumber(138, 151, 120, 0xFFFFFFFF)
        DrawNumber(184, 151, 240, 0xFFFFFFFF)
        LDrawSprite(40 + ((g_tick / 10) % 2), 52, 178, 0.0)
        DrawGlyphText(76, 175, "SPLIT", 0xFFFFFFFF, 1)
        DrawNumber(138, 175, 90, 0xFFFFFFFF)
        DrawNumber(184, 175, 180, 0xFFFFFFFF)
        LDrawSprite(42 + ((g_tick / 12) % 2), 52, 202, 0.0)
        DrawGlyphText(76, 199, "ORBIT", 0xFFFFFFFF, 1)
        DrawNumber(138, 199, 130, 0xFFFFFFFF)
        DrawNumber(184, 199, 300, 0xFFFFFFFF)
        DrawCentered(220, "BOSS WITH ESCORTS 800 OR 1600", 0xFFFFDC3C)
        DrawCentered(232, "BONUS STAGE  100 EACH", 0xFF3CE1FF)
        DrawCentered(242, "ALL 40 HIT  10000 BONUS", 0xFF3CE1FF)
        DrawCentered(252, "RESCUE A FIGHTER  1000", 0xFF3CE1FF)
    ELSEIF pg = 3 THEN
        DrawCentered(46, "POWER-UPS", CycleColor(g_tick * 3))
        FOR i = 0 TO 5
            y = 68 + (i * 22)
            DrawCapsule(52, y + 5, i + 1, g_tick)
            IF i = 0 THEN
                DrawGlyphText(74, y, "SPREAD SHOT", 0xFFFFFFFF, 1)
                DrawGlyphText(74, y + 9, "3 THEN 5 WAY FIRE", 0xFF9090C8, 1)
            ELSEIF i = 1 THEN
                DrawGlyphText(74, y, "RAPID FIRE", 0xFFFFFFFF, 1)
                DrawGlyphText(74, y + 9, "FASTER SHOTS  STACKS", 0xFF9090C8, 1)
            ELSEIF i = 2 THEN
                DrawGlyphText(74, y, "SHIELD", 0xFFFFFFFF, 1)
                DrawGlyphText(74, y + 9, "ABSORBS HITS  STACKS", 0xFF9090C8, 1)
            ELSEIF i = 3 THEN
                DrawGlyphText(74, y, "SPEED UP", 0xFFFFFFFF, 1)
                DrawGlyphText(74, y + 9, "STACKS UP TO 3 TIMES", 0xFF9090C8, 1)
            ELSEIF i = 4 THEN
                DrawGlyphText(74, y, "COVIDOZ  BAD !", 0xFFFFE132, 1)
                DrawGlyphText(74, y + 9, "SLOW SHIP AND SLOW GUNS", 0xFF9090C8, 1)
            ELSE
                DrawGlyphText(74, y, "EXTRA LIFE", 0xFFFFFFFF, 1)
                DrawGlyphText(74, y + 9, "RARE", 0xFF9090C8, 1)
            ENDIF
        NEXT i
        DrawCentered(206, "SHOOT DIVING ENEMIES", 0xFFFFDC3C)
        DrawCentered(218, "TO MAKE THEM DROP CAPSULES", 0xFFFFDC3C)
        DrawCentered(234, "ALL LOST WITH YOUR SHIP", 0xFFFF3C3C)
    ELSE
        DrawCentered(54, "CONTROLS", CycleColor(g_tick * 3))
        DrawGlyphText(30, 80, "KEYBOARD", 0xFF3CE1FF, 1)
        DrawGlyphText(30, 92, "[ARROWS] OR [A] [D]  MOVE", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 103, "[SPACE] [CTRL] [Z] [X]  FIRE", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 114, "[P] PAUSE  [M] MUTE  [C] CRT", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 125, "[Q] END GAME  [ESC] QUIT", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 224 + 12, "[+] [-] DIFFICULTY (TITLE)", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 248, "[O] OPTIONS  SPEED  VOLUME", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 138, "MOUSE", 0xFF3CE1FF, 1)
        DrawGlyphText(30, 150, "MOVE THE MOUSE  STEER", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 161, "LEFT BUTTON  FIRE", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 185, "GAMEPAD", 0xFF3CE1FF, 1)
        DrawGlyphText(30, 197, "STICK OR D PAD  MOVE", 0xFFFFFFFF, 1)
        DrawGlyphText(30, 208, "ANY BUTTON  FIRE", 0xFFFFFFFF, 1)
        IF g_joyOk = 1 THEN
            DrawGlyphText(30, 222, "PAD DETECTED", 0xFF46E146, 1)
        ELSE
            DrawGlyphText(30, 222, "NO PAD FOUND", 0xFF505078, 1)
        ENDIF
    ENDIF

    IF pg > 0 THEN
        IF ((g_tick / 24) % 2) = 0 THEN DrawCentered(266, "PRESS FIRE TO START", 0xFFFFFFFF)
    ENDIF
    DrawMarquee(30, g_marq, 0xFFB4B4E6)      ' 1 pixel per tick: smoother than 1 pixel every 2 ticks
ENDSUB

' ---- mouse cursor: hidden while playing (the mouse steers the ship), normal arrow on menus / pause / name entry ----------
' (the same idea as XGalaga's W_BlankCursor). SETCURSOR with @CSCUSTOM and a NULL handle shows no cursor at all.
SUB UpdateCursor()
    INT want

    g_curPass = g_curPass + 1
    want = 0
    IF g_paused = 0 AND (g_gstate = GS_READY OR g_gstate = GS_PLAY OR g_gstate = GS_PDEAD OR g_gstate = GS_CLEAR) THEN want = 1
    IF want = g_curState AND (g_curPass % 30) <> 0 THEN RETURN      ' re-applied twice a second in case Windows reset it
    g_curState = want
    IF want = 1 THEN
        SETCURSOR main_win, @CSCUSTOM, 0
    ELSE
        SETCURSOR main_win, @CSARROW
    ENDIF
ENDSUB

' ---- demo mode (after a minute without input on the title) -----------------------------------------------------
SUB StartDemo()
    g_demo = 1
    g_demoQuit = 0
    g_demoT = 0
    g_demoMode = g_mode
    g_demoHi = g_hiscore
    g_demoDiff = g_diff
    g_mode = 0                                      ' an arcade game on normal difficulty
    g_diff = 1
    StopMusic()
    NewGame()
    g_demoSeg = 0
    g_demoLast = -1
    DemoSegment()                                   ' the first of six scenes
ENDSUB

SUB ExitDemo()
    g_demo = 0
    g_demoQuit = 0
    g_cosmo = 0                                    ' nothing the demo pilot rescued counts
    g_medals = 0
    g_mode = g_demoMode
    ClearObstacles(0)
    ClearBombs()
    g_diff = g_demoDiff
    g_hiscore = g_demoHi
    g_cBranch = -1
    g_cStep = 0
    FlushWorld()
    g_paused = 0
    g_score = 0
    g_stream = 0
    g_challenge = 0
    g_swarm = 0
    g_lemon = 0
    g_warp = 1.0
    g_palive = 0
    g_gstate = GS_TITLE
    g_atTick = 0
    g_idle = 0
    IF g_musSong <> 10 THEN PlayMusic(10, 1)          ' the title tune goes on from where the demo left it
ENDSUB

' the demo has six scenes, always in this order:
'   0  an early arcade stage                                      (r = 0)
'   1  a late arcade stage: obstacles, bombs and the carrier      (r = 4)
'   2  the arcade derelict fleet: wreckage, hull plates, a cosmonaut to rescue (r = 6)
'   3  a campaign orbital stage with the obstacles of its world   (r = 5)
'   4  the campaign orbit of the Empire world: the derelict fleet, a cosmonaut (r = 7)
'   5  a planetary stream (the enemy jets) or a big boss          (r = 2 or 3)
SUB DemoSegment()
    INT r, b

    r = 0
    IF g_demoSeg = 1 THEN r = 4
    IF g_demoSeg = 2 THEN r = 6
    IF g_demoSeg = 3 THEN r = 5
    IF g_demoSeg = 4 THEN r = 7
    IF g_demoSeg >= 5 THEN
        r = 2 + INT(RND(2.0))
        IF r > 3 THEN r = 3
        IF r = g_demoLast THEN r = 5 - r
    ENDIF
    g_demoLast = r
    ClearObstacles(0)
    ClearBombs()
    g_demoT = 0
    FlushWorld()
    g_palive = 1
    g_px = 112.0
    g_py = 264.0
    g_bank = 0.0
    g_dual = 0
    g_resc = 0
    g_heldShip = 0
    g_capPhase = 0
    g_capCool = 0
    g_capBoss = -1
    g_capMsg = 0
    g_lemon = 0
    g_grab = 0
    g_grabCool = 0
    g_invert = 0
    g_attackHold = 0
    g_shHit = 0
    g_flash = 0
    g_lives = 3
    g_spread = 1
    g_rapid = 1
    g_pspeed = 1
    g_shield = 2
    g_challenge = 0
    g_swarm = 0
    g_stream = 0
    g_warp = 1.0
    IF r = 0 OR r = 4 OR r = 6 THEN
        g_mode = 0                                  ' arcade stage 1 to 8, or a late stage (obstacles, bombs, carrier), or the derelict fleet
        g_cBranch = -1
        g_cStep = 0
        g_stage = INT(RND(8.0))
        IF r = 4 THEN
            b = INT(RND(4.0))
            IF b = 0 THEN g_stage = 10              ' stages 11, 13, 16, 18 (StartStage adds one)
            IF b = 1 THEN g_stage = 12
            IF b = 2 THEN g_stage = 15
            IF b > 2 THEN g_stage = 17
            g_spread = 2
            g_rapid = 2
        ENDIF
        IF r = 6 THEN
            g_spread = 2
            g_rapid = 2
            IF RND(2.0) < 1.0 THEN g_stage = 15 ELSE g_stage = 6       ' stage 16 (hull plates) or stage 7 (plain wreckage): StartStage adds one
        ENDIF
        StartStage()
        g_gstate = GS_READY
        g_gtimer = 120
    ELSE
        g_mode = 1                                  ' campaign: a random world
        b = INT(RND(4.0))
        IF b > 3 THEN b = 3
        IF r = 5 THEN
            b = INT(RND(3.0))                       ' orbital stage with obstacles: Cryos, Pyrra or Xenos
            IF b > 2 THEN b = 2
        ENDIF
        IF r = 7 THEN b = 3                         ' the Empire world: its orbit is the derelict fleet
        g_cBranch = b
        IF r = 5 THEN
            g_cStep = 2 + INT(RND(3.0))             ' orbital 3-5 (CampNextStage adds one: 3, 4 or 5)
            g_spread = 2
            g_rapid = 1
        ENDIF
        IF r = 7 THEN
            g_cStep = INT(RND(4.0))                 ' orbital 1-4 (CampNextStage adds one)
            g_spread = 2
            g_rapid = 1
        ENDIF
        IF r = 2 THEN g_cStep = 5 + INT(RND(3.0))   ' planetary 1-3
        IF r = 3 THEN
            g_cStep = 8                             ' the big boss
            g_spread = 2
            g_rapid = 2
        ENDIF
        IF g_cStep > 8 THEN g_cStep = 8
        IF g_skyInit = 1 THEN RollSky()
        CampNextStage()
    ENDIF
ENDSUB

SUB DemoNext()
    g_demoSeg = g_demoSeg + 1
    IF g_demoSeg >= 6 THEN
        ExitDemo()
    ELSE
        DemoSegment()
    ENDIF
ENDSUB

' the demo pilot: chase the lowest enemy (or the boss), step aside from shots and divers
SUB DemoAI()
    INT e, st, i, dodge, freeM
    FLOAT best, sc, tx, ty

    freeM = 0
    IF g_mode = 1 AND g_cStep >= 6 AND g_challenge = 0 THEN freeM = 1
    best = -1.0
    tx = 112.0
    ty = 236.0
    IF g_bsOn = 1 THEN
        tx = g_bsX
    ELSE
        FOR e = 0 TO 39
            st = g_eState[e]
            IF st = ES_FORM OR st = ES_HOME OR st = ES_DIVE OR st = ES_ENTER THEN
                IF g_eY[e] > 8.0 THEN
                    sc = g_eY[e]
                    IF st = ES_DIVE THEN sc = sc + 120.0
                    IF sc > best THEN
                        best = sc
                        tx = g_eX[e]
                    ENDIF
                ENDIF
            ENDIF
        NEXT e
    ENDIF
    IF g_crOn = 1 AND (best < 0.0 OR g_crPh = 2) THEN tx = g_crX      ' the fleet is gone: shoot the carrier
    FOR i = 0 TO 3
        IF g_prOn[i] = 1 AND g_prType[i] = 8 AND g_prY[i] > 40.0 THEN tx = g_prX[i]       ' a cosmonaut drifts down: go and catch him
    NEXT i
    ObSync()
    FOR i = 0 TO 7
        IF g_obOn[i] = 1 AND ABS(g_obX[i] - tx) < 24.0 AND g_obY[i] > 8.0 THEN
            tx = g_obX[i]                           ' an obstacle shields the target: shoot it first
        ENDIF
    NEXT i
    dodge = 0
    FOR i = 0 TO 3
        IF g_bmOn[i] = 1 THEN
            IF g_bmY[i] < (g_py - 50.0) THEN tx = g_bmX[i]            ' shoot the bomb before it comes down
            IF g_bmY[i] > (g_py - 90.0) AND ABS(g_bmX[i] - g_px) < 36.0 THEN
                IF g_bmX[i] < g_px THEN dodge = 1 ELSE dodge = -1       ' too close: get out of the blast
            ENDIF
        ENDIF
    NEXT i
    FOR i = 0 TO 9
        IF g_ebOn[i] = 1 THEN
            IF g_ebY[i] > (g_py - 70.0) AND g_ebY[i] < (g_py + 4.0) AND ABS(g_ebX[i] - g_px) < 14.0 THEN
                IF g_ebX[i] < g_px THEN dodge = 1 ELSE dodge = -1
            ENDIF
        ENDIF
    NEXT i
    FOR i = 0 TO 31
        IF g_bbOn[i] = 1 THEN
            IF g_bbY[i] > (g_py - 60.0) AND g_bbY[i] < (g_py + 4.0) AND ABS(g_bbX[i] - g_px) < 14.0 THEN
                IF g_bbX[i] < g_px THEN dodge = 1 ELSE dodge = -1
            ENDIF
        ENDIF
    NEXT i
    FOR e = 0 TO 39
        IF g_eState[e] = ES_DIVE THEN
            IF g_eY[e] < g_py AND g_eY[e] > (g_py - 55.0) AND ABS(g_eX[e] - g_px) < 20.0 THEN
                IF g_eX[e] < g_px THEN dodge = 1 ELSE dodge = -1
            ENDIF
        ENDIF
    NEXT e
    IF dodge = -1 AND g_px < 26.0 THEN dodge = 1
    IF dodge = 1 AND g_px > 198.0 THEN dodge = -1
    g_dmL = 0
    g_dmR = 0
    g_dmU = 0
    g_dmD = 0
    IF dodge = -1 THEN
        g_dmL = 1
    ELSEIF dodge = 1 THEN
        g_dmR = 1
    ELSEIF tx < (g_px - 3.0) THEN
        g_dmL = 1
    ELSEIF tx > (g_px + 3.0) THEN
        g_dmR = 1
    ENDIF
    IF freeM = 1 THEN
        IF g_py > (ty + 6.0) THEN g_dmU = 1
        IF g_py < (ty - 6.0) THEN g_dmD = 1
    ENDIF
ENDSUB

' ---- options screen --------------------------------------------------------------------------------------------
SUB UpdateOptions(fireEdge:INT)
    INT dU, dD, dL, dR, ch

    dU = KeyRep(2, g_inU)
    dD = KeyRep(3, g_inD)
    dL = KeyRep(0, g_inL)
    dR = KeyRep(1, g_inR)
    IF dU = 1 AND g_optSel > 0 THEN
        g_optSel = g_optSel - 1
        PlaySfx(12)
    ENDIF
    IF dD = 1 AND g_optSel < 5 THEN
        g_optSel = g_optSel + 1
        PlaySfx(12)
    ENDIF
    ch = dR - dL
    IF ch <> 0 THEN
        IF g_optSel = 0 THEN
            g_volMus = g_volMus + ch
            IF g_volMus < 0 THEN g_volMus = 0
            IF g_volMus > 10 THEN g_volMus = 10
        ELSEIF g_optSel = 1 THEN
            g_volSfx = g_volSfx + ch
            IF g_volSfx < 0 THEN g_volSfx = 0
            IF g_volSfx > 10 THEN g_volSfx = 10
            PlaySfx(3)                                  ' hear the new level
        ELSEIF g_optSel = 2 THEN
            g_speed = g_speed - ch                      ' right = faster (2 slow, 1 normal, 0 fast)
            IF g_speed < 0 THEN g_speed = 0
            IF g_speed > 2 THEN g_speed = 2
            PlaySfx(12)
        ELSEIF g_optSel = 3 THEN
            g_diff = g_diff + ch
            IF g_diff < 0 THEN g_diff = 0
            IF g_diff > 2 THEN g_diff = 2
            PlaySfx(12)
        ELSEIF g_optSel = 4 THEN
            g_scanLevel = (g_scanLevel + ch + 3) % 3
            PlaySfx(12)
        ENDIF
    ENDIF
    IF fireEdge = 1 THEN
        g_gstate = GS_TITLE
        g_atTick = 0
        SaveSettings()
        PlaySfx(12)
    ENDIF
ENDSUB

SUB DrawVolRow(y:INT, llabel:STRING, vol:INT, sel:INT)
    INT k, col, lc

    lc = 0xFFFFFFFF
    IF sel = 1 THEN
        lc = 0xFFFFDC3C
        DrawGlyphText(14, y, "*", 0xFFFFDC3C, 1)
    ENDIF
    DrawGlyphText(26, y, llabel, lc, 1)
    FOR k = 0 TO 9
        col = 0xFF303050
        IF k < vol THEN col = 0xFF3CE1FF
        FillRectSolid(30 + (k * 16), y + 12, 12, 6, col)
    NEXT k
    DrawNumber(214, y + 11, vol, lc)
ENDSUB

SUB DrawOptions()
    INT sel, lc, c0, c1, c2

    DrawCentered(30, "OPTIONS", CycleColor(g_tick * 3))
    sel = g_optSel

    c0 = 0
    IF sel = 0 THEN c0 = 1
    DrawVolRow(52, "MUSIC VOLUME", g_volMus, c0)
    c0 = 0
    IF sel = 1 THEN c0 = 1
    DrawVolRow(80, "SFX VOLUME", g_volSfx, c0)

    ' game speed
    lc = 0xFFFFFFFF
    IF sel = 2 THEN
        lc = 0xFFFFDC3C
        DrawGlyphText(14, 108, "*", 0xFFFFDC3C, 1)
    ENDIF
    DrawGlyphText(26, 108, "GAME SPEED", lc, 1)
    c0 = 0xFF505078
    c1 = 0xFF505078
    c2 = 0xFF505078
    IF g_speed = 2 THEN c0 = 0xFF46E146
    IF g_speed = 1 THEN c1 = 0xFFFFDC3C
    IF g_speed = 0 THEN c2 = 0xFFFF3C3C
    DrawGlyphText(30, 121, "SLOW", c0, 1)
    DrawGlyphText(88, 121, "NORMAL", c1, 1)
    DrawGlyphText(164, 121, "FAST", c2, 1)
    IF g_speed = 2 THEN
        DrawCentered(133, "20% SLOWER  TO LEARN THE PATTERNS", 0xFF9090C8)
    ELSEIF g_speed = 1 THEN
        DrawCentered(133, "10% SLOWER", 0xFF9090C8)
    ELSE
        DrawCentered(133, "THE ORIGINAL ARCADE SPEED", 0xFF9090C8)
    ENDIF

    ' difficulty
    lc = 0xFFFFFFFF
    IF sel = 3 THEN
        lc = 0xFFFFDC3C
        DrawGlyphText(14, 150, "*", 0xFFFFDC3C, 1)
    ENDIF
    DrawGlyphText(26, 150, "DIFFICULTY", lc, 1)
    IF g_diff = 0 THEN
        DrawCentered(163, "[-] EASY [+]", 0xFF46E146)
    ELSEIF g_diff = 1 THEN
        DrawCentered(163, "[-] NORMAL [+]", 0xFFFFDC3C)
    ELSE
        DrawCentered(163, "[-] HARD [+]", 0xFFFF3C3C)
    ENDIF

    ' scanlines
    lc = 0xFFFFFFFF
    IF sel = 4 THEN
        lc = 0xFFFFDC3C
        DrawGlyphText(14, 186, "*", 0xFFFFDC3C, 1)
    ENDIF
    DrawGlyphText(26, 186, "CRT SCANLINES", lc, 1)
    IF g_scanLevel = 0 THEN
        DrawCentered(197, "[-] OFF [+]", 0xFF9090C8)
    ELSEIF g_scanLevel = 1 THEN
        DrawCentered(197, "[-] LIGHT [+]", 0xFF9090C8)
    ELSE
        DrawCentered(197, "[-] STRONG [+]", 0xFF9090C8)
    ENDIF

    ' back
    lc = 0xFFFFFFFF
    IF sel = 5 THEN lc = 0xFFFFDC3C
    DrawCentered(222, "BACK", lc)
    IF sel = 5 THEN DrawGlyphText(90, 222, "*", 0xFFFFDC3C, 1)

    DrawCentered(240, "[UP] [DOWN] SELECT", 0xFF9090C8)
    DrawCentered(250, "[LEFT] [RIGHT] CHANGE", 0xFF9090C8)
    DrawCentered(260, "[SPACE] OR [ESC] BACK", 0xFF9090C8)
ENDSUB

SUB GameTick()
    INT i, j, k, inL, inR, fireHeld, fireEdge, fire, pg

    g_tick = g_tick + 1
    UpdateWarp()
    ScrollStars()
    UpdateSparks()
    UpdateRocks()
    UpdateHulk()
    IF g_gstate = GS_PLAY AND g_bsOn = 0 AND g_palive = 1 AND DerelictOn() = 1 THEN
        g_cosT = g_cosT - 1
        IF g_cosT <= 0 THEN
            SpawnSurvivor(24.0 + RND(176.0), -10.0)        ' a cosmonaut tumbles out of the wreckage
            g_cosT = 1500 + INT(RND(900.0))
        ENDIF
    ENDIF
    g_bgY = g_bgY + (0.5 * g_warp)
    IF g_bgY > 100000.0 THEN g_bgY = 0.0

    FOR i = 0 TO 15
        IF g_exOn[i] = 1 THEN
            g_exAge[i] = g_exAge[i] + 1
            FOR k = 0 TO 15
                j = (i * 24) + k                             ' Euler step: drag, gravity, then move
                g_xpVX[j] = g_xpVX[j] * 0.97
                g_xpVY[j] = (g_xpVY[j] * 0.97) + 0.03
                g_xpX[j] = g_xpX[j] + g_xpVX[j]
                g_xpY[j] = g_xpY[j] + g_xpVY[j]
            NEXT k
            IF g_exAge[i] > 44 THEN g_exOn[i] = 0
        ENDIF
    NEXT i
    FOR i = 0 TO 7
        IF g_popOn[i] = 1 THEN
            g_popAge[i] = g_popAge[i] + 1
            IF g_popAge[i] > 55 THEN g_popOn[i] = 0
        ENDIF
    NEXT i

    ReadInputs()
    IF g_demo = 1 THEN
        g_demoT = g_demoT + 1
        IF g_demoQuit = 1 OR g_inL = 1 OR g_inR = 1 OR g_inU = 1 OR g_inD = 1 OR g_inFire = 1 THEN
            ExitDemo()                                 ' any input ends the demo
            RETURN
        ENDIF
        IF (g_demoT > 2700 AND g_demoSeg <> 1) OR g_demoT > 4200 THEN       ' 45 s on one scene (70 s for the carrier scene): on to the next
            DemoNext()
            RETURN
        ENDIF
        IF g_gstate = GS_PLAY AND g_shield < 2 AND (g_demoT % 180) = 0 THEN g_shield = g_shield + 1     ' the demo ship gets its shield back
    ENDIF
    inL = g_inL | g_mouseL
    inR = g_inR | g_mouseR
    fireHeld = g_inFire
    fireEdge = 0
    IF fireHeld = 1 AND g_firePrev = 0 THEN fireEdge = 1
    g_firePrev = fireHeld
    fire = fireHeld
    IF g_demo = 1 THEN
        DemoAI()
        inL = g_dmL
        inR = g_dmR
        g_inU = g_dmU
        g_inD = g_dmD
        g_mouseU = 0
        g_mouseD = 0
        fire = 1
        fireEdge = 0
    ENDIF
    g_fireEdge = fireEdge

    IF g_gstate = GS_TITLE THEN
        g_atTick = g_atTick + 1
        g_marq = g_marq + 1
        pg = (g_atTick / 420) % 5
        IF KeyRep(1, g_inR) = 1 AND g_kRep[1] = 1 THEN g_atTick = ((pg + 1) % 5) * 420
        IF KeyRep(0, g_inL) = 1 AND g_kRep[0] = 1 THEN g_atTick = ((pg + 4) % 5) * 420
        IF g_inL = 1 OR g_inR = 1 OR g_inU = 1 OR g_inD = 1 OR g_inFire = 1 THEN g_idle = 0 ELSE g_idle = g_idle + 1
        IF g_idle >= 3600 THEN                         ' a minute of nothing: demo mode (the title tune goes on)
            StartDemo()
            RETURN
        ENDIF
        IF IsKeyDown(0x42) = 1 THEN
            ' shortcut: hold B on the title screen and press 1 (frost manta), 2 (magma core), 3 (hive queen), 4 (empire flagship) or 5 (the Emperor)
            FOR i = 0 TO 4
                IF IsKeyDown(0x31 + i) = 1 OR IsKeyDown(0x61 + i) = 1 THEN
                    StartBossCheat(i)
                    RETURN
                ENDIF
            NEXT i
        ENDIF
        IF IsKeyDown(0x45) = 1 AND IsKeyDown(0x4E) = 1 AND IsKeyDown(0x44) = 1 THEN
            ' easter egg: hold E + N + D on the title screen to jump straight to the ending (with the love story page too)
            FlushWorld()
            g_score = 0
            g_cosmo = 1
            g_sPage = 0
            g_cTimer = 0
            g_sBr = -1
            g_gstate = GS_END
            PlayMusic(13, 1)
            RETURN
        ENDIF
        IF fireEdge = 1 THEN
            StopMusic()
            NewGame()
        ENDIF
        RETURN
    ENDIF

    IF g_gstate = GS_OPT THEN
        g_idle = 0
        g_marq = g_marq + 1
        UpdateOptions(fireEdge)
        RETURN
    ENDIF

    IF g_gstate = GS_NAME THEN
        FlushWorld()
        UpdateName()
        RETURN
    ENDIF

    IF g_gstate = GS_STORY OR g_gstate = GS_MAP OR g_gstate = GS_END THEN
        CampUpdate(fireEdge, inL, inR)
        RETURN
    ENDIF

    g_ftick = g_ftick + 1

    IF g_gstate = GS_READY THEN
        g_gtimer = g_gtimer - 1
        IF g_mode = 1 AND g_cStep >= 9 AND (g_gtimer % 30) = 20 THEN PlaySfx(5)         ' the boss alarm
        IF g_stream = 1 AND g_py > 192.0 AND g_gtimer < 100 THEN g_py = g_py - 1.0      ' planetary assault: the ship climbs to
                                                                                        ' a third of the screen height
        IF g_mode = 0 OR g_cStep < 6 THEN
            IF g_py < 264.0 THEN g_py = g_py + 1.5           ' back down to the bottom after the warp
            IF g_py > 264.0 THEN g_py = 264.0
        ENDIF
        IF g_stMus = 1 THEN
            IF g_mode = 1 AND g_cStep >= 9 THEN
                IF g_gtimer <= 0 THEN StageMusic()                                      ' boss: after the alarm
            ELSE
                StageMusic()                                                            ' no fanfare any more: the stage tune starts at once
            ENDIF
        ENDIF
        IF g_gtimer <= 0 THEN g_gstate = GS_PLAY
        RETURN
    ENDIF

    IF g_gstate = GS_PLAY OR g_gstate = GS_PDEAD THEN
        UpdateEnemies()
        UpdateAttacks()
        UpdateTractor()
        UpdateBullets()
        UpdateBombs()
        UpdateCarrier()
        UpdateBoss()
        CheckRam()
        UpdateGrab()
        UpdateRescue()
        UpdatePrizes()
    ENDIF

    IF g_gstate = GS_PLAY THEN
        IF g_flash > 0 THEN g_flash = g_flash - 1
        IF g_shHit > 0 THEN g_shHit = g_shHit - 1
        IF g_lemon > 0 THEN g_lemon = g_lemon - 1
        IF g_invert > 0 THEN
            g_invert = g_invert - 1                    ' inked: left and right are swapped
            UpdatePlayer(inR, inL, fire)
            g_bank = g_bank + (((FLOAT(inL - inR) * 0.2) - g_bank) * 0.3)
        ELSE
            UpdatePlayer(inL, inR, fire)
            g_bank = g_bank + (((FLOAT(inR - inL) * 0.2) - g_bank) * 0.3)
        ENDIF
        g_stT = g_stT + 1
        IF g_mode = 0 AND g_crDone = 0 AND g_crOn = 0 AND g_challenge = 0 AND g_swarm = 0 AND g_stream = 0 AND g_bsOn = 0 AND (g_demo = 0 OR g_demoSeg = 1) AND g_stage >= 3 THEN
            IF (g_spread + g_rapid) >= 2 AND (g_stT < 2700 OR g_demo = 1) THEN
                IF AliveCount() = 0 THEN SpawnCarrier()      ' wiped out in under 45 seconds with stacked capsules: the carrier arrives
            ENDIF
        ENDIF
        IF AliveCount() = 0 THEN
            g_gstate = GS_CLEAR
            g_gtimer = 150
            g_accBonus = 0
            g_accPts = 0
            IF g_challenge = 0 AND g_demo = 0 THEN AccuracyBonus()
            ClearPrizes()
            ClearObstacles(1)
            ClearBombs()
            FOR i = 0 TO 15
                g_pbOn[i] = 0                          ' the last alien is gone: no shot stays suspended in the void
            NEXT i
            FOR i = 0 TO 9
                g_ebOn[i] = 0
            NEXT i
            IF g_challenge = 1 THEN
                g_gtimer = 260                         ' time to read the result
                IF g_chHits = 40 THEN
                    AddScore(10000)
                    PlaySfx(6)
                ENDIF
            ENDIF
        ENDIF

    ELSEIF g_gstate = GS_PDEAD THEN
        g_gtimer = g_gtimer - 1
        IF g_gtimer <= 0 THEN
            IF g_lives > 0 THEN
                g_palive = 1
                g_px = 112.0
                g_py = 264.0
                g_gstate = GS_PLAY
                g_capMsg = 0
                g_flash = 100                      ' blinking and invulnerable for 1.7 s
            ELSEIF g_demo = 1 THEN
                DemoNext()                         ' the demo ship was shot down: on to the next scene
            ELSE
                g_gstate = GS_OVER
                ClearObstacles(0)
                ClearBombs()
                g_gtimer = 240
                g_nameRank = -1
                PlayMusic(2, 0)
                IF g_score > 0 AND FindRank(g_score) >= 0 THEN
                    g_gstate = GS_NAME
                    g_nameLen = 0
                    g_nameCh[0] = 65
                    g_nameCh[1] = 65
                    g_nameCh[2] = 65
                    g_nameTimer = 1500
                ENDIF
                SaveSettings()
            ENDIF
        ENDIF

    ELSEIF g_gstate = GS_CLEAR THEN
        g_gtimer = g_gtimer - 1
        IF g_gtimer <= 0 THEN
            IF g_demo = 1 THEN
                DemoNext()                         ' scene cleared
            ELSEIF g_mode = 1 THEN
                CampAfterClear()
            ELSE
                StartStage()
                g_gstate = GS_READY
                g_gtimer = 120
            ENDIF
        ENDIF

    ELSEIF g_gstate = GS_OVER THEN
        FlushWorld()
        g_gtimer = g_gtimer - 1
        IF g_gtimer <= 0 THEN
            g_gstate = GS_TITLE
            g_atTick = 0
            IF g_nameRank >= 0 THEN g_atTick = 420          ' show the table with the new entry first
            PlayMusic(10, 1)
        ENDIF
    ENDIF
ENDSUB

' ===============================================================================
' RENDERING
' ===============================================================================
' ===============================================================================
' CAMPAIGN: story, galaxy map, branches (5 stages + a boss wave each)
' ===============================================================================
SUB CampInit()
    g_cBranch = -1
    g_cStep = 0
    g_cDone = 0
    g_warpPod = 0
    g_cJump = 0
    g_warpMsg = 0
    g_podDrop = 0
    g_cForce = 0
    g_mapSel = 0
    g_sPage = 0
    g_cTimer = 0
    g_bsOn = 0
    g_sBr = -1
ENDSUB

SUB CampColor(b:INT), INT
    IF b = 0 THEN RETURN 0xFF64C8FF
    IF b = 1 THEN RETURN 0xFFFF6E28
    IF b = 2 THEN RETURN 0xFF78E650
    RETURN 0xFFD23CFF
ENDSUB

' 1 when the branch can be chosen: not cleared yet, and the empire only after the three worlds
SUB CampAvail(b:INT), INT
    IF b < 3 THEN
        IF (g_cDone & (1 << b)) = 0 THEN RETURN 1
        RETURN 0
    ENDIF
    IF (g_cDone & 7) = 7 AND (g_cDone & 8) = 0 THEN RETURN 1
    RETURN 0
ENDSUB

SUB CampPickSel()
    g_mapSel = 0
    IF CampAvail(3) = 1 THEN g_mapSel = 3
    IF CampAvail(2) = 1 THEN g_mapSel = 2
    IF CampAvail(1) = 1 THEN g_mapSel = 1
    IF CampAvail(0) = 1 THEN g_mapSel = 0
ENDSUB

SUB CampMove(d:INT)
    INT k, n, found
    n = g_mapSel
    found = 0
    FOR k = 1 TO 4
        IF found = 0 THEN
            n = (n + d + 4) % 4
            IF CampAvail(n) = 1 THEN found = 1
        ENDIF
    NEXT k
    IF found = 1 AND n <> g_mapSel THEN
        g_mapSel = n
        PlaySfx(12)
    ENDIF
ENDSUB

SUB CampNextStage()
    g_cStep = g_cStep + 1
    g_cForce = 0
    g_stream = 0
    IF g_cStep >= 6 AND g_cStep <= 8 THEN g_stream = 1          ' steps 6-8: planetary defences stream past
    StartStage()
    IF g_cStep >= 9 AND g_cBranch = 0 THEN BossSpawn(0)         ' step 9: the big boss (the frost manta)
    IF g_cStep >= 9 AND g_cBranch = 1 THEN BossSpawn(1)         ' the magma core
    IF g_cStep >= 9 AND g_cBranch = 2 THEN BossSpawn(2)         ' the hive queen
    IF g_cStep >= 9 AND g_cBranch = 3 THEN BossSpawn(3)         ' the empire flagship
    IF g_cStep >= 9 THEN PlayMusic(15, 0)                       ' the boss WARNING stinger (2 s); the boss theme follows
    g_gstate = GS_READY
    g_gtimer = 120
ENDSUB

' shortcut (title screen: hold B and press 1-4): straight into a boss battle of the campaign
SUB StartBossCheat(k:INT)
    StopMusic()
    g_mode = 1
    NewGame()
    g_bossCheat = 1
    IF k = 4 THEN g_cBranch = 3 ELSE g_cBranch = k
    IF g_skyInit = 1 THEN RollSky()
    g_cDone = 0
    g_cStep = 8                                          ' the next step is the boss
    g_warpPod = 0
    g_cJump = 0
    g_warpMsg = 0
    CampNextStage()
    IF k = 4 THEN BossSpawn(4)                           ' B + 5: straight to the Emperor
ENDSUB

SUB CampStartBranch(b:INT)
    g_cBranch = b
    IF g_skyInit = 1 THEN RollSky()                              ' a new sky for every world
    g_cStep = 0
    g_warpPod = 0
    g_cJump = 0
    g_warpMsg = 0
    CampNextStage()
ENDSUB

' called when a stage of the campaign has been cleared and its result screen is over
SUB CampBrief(b:INT)
    g_sBr = b
    g_sPage = 0
    g_cTimer = 0
    g_gstate = GS_STORY
    PlaySfx(12)
    IF b = 2 THEN PlayMusic(14, 1) ELSE PlayMusic(12, 1)  ' the hive briefing: Hive Dread; the other mission briefings: Briefing Room
ENDSUB

SUB CampPageCount(), INT
    IF g_sBr < 0 THEN
        IF g_cosmo > 0 THEN RETURN 5                 ' a cosmonaut was rescued: the love story is inserted before the final score
        RETURN 4
    ENDIF
    IF g_sBr < 4 THEN RETURN 3
    RETURN 2
ENDSUB

SUB CampCount(d:INT), INT
    RETURN (d & 1) + ((d >> 1) & 1) + ((d >> 2) & 1) + ((d >> 3) & 1)
ENDSUB

' called when a stage of the campaign has been cleared and its result screen is over
SUB CampAfterClear()
    IF g_cStep >= 9 THEN
        AddScore(5000)
        IF g_lives < 9 THEN g_lives = g_lives + 1
        IF g_cJump > 3 THEN g_cJump = 3
        g_cDone = g_cDone | (1 << g_cBranch) | (g_cJump << (4 + (2 * g_cBranch)))      ' the warp jumps made in this world are kept for the route screen
        g_cTimer = 0
        g_sPage = 0
        IF g_cBranch = 3 THEN
            PlayMusic(13, 1)                               ' the last world won: the ending tune (Drift)
        ELSEIF g_cBranch = 2 THEN
            PlayMusic(14, 1)                               ' the hive report: Hive Dread
        ELSE
            PlayMusic(1, 1)
        ENDIF
        IF g_cBranch = 3 THEN
            IF g_bossCheat = 0 THEN
                g_cSaveDone = 0                            ' the campaign is won: nothing left to continue
                SaveSettings()
            ENDIF
            g_sBr = -1
            g_gstate = GS_END
        ELSE
            IF g_bossCheat = 0 THEN
                g_cSaveDone = g_cDone                      ' checkpoint: cleared worlds, score and lives
                g_cSaveScore = g_score
                g_cSaveLives = g_lives
                SaveSettings()
            ENDIF
            g_sBr = 10 + g_cBranch                         ' the epilogue of this world, then the map
            g_cBranch = -1
            g_gstate = GS_STORY
        ENDIF
    ELSE
        IF g_warpPod = 1 AND g_cStep <= 7 THEN
            g_cStep = g_cStep + 1                          ' the warp pod: one step is skipped
            g_cJump = g_cJump + 1
            g_warpMsg = 150
            AddScore(1000)
        ENDIF
        g_warpPod = 0
        CampNextStage()
    ENDIF
ENDSUB

SUB CampUpdate(fireEdge:INT, inL:INT, inR:INT)
    INT b
    g_cTimer = g_cTimer + 1
    IF g_gstate = GS_STORY THEN
        IF fireEdge = 1 THEN
            PlaySfx(12)
            g_sPage = g_sPage + 1
            g_cTimer = 0
            IF g_sPage >= CampPageCount() THEN
                IF g_sBr >= 0 AND g_sBr < 4 THEN
                    b = g_sBr                              ' the briefing is over: off to the world
                    g_sBr = -1
                    CampStartBranch(b)
                ELSE
                    g_sBr = -1
                    g_gstate = GS_MAP
                    CampPickSel()
                    IF g_musSong <> 1 THEN PlayMusic(1, 1)          ' back to the map tune
                ENDIF
            ENDIF
        ENDIF
    ELSEIF g_gstate = GS_MAP THEN
        IF KeyRep(1, inR) = 1 THEN CampMove(1)
        IF KeyRep(0, inL) = 1 THEN CampMove(-1)
        IF fireEdge = 1 AND CampAvail(g_mapSel) = 1 THEN CampBrief(g_mapSel)
    ELSEIF g_gstate = GS_END THEN
        IF fireEdge = 1 AND g_cTimer > 40 THEN
            PlaySfx(12)
            g_sPage = g_sPage + 1
            g_cTimer = 0
            IF g_sPage >= CampPageCount() THEN
                g_lives = 0                                  ' on to the usual score / name entry
                g_palive = 0
                g_gstate = GS_PDEAD
                g_gtimer = 1
                g_capMsg = 0
            ENDIF
        ENDIF
    ENDIF
ENDSUB

' branch name + phase shown under STAGE n while READY
SUB CampBanner()
    INT col
    IF g_cBranch < 0 THEN RETURN
    col = CampColor(g_cBranch)
    IF g_warpMsg > 0 THEN
        g_warpMsg = g_warpMsg - 1
        IF ((g_tick / 6) % 2) = 0 THEN DrawCentered(176, "WARP JUMP !", 0xFF9B5CFF)
    ENDIF
    IF g_cBranch = 0 THEN DrawCentered(92, "ICE PLANET", col)
    IF g_cBranch = 1 THEN DrawCentered(92, "LAVA PLANET", col)
    IF g_cBranch = 2 THEN DrawCentered(92, "INSECTOID HIVE", col)
    IF g_cBranch = 3 THEN DrawCentered(92, "EMPIRE FLAGSHIP", col)
    IF g_cStep >= 9 THEN
        DrawHazard(118, 6, g_tick)
        DrawHazard(158, 6, 600 - (g_tick % 600))
        IF ((g_tick / 6) % 2) = 0 THEN DrawCentered(130, "WARNING !", 0xFFFF3C3C)
        IF g_cBranch = 0 THEN DrawCentered(144, "FROST MANTA", 0xFFFFFFFF)
        IF g_cBranch = 1 THEN DrawCentered(144, "MAGMA CORE", 0xFFFFFFFF)
        IF g_cBranch = 2 THEN DrawCentered(144, "HIVE QUEEN", 0xFFFFFFFF)
        IF g_cBranch = 3 THEN DrawCentered(144, "EMPIRE FLAGSHIP", 0xFFFFFFFF)
        IF ((g_tick / 8) % 2) = 0 THEN DrawCentered(106, "BIG BOSS", 0xFFFF3C3C)
    ELSEIF g_cStep >= 6 THEN
        DrawGlyphText(64, 106, "PLANETARY", 0xFFFFFFFF, 1)                      ' 16 characters, centred on 112
        DrawGlyphIdx(124, 106, g_cStep - 5, 0xFFFFDC3C, 1)
        DrawGlyphText(136, 106, "OF 3", 0xFFFFFFFF, 1)
    ELSE
        DrawGlyphText(70, 106, "ORBITAL", 0xFFFFFFFF, 1)                        ' 14 characters, centred on 112
        DrawGlyphIdx(118, 106, g_cStep, 0xFFFFDC3C, 1)
        DrawGlyphText(130, 106, "OF 5", 0xFFFFFFFF, 1)
    ENDIF
ENDSUB

SUB CampLabel(b:INT, cx:INT, y:INT, col:INT)
    IF b = 0 THEN DrawGlyphText(cx - 9, y, "ICE", col, 1)
    IF b = 1 THEN DrawGlyphText(cx - 12, y, "FIRE", col, 1)
    IF b = 2 THEN DrawGlyphText(cx - 12, y, "HIVE", col, 1)
    IF b = 3 THEN DrawGlyphText(cx - 18, y, "EMPIRE", col, 1)
ENDSUB

SUB DrawPlanet(cx:INT, cy:INT, rad:INT, col:INT)
    INT xx, yy, t, dark, light, c
    dark = 0xFF000000 | ((col >> 1) & 0x7F7F7F)
    light = 0xFF000000 | (((col >> 1) & 0x7F7F7F) + 0x808080)
    FOR yy = -rad TO rad
        FOR xx = -rad TO rad
            IF (xx * xx) + (yy * yy) <= rad * rad THEN
                t = xx + yy
                c = col
                IF t < 0 - (rad / 2) THEN c = light
                IF t > rad / 2 THEN c = dark
                PutPix(cx + xx, cy + yy, c)
            ENDIF
        NEXT xx
    NEXT yy
ENDSUB

SUB DrawOval(cx:INT, cy:INT, rx:INT, ry:INT, col:INT)
    INT k
    FLOAT a
    FOR k = 0 TO 95
        a = FLOAT(k) * 0.06545
        PutPix(cx + INT(FLOAT(rx) * COS(a)), cy + INT(FLOAT(ry) * SIN(a)), col)
    NEXT k
ENDSUB

' ---- the star routes screen: one pillar of 9 steps per world, the empire at the top, the lit route of the worlds already won ----
SUB RouteLine(x0:INT, y0:INT, x1:INT, y1:INT, lit:INT)
    INT k, n, x, y, col
    n = ABS(x1 - x0)
    IF ABS(y1 - y0) > n THEN n = ABS(y1 - y0)
    IF n = 0 THEN
        IF lit = 1 THEN PutPix(x0, y0, 0xFFC050FF)
        RETURN
    ENDIF
    FOR k = 0 TO n
        x = x0 + (((x1 - x0) * k) / n)
        y = y0 + (((y1 - y0) * k) / n)
        IF lit = 1 THEN
            col = 0xFFC050FF
            IF ((k + (g_tick / 2)) % 14) < 4 THEN col = 0xFFF8C8FF
            PutPix(x, y, col)
            PutPix(x + 1, y, 0xFF7028B0)
        ELSEIF (k % 3) = 0 THEN
            PutPix(x, y, 0xFF303860)
        ENDIF
    NEXT k
ENDSUB

SUB GRoundRect(x:INT, y:INT, w:INT, h:INT, col:INT)
    FillRectSolid(x + 1, y, w - 2, 1, col)
    FillRectSolid(x, y + 1, w, h - 2, col)
    FillRectSolid(x + 1, y + h - 1, w - 2, 1, col)
ENDSUB

' a little picture card (46 x 30): magenta frame, a 40 x 24 bitmap, a pointer tail towards the pillar (tl 1: tail on top, 2: tail below)
' idx 0 ice, 1 lava, 2 hive, 3 empire; hot = the selected card blinks
SUB RouteCard(cx:INT, y0:INT, idx:INT, hot:INT, tl:INT)
    INT x0, k, col
    x0 = cx - 23
    IF hot = 1 THEN
        IF ((g_tick / 10) % 2) = 0 THEN col = 0xFFFFDC3C ELSE col = 0xFFFFFFFF
        FillRectSolid(x0 - 3, y0 - 3, 52, 1, col)
        FillRectSolid(x0 - 3, y0 + 32, 52, 1, col)
        FillRectSolid(x0 - 3, y0 - 3, 1, 36, col)
        FillRectSolid(x0 + 48, y0 - 3, 1, 36, col)
    ENDIF
    GRoundRect(x0, y0, 46, 30, 0xFF6A1A68)
    GRoundRect(x0, y0, 45, 29, 0xFFE060D8)
    GRoundRect(x0 + 1, y0 + 1, 43, 27, 0xFF1A0820)
    IF g_pRouteCard <> 0 THEN DrawSpr(g_pRouteCard + (idx * 960 * 4), 40, 24, x0 + 3, y0 + 3, 0)
    FOR k = 0 TO 3
        IF tl = 1 THEN
            FillRectSolid(cx - 3 + k, y0 - 1 - k, 7 - (2 * k), 1, 0xFFE060D8)
        ELSE
            FillRectSolid(cx - 3 + k, y0 + 30 + k, 7 - (2 * k), 1, 0xFFE060D8)
        ENDIF
    NEXT k
ENDSUB

' one step of a pillar: st 0 not reached, 1 won, 2 skipped by a warp pod, 3 the scan light
SUB RouteCell(x:INT, y:INT, w:INT, h:INT, st:INT)
    INT face, hi, sh
    face = 0xFF1C2038
    hi = 0xFF343C64
    sh = 0xFF10142A
    IF st = 1 THEN
        face = 0xFF2E8C3C
        hi = 0xFF78F078
        sh = 0xFF1C5A28
    ELSEIF st = 2 THEN
        face = 0xFF5A3CA8
        hi = 0xFFB090FF
        sh = 0xFF2C1E5C
    ELSEIF st = 3 THEN
        face = 0xFF506090
        hi = 0xFFC8D8FF
        sh = 0xFF28304C
    ENDIF
    FillRectSolid(x, y, w, h, face)
    FillRectSolid(x, y, w, 1, hi)
    FillRectSolid(x, y + h - 1, w, 1, sh)
    FillRectSolid(x + 2, y + (h / 2), w - 4, 1, sh)
    FillRectSolid(x, y, 1, h, hi)
    FillRectSolid(x + w - 1, y, 1, h, sh)
ENDSUB

SUB DrawRouteMap()
    INT b, cx, k, j, st, cy, col, jmp, cl, open, ty, scan
    DrawCentered(25, "STAR ROUTES", CycleColor(g_tick * 3))
    open = 0
    IF (g_cDone & 7) = 7 THEN open = 1
    ' the empire at the top
    col = CampColor(3)
    IF open = 0 THEN col = 0xFF504060
    RouteLine(112, 68, 112, 74, open)
    IF (g_cDone & 8) <> 0 THEN RouteLine(112, 68, 112, 74, 1)
    ' top bus and the three pillars
    FOR b = 0 TO 2
        cx = 40 + (b * 72)
        cl = (g_cDone >> b) & 1
        RouteLine(cx, 74, 112, 74, cl)
        jmp = (g_cDone >> (4 + (2 * b))) & 3
        scan = (g_tick / 6) % 12
        FOR k = 0 TO 8
            ty = 80 + ((8 - k) * 11)
            st = 0
            IF cl = 1 THEN
                st = 1
                IF jmp > 0 AND k = 2 THEN st = 2
                IF jmp > 1 AND k = 4 THEN st = 2
                IF jmp > 2 AND k = 6 THEN st = 2
            ELSEIF g_mapSel = b AND k = scan THEN
                st = 3
            ENDIF
            RouteCell(cx - 13, ty, 26, 10, st)
        NEXT k
        IF cl = 1 THEN RouteLine(cx, 181, cx, 78, 1)
        RouteLine(cx, 181, cx, 183, cl)
    NEXT b
    ty = 0
    IF g_mapSel = 3 THEN ty = 1
    RouteCard(112, 34, 3, ty, 2)
    DrawGlyphText(142, 46, "EMPIRE", col, 1)
    ' the three worlds at the bottom
    FOR b = 0 TO 2
        cx = 40 + (b * 72)
        cl = (g_cDone >> b) & 1
        jmp = (g_cDone >> (4 + (2 * b))) & 3
        ty = 0
        IF g_mapSel = b THEN ty = 1
        RouteCard(cx, 184, b, ty, 1)
        IF cl = 1 THEN
            CampLabel(b, cx, 217, 0xFF46E146)
            DrawGlyphText(cx - 15, 226, "CLEAR", 0xFF46E146, 1)
            IF jmp > 0 THEN
                CapIcon(cx + 17, 225, 7, 0xFF9B5CFF)
                DrawGlyphIdx(cx + 28, 226, jmp, 0xFF9B5CFF, 1)
            ENDIF
        ELSE
            CampLabel(b, cx, 217, 0xFFFFFFFF)
        ENDIF
    NEXT b
    ' station omega: the ring station, scaled down
    IF g_pOmegaMini <> 0 THEN DrawSpr(g_pOmegaMini, 34, 40, 95, 235, 0)
    DrawGlyphText(134, 247, "STATION", 0xFF9090C8, 1)
    DrawGlyphText(134, 257, "OMEGA", 0xFF9090C8, 1)
ENDSUB

' ---- briefings (before a world) and epilogues (after its boss)
SUB DrawBrief(b:INT, pg:INT)
    IF pg = 0 THEN
        IF b = 0 THEN
            DrawCentered(84, "TARGET: CRYOS", 0xFFFFDC3C)
            DrawCentered(106, "AN ICE WORLD.", 0xFFFFFFFF)
            DrawCentered(126, "THE EMPIRE DRILLS ITS SEAS", 0xFFFFFFFF)
            DrawCentered(138, "FOR REACTOR COOLANT.", 0xFFFFFFFF)
        ELSEIF b = 1 THEN
            DrawCentered(84, "TARGET: PYRRA", 0xFFFFDC3C)
            DrawCentered(106, "A WORLD OF LAVA AND ASH.", 0xFFFFFFFF)
            DrawCentered(126, "THE EMPIRE FORGES ITS HULLS", 0xFFFFFFFF)
            DrawCentered(138, "IN THE MOLTEN SEAS.", 0xFFFFFFFF)
        ELSEIF b = 2 THEN
            DrawCentered(84, "TARGET: XENOS", 0xFFFFDC3C)
            DrawCentered(106, "THE INSECTOID HOMEWORLD.", 0xFFFFFFFF)
            DrawCentered(126, "THE EMPIRE BREEDS ITS", 0xFFFFFFFF)
            DrawCentered(138, "SWARMS IN THESE HIVES.", 0xFFFFFFFF)
        ELSE
            DrawCentered(84, "TARGET: THE EMPIRE", 0xFFFFDC3C)
            DrawCentered(106, "ITS FLAGSHIP HANGS ABOVE", 0xFFFFFFFF)
            DrawCentered(118, "THE CAPITAL.", 0xFFFFFFFF)
            DrawCentered(140, "THREE WORLDS ARE FREE.", 0xFF46E146)
        ENDIF
    ELSEIF pg = 1 THEN
        DrawCentered(84, "MISSION PLAN", 0xFFFFDC3C)
        DrawCentered(106, "ORBIT: 5 WAVES OF PATROLS.", 0xFFFFFFFF)
        DrawCentered(118, "SURFACE: 3 DEFENCE WAVES.", 0xFFFFFFFF)
        DrawCentered(130, "THEN THE BIG BOSS.", 0xFFFF3C3C)
        IF b = 0 THEN DrawCentered(152, "THE ICE FIELDS HIDE GUNS.", 0xFF64C8FF)
        IF b = 1 THEN DrawCentered(152, "HEAT BLINDS OUR SCANNERS.", 0xFFFF6E28)
        IF b = 2 THEN DrawCentered(152, "THE JUNGLE HIDES THE SWARM.", 0xFF78E650)
        IF b = 3 THEN DrawCentered(152, "THERE IS NO RETREAT.", 0xFFD23CFF)
    ELSE
        IF b = 0 THEN
            DrawCentered(84, "THE FROST MANTA", 0xFFFF3C3C)
            DrawCentered(106, "GUARDS THE POLAR PASS.", 0xFFFFFFFF)
            DrawCentered(126, "ITS WINGS CUT THE SKY.", 0xFFFFFFFF)
        ELSEIF b = 1 THEN
            DrawCentered(84, "THE MAGMA CORE", 0xFFFF3C3C)
            DrawCentered(106, "BURNS BELOW THE CRUST.", 0xFFFFFFFF)
            DrawCentered(126, "SHATTER ITS ROCKS FIRST.", 0xFFFFFFFF)
        ELSEIF b = 2 THEN
            DrawCentered(84, "THE HIVE QUEEN", 0xFFFF3C3C)
            DrawCentered(106, "NEVER STOPS LAYING EGGS.", 0xFFFFFFFF)
            DrawCentered(126, "KILL HER FAST.", 0xFFFFFFFF)
        ELSE
            DrawCentered(84, "THE EMPIRE FLAGSHIP", 0xFFFF3C3C)
            DrawCentered(106, "CARRIES FOUR TURRETS.", 0xFFFFFFFF)
            DrawCentered(126, "BREAK THEM. THEN HIT", 0xFFFFFFFF)
            DrawCentered(138, "THE CORE UNDER THE HATCH.", 0xFFFFFFFF)
        ENDIF
        DrawCentered(160, "GOOD HUNTING PILOT.", 0xFFFFDC3C)
    ENDIF
ENDSUB

SUB DrawEpi(b:INT, pg:INT)
    INT n
    IF pg = 0 THEN
        IF b = 0 THEN
            DrawCentered(90, "THE FROST MANTA FALLS.", 0xFFFFFFFF)
            DrawCentered(110, "CRYOS BEGINS TO THAW.", 0xFF64C8FF)
        ELSEIF b = 1 THEN
            DrawCentered(90, "THE MAGMA CORE GOES DARK.", 0xFFFFFFFF)
            DrawCentered(110, "THE FORGES FALL SILENT.", 0xFFFF6E28)
        ELSE
            DrawCentered(90, "THE HIVE QUEEN IS DEAD.", 0xFFFFFFFF)
            DrawCentered(110, "THE SWARMS GO QUIET.", 0xFF78E650)
        ENDIF
    ELSE
        IF b = 0 THEN DrawCentered(90, "THE EMPIRE LOSES ITS COOLANT.", 0xFFFFFFFF)
        IF b = 1 THEN DrawCentered(90, "THE EMPIRE LOSES ITS HULL YARDS.", 0xFFFFFFFF)
        IF b = 2 THEN DrawCentered(90, "THE EMPIRE LOSES ITS DRONES.", 0xFFFFFFFF)
        n = CampCount(g_cDone & 7)
        DrawNumber(64, 124, n, 0xFFFFDC3C)
        DrawGlyphText(70, 124, "OF 3 WORLDS FREE", 0xFFFFFFFF, 1)
        IF n = 3 THEN
            DrawCentered(148, "THE PATH TO THE EMPIRE", 0xFFD23CFF)
            DrawCentered(160, "IS OPEN.", 0xFFD23CFF)
        ENDIF
    ENDIF
ENDSUB

' ===============================================================================
' ENDING VIGNETTES  (a framed 192 x 100 painting above the text of each of the four ending pages; the paintings are bitmaps, made in
' proto/vignettes.py, and the animated parts (flames, embers, ships) are drawn over them, clipped to the painting)
' ===============================================================================
SUB PcPix(x:INT, y:INT, col:INT)
    IF x >= g_pcX0 AND x <= g_pcX1 AND y >= g_pcY0 AND y <= g_pcY1 THEN PutPix(x, y, col)
ENDSUB

SUB PcRect(x:INT, y:INT, w:INT, h:INT, col:INT)
    INT ix, iy
    FOR iy = 0 TO h - 1
        FOR ix = 0 TO w - 1
            PcPix(x + ix, y + iy, col)
        NEXT ix
    NEXT iy
ENDSUB

SUB PcEllipse(cx:INT, cy:INT, rx:INT, ry:INT, col:INT)
    INT xx, yy
    FOR yy = 0 - ry TO ry
        FOR xx = 0 - rx TO rx
            IF (xx * xx * ry * ry) + (yy * yy * rx * rx) <= (rx * rx * ry * ry) THEN PcPix(cx + xx, cy + yy, col)
        NEXT xx
    NEXT yy
ENDSUB

SUB PcAlien(ax:INT, ay:INT, col:INT)
    PcRect(ax - 3, ay, 7, 2, col)
    PcRect(ax - 1, ay - 1, 3, 1, col)
    PcPix(ax - 4, ay + 2, col)
    PcPix(ax + 4, ay + 2, col)
ENDSUB


' the frame (green, rounded, bevelled) around a picture of 192 x 100 pixels whose top left corner is (x, y)
SUB DrawVigFrame(x:INT, y:INT)
    GRoundRect(x - 4, y - 4, 200, 108, 0xFF0A3410)
    GRoundRect(x - 3, y - 3, 198, 106, 0xFF38C048)
    GRoundRect(x - 2, y - 2, 196, 104, 0xFF1C7A28)
    GRoundRect(x - 1, y - 1, 194, 102, 0xFF0A2410)
    FillRectSolid(x - 2, y - 3, 194, 1, 0xFF8CF08C)
    FillRectSolid(x - 3, y - 2, 1, 100, 0xFF8CF08C)
    FillRectSolid(x - 2, y + 101, 194, 1, 0xFF0E4A18)
    FillRectSolid(x + 193, y - 2, 1, 100, 0xFF0E4A18)
ENDSUB

' page 0: the empire flagship burns above its homeworld while the fleet scatters
SUB PcVictory(ox:INT, oy:INT)
    INT i, fx, fy, ph, rr, tt, ax, ay, k
    IF g_pHullS <> 0 THEN DrawSpr(g_pHullS, 120, 56, ox + 36, oy + 8, 0)
    FOR k = 0 TO 53
        PcRect(ox + 92 + ((k * 4) / 9) + (((k / 6) % 2) * 2), oy + 8 + k, 2, 1, 0xFF100818)        ' the hull is broken in two
    NEXT k
    FOR i = 0 TO 7
        fx = ox + 46 + ((i * 17) % 104)
        fy = oy + 16 + ((i * 11) % 38)
        ph = ((g_tick / 4) + (i * 3)) % 4
        rr = 2 + (ph % 3)
        PcEllipse(fx, fy, rr + 2, rr + 1, 0xFFD02810)
        PcEllipse(fx, fy, rr + 1, rr, 0xFFFF7A18)
        PcEllipse(fx, fy, rr - 1, rr - 1, 0xFFFFE850)
        tt = ((g_tick / 3) + (i * 4)) % 20
        PcPix(fx - 1 + (i % 3), fy - 6 - tt, 0xFF70687C)
        PcPix(fx + (i % 2), fy - 7 - tt, 0xFF504860)
    NEXT i
    FOR i = 0 TO 4
        tt = ((g_tick / 2) + (i * 21)) % 100
        ax = ox + 96 + ((tt * ((i * 2) - 4)) / 2)
        ay = oy + 60 + ((i % 2) * (tt / 4))
        PcAlien(ax, ay, 0xFF78E650)
    NEXT i
    IF g_pLifeS <> 0 THEN
        ax = ox + 150
        ay = oy + 66 - ((g_tick / 14) % 2)
        DrawSpr(g_pLifeS, LIFE_W, LIFE_H, ax, ay, 0)
        PcRect(ax + 6, ay + LIFE_H, 2, 2 + ((g_tick / 3) % 3), 0xFFFFC83C)
        PcRect(ax + 14, ay + LIFE_H, 2, 2 + (((g_tick / 3) + 1) % 3), 0xFFFFC83C)
    ENDIF
ENDSUB

' page 1: ice melts, fires die, hives sleep
SUB PcAfter(ox:INT, oy:INT)
    INT i, cx, cy, dy
    cy = oy + 54
    cx = ox + 34
    FOR i = 0 TO 3
        dy = ((g_tick / 3) + (i * 5)) % 16
        PcPix(cx - 12 + (i * 8), cy + 20 + dy, 0xFF98D0F8)
    NEXT i
    cx = ox + 96
    cy = oy + 50
    FOR i = 0 TO 5
        IF ((((g_tick / 5) + (i * 3)) % 8) < 4) THEN PcPix(cx - 14 + (i * 6), cy - 8 + ((i * 7) % 15), 0xFFFFC83C)
        dy = ((g_tick / 4) + (i * 3)) % 14
        PcPix(cx - 8 + (i * 3), cy - 28 - dy, 0xFF706868)
        PcPix(cx - 7 + (i * 3), cy - 29 - dy, 0xFF504848)
    NEXT i
    cx = ox + 158
    cy = oy + 54
    DrawGlyphText(cx + 14, cy - 30 - ((g_tick / 10) % 6), "Z", 0xFFFFFFFF, 1)
    DrawGlyphText(cx + 22, cy - 38 - ((g_tick / 12) % 5), "Z", 0xFFC8FFC8, 1)
ENDSUB

' page 2: Station Omega is safe, the fleet salutes
SUB PcStation(ox:INT, oy:INT)
    INT i, sz
    IF g_pOmegaBg <> 0 THEN DrawSpr(g_pOmegaBg, 78, 88, ox + 104, oy + 4, 0)
    IF g_pFleet <> 0 THEN
        DrawSpr(g_pFleet, 24, 26, ox + 4, oy + 68 - ((g_tick / 30) % 2), 0)                      ' the fleet: an interceptor, a striker, ...
        DrawSpr(g_pFleet + (624 * 4), 24, 26, ox + 30, oy + 72 - (((g_tick / 30) + 1) % 2), 0)
        DrawSpr(g_pFleet + (1248 * 4), 24, 26, ox + 84, oy + 70 - (((g_tick / 30) + 1) % 2), 0)  ' ... a heavy fighter ...
    ENDIF
    IF g_pLifeS <> 0 THEN DrawSpr(g_pLifeS, LIFE_W, LIFE_H, ox + 58, oy + 60 - ((g_tick / 30) % 2), 0)   ' ... and the hero in the middle
    sz = 2 + ((g_tick / 15) % 2)
    PcRect(ox + 54 - sz, oy + 30, (sz * 2) + 1, 1, 0xFFFFDC3C)
    PcRect(ox + 54, oy + 30 - sz, 1, (sz * 2) + 1, 0xFFFFDC3C)
    PcRect(ox + 53, oy + 29, 3, 3, 0xFFFFFFFF)
ENDSUB

' page 3: the pilot flies into the sunrise
SUB PcSunrise(ox:INT, oy:INT)
    INT sz, ay
    ay = oy + 34 + ((g_tick / 14) % 2)
    IF g_pLifeS <> 0 THEN
        DrawSpr(g_pLifeS, LIFE_W, LIFE_H, ox + 85, ay, 0)
        PcRect(ox + 91, ay + LIFE_H, 2, 2 + ((g_tick / 3) % 3), 0xFFFFE850)
        PcRect(ox + 99, ay + LIFE_H, 2, 2 + (((g_tick / 3) + 1) % 3), 0xFFFFE850)
    ENDIF
    sz = 3 + ((g_tick / 15) % 3)
    PcRect(ox + 126 - sz, oy + 68, (sz * 2) + 1, 1, 0xFFFFF4C0)
    PcRect(ox + 126, oy + 68 - sz, 1, (sz * 2) + 1, 0xFFFFF4C0)
ENDSUB

' the vignette of an ending page (pg 0 to 3): painting, animation, frame
SUB PcCard(pg:INT)
    INT ox, oy
    ox = 16
    oy = 38
    g_pcX0 = ox
    g_pcY0 = oy
    g_pcX1 = ox + 191
    g_pcY1 = oy + 99
    DrawVigFrame(ox, oy)
    IF pg = 4 AND g_pLove <> 0 THEN
        DrawSpr(g_pLove, 192, 100, ox, oy, 0)
    ELSEIF pg = 4 THEN
        FillRectSolid(ox, oy, 192, 100, 0xFF1A2440)
    ELSEIF g_pVig <> 0 THEN
        DrawSpr(g_pVig + (pg * 19200 * 4), 192, 100, ox, oy, 0)
    ELSE
        FillRectSolid(ox, oy, 192, 100, 0xFF080810)
    ENDIF
    IF pg = 0 THEN
        PcVictory(ox, oy)
    ELSEIF pg = 1 THEN
        PcAfter(ox, oy)
    ELSEIF pg = 2 THEN
        PcStation(ox, oy)
    ELSEIF pg = 4 THEN
        PcLove(ox, oy)
    ELSE
        PcSunrise(ox, oy)
    ENDIF
ENDSUB

SUB DrawStoryBr()
    INT b, col
    b = g_sBr
    IF b >= 10 THEN b = b - 10
    col = CampColor(b)
    IF g_sBr < 4 THEN
        DrawCentered(40, "BRIEFING", CycleColor(g_tick * 3))
        DrawPlanet(112, 226, 24, col)
        DrawBrief(b, g_sPage)
    ELSE
        DrawCentered(40, "REPORT", CycleColor(g_tick * 3))
        DrawPlanet(112, 226, 24, col)
        DrawEpi(b, g_sPage)
    ENDIF
    IF ((g_tick / 24) % 2) = 0 THEN DrawCentered(266, "PRESS FIRE", 0xFFFFFFFF)
ENDSUB

SUB DrawCampaign()
    INT b, cx, cy, rad, col, selb, pg

    IF g_gstate = GS_STORY AND g_sBr >= 0 THEN
        DrawStoryBr()
        RETURN
    ENDIF

    IF g_gstate = GS_STORY THEN
        DrawCentered(40, "STATION OMEGA", CycleColor(g_tick * 3))
        IF g_pStnS <> 0 THEN
            DrawSpr(g_pStnS, 160, 64, 32, 190, 0)
            IF ((g_tick / 20) % 2) = 0 THEN PutPix(112, 190, 0xFFFF3C3C) ELSE PutPix(112, 190, 0xFFFFAA3C)
        ELSE
            DrawOval(112, 215, 40, 16, 0xFF505078)
            FillRectSolid(106, 209, 12, 12, 0xFF9090C8)
            FillRectSolid(110, 205, 4, 20, 0xFF6464A0)
        ENDIF
        IF g_sPage = 0 THEN
            DrawCentered(80, "YEAR 2387", 0xFFFFDC3C)
            DrawCentered(104, "THE ALIEN EMPIRE HAS SWEPT", 0xFFFFFFFF)
            DrawCentered(116, "THROUGH EVERY HUMAN COLONY.", 0xFFFFFFFF)
            DrawCentered(140, "ONE BASTION REMAINS:", 0xFFFFFFFF)
            DrawCentered(152, "STATION OMEGA.", 0xFF3CE1FF)
        ELSEIF g_sPage = 1 THEN
            DrawCentered(92, "COMMAND HAS SEARCHED THE FLEET", 0xFFFFFFFF)
            DrawCentered(104, "FOR THE BEST PILOT", 0xFFFFFFFF)
            DrawCentered(116, "IN THE GALAXY.", 0xFFFFFFFF)
            DrawCentered(144, "THEY FOUND YOU.", 0xFFFFDC3C)
        ELSEIF g_sPage = 2 THEN
            DrawCentered(84, "THREE WORLDS FEED THE EMPIRE:", 0xFFFFFFFF)
            DrawCentered(104, "ICE   FIRE   HIVE", 0xFF64C8FF)
            DrawCentered(124, "DESTROY THE BIG BOSS", 0xFFFFFFFF)
            DrawCentered(136, "OF EACH WORLD", 0xFFFFFFFF)
            DrawCentered(156, "THEN STRIKE THE EMPIRE ITSELF.", 0xFFD23CFF)
        ELSE
            DrawCentered(100, "GOOD LUCK PILOT.", 0xFFFFDC3C)
            DrawCentered(124, "HUMANITY IS BEHIND YOU.", 0xFFFFFFFF)
        ENDIF
        IF ((g_tick / 24) % 2) = 0 THEN DrawCentered(266, "PRESS FIRE", 0xFFFFFFFF)
    ELSEIF g_gstate = GS_MAP THEN
        DrawRouteMap()
    ELSEIF g_gstate = GS_END THEN
        pg = g_sPage
        IF g_cosmo > 0 THEN
            IF g_sPage = 3 THEN pg = 4
            IF g_sPage = 4 THEN pg = 3
        ENDIF
        PcCard(pg)
        IF pg = 4 THEN
            DrawCentered(154, "BONUS ENDING : LOVE STORY", CycleColor(g_tick * 4))
            DrawCentered(180, "FROM : THE PILOT YOU RESCUED", 0xFFFFFFFF)
            DrawCentered(192, "TO : THE ONE WHO CAME BACK", 0xFFFFFFFF)
            DrawCentered(214, "YOU FOUND ME IN THE WRECKAGE.", 0xFFFF8CA0)
            DrawCentered(228, "NOW I FLY BESIDE YOU.", 0xFFFF8CA0)
            DrawCentered(246, "WELCOME HOME.", 0xFFFFDC3C)
        ELSEIF pg = 0 THEN
            DrawCentered(154, "VICTORY !", CycleColor(g_tick * 4))
            DrawCentered(194, "THE EMPEROR AND HIS FLAGSHIP FALL.", 0xFFFFFFFF)
            DrawCentered(206, "THE ALIEN FLEET SCATTERS.", 0xFFFFFFFF)
            DrawCentered(230, "THE LAST WAR IS OVER.", 0xFF3CE1FF)
        ELSEIF pg = 1 THEN
            DrawCentered(154, "AFTERMATH", 0xFFFFDC3C)
            DrawCentered(188, "ON CRYOS THE ICE MELTS.", 0xFF64C8FF)
            DrawCentered(204, "ON PYRRA THE FIRES DIE.", 0xFFFF6E28)
            DrawCentered(220, "ON XENOS THE HIVES SLEEP.", 0xFF78E650)
            DrawCentered(244, "THE EMPIRE IS NO MORE.", 0xFFD23CFF)
        ELSEIF pg = 2 THEN
            DrawCentered(154, "STATION OMEGA IS SAFE.", 0xFF3CE1FF)
            DrawCentered(170, "HUMANITY LIVES ON.", 0xFF3CE1FF)
            DrawCentered(196, "THE FLEET SALUTES", 0xFFFFFFFF)
            DrawCentered(208, "ITS BEST PILOT.", 0xFFFFFFFF)
            DrawCentered(232, "YOU ARE A LEGEND.", 0xFFFFDC3C)
        ELSE
            DrawCentered(154, "MISSION COMPLETE", 0xFFFFDC3C)
            DrawCentered(184, "FINAL SCORE", 0xFF3CE1FF)
            DrawNumber(139, 200, g_score, 0xFFFFFFFF)
        ENDIF
        IF g_cTimer > 40 AND ((g_tick / 24) % 2) = 0 THEN DrawCentered(266, "PRESS FIRE", 0xFFFFFFFF)
    ENDIF
ENDSUB

' ===============================================================================
' BIG BOSSES (kind 0: the frost manta of the ice planet)
' ===============================================================================
SUB BossSpawn(kind:INT)
    INT e, i
    FOR e = 0 TO 39
        g_eState[e] = ES_DEAD                        ' the boss fights alone
    NEXT e
    FOR i = 0 TO 31
        g_bbOn[i] = 0
    NEXT i
    g_bsOn = 1
    g_bsKind = kind
    HiveGuardsInit(kind)
    g_bsHp = 60
    IF g_diff = 0 THEN g_bsHp = 38
    IF g_diff = 2 THEN g_bsHp = 85
    IF kind = 1 THEN
        g_bsHp = 45
        IF g_diff = 0 THEN g_bsHp = 28
        IF g_diff = 2 THEN g_bsHp = 65
        FOR i = 0 TO 3
            g_rkHp[i] = 5
            IF g_diff = 0 THEN g_rkHp[i] = 3
            IF g_diff = 2 THEN g_rkHp[i] = 7
        NEXT i
    ENDIF
    IF kind = 2 THEN
        g_bsHp = 55
        IF g_diff = 0 THEN g_bsHp = 35
        IF g_diff = 2 THEN g_bsHp = 80
    ENDIF
    IF kind = 3 THEN
        IF g_diff = 0 THEN
            g_bsHp = 32 + 20
        ELSEIF g_diff = 2 THEN
            g_bsHp = 70 + 44
        ELSE
            g_bsHp = 50 + 32
        ENDIF
        FOR i = 0 TO 3
            g_tuHp[i] = 8
            IF g_diff = 0 THEN g_tuHp[i] = 5
            IF g_diff = 2 THEN g_tuHp[i] = 11
            g_tuCd[i] = 100 + (i * 30)
        NEXT i
    ENDIF
    IF kind = 4 THEN SetupEmperor()
    g_bsAcc = 0
    g_emRv = 0
    g_emMus = 0
    g_emSeq = 0
    g_emShk = 0
    g_emAt = 0
    g_fsOpen = 0
    g_fsBeam = 0
    g_fsBP = -1
    g_fsBX = 112.0
    g_bsSp = 120
    g_rkA = 0.0
    g_bsSpA = 0.0
    g_bsFlip = 0
    g_bsMax = g_bsHp
    g_bsT = 0
    g_bsFlash = 0
    g_bsDying = 0
    g_bsAtk = 150
    g_bsPh = 0
    g_bsDmg = 0
    g_bsSw = 0
    g_bsX = 112.0
    g_bsY = -50.0
    g_bsTX = 112.0
    g_bsSwA = 0.0
    IF kind = 4 THEN EmpBeginWake(-140.0)
ENDSUB

' difficulty scaling of the boss: shot speed and pace (easy is much gentler)
SUB BossSpeed(), FLOAT
    IF g_diff = 0 THEN RETURN 0.7
    IF g_diff = 2 THEN RETURN 1.0
    RETURN 0.85
ENDSUB

SUB BossPace(), INT
    IF g_diff = 0 THEN RETURN 160                 ' % of the attack delay
    IF g_diff = 2 THEN RETURN 100
    RETURN 125
ENDSUB

SUB BossShot(x:FLOAT, y:FLOAT, vx:FLOAT, vy:FLOAT)
    INT i
    FOR i = 0 TO 31
        IF g_bbOn[i] = 0 THEN
            g_bbOn[i] = 1
            g_bbX[i] = x
            g_bbY[i] = y
            g_bbVX[i] = vx * BossSpeed()
            g_bbVY[i] = vy * BossSpeed()
            RETURN
        ENDIF
    NEXT i
ENDSUB

' n shots in a fan straight down from the boss
SUB BossFan(n:INT, spread:FLOAT, spd:FLOAT)
    INT k
    FOR k = 0 TO n - 1
        BossShot(g_bsX, g_bsY + 18.0, FLOAT((2 * k) - (n - 1)) * 0.5 * spread, spd)
    NEXT k
    PlaySfx(5)
ENDSUB

SUB BossAim(x:FLOAT, y:FLOAT, spd:FLOAT)
    FLOAT dx, dy, d
    dx = g_px - x
    dy = g_py - y
    d = SQRT((dx * dx) + (dy * dy))
    IF d < 1.0 THEN d = 1.0
    BossShot(x, y, (dx / d) * spd, (dy / d) * spd)
ENDSUB

SUB UpdateBoss()
    INT i, ph, k, hitR
    FLOAT f, tgx, tgy

    IF g_bsOn = 0 THEN RETURN
    g_bsT = g_bsT + 1
    IF g_bsFlash > 0 THEN g_bsFlash = g_bsFlash - 1

    ' boss bullets
    FOR i = 0 TO 31
        IF g_bbOn[i] = 1 THEN
            g_bbX[i] = g_bbX[i] + g_bbVX[i]
            g_bbY[i] = g_bbY[i] + g_bbVY[i]
            IF g_bbY[i] > 296.0 OR g_bbY[i] < -12.0 OR g_bbX[i] < -8.0 OR g_bbX[i] > 232.0 OR g_gstate = GS_PDEAD OR g_bsDying > 0 THEN
                g_bbOn[i] = 0
            ELSEIF g_palive = 1 THEN
                IF ABS(g_bbX[i] - g_px) < (5.0 + (8.0 * FLOAT(g_dual))) AND ABS(g_bbY[i] - g_py) < 7.0 THEN
                    g_bbOn[i] = 0
                    KillPlayer()
                ENDIF
            ENDIF
        ENDIF
    NEXT i

    ' dying: a string of explosions, then the boss is gone
    IF g_bsDying > 0 THEN
        g_bsDying = g_bsDying - 1
        IF (g_bsDying % 3) = 0 THEN
            IF g_bsKind = 4 THEN
                SpawnExplosion(g_bsX + RND(90.0) - 45.0, g_bsY + RND(84.0))
            ELSE
                SpawnExplosion(g_bsX + RND(100.0) - 50.0, g_bsY + RND(50.0) - 25.0)
            ENDIF
            IF (g_bsDying % 6) = 0 THEN PlaySfx(3)
        ENDIF
        IF g_bsDying = 6 THEN
            FOR k = 0 TO 7
                SpawnExplosion(g_bsX + RND(90.0) - 45.0, g_bsY + RND(44.0) - 22.0)
            NEXT k
            PlaySfx(4)
        ENDIF
        g_bsY = g_bsY + 0.25
        IF g_bsDying = 0 THEN g_bsOn = 0
        RETURN
    ENDIF

    IF g_emRv > 0 THEN
        UpdateEmpReveal()                               ' the flagship is beaten: its hatch opens on something worse
        RETURN
    ENDIF

    ph = 0
    IF g_bsHp * 3 <= g_bsMax * 2 THEN ph = 1
    IF g_bsHp * 3 <= g_bsMax THEN ph = 2
    IF ph > g_bsPh THEN
        g_bsPh = ph
        g_bsAtk = 40                                   ' a new phase: a short breather first
        PlaySfx(6)
    ENDIF

    ' entry: glides in from above, harmless and untouchable
    IF g_bsT < 130 THEN
        g_bsY = -50.0 + (128.0 * FLOAT(g_bsT) / 130.0)
        RETURN
    ENDIF

    ' player bullets
    FOR i = 0 TO 15
        IF g_pbOn[i] = 1 THEN
            hitR = BossBulletHit(i)
            IF hitR > 0 THEN
                g_pbOn[i] = 0
                g_stHits = g_stHits + 1
                g_totHits = g_totHits + 1
            ENDIF
            IF hitR = 3 THEN g_bsFlash = 2
            IF hitR = 2 THEN
                g_bsHp = g_bsHp - 1
                g_bsFlash = 3
                g_bsDmg = g_bsDmg + 1
                IF (g_bsDmg % 3) = 0 THEN PlaySfx(2)
                IF (g_bsDmg % 20) = 0 THEN SpawnPrize(g_bsX, g_bsY + 14.0)
                IF g_bsHp <= 0 THEN
                    g_bsHp = 0
                    IF g_bsKind = 3 THEN
                        StartEmpReveal()
                        RETURN
                    ENDIF
                    g_bsDying = 110
                    HiveGuardsKill(1)
                    AddScore(10000)
                    SpawnPopup(g_bsX, g_bsY, 10000)
                    PlaySfx(4)
                    FOR k = 0 TO 31
                        g_bbOn[k] = 0
                    NEXT k
                    FOR k = 0 TO 39
                        IF g_eState[k] <> ES_DEAD THEN
                            SpawnExplosion(g_eX[k], g_eY[k])           ' the brood dies with its queen
                            g_eState[k] = ES_DEAD
                        ENDIF
                    NEXT k
                    RETURN
                ENDIF
            ENDIF
        ENDIF
    NEXT i

    IF g_bsKind = 1 THEN
        UpdateCoreAI(ph)
        RETURN
    ENDIF
    IF g_bsKind = 2 THEN
        UpdateQueenAI(ph)
        RETURN
    ENDIF
    IF g_bsKind = 3 THEN
        UpdateFlagAI(ph)
        RETURN
    ENDIF
    IF g_bsKind = 4 THEN
        UpdateEmpAI()
        RETURN
    ENDIF

    ' movement
    IF g_bsSw = 0 THEN
        g_bsSwA = g_bsSwA + 0.012 + (0.004 * FLOAT(ph))
        tgx = 112.0 + (62.0 * SIN(g_bsSwA))
        tgy = 78.0 + (6.0 * SIN(FLOAT(g_bsT) * 0.05))
        g_bsX = g_bsX + ((tgx - g_bsX) * 0.06)
        g_bsY = g_bsY + ((tgy - g_bsY) * 0.05)
    ELSEIF g_bsSw = 1 THEN                               ' swoop down towards where the ship was
        f = g_bsTX - g_bsX
        IF f > 2.6 THEN f = 2.6
        IF f < -2.6 THEN f = -2.6
        g_bsX = g_bsX + f
        g_bsY = g_bsY + 3.4
        IF g_bsY >= 240.0 THEN
            g_bsSw = 2
            BossFan(7 - (2 * (1 - g_diff) * (1 - (g_diff / 2))), 0.5, 1.9)
        ENDIF
    ELSE
        g_bsY = g_bsY - 2.4
        IF g_bsY <= 80.0 THEN
            g_bsSw = 0
            g_bsAtk = 60
        ENDIF
    ENDIF
    IF g_bsSw > 0 AND g_palive = 1 THEN
        IF ABS(g_bsX - g_px) < 32.0 AND (g_bsY + 14.0) > (g_py - 12.0) AND (g_bsY - 14.0) < (g_py + 8.0) THEN KillPlayer()
    ENDIF
    IF g_free = 1 AND g_palive = 1 AND g_flash = 0 AND g_shield = 0 THEN
        IF ABS(g_bsX - g_px) < 22.0 AND ABS((g_bsY + 4.0) - g_py) < 16.0 THEN KillPlayer()
    ENDIF

    ' attacks (not while the ship is down, nor during a swoop)
    IF g_palive = 0 OR g_bsSw > 0 THEN RETURN
    IF ph >= 1 AND (g_bsT % ((26 * BossPace()) / 100)) = 0 THEN BossShot(8.0 + RND(208.0), 34.0, 0.0, 2.3)      ' icicle rain
    g_bsAtk = g_bsAtk - 1
    IF g_bsAtk > 0 THEN RETURN
    IF ph = 0 THEN
        BossFan(5, 0.55, 1.7)
        g_bsAtk = (85 * BossPace()) / 100
    ELSEIF ph = 1 THEN
        BossFan(7, 0.45, 1.9)
        IF g_diff > 0 THEN
            BossAim(g_bsX - 30.0, g_bsY + 4.0, 2.2)
            BossAim(g_bsX + 30.0, g_bsY + 4.0, 2.2)
        ENDIF
        g_bsAtk = (65 * BossPace()) / 100
    ELSE
        IF RND(100.0) < FLOAT(15 + (g_diff * 10)) THEN
            g_bsSw = 1
            g_bsTX = g_px
        ELSE
            BossFan(9, 0.4, 2.0)
            IF g_diff > 0 THEN BossAim(g_bsX, g_bsY + 10.0, 2.5)
            g_bsAtk = (55 * BossPace()) / 100
        ENDIF
    ENDIF
ENDSUB

' the manta seen from above, facing down: wings flap, red eyes, a long tail
SUB DrawMantaVec(cx:INT, cy:INT, fp:FLOAT, flash:INT)
    INT dx, dy, ins, col, adx
    FLOAT ux, yl, yt, f, fy, bx, by

    f = 7.0 * SIN(fp)
    FOR dy = -36 TO 28
        FOR dx = -52 TO 52
            adx = dx
            IF adx < 0 THEN adx = 0 - adx
            ins = 0
            col = 0xFF3C78C8
            fy = FLOAT(dy)
            ux = FLOAT(adx) / 50.0
            IF ux <= 1.0 THEN
                yl = 14.0 - (30.0 * ux) + (f * ux * ux)
                yt = -8.0 - (14.0 * ux) + (f * ux * ux)
                IF fy <= yl AND fy >= yt THEN
                    ins = 1
                    IF ux > 0.6 THEN col = 0xFF2D5AA0
                    IF ((dx * 7) + (dy * 13)) % 23 = 0 THEN col = 0xFFC8F0FF
                    IF yl - fy < 2.0 THEN col = 0xFF8CD2FF
                    IF fy - yt < 2.0 THEN col = 0xFF1E3C78
                ENDIF
            ENDIF
            bx = FLOAT(dx) / 9.0
            by = (fy - 4.0) / 17.0
            IF (bx * bx) + (by * by) <= 1.0 THEN
                ins = 1
                col = 0xFF64B4F0
                IF adx < 2 THEN col = 0xFF8CD2FF
                IF dy >= 12 AND dy <= 14 AND adx >= 3 AND adx <= 5 THEN col = 0xFFFF3C3C
            ENDIF
            IF dy < -9 AND dy > -34 AND adx <= 1 THEN
                IF adx = 0 OR dy > -26 THEN
                    ins = 1
                    col = 0xFF2D5AA0
                ENDIF
            ENDIF
            IF dy >= 18 AND dy <= 22 AND adx >= 4 AND adx <= 7 THEN         ' head fins
                ins = 1
                col = 0xFF8CD2FF
            ENDIF
            IF ins = 1 THEN
                IF flash > 0 THEN col = 0xFFD8F0FF
                PutPix(cx + dx, cy + dy, col)
            ENDIF
        NEXT dx
    NEXT dy
ENDSUB

' the manta as baked 16 bit art: 9 wing-flap frames of 116 x 84, colour 0 = transparent
SUB DrawManta(cx:INT, cy:INT, fp:FLOAT, flash:INT)
    INT fi, x, y, col
    POINTER pf
    IF g_pManta = 0 THEN
        DrawMantaVec(cx, cy, fp, flash)
        RETURN
    ENDIF
    fi = MantaFrame(fp)
    pf = g_pManta + (fi * 116 * 84 * 4)
    FOR y = 0 TO 83
        FOR x = 0 TO 115
            col = *<INT>(pf + (((y * 116) + x) * 4))
            IF col <> 0 THEN
                IF flash > 0 THEN col = 0xFFD8F0FF
                PutPix(cx - 58 + x, cy - 48 + y, col)
            ENDIF
        NEXT x
    NEXT y
ENDSUB

' ---- 16 bit enemy and ship art: every sprite has its own palette of up to 15 colours and is stored as ready 32 bit colours
SUB SprBegin(slot:INT, pal:STRING)
    INT i, k, c, v, col
    POINTER p
    p = &pal
    g_sprBase = slot * 256
    g_bgPos = 0
    g_bgLimit = 256
    g_bgPal[0] = 0
    FOR i = 0 TO 14
        col = 0
        FOR k = 0 TO 5
            c = *<CHAR>(p + (i * 6) + k)
            IF c >= 65 THEN v = c - 55 ELSE v = c - 48
            col = (col << 4) | v
        NEXT k
        g_bgPal[i + 1] = 0xFF000000 | col
    NEXT i
ENDSUB

SUB SprRun(s:STRING)
    INT i, n, c, cnt, idx, k
    POINTER p
    p = &s
    n = LEN(s)
    i = 0
    WHILE i < n
        c = *<CHAR>(p + i)
        IF c >= 65 THEN idx = c - 55 ELSE idx = c - 48
        c = *<CHAR>(p + i + 1)
        IF c >= 65 AND c <= 90 THEN
            cnt = c - 65
        ELSEIF c >= 97 AND c <= 122 THEN
            cnt = c - 71
        ELSEIF c >= 48 AND c <= 57 THEN
            cnt = c + 4
        ELSEIF c = 43 THEN
            cnt = 62
        ELSE
            cnt = 63
        ENDIF
        cnt = cnt + 1
        FOR k = 1 TO cnt
            IF g_bgPos < g_bgLimit THEN
                g_spr[g_sprBase + g_bgPos] = g_bgPal[idx]
                g_bgPos = g_bgPos + 1
            ENDIF
        NEXT k
        i = i + 2
    ENDWHILE
ENDSUB

